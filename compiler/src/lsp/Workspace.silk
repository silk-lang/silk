/// A zero-based line and column in a document, the column counted in the negotiated encoding.
pub struct Position {
  pub line: usize,
  pub character: usize,
}

impl Copy for Position {}

/// One diagnostic, located for the client.
pub struct Problem {
  pub start: Position,
  pub end: Position,
  pub code: Bytes,
  pub message: Bytes,
  /// Whether the problem is a warning rather than an error.
  pub warning: bool,
  /// Whether it marks code that does nothing, such as an unused binding, which a client fades.
  pub unnecessary: bool,
}

/// The diagnostics owed to the client for one document; an empty list clears its diagnostics.
pub struct Published {
  pub uri: Bytes,
  pub version: Option<usize>,
  pub problems: List<Problem>,
}

/// One open document.
pub struct Document {
  pub uri: Bytes,
  pub version: usize,
  pub text: Bytes,

  // The package that owns the document, or usize.MAX when it has none.
  package: usize,

  // The document's module in its package; none outside a package or a valid module path.
  module: Option<ModuleId>,

  // Whether the text changed since its diagnostics were last taken.
  stale: bool,

  // Whether the client has not yet seen this text's diagnostics.
  owed: bool,

  // The text parsed alone, once its diagnostics are taken; the syntax features read it.
  unit: Option<SourceUnit>,

  // Why the package of the nearest manifest could not be opened, such as a git dependency whose
  // commit is not fetched yet: shown on the document's first line, as `silk check` would refuse.
  refusal: Option<Bytes>,
}

// The last check of one module.
struct Checked {
  module: ModuleId,
  rejections: List<Shared<Rejection>>,

  // Whether the check saw the package's current revision.
  current: bool,
}

struct Package {
  sources: ModuleSources,
  store: Semantic,
  request: SemanticRequest,
  rootPackage: List<ModuleId>,
  runtime: Option<ModuleId>,

  // Whether the package's profile was assembled; a refused one gets syntax diagnostics only.
  semantic: bool,

  // Whether an open document of this package changed since the store's last update.
  stale: bool,

  // The modules waiting for a check, open documents' first.
  queue: List<ModuleId>,

  // The module being prepared one declaration per step, and its declarations not yet prepared.
  // Its check follows the last one.
  preparing: Option<ModuleId>,
  unprepared: List<DeclarationId>,
  checked: List<Checked>,

  // The modules whose diagnostics changed since they were last taken.
  dirty: List<ModuleId>,

  // The closed modules whose last published diagnostics were not empty.
  shown: List<ModuleId>,

  // The package's semantic cache file, read when the package opened, and how many module checks
  // the store had run when it last wrote the file.
  cache: Option<CacheFile>,
  saved: usize,
}

/// The open documents and the packages they belong to.
pub struct Workspace {
  standardLibrary: Option<Path>,
  // The git checkout store git dependencies read (driver/GitCheckouts); the server never fetches.
  store: Option<Path>,
  target: Target,
  documents: List<Document>,
  packages: List<Package>,

  // Documents closed since diagnostics were last taken, whose diagnostics the client must clear.
  closed: List<Bytes>,
}

/// An empty workspace whose packages read the standard library at `standardLibrary` and their git
/// dependencies' checkouts in `store`, and analyze for `target`.
pub fn make(standardLibrary: Option<Path>, store: Option<Path>, target: Target) -> Workspace {
  return Workspace {
    standardLibrary: move standardLibrary,
    store: move store,
    target: target,
    documents: List<Document>.make(),
    packages: List<Package>.make(),
    closed: List<Bytes>.make(),
  }
}

impl Workspace {
  /// The `file:` URI of the standard library the workspace's packages read, if it has one.
  pub effect fn libraryUri(self: &Self) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
    return match &self.standardLibrary {
      Option<Path>.Some { value } => Option<Bytes>.some(run fileUri(Path.rawBytes(&value)))
      Option<Path>.None => Option<Bytes>.none()
    }
  }

  /// Opens the document at `uri` with `text`, or replaces it when it is already open.
  pub effect fn open(self: &mut Self, uri: &[u8], version: usize, text: &[u8]) -> ()
    ! OutOfMemoryError
    ? &mut FileSystem | &mut Allocator | &mut Types {
    if documentAt(&self.*, uri) != usize.MAX {
      return run self.change(uri, version, text)
    }
    let mut package = usize.MAX
    let mut module = Option<ModuleId>.none()
    let mut refusal = Option<Bytes>.none()
    if let Option<Bytes>.Some { value: path } = move run filePath(uri) {
      package = run packageFor(&mut self.*, Bytes.asSlice(&path), &mut refusal)
      if package != usize.MAX {
        let packages = List<Package>.asMutSlice(&mut self.packages)
        module = run moduleIn(&packages[package].sources, Bytes.asSlice(&path))
        packages[package].stale = true
      }
    }
    run markReaders(&mut self.*, uri)
    return run List<Document>.append(
      &mut self.documents,
      Document {
        uri: run Bytes.copy(uri),
        version: version,
        text: run Bytes.copy(text),
        package: package,
        module: move module,
        stale: true,
        owed: true,
        unit: Option<SourceUnit>.none(),
        refusal: move refusal,
      }
    )
  }

  /// Replaces the whole text of the open document at `uri`; an unknown document is ignored.
  pub effect fn change(self: &mut Self, uri: &[u8], version: usize, text: &[u8]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let at = documentAt(&self.*, uri)
    if at == usize.MAX {
      return ()
    }
    let replaced = run Bytes.copy(text)
    let documents = List<Document>.asMutSlice(&mut self.documents)
    documents[at].text = move replaced
    documents[at].version = version
    documents[at].stale = true
    documents[at].owed = true
    let package = documents[at].package
    if package != usize.MAX {
      let packages = List<Package>.asMutSlice(&mut self.packages)
      packages[package].stale = true
    }
    return run markReaders(&mut self.*, uri)
  }

  /// Takes the saved text of the open document at `uri` as its file's contents for every package
  /// that reads it, so they keep it once the document closes.
  pub effect fn save(self: &mut Self, uri: &[u8]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let at = documentAt(&self.*, uri)
    if at == usize.MAX {
      return ()
    }
    let path = match move run filePath(uri) {
      Option<Bytes>.Some { value } => move value
      Option<Bytes>.None => {
        return ()
      }
    }
    let documents = List<Document>.asSlice(&self.documents)
    let packages = List<Package>.asMutSlice(&mut self.packages)
    let mut package = usize.ZERO
    while package < packages.length {
      if let Option<ModuleId>.Some { value: module } = move run readerModule(&packages[package], Bytes.asSlice(&path)) {
        run Sources.reread(&mut packages[package].sources, &module, Bytes.asSlice(&documents[at].text))
        packages[package].stale = true
      }
      package = package + usize.ONE
    }
    return ()
  }

  /// Applies the changes of one `didChange` notification to the open document at `uri`, each to
  /// the text the ones before it left, with positions counted in `encoding`.
  pub effect fn edit(self: &mut Self, uri: &[u8], version: usize, changes: &[Change], encoding: PositionEncoding) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let at = documentAt(&self.*, uri)
    if at == usize.MAX || changes.length == usize.ZERO {
      return ()
    }
    let mut text = run Bytes.copy(Bytes.asSlice(&List<Document>.asSlice(&self.documents)[at].text))
    let mut index = usize.ZERO
    while index < changes.length {
      let replacement = Bytes.asSlice(&changes[index].text)
      if changes[index].whole {
        text = run Bytes.copy(replacement)
      } else {
        let current = Bytes.asSlice(&text)
        let start = offsetOf(current, changes[index].start, encoding)
        let mut end = offsetOf(current, changes[index].end, encoding)
        if end < start {
          end = start
        }
        let mut spliced = run Bytes.copy(Slice.view<u8>(current, usize.ZERO, start))
        run Bytes.append(&mut spliced, replacement)
        run Bytes.append(&mut spliced, Slice.view<u8>(current, end, current.length - end))
        text = move spliced
      }
      index = index + usize.ONE
    }
    return run self.change(uri, version, Bytes.asSlice(&text))
  }

  /// Closes the document at `uri`; its module returns to the package's disk contents.
  pub effect fn close(self: &mut Self, uri: &[u8]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let at = documentAt(&self.*, uri)
    if at == usize.MAX {
      return ()
    }
    let removed = List<Document>.remove(&mut self.documents, at)
    if removed.package != usize.MAX {
      let packages = List<Package>.asMutSlice(&mut self.packages)
      packages[removed.package].stale = true
    }
    run markReaders(&mut self.*, Bytes.asSlice(&removed.uri))
    return run List<Bytes>.append(&mut self.closed, move removed.uri)
  }

  /// Reports whether any document or package is waiting for [`refresh`] or [`diagnostics`]: a
  /// changed document, a document whose module's check is done, or a module whose checked
  /// diagnostics changed.
  pub fn stale(self: &Self) -> bool {
    if List<Bytes>.length(&self.closed) > usize.ZERO {
      return true
    }
    let documents = List<Document>.asSlice(&self.documents)
    let mut at = usize.ZERO
    while at < documents.length {
      if documents[at].stale || (documents[at].owed && !waiting(&self.*, &documents[at])) {
        return true
      }
      at = at + usize.ONE
    }
    let packages = List<Package>.asSlice(&self.packages)
    at = usize.ZERO
    while at < packages.length {
      if packages[at].stale || List<ModuleId>.length(&packages[at].dirty) > usize.ZERO {
        return true
      }
      at = at + usize.ONE
    }
    return false
  }

  /// Reports whether a module is waiting for [`work`].
  pub fn busy(self: &Self) -> bool {
    let packages = List<Package>.asSlice(&self.packages)
    let mut at = usize.ZERO
    while at < packages.length {
      if List<ModuleId>.length(&packages[at].queue) > usize.ZERO || preparingOne(&packages[at]) {
        return true
      }
      at = at + usize.ONE
    }
    return false
  }

  /// Opens again the package of each edited document whose package was refused, as the edit may
  /// follow a fetch or a manifest fix; one still refused keeps the newest refusal.
  pub effect fn reopen(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut FileSystem | &mut Allocator | &mut Types {
    let mut at = usize.ZERO
    while at < List<Document>.length(&self.documents) {
      let mut retried = Option<Bytes>.none()
      let document = &List<Document>.asSlice(&self.documents)[at]
      if let Option<Bytes>.Some {..} = &document.refusal {
        if document.stale { retried = run filePath(Bytes.asSlice(&document.uri)) }
      }
      if let Option<Bytes>.Some { value: path } = move retried {
        let mut refusal = Option<Bytes>.none()
        let package = run packageFor(&mut self.*, Bytes.asSlice(&path), &mut refusal)
        let mut module = Option<ModuleId>.none()
        if package != usize.MAX {
          let packages = List<Package>.asMutSlice(&mut self.packages)
          module = run moduleIn(&packages[package].sources, Bytes.asSlice(&path))
          packages[package].stale = true
        }
        let documents = List<Document>.asMutSlice(&mut self.documents)
        documents[at].package = package
        documents[at].module = move module
        documents[at].refusal = move refusal
      }
      at = at + usize.ONE
    }
    return ()
  }

  /// Brings every stale package's store up to its open documents: one revision of the disk
  /// sources with each open document published over its module, and one store update. Then queues
  /// every module of the package for a check, open documents' modules first.
  pub effect fn refresh(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut FileSystem | &mut Allocator {
    let mut package = usize.ZERO
    while package < List<Package>.length(&self.packages) {
      if List<Package>.asSlice(&self.packages)[package].stale {
        run refreshPackage(&mut self.*, package)
      }
      package = package + usize.ONE
    }
    return ()
  }

  /// Takes one step of the next queued module's check, if any, and answers whether it took one.
  /// A step checks a module whose kept sweep still verifies, or lists, prepares one declaration
  /// of, or finally checks a module that must be swept again.
  pub effect fn work(self: &mut Self) -> bool
    ! OutOfMemoryError
    ? &mut FileSystem | &mut Allocator | &mut Types {
    let packages = List<Package>.asMutSlice(&mut self.packages)
    let mut at = usize.ZERO
    while at < packages.length {
      if preparingOne(&packages[at]) || List<ModuleId>.length(&packages[at].queue) > usize.ZERO {
        run step(&mut packages[at])
        // The package's first full check is written to its cache once it finishes, so the next
        // session starts warm; later edits are written when the server shuts down.
        if packages[at].saved == usize.ZERO && !preparingOne(&packages[at]) && List<ModuleId>.length(&packages[at].queue) == usize.ZERO {
          run persist(&mut packages[at])
        }
        return true
      }
      at = at + usize.ONE
    }
    return false
  }

  /// Writes each package's semantic cache, for the module checks run since it was last written.
  pub effect fn persistCaches(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut FileSystem | &mut Allocator {
    let packages = List<Package>.asMutSlice(&mut self.packages)
    let mut at = usize.ZERO
    while at < packages.length {
      run persist(&mut packages[at])
      at = at + usize.ONE
    }
  }

  /// Takes the diagnostics the client has not seen: those of every document changed since the
  /// last call, the checked diagnostics of every module whose diagnostics changed, and an empty
  /// list for every document closed since then.
  ///
  /// A changed document of a package with semantic analysis waits for its module's check, unless
  /// it has syntax errors, which hide semantic ones, so its diagnostics never flicker.
  pub effect fn diagnostics(self: &mut Self, encoding: PositionEncoding) -> List<Published>
    ! OutOfMemoryError
    ? &mut FileSystem | &mut Allocator {
    let mut published = List<Published>.make()
    while List<Bytes>.length(&self.closed) > usize.ZERO {
      let uri = List<Bytes>.remove(&mut self.closed, usize.ZERO)
      run List<Published>.append(
        &mut published,
        Published { uri: move uri, version: Option<usize>.none(), problems: List<Problem>.make() }
      )
    }

    // Changed documents are parsed alone; the dirty modules of their packages are marked owed.
    let mut at = usize.ZERO
    while at < List<Document>.length(&self.documents) {
      let documents = List<Document>.asMutSlice(&mut self.documents)
      if documents[at].stale {
        documents[at].unit = run parse(&documents[at])
        documents[at].stale = false
      }
      at = at + usize.ONE
    }
    let mut package = usize.ZERO
    while package < List<Package>.length(&self.packages) {
      while List<ModuleId>.length(&List<Package>.asSlice(&self.packages)[package].dirty) > usize.ZERO {
        let packages = List<Package>.asMutSlice(&mut self.packages)
        let module = List<ModuleId>.remove(&mut packages[package].dirty, usize.ZERO)
        let opened = documentOf(&self.*, package, &module)
        if opened != usize.MAX {
          // A document with syntax errors shows only those, so its module's check changes nothing.
          let documents = List<Document>.asMutSlice(&mut self.documents)
          if !malformed(&documents[opened]) {
            documents[opened].owed = true
          }
        } else {
          run publishClosed(&mut List<Package>.asMutSlice(&mut self.packages)[package], &module, encoding, &mut published)
        }
      }
      package = package + usize.ONE
    }

    at = usize.ZERO
    while at < List<Document>.length(&self.documents) {
      if let Option<Published>.Some { value } = move run documentDiagnostics(&self.*, at, encoding) {
        run List<Published>.append(&mut published, move value)
        let documents = List<Document>.asMutSlice(&mut self.documents)
        documents[at].owed = false
      }
      at = at + usize.ONE
    }
    return move published
  }

  /// The parsed text of the open document at `uri`, current once [`diagnostics`] has been taken
  /// since its last change.
  pub fn unit(self: &Self, uri: &[u8]) -> Option<&SourceUnit> {
    let at = documentAt(&self.*, uri)
    if at == usize.MAX {
      return Option<&SourceUnit>.none()
    }
    return match &List<Document>.asSlice(&self.documents)[at].unit {
      Option<SourceUnit>.Some { value } => Option<&SourceUnit>.some(&value)
      Option<SourceUnit>.None => Option<&SourceUnit>.none()
    }
  }

  /// The demand counters of the store that owns the document at `uri`, if it has one.
  pub fn statistics(self: &Self, uri: &[u8]) -> Option<Statistics> {
    let at = documentAt(&self.*, uri)
    if at == usize.MAX {
      return Option<Statistics>.none()
    }
    let package = List<Document>.asSlice(&self.documents)[at].package
    if package == usize.MAX {
      return Option<Statistics>.none()
    }
    return Option<Statistics>.some(
      Semantic.statistics(&List<Package>.asSlice(&self.packages)[package].store)
    )
  }

  /// What the cursor at `position` of the open document at `uri` names, as Markdown, or the type
  /// of the expression under it.
  pub effect fn hover(self: &mut Self, uri: &[u8], position: Position, encoding: PositionEncoding) -> Option<Shown>
    ! OutOfMemoryError
    ? &mut FileSystem | &mut Allocator | &mut Types {
    let at = run subject(&mut self.*, uri)
    if at == usize.MAX {
      return Option<Shown>.none()
    }
    let document = &List<Document>.asSlice(&self.documents)[at]
    let module = moduleOf(document)
    let text = Bytes.asSlice(&document.text)
    let offset = offsetOf(text, position, encoding)
    let package = &mut List<Package>.asMutSlice(&mut self.packages)[document.package]
    let attempted = run Effect.result(Navigation.hover(&mut package.store, &module, text, offset))
    let shown = match move attempted {
      Result<Option<Hover>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success { value } => move value
      Result<Option<Hover>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure { error } => match move error {
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
        _ => Option<Hover>.none()
      }
    }
    if let Option<Hover>.Some { value } = move shown {
      // Each resolved code link points at its destination's line: `file:///…#L12`.
      let written = Bytes.asSlice(&value.text)
      let links = List<Linked>.asSlice(&value.links)
      let mut linked = Bytes.make()
      let mut cursor = usize.ZERO
      let mut index = usize.ZERO
      while index < links.length {
        run Bytes.append(&mut linked, Slice.view<u8>(written, cursor, links[index].at - cursor))
        cursor = links[index].at
        if let Option<Bytes>.Some { value: target } = move run uriOf(&package.sources, &links[index].module) {
          run Bytes.append(&mut linked, b"(")
          run Bytes.append(&mut linked, Bytes.asSlice(&target))
          run Bytes.append(&mut linked, b"#L")
          run appendDecimal(&mut linked, links[index].line + usize.ONE)
          run Bytes.append(&mut linked, b")")
        }
        index = index + usize.ONE
      }
      run Bytes.append(&mut linked, Slice.view<u8>(written, cursor, written.length - cursor))
      return Option<Shown>.some(Shown {
        start: locate(text, value.span.start, encoding),
        end: locate(text, value.span.end, encoding),
        text: move linked,
      })
    }
    return Option<Shown>.none()
  }

  /// Where the name at `position` of the open document at `uri` is defined.
  pub effect fn definition(self: &mut Self, uri: &[u8], position: Position, encoding: PositionEncoding) -> Option<Location>
    ! OutOfMemoryError
    ? &mut FileSystem | &mut Allocator | &mut Types {
    let at = run subject(&mut self.*, uri)
    if at == usize.MAX {
      return Option<Location>.none()
    }
    let document = &List<Document>.asSlice(&self.documents)[at]
    let module = moduleOf(document)
    let text = Bytes.asSlice(&document.text)
    let offset = offsetOf(text, position, encoding)
    let package = &mut List<Package>.asMutSlice(&mut self.packages)[document.package]
    let attempted = run Effect.result(Navigation.definition(&mut package.store, &module, text, offset))
    let found = match move attempted {
      Result<Option<Destination>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success { value } => move value
      Result<Option<Destination>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure { error } => match move error {
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
        _ => Option<Destination>.none()
      }
    }
    if let Option<Destination>.Some { value: target } = move found {
      let mut targetUri = run Bytes.copy(Bytes.asSlice(&document.uri))
      if !ModuleId.equals(&target.module, &module) {
        match move run uriOf(&package.sources, &target.module) {
          Option<Bytes>.Some { value } => {
            targetUri = move value
          }
          Option<Bytes>.None => {
            return Option<Location>.none()
          }
        }
      }
      let targetText = Bytes.asSlice(&target.text)
      return Option<Location>.some(Location {
        uri: move targetUri,
        start: locate(targetText, target.span.start, encoding),
        end: locate(targetText, target.span.end, encoding),
      })
    }
    return Option<Location>.none()
  }

  /// A `: Type` hint after each binding of the open document at `uri` whose type was inferred.
  pub effect fn hints(self: &mut Self, uri: &[u8], encoding: PositionEncoding) -> List<Hinted>
    ! OutOfMemoryError
    ? &mut FileSystem | &mut Allocator | &mut Types {
    let mut hinted = List<Hinted>.make()
    let at = run subject(&mut self.*, uri)
    if at == usize.MAX {
      return move hinted
    }
    let document = &List<Document>.asSlice(&self.documents)[at]
    let module = moduleOf(document)
    let text = Bytes.asSlice(&document.text)
    let package = &mut List<Package>.asMutSlice(&mut self.packages)[document.package]
    let attempted = run Effect.result(Navigation.hints(&mut package.store, &module))
    let found = match move attempted {
      Result<List<Hint>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success { value } => move value
      Result<List<Hint>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure { error } => match move error {
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
        _ => List<Hint>.make()
      }
    }
    let listed = List<Hint>.asSlice(&found)
    let mut index = usize.ZERO
    while index < listed.length {
      run List<Hinted>.append(&mut hinted, Hinted {
        position: locate(text, listed[index].offset, encoding),
        label: run Bytes.copy(Bytes.asSlice(&listed[index].label)),
      })
      index = index + usize.ONE
    }
    return move hinted
  }

  /// The signature of the call whose arguments hold `position` in the open document at `uri`.
  pub effect fn signature(self: &mut Self, uri: &[u8], position: Position, encoding: PositionEncoding) -> Option<Help>
    ! OutOfMemoryError
    ? &mut FileSystem | &mut Allocator | &mut Types {
    let at = run subject(&mut self.*, uri)
    if at == usize.MAX {
      return Option<Help>.none()
    }
    let document = &List<Document>.asSlice(&self.documents)[at]
    let module = moduleOf(document)
    let offset = offsetOf(Bytes.asSlice(&document.text), position, encoding)
    let package = &mut List<Package>.asMutSlice(&mut self.packages)[document.package]
    let attempted = run Effect.result(Navigation.help(&mut package.store, &module, offset))
    return match move attempted {
      Result<Option<Help>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success { value } => move value
      Result<Option<Help>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure { error } => match move error {
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
        _ => Option<Help>.none()
      }
    }
  }

  /// The completions at `position` of the open document at `uri`: the members of the receiver
  /// before a `.`, or else the names in scope, that start with the identifier being typed.
  pub effect fn completion(self: &mut Self, uri: &[u8], position: Position, encoding: PositionEncoding) -> List<Item>
    ! OutOfMemoryError
    ? &mut FileSystem | &mut Allocator | &mut Types {
    let at = run subject(&mut self.*, uri)
    if at == usize.MAX {
      return List<Item>.make()
    }
    let document = &List<Document>.asSlice(&self.documents)[at]
    let module = moduleOf(document)
    let text = Bytes.asSlice(&document.text)
    let offset = offsetOf(text, position, encoding)
    let mut start = offset
    while start > usize.ZERO && Completions.identifierByte(text[start - usize.ONE]) {
      start = start - usize.ONE
    }
    let prefix = Slice.view<u8>(text, start, offset - start)
    let package = &mut List<Package>.asMutSlice(&mut self.packages)[document.package]
    let mut attempted = Result<List<Item>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success { value: List<Item>.make() }
    if start > usize.ZERO && text[start - usize.ONE] == '.' {
      attempted = run Effect.result(Completions.members(&mut package.store, &module, text, start - usize.ONE, prefix))
    } else {
      attempted = run Effect.result(Completions.scope(&mut package.store, &module, start, prefix))
    }
    return match move attempted {
      Result<List<Item>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success { value } => move value
      Result<List<Item>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure { error } => match move error {
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
        _ => List<Item>.make()
      }
    }
  }

  /// Every place the package of the open document at `uri` names what the name at `position`
  /// refers to, its declaration too when `declaration` is set; empty when it names nothing.
  pub effect fn references(self: &mut Self, uri: &[u8], position: Position, encoding: PositionEncoding, declaration: bool) -> List<Location>
    ! OutOfMemoryError
    ? &mut FileSystem | &mut Allocator | &mut Types {
    let mut locations = List<Location>.make()
    let at = run subject(&mut self.*, uri)
    if at == usize.MAX {
      return move locations
    }
    let document = &List<Document>.asSlice(&self.documents)[at]
    let module = moduleOf(document)
    let offset = offsetOf(Bytes.asSlice(&document.text), position, encoding)
    let package = &mut List<Package>.asMutSlice(&mut self.packages)[document.package]
    if let Option<Searched>.Some { value: searched } = move run search(&mut package.*, &module, offset, declaration) {
      let found = List<Found>.asSlice(&searched.found)
      let mut index = usize.ZERO
      while index < found.length {
        if let Option<Bytes>.Some { value: located } = move run uriOf(&package.sources, &found[index].module) {
          let text = Bytes.asSlice(&found[index].text)
          let lines = run Lines.make(text)
          let spans = List<Span>.asSlice(&found[index].spans)
          let mut place = usize.ZERO
          while place < spans.length {
            run List<Location>.append(&mut locations, Location {
              uri: run Bytes.copy(Bytes.asSlice(&located)),
              start: lines.position(text, spans[place].start, encoding),
              end: lines.position(text, spans[place].end, encoding),
            })
            place = place + usize.ONE
          }
        }
        index = index + usize.ONE
      }
    }
    return move locations
  }

  /// The edits that rename what the name at `position` of the open document at `uri` refers to
  /// as `name`, in every module of its package; absent when `name` is not an identifier, the name
  /// names nothing, or what it names is declared outside the package.
  pub effect fn rename(self: &mut Self, uri: &[u8], position: Position, encoding: PositionEncoding, name: &[u8]) -> Option<List<Changed>>
    ! OutOfMemoryError
    ? &mut FileSystem | &mut Allocator | &mut Types {
    if !run identifier(name) {
      return Option<List<Changed>>.none()
    }
    let at = run subject(&mut self.*, uri)
    if at == usize.MAX {
      return Option<List<Changed>>.none()
    }
    let document = &List<Document>.asSlice(&self.documents)[at]
    let module = moduleOf(document)
    let offset = offsetOf(Bytes.asSlice(&document.text), position, encoding)
    let package = &mut List<Package>.asMutSlice(&mut self.packages)[document.package]
    let searched = match move run search(&mut package.*, &module, offset, true) {
      Option<Searched>.Some { value } => move value
      Option<Searched>.None => {
        return Option<List<Changed>>.none()
      }
    }
    if let Sought.Declaration { identity } = &searched.target.sought {
      if !owns(List<ModuleId>.asSlice(&package.rootPackage), DeclarationId.moduleId(&identity)) {
        return Option<List<Changed>>.none()
      }
    }
    let mut changes = List<Changed>.make()
    let found = List<Found>.asSlice(&searched.found)
    let mut index = usize.ZERO
    while index < found.length {
      let located = match move run uriOf(&package.sources, &found[index].module) {
        Option<Bytes>.Some { value } => move value
        Option<Bytes>.None => {
          return Option<List<Changed>>.none()
        }
      }
      let text = Bytes.asSlice(&found[index].text)
      let lines = run Lines.make(text)
      let spans = List<Span>.asSlice(&found[index].spans)
      let mut edits = run List<Edit>.makeWithCapacity(spans.length)
      let mut place = usize.ZERO
      while place < spans.length {
        run List<Edit>.append(&mut edits, Edit {
          start: lines.position(text, spans[place].start, encoding),
          end: lines.position(text, spans[place].end, encoding),
          text: run Bytes.copy(name),
        })
        place = place + usize.ONE
      }
      run List<Changed>.append(&mut changes, Changed { uri: move located, edits: move edits })
      index = index + usize.ONE
    }
    return Option<List<Changed>>.some(move changes)
  }

  /// The declarations of every open package's own modules whose names hold `query`, ignoring
  /// ASCII case; at most `limit` of them.
  pub effect fn symbols(self: &mut Self, query: &[u8], encoding: PositionEncoding, limit: usize) -> List<Placed>
    ! OutOfMemoryError
    ? &mut FileSystem | &mut Allocator | &mut Types {
    run self.refresh()
    let mut placed = List<Placed>.make()
    let packages = List<Package>.asMutSlice(&mut self.packages)
    let mut index = usize.ZERO
    while index < packages.length && List<Placed>.length(&placed) < limit {
      let package = &mut packages[index]
      if package.semantic {
        let modules = List<ModuleId>.asSlice(&package.rootPackage)
        let mut at = usize.ZERO
        while at < modules.length && List<Placed>.length(&placed) < limit {
          let attempted = run Effect.result(References.declarations(&mut package.store, &modules[at], query))
          let listed = match move attempted {
            Result<Option<Listed>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success { value } => move value
            Result<Option<Listed>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure { error } => match move error {
              OutOfMemoryError exhausted => {
                fail move exhausted
              }
              _ => Option<Listed>.none()
            }
          }
          if let Option<Listed>.Some { value } = move listed {
            if List<Declared>.length(&value.declared) > usize.ZERO {
              if let Option<Bytes>.Some { value: located } = move run uriOf(&package.sources, &modules[at]) {
                let text = Bytes.asSlice(&value.text)
                let lines = run Lines.make(text)
                let declared = List<Declared>.asSlice(&value.declared)
                let mut place = usize.ZERO
                while place < declared.length && List<Placed>.length(&placed) < limit {
                  run List<Placed>.append(&mut placed, Placed {
                    name: run Bytes.copy(Bytes.asSlice(&declared[place].name)),
                    kind: declared[place].kind,
                    location: Location {
                      uri: run Bytes.copy(Bytes.asSlice(&located)),
                      start: lines.position(text, declared[place].span.start, encoding),
                      end: lines.position(text, declared[place].span.end, encoding),
                    },
                  })
                  place = place + usize.ONE
                }
              }
            }
          }
          at = at + usize.ONE
        }
      }
      index = index + usize.ONE
    }
    return move placed
  }
}

/// A hover, located for the client.
pub struct Shown {
  pub start: Position,
  pub end: Position,
  pub text: Bytes,
}

/// A range of a document, located for the client.
pub struct Location {
  pub uri: Bytes,
  pub start: Position,
  pub end: Position,
}

/// The edits renaming makes in one document.
pub struct Changed {
  pub uri: Bytes,
  pub edits: List<Edit>,
}

/// A declaration a workspace symbol search found: its name, its SymbolKind number and where its
/// name is written.
pub struct Placed {
  pub name: Bytes,
  pub kind: usize,
  pub location: Location,
}

/// An inlay hint, located for the client.
pub struct Hinted {
  pub position: Position,
  pub label: Bytes,
}

// The open document at `uri` once the store has its current text, when its package has semantic
// analysis and the document has a module; usize.MAX otherwise.
effect fn subject(self: &mut Workspace, uri: &[u8]) -> usize
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  run self.refresh()
  let at = documentAt(&self.*, uri)
  if at == usize.MAX {
    return usize.MAX
  }
  let document = &List<Document>.asSlice(&self.documents)[at]
  if document.package == usize.MAX || !List<Package>.asSlice(&self.packages)[document.package].semantic {
    return usize.MAX
  }
  if let Option<ModuleId>.None = &document.module {
    return usize.MAX
  }
  return at
}

// What the name at `offset` of `module` refers to, and every place the package names it.
struct Searched {
  target: References.Target,
  found: List<Found>,
}

effect fn search(package: &mut Package, module: &ModuleId, offset: usize, declaration: bool) -> Option<Searched>
  ! OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let attempted = run Effect.result(searchStore(&mut package.store, List<ModuleId>.asSlice(&package.rootPackage), module, offset, declaration))
  return match move attempted {
    Result<Option<Searched>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success { value } => move value
    Result<Option<Searched>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure { error } => match move error {
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
      _ => Option<Searched>.none()
    }
  }
}

effect fn searchStore(store: &mut Semantic, modules: &[ModuleId], module: &ModuleId, offset: usize, declaration: bool) -> Option<Searched>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let target = match move run References.target(&mut store.*, module, offset) {
    Option<References.Target>.Some { value } => move value
    Option<References.Target>.None => {
      return Option<Searched>.none()
    }
  }
  let found = run References.references(&mut store.*, modules, &target, declaration)
  return Option<Searched>.some(Searched { target: move target, found: move found })
}

fn owns(modules: &[ModuleId], module: &ModuleId) -> bool {
  let mut at = usize.ZERO
  while at < modules.length {
    if ModuleId.equals(&modules[at], module) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// Whether `name` is one identifier, which a rename may write where a name was.
effect fn identifier(name: &[u8]) -> bool {
  let mut lexer = Lexer.make(name)
  return match move run Stream.take(&mut lexer) {
    Option<Token>.Some { value } => Tokens.kind(value) == TokenKind.Identifier && Tokens.span(value).start == usize.ZERO
      && Tokens.span(value).end == name.length
    Option<Token>.None => false
  }
}

fn moduleOf(document: &Document) -> ModuleId {
  return match &document.module {
    Option<ModuleId>.Some { value } => ModuleId.copy(&value)
    Option<ModuleId>.None => CompilerBug.panic(b"a subject document has no module")
  }
}

// The `file:` URI of `module`'s source file.
effect fn uriOf(sources: &ModuleSources, module: &ModuleId) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let located = run Effect.result(Sources.sourceLocation(sources, module))
  return match move located {
    Result<SourceLocation, FileError | OutOfMemoryError>.Success { value } => match &value.path {
      Option<Path>.Some { value: path } => Option<Bytes>.some(run fileUri(Path.rawBytes(&path)))
      Option<Path>.None => Option<Bytes>.none()
    }
    Result<SourceLocation, FileError | OutOfMemoryError>.Failure { error } => match move error {
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
      _ => Option<Bytes>.none()
    }
  }
}

/// The byte offset of `position` in `text`, its column counted in UTF-8 bytes or UTF-16 code
/// units; clamped to the end of its line and of the text.
pub fn offsetOf(text: &[u8], position: Position, encoding: PositionEncoding) -> usize {
  let mut at = usize.ZERO
  let mut line = usize.ZERO
  while line < position.line && at < text.length {
    if text[at] == 10 {
      line = line + usize.ONE
    }
    at = at + usize.ONE
  }
  let mut units = usize.ZERO
  while at < text.length && text[at] != 10 && units < position.character {
    let byte = text[at]
    if encoding == PositionEncoding.Utf8 {
      units = units + usize.ONE
    } else if byte >= 240 {
      units = units + 2
    } else if byte < 128 || byte >= 192 {
      units = units + usize.ONE
    }
    at = at + usize.ONE
    // A character's continuation bytes belong to it.
    while encoding == PositionEncoding.Utf16 && at < text.length && text[at] >= 128 && text[at] < 192 {
      at = at + usize.ONE
    }
  }
  return at
}

fn documentAt(self: &Workspace, uri: &[u8]) -> usize {
  let documents = List<Document>.asSlice(&self.documents)
  let mut at = usize.ZERO
  while at < documents.length {
    if same(Bytes.asSlice(&documents[at].uri), uri) {
      return at
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

// The diagnostics owed for the open document at `at`, unless they wait for its module's check:
// its syntax errors, or else the checked rejections located in its module.
effect fn documentDiagnostics(self: &Workspace, at: usize, encoding: PositionEncoding) -> Option<Published>
  ! OutOfMemoryError
  ? &mut Allocator {
  let document = &List<Document>.asSlice(&self.documents)[at]
  if !document.owed || waiting(&self.*, document) {
    return Option<Published>.none()
  }
  let mut problems = List<Problem>.make()
  if let Option<SourceUnit>.Some { value: unit } = &document.unit {
    problems = run syntaxProblems(&unit, encoding)
    if let Option<Bytes>.Some { value: refusal } = &document.refusal {
      if List<Problem>.length(&problems) == usize.ZERO {
        let first = Position { line: usize.ZERO, character: usize.ZERO }
        run List<Problem>.append(&mut problems,
          Problem { start: first, end: first, code: Bytes.make(), message: run Bytes.copy(Bytes.asSlice(&refusal)), warning: false,
            unnecessary: false })
      }
    }
    let mut located = List<Shared<Rejection>>.make()
    if List<Problem>.length(&problems) == usize.ZERO && document.package != usize.MAX {
      if let Option<ModuleId>.Some { value: module } = &document.module {
        let packages = List<Package>.asSlice(&self.packages)
        located = run locatedIn(&packages[document.package], &module)
        problems = run problemsOf(List<Shared<Rejection>>.asSlice(&located), SourceUnit.bytes(&unit), encoding)
      }
    }
    // Unused bindings come from the document's own text, so they follow each edit before a check.
    // One inside an error's span, such as an import of a missing member, reports only the error.
    if SourceUnit.diagnosticCount(&unit) == usize.ZERO {
      let mut found = List<Shared<Rejection>>.make()
      run Semantics.appendUnusedWarnings(&mut found, &unit)
      let mut warnings = List<Shared<Rejection>>.make()
      while List<Shared<Rejection>>.length(&found) > usize.ZERO {
        let warning = List<Shared<Rejection>>.remove(&mut found, usize.ZERO)
        if !insideError(&warning, List<Shared<Rejection>>.asSlice(&located)) {
          run List<Shared<Rejection>>.append(&mut warnings, move warning)
        }
      }
      let mut unused = run problemsOf(List<Shared<Rejection>>.asSlice(&warnings), SourceUnit.bytes(&unit), encoding)
      while List<Problem>.length(&unused) > usize.ZERO {
        run List<Problem>.append(&mut problems, List<Problem>.remove(&mut unused, usize.ZERO))
      }
    }
  }
  return Option<Published>.some(
    Published {
      uri: run Bytes.copy(Bytes.asSlice(&document.uri)),
      version: Option<usize>.some(document.version),
      problems: move problems,
    }
  )
}

// The open document of `package` whose module is `module`, or usize.MAX.
fn documentOf(self: &Workspace, package: usize, module: &ModuleId) -> usize {
  let documents = List<Document>.asSlice(&self.documents)
  let mut at = usize.ZERO
  while at < documents.length {
    if documents[at].package == package {
      if let Option<ModuleId>.Some { value } = &documents[at].module {
        if ModuleId.equals(&value, module) {
          return at
        }
      }
    }
    at = at + usize.ONE
  }
  return usize.MAX
}

// Whether `document`'s diagnostics wait for its module's check: it parsed without syntax errors
// in a package with semantic analysis, and the module's check is not current.
fn waiting(self: &Workspace, document: &Document) -> bool {
  if document.package == usize.MAX {
    return false
  }
  let package = &List<Package>.asSlice(&self.packages)[document.package]
  if !package.semantic {
    return false
  }
  if malformed(document) {
    return false
  }
  if let Option<ModuleId>.Some { value: module } = &document.module {
    let checked = List<Checked>.asSlice(&package.checked)
    let mut at = usize.ZERO
    while at < checked.length {
      if ModuleId.equals(&checked[at].module, &module) {
        return !checked[at].current
      }
      at = at + usize.ONE
    }
    return true
  }
  return false
}

// Whether `document`'s parsed text has syntax errors.
fn malformed(document: &Document) -> bool {
  if let Option<SourceUnit>.Some { value: unit } = &document.unit {
    return SourceUnit.diagnosticCount(&unit) > usize.ZERO
  }
  return false
}

// Publishes the open documents of `package` over its disk revision, updates its store, and queues
// its modules for a check: open documents' first, then the root package's.
effect fn refreshPackage(self: &mut Workspace, package: usize) -> ()
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let documents = List<Document>.asSlice(&self.documents)
  let packages = List<Package>.asMutSlice(&mut self.packages)
  let target = &mut packages[package]

  // An unsaved import can name a module no earlier text reached; it is read from disk first.
  let mut at = usize.ZERO
  while at < documents.length {
    if documents[at].package == package {
      if let Option<ModuleId>.Some { value: module } = &documents[at].module {
        run preloadImports(&mut target.sources, &module, Bytes.asSlice(&documents[at].text))
      }
    }
    at = at + usize.ONE
  }
  let mut revision = run Sources.revision(&target.sources)
  let mut queue = List<ModuleId>.make()
  at = usize.ZERO
  while at < documents.length {
    if documents[at].package == package {
      if let Option<ModuleId>.Some { value: module } = &documents[at].module {
        let content = Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&documents[at].text)))
        revision = run Revision.publish(&revision, &module, &content)
        run enqueue(&mut queue, &module)
      }
    } else if let Option<Bytes>.Some { value: path } = move run filePath(Bytes.asSlice(&documents[at].uri)) {
      // An open document of a package this one depends on is read as its buffer, as its own
      // package reads it.
      if let Option<ModuleId>.Some { value: module } = move run Sources.dependencyModule(&target.sources, Bytes.asSlice(&path)) {
        let content = Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&documents[at].text)))
        revision = run Revision.publish(&revision, &module, &content)
      }
    }
    at = at + usize.ONE
  }
  run Semantic.update(&mut target.store, move revision)
  target.stale = false
  if !target.semantic {
    return ()
  }
  let roots = List<ModuleId>.asSlice(&target.rootPackage)
  at = usize.ZERO
  while at < roots.length {
    run enqueue(&mut queue, &roots[at])
    at = at + usize.ONE
  }
  target.queue = move queue
  target.preparing = Option<ModuleId>.none()
  target.unprepared = List<DeclarationId>.make()
  let checked = List<Checked>.asMutSlice(&mut target.checked)
  at = usize.ZERO
  while at < checked.length {
    checked[at].current = false
    at = at + usize.ONE
  }
  return ()
}

// The module of `package` that the file at `path` holds: one of its own, of its standard library,
// or of a package it depends on.
effect fn readerModule(package: &Package, path: &[u8]) -> Option<ModuleId> ! OutOfMemoryError ? &mut Allocator {
  if let Option<ModuleId>.Some { value } = move run moduleIn(&package.sources, path) {
    return Option<ModuleId>.some(move value)
  }
  return run Sources.dependencyModule(&package.sources, path)
}

// Marks stale every package that reads the file of the document at `uri`, so its next refresh
// sees the document's current text or, once it closes, its file.
effect fn markReaders(self: &mut Workspace, uri: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let path = match move run filePath(uri) {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => {
      return ()
    }
  }
  let packages = List<Package>.asMutSlice(&mut self.packages)
  let mut at = usize.ZERO
  while at < packages.length {
    if let Option<ModuleId>.Some { .. } = move run readerModule(&packages[at], Bytes.asSlice(&path)) {
      packages[at].stale = true
    }
    at = at + usize.ONE
  }
  return ()
}

// Reads from disk what an open document's text imports. A module that cannot be read stays absent
// and is rejected where it is imported.
effect fn preloadImports(sources: &mut ModuleSources, module: &ModuleId, text: &[u8]) -> ()
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let loaded = run Effect.result(Sources.preloadImports(&mut sources.*, module, text))
  return match move loaded {
    Result<(), FileError | InvalidModulePath | OutOfMemoryError>.Success { .. } => ()
    Result<(), FileError | InvalidModulePath | OutOfMemoryError>.Failure { error } => match move error {
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
      _ => ()
    }
  }
}

effect fn enqueue(queue: &mut List<ModuleId>, module: &ModuleId) -> () ! OutOfMemoryError ? &mut Allocator {
  if !listed(List<ModuleId>.asSlice(&queue.*), module) {
    run List<ModuleId>.append(&mut queue.*, ModuleId.copy(module))
  }
  return ()
}

fn listed(modules: &[ModuleId], module: &ModuleId) -> bool {
  let mut at = usize.ZERO
  while at < modules.length {
    if ModuleId.equals(&modules[at], module) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// One step of the package's queued checks: the next declaration of the module being prepared,
// that module's check once none is left, or else the next queued module, checked at once when its
// kept sweep verifies and otherwise listed for preparation. A step the store cannot complete
// leaves the module's check to report it.
effect fn step(package: &mut Package) -> ()
  ! OutOfMemoryError
  ? &mut Allocator | &mut Types {
  if preparingOne(&package.*) {
    if List<DeclarationId>.length(&package.unprepared) > usize.ZERO {
      let declaration = List<DeclarationId>.remove(&mut package.unprepared, usize.ZERO)
      let prepared = run Effect.result(Semantic.prepareDeclaration(&mut package.store, &mut package.request, &declaration))
      run tolerated(move prepared)
      return run release(&mut package.*)
    }
    let module = match Intrinsic.replace(package.preparing, Option<ModuleId>.none()) {
      Option<ModuleId>.Some {value} => move value
      Option<ModuleId>.None => CompilerBug.panic(b"a prepared module is named")
    }
    run checkModule(&mut package.*, move module)
    return run release(&mut package.*)
  }
  let module = List<ModuleId>.remove(&mut package.queue, usize.ZERO)
  let current = run Effect.result(Semantic.moduleSweepCurrent(&mut package.store, &module))
  let mut kept = false
  match move current {
    Result<bool, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} => {
      kept = value
    }
    Result<bool, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => match move error {
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
      _ => ()
    }
  }
  if kept {
    run checkModule(&mut package.*, move module)
    return run release(&mut package.*)
  }
  let listed = run Effect.result(Semantic.moduleDeclarations(&mut package.store, &module))
  match move listed {
    Result<List<DeclarationId>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success {value} => {
      package.unprepared = move value
    }
    Result<List<DeclarationId>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => match move error {
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
      _ => {
        package.unprepared = List<DeclarationId>.make()
      }
    }
  }
  package.preparing = Option<ModuleId>.some(move module)
  return ()
}

// Writes the package's semantic cache when the store ran a module check since it was last written.
// A store that fails to give its image keeps the file as it was.
effect fn persist(package: &mut Package) -> () ! OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let ran = Semantic.moduleCheckRuns(&package.store)
  if ran == package.saved { return () }
  package.saved = ran
  if let Option<CacheFile>.Some { value: file } = &package.cache {
    let attempted = run Effect.result(SemanticCache.save(&mut package.store, &file))
    match move attempted {
      Result<(), Cycle | OutOfMemoryError>.Success { .. } => ()
      Result<(), Cycle | OutOfMemoryError>.Failure { error } => match move error {
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
        _ => ()
      }
    }
  }
}

// Whether a module of `package` is being prepared.
fn preparingOne(package: &Package) -> bool {
  if let Option<ModuleId>.Some { .. } = &package.preparing {
    return true
  }
  return false
}

// Passes on only running out of memory; the module's check reports any other failure.
effect fn tolerated(attempted: Result<(), Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>) -> ()
  ! OutOfMemoryError {
  return match move attempted {
    Result<(), Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success { .. } => ()
    Result<(), Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {error} => match move error {
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
      _ => ()
    }
  }
}

// Drops what the package's store no longer needs once a step is done: the roots its request
// demanded and the lowered MIR that reruns replaced, so a long session does not grow.
effect fn release(package: &mut Package) -> () ! OutOfMemoryError ? &mut Allocator {
  SemanticRequest.forgetRoots(&mut package.request)
  drop run Semantic.releaseStaleMir(&mut package.store, &package.request)
  return ()
}

// Checks `module` and records its rejections. When they differ from the last check's, the module
// and the modules its old and new rejections are located in become dirty. A check the store
// cannot complete records no rejections.
effect fn checkModule(package: &mut Package, module: ModuleId) -> ()
  ! OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let attempted = run Effect.result(moduleRejections(&mut package.*, &module))
  let mut rejections = List<Shared<Rejection>>.make()
  match move attempted {
    Result<List<Shared<Rejection>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Success { value } => {
      rejections = move value
    }
    Result<List<Shared<Rejection>>, Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError>.Failure {
      error
    } => match move error {
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
      _ => ()
    }
  }
  let checked = List<Checked>.asMutSlice(&mut package.checked)
  let mut at = usize.ZERO
  while at < checked.length {
    if ModuleId.equals(&checked[at].module, &module) {
      let previous = List<Shared<Rejection>>.asSlice(&checked[at].rejections)
      if !sameSites(previous, List<Shared<Rejection>>.asSlice(&rejections)) {
        run markDirty(&mut package.dirty, &module)
        run markLocations(&mut package.dirty, previous)
        run markLocations(&mut package.dirty, List<Shared<Rejection>>.asSlice(&rejections))
      }
      checked[at].rejections = move rejections
      checked[at].current = true
      return ()
    }
    at = at + usize.ONE
  }
  run markDirty(&mut package.dirty, &module)
  run markLocations(&mut package.dirty, List<Shared<Rejection>>.asSlice(&rejections))
  return run List<Checked>.append(
    &mut package.checked,
    Checked { module: move module, rejections: move rejections, current: true }
  )
}

// What a check of `module` rejects, with its imports' refused members, which `silk check` also
// reports apart from its declarations.
effect fn moduleRejections(package: &mut Package, module: &ModuleId) -> List<Shared<Rejection>>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  let checked = run Semantic.checkModule(&mut package.store, &mut package.request, module, &package.runtime)
  let mut rejections = move checked.rejections
  let mut imported = run Semantic.moduleImportRejections(&mut package.store, &mut package.request, module)
  while List<Shared<Rejection>>.length(&imported) > usize.ZERO {
    run List<Shared<Rejection>>.append(&mut rejections, List<Shared<Rejection>>.remove(&mut imported, usize.ZERO))
  }
  return move rejections
}

effect fn markDirty(dirty: &mut List<ModuleId>, module: &ModuleId) -> () ! OutOfMemoryError ? &mut Allocator {
  return run enqueue(&mut dirty.*, module)
}

effect fn markLocations(dirty: &mut List<ModuleId>, rejections: &[Shared<Rejection>]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut at = usize.ZERO
  while at < rejections.length {
    let module = Shared<Rejection>.with<ModuleId>(&rejections[at], fn(held: &Rejection) -> ModuleId {
      return ModuleId.copy(&held.module)
    })
    run markDirty(&mut dirty.*, &module)
    at = at + usize.ONE
  }
  return ()
}

// The distinct rejections located in `module`, from every current check of `package`.
effect fn locatedIn(package: &Package, module: &ModuleId) -> List<Shared<Rejection>>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut located = List<Shared<Rejection>>.make()
  let checked = List<Checked>.asSlice(&package.checked)
  let mut at = usize.ZERO
  while at < checked.length {
    if checked[at].current {
      let rejections = List<Shared<Rejection>>.asSlice(&checked[at].rejections)
      let mut rejectionAt = usize.ZERO
      while rejectionAt < rejections.length {
        let site = siteOf(&rejections[rejectionAt])
        if ModuleId.equals(&site.module, module) && !repeated(List<Shared<Rejection>>.asSlice(&located), &site) {
          run List<Shared<Rejection>>.append(&mut located, Shared<Rejection>.clone(&rejections[rejectionAt]))
        }
        rejectionAt = rejectionAt + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return move located
}

// Whether two checks found rejections of the same modules, codes and spans, in the same order.
fn sameSites(left: &[Shared<Rejection>], right: &[Shared<Rejection>]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    let one = siteOf(&left[at])
    let other = siteOf(&right[at])
    if !ModuleId.equals(&one.module, &other.module) || one.code != other.code
      || one.span.start != other.span.start || one.span.end != other.span.end {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

struct Site {
  module: ModuleId,
  code: RejectionCode,
  span: Span,
}

fn siteOf(rejection: &Shared<Rejection>) -> Site {
  return Shared<Rejection>.with<Site>(rejection, fn(held: &Rejection) -> Site {
    return Site { module: ModuleId.copy(&held.module), code: held.code, span: held.span }
  })
}

// Whether a rejection in `listed` has the code and span of `site`, so the client sees it once.
fn repeated(listed: &[Shared<Rejection>], site: &Site) -> bool {
  let mut at = usize.ZERO
  while at < listed.length {
    let known = siteOf(&listed[at])
    if known.code == site.code && known.span.start == site.span.start && known.span.end == site.span.end {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// Publishes the checked diagnostics of a module no document has open, read from its file on
// disk; an empty list only when the client was last shown some.
effect fn publishClosed(package: &mut Package, module: &ModuleId, encoding: PositionEncoding, published: &mut List<Published>) -> ()
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let location = run Effect.result(Sources.sourceLocation(&package.sources, module))
  let path = match move location {
    Result<Sources.SourceLocation, FileError | OutOfMemoryError>.Success { value } => match move value.path {
      Option<Path>.Some { value: found } => move found
      Option<Path>.None => {
        return ()
      }
    }
    Result<Sources.SourceLocation, FileError | OutOfMemoryError>.Failure { error } => match move error {
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
      _ => {
        return ()
      }
    }
  }
  let located = run locatedIn(&package.*, module)
  let wasShown = listed(List<ModuleId>.asSlice(&package.shown), module)
  if List<Shared<Rejection>>.length(&located) == usize.ZERO && !wasShown {
    return ()
  }
  let read = run Effect.result(FileSystem.readFile(&path))
  let text = match move read {
    Result<Bytes, FileError | OutOfMemoryError>.Success { value } => move value
    Result<Bytes, FileError | OutOfMemoryError>.Failure { error } => match move error {
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
      _ => Bytes.make()
    }
  }
  let problems = run problemsOf(List<Shared<Rejection>>.asSlice(&located), Bytes.asSlice(&text), encoding)
  let shown = List<Problem>.length(&problems) > usize.ZERO
  run setShown(&mut package.shown, module, shown)
  return run List<Published>.append(
    &mut published.*,
    Published { uri: run fileUri(Path.rawBytes(&path)), version: Option<usize>.none(), problems: move problems }
  )
}

effect fn setShown(shown: &mut List<ModuleId>, module: &ModuleId, value: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < List<ModuleId>.length(&shown.*) {
    if ModuleId.equals(&List<ModuleId>.asSlice(&shown.*)[at], module) {
      if !value {
        let _removed = List<ModuleId>.remove(&mut shown.*, at)
      }
      return ()
    }
    at = at + usize.ONE
  }
  if value {
    run List<ModuleId>.append(&mut shown.*, ModuleId.copy(module))
  }
  return ()
}

/// The `file:` URI of an absolute path, percent-encoding every byte outside the unreserved set
/// and `/`.
pub effect fn fileUri(path: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let digits = b"0123456789ABCDEF"
  let mut uri = run Bytes.copy(b"file://")
  let mut at = usize.ZERO
  while at < path.length {
    let byte = path[at]
    let plain = (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90) || (byte >= 48 && byte <= 57)
      || byte == 45 || byte == 46 || byte == 95 || byte == 126 || byte == 47
    if plain {
      run Bytes.append(&mut uri, &[byte])
    } else {
      run Bytes.append(&mut uri, &[37, digits[u8.toUsize(byte / 16)], digits[u8.toUsize(byte % 16)]])
    }
    at = at + usize.ONE
  }
  return move uri
}

// The package whose module directory holds `path`, opened from the nearest manifest the first
// time one of its documents opens; usize.MAX when no package holds it or it cannot be opened, with
// `refusal` the dependency that kept it from opening.
effect fn packageFor(self: &mut Workspace, path: &[u8], refusal: &mut Option<Bytes>) -> usize
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator | &mut Types {
  let packages = List<Package>.asSlice(&self.packages)
  let mut at = usize.ZERO
  while at < packages.length {
    if within(Path.rawBytes(Sources.moduleRoot(&packages[at].sources)), path) {
      return at
    }
    at = at + usize.ONE
  }
  // A standard-library file belongs to the first package that reads it, as go to definition
  // reaches it from that package's documents.
  at = usize.ZERO
  while at < packages.length {
    if packages[at].semantic && libraryPath(&packages[at].sources, path) {
      return at
    }
    at = at + usize.ONE
  }
  let found = run Effect.result(openPackage(path, &self.standardLibrary, &self.store, self.target))
  let opened = match move found {
    Result<
      Option<Package>,
      ProjectError
        | PlanError
        | InvalidProjectCommand
        | InitialProfileProblem
        | FileError
        | InvalidModulePath
        | InvalidSourceRoot
        | InvalidDependency
        | MissingManifest
        | InvalidBuildComposition
        | MissingStandardLibrary
        | InvalidNativeLinkInput
        | TomlError
        | RegistrationClosed
        | ConflictingPackageSource
        | Cycle
        | RevisionMismatch
        | OutOfMemoryError
    >.Success {
      value
    } => move value
    Result<
      Option<Package>,
      ProjectError
        | PlanError
        | InvalidProjectCommand
        | InitialProfileProblem
        | FileError
        | InvalidModulePath
        | InvalidSourceRoot
        | InvalidDependency
        | MissingManifest
        | InvalidBuildComposition
        | MissingStandardLibrary
        | InvalidNativeLinkInput
        | TomlError
        | RegistrationClosed
        | ConflictingPackageSource
        | Cycle
        | RevisionMismatch
        | OutOfMemoryError
    >.Failure {
      error
    } => match move error {
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
      InvalidDependency invalid => {
        refusal.* = Option<Bytes>.some(move invalid.detail)
        Option<Package>.none()
      }
      _ => Option<Package>.none()
    }
  }
  return match move opened {
    Option<Package>.Some { value } => {
      run List<Package>.append(&mut self.packages, move value)
      return List<Package>.length(&self.packages) - usize.ONE
    }
    Option<Package>.None => usize.MAX
  }
}

// Opens the package of the nearest manifest above `path` as `silk check` does, for the first
// target its manifest plans, on a revisable store; none when its profile names no artifact form.
// A package whose profile is refused gets syntax diagnostics only.
effect fn openPackage(path: &[u8], standardLibrary: &Option<Path>, checkouts: &Option<Path>, host: Target) -> Option<Package>
  ! ProjectError
    | PlanError
    | InvalidProjectCommand
    | InitialProfileProblem
    | FileError
    | InvalidModulePath
    | InvalidSourceRoot
    | InvalidDependency
    | MissingManifest
    | InvalidBuildComposition
    | MissingStandardLibrary
    | InvalidNativeLinkInput
    | TomlError
    | RegistrationClosed
    | ConflictingPackageSource
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator | &mut Types {
  let source = run Path.fromBytes(path)
  let directory = match move run Path.parent(&source) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      return Option<Package>.none()
    }
  }
  let manifest = run Projects.discover(&directory)
  let project = run Projects.load(&manifest)
  let defaults = run ProjectCommands.parseCheck(&[])
  let mut plans = run ProjectPlans.make(&project, &defaults.options, Projects.targets(&project), host)
  if List<ProjectPlan>.length(&plans) == usize.ZERO {
    return Option<Package>.none()
  }
  let ProjectPlan { input: planned, bindings, name: _, maxMemory: unlimited } = List<ProjectPlan>.remove(&mut plans, usize.ZERO)
  drop unlimited
  let mut input = move planned
  if let Option<Bytes>.None = &input.artifact {
    input.artifact = Option<Bytes>.some(run Bytes.copy(Projects.profileArtifact(Projects.form(&project))))
  }
  let profile = run InitialProfile.freeze(&input)
  let mut library = Option<Path>.none()
  if let Option<Path>.Some { value } = &standardLibrary.* {
    library = Option<Path>.some(run Path.fromBytes(Path.rawBytes(&value)))
  }
  let opened = run Analyses.open(
    Projects.entry(&project),
    Option<&Path>.some(Projects.manifest(&project)),
    move library,
    match &checkouts.* {
      Option<Path>.Some { value } => Option<&Path>.some(&value)
      Option<Path>.None => Option<&Path>.none()
    },
    &profile,
    move bindings,
    false,
    true,
    Option<&[u8]>.none(),
    Option<ImportSummaries>.none()
  )
  return match move opened {
    Opened.Ready { analysis } => {
      let Analysis { sources, store, request, rootPackage, checked, identity, runtime } = move analysis
      drop checked
      drop identity
      // Checked bodies keep the names they resolve, for hover and go to definition.
      let mut store = move store
      Semantic.selectEditorTables(&mut store, true)
      // The cache `silk check` keeps for this target and profile: module checks whose sources
      // still read the same start out current instead of waiting their turn in the queue.
      let mut cache = Option<CacheFile>.none()
      if let Option<Bytes>.Some { value: compiler } = move run CacheStamp.compiler() {
        if let Option<Path>.Some { value: cacheDirectory } = move run SemanticCache.directory(Projects.outputDirectory(&project), Projects.name(&project)) {
          cache = run SemanticCache.open(&mut store, &request, &cacheDirectory, Bytes.asSlice(&compiler), true, false)
        }
      }
      return Option<Package>.some(
        Package {
          sources: move sources,
          store: move store,
          request: move request,
          rootPackage: move rootPackage,
          runtime: move runtime,
          semantic: true,
          stale: true,
          queue: List<ModuleId>.make(),
          preparing: Option<ModuleId>.none(),
          unprepared: List<DeclarationId>.make(),
          checked: List<Checked>.make(),
          dirty: List<ModuleId>.make(),
          shown: List<ModuleId>.make(),
          cache: move cache,
          saved: usize.ZERO,
        }
      )
    }
    Opened.Refused { sources, store, refusal } => {
      drop refusal
      let request = SemanticRequest.forApplication(ModuleId.copy(Sources.entry(&sources)))
      return Option<Package>.some(
        Package {
          sources: move sources,
          store: move store,
          request: move request,
          rootPackage: List<ModuleId>.make(),
          runtime: Option<ModuleId>.none(),
          semantic: false,
          stale: true,
          queue: List<ModuleId>.make(),
          preparing: Option<ModuleId>.none(),
          unprepared: List<DeclarationId>.make(),
          checked: List<Checked>.make(),
          dirty: List<ModuleId>.make(),
          shown: List<ModuleId>.make(),
          cache: Option<CacheFile>.none(),
          saved: usize.ZERO,
        }
      )
    }
    Opened.InvalidProfile => Option<Package>.none()
    Opened.PlanRefused { sources, store, rejection, file, reason } => {
      drop sources
      drop store
      drop rejection
      drop file
      drop reason
      return Option<Package>.none()
    }
  }
}

// Whether `path` is a `silk/` module of the standard library `sources` reads.
fn libraryPath(sources: &ModuleSources, path: &[u8]) -> bool {
  if let Option<&Path>.Some { value: library } = Sources.standardLibrary(sources) {
    let root = Path.rawBytes(library)
    if within(root, path) {
      let logical = Slice.view<u8>(path, root.length + usize.ONE, path.length - root.length - usize.ONE)
      return logical.length > b"silk/".length && same(Slice.view<u8>(logical, usize.ZERO, b"silk/".length), b"silk/")
    }
  }
  return false
}

// The module `path` names in the package of `sources`, if `path` is under its module directory
// or is a `silk/` module of its standard library.
effect fn moduleIn(sources: &ModuleSources, path: &[u8]) -> Option<ModuleId>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut root = Path.rawBytes(Sources.moduleRoot(sources))
  if !within(root, path) {
    if !libraryPath(sources, path) {
      return Option<ModuleId>.none()
    }
    if let Option<&Path>.Some { value: library } = Sources.standardLibrary(sources) {
      root = Path.rawBytes(library)
    }
  }
  let logical = Slice.view<u8>(path, root.length + usize.ONE, path.length - root.length - usize.ONE)
  let identified = run Effect.result(Sources.module(sources, logical))
  return match move identified {
    Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Success { value } => Option<
      ModuleId
    >.some(move value)
    Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Failure { error } => match move error {
      InvalidModulePath _invalid => Option<ModuleId>.none()
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// Reports whether `path` is strictly below the directory `root`.
fn within(root: &[u8], path: &[u8]) -> bool {
  if path.length <= root.length + usize.ONE || path[root.length] != 47 {
    return false
  }
  return same(Slice.view<u8>(path, usize.ZERO, root.length), root)
}

/// The filesystem path a `file:` URI names, with its percent escapes decoded; none for any other
/// scheme or a malformed escape.
pub effect fn filePath(uri: &[u8]) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let prefix = b"file://"
  if uri.length <= prefix.length || !same(Slice.view<u8>(uri, usize.ZERO, prefix.length), prefix) {
    return Option<Bytes>.none()
  }
  let mut path = Bytes.make()
  let mut at = prefix.length
  while at < uri.length {
    let byte = uri[at]
    if byte == 37 {
      if at + 2 >= uri.length {
        return Option<Bytes>.none()
      }
      let high = hexDigit(uri[at + 1])
      let low = hexDigit(uri[at + 2])
      if high > 15 || low > 15 {
        return Option<Bytes>.none()
      }
      run Bytes.append(&mut path, &[high * 16 + low])
      at = at + 3
    } else {
      run Bytes.append(&mut path, &[byte])
      at = at + usize.ONE
    }
  }
  return Option<Bytes>.some(move path)
}

effect fn appendDecimal(output: &mut Bytes, value: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  if value >= 10 {
    run appendDecimal(&mut output.*, value / 10)
  }
  return run Bytes.append(&mut output.*, Slice.view<u8>(b"0123456789", value % 10, 1))
}

// The value of one hexadecimal digit, or 255 for any other byte.
fn hexDigit(byte: u8) -> u8 {
  if byte >= 48 && byte <= 57 {
    return byte - 48
  }
  if byte >= 97 && byte <= 102 {
    return byte - 87
  }
  if byte >= 65 && byte <= 70 {
    return byte - 55
  }
  return 255
}

// Parses the document alone, as its own module or as a placeholder module outside a package.
effect fn parse(document: &Document) -> Option<SourceUnit>
  ! OutOfMemoryError
  ? &mut Allocator {
  let module = match &document.module {
    Option<ModuleId>.Some { value } => ModuleId.copy(&value)
    Option<ModuleId>.None => match move run Effect.result(
      ModuleId.make(b"file", b"document", b"document.silk")
    ) {
      Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Success { value } => move value
      Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Failure { error } => match move error {
        InvalidModulePath _invalid => {
          return Option<SourceUnit>.none()
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
  }
  let unit = run SourceUnit.parse(
    &module,
    usize.ZERO,
    run Bytes.copy(Bytes.asSlice(&document.text))
  )
  return Option<SourceUnit>.some(move unit)
}


// Whether `warning` lies inside the span of one of `errors`.
fn insideError(warning: &Shared<Rejection>, errors: &[Shared<Rejection>]) -> bool {
  let site = siteOf(warning)
  let mut at = usize.ZERO
  while at < errors.length {
    let known = siteOf(&errors[at])
    if known.span.start <= site.span.start && site.span.end <= known.span.end { return true }
    at = at + usize.ONE
  }
  return false
}

// Locates each syntax diagnostic of a parsed document.
effect fn syntaxProblems(unit: &SourceUnit, encoding: PositionEncoding) -> List<Problem>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut rejections = List<Shared<Rejection>>.make()
  let mut at = usize.ZERO
  while at < SourceUnit.diagnosticCount(unit) {
    let diagnostic = SourceUnit.diagnostic(unit, at)
    let holes = run SourceIndexes.sourceHoles(diagnostic.detail, SourceUnit.bytes(unit))
    let rejection = run Semantics.syntaxRejection(
      &unit.id,
      Rejection.causeCode(diagnostic.code),
      diagnostic.span,
      diagnostic.detail,
      List<Bytes>.asSlice(&holes)
    )
    run List<Shared<Rejection>>.append(&mut rejections, move rejection)
    at = at + usize.ONE
  }
  return run problemsOf(List<Shared<Rejection>>.asSlice(&rejections), SourceUnit.bytes(unit), encoding)
}

// Locates each of `rejections` in `text`, the text of the module they are located in.
effect fn problemsOf(rejections: &[Shared<Rejection>], text: &[u8], encoding: PositionEncoding) -> List<Problem>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut problems = List<Problem>.make()
  let mut at = usize.ZERO
  while at < rejections.length {
    if let Option<RenderedDiagnostic>.Some { value: rendered } = move run Reports.fields(
      &rejections[at],
      text,
      b""
    ) {
      let mut message = run Bytes.copy(Bytes.asSlice(&rendered.code))
      if let Option<Bytes>.Some { value: filled } = &rendered.message {
        message = run Bytes.copy(Bytes.asSlice(&filled))
      }
      let code = Shared<Rejection>.with<RejectionCode>(&rejections[at], fn(value: &Rejection) -> RejectionCode { return value.code })
      run List<Problem>.append(
        &mut problems,
        Problem {
          start: locate(text, rendered.start, encoding),
          end: locate(text, rendered.end, encoding),
          code: move rendered.code,
          message: move message,
          warning: same(Bytes.asSlice(&rendered.severity), b"warning"),
          unnecessary: code == RejectionCode.UnusedImport || code == RejectionCode.UnusedLocal,
        }
      )
    }
    at = at + usize.ONE
  }
  return move problems
}

/// The position of byte `offset` in `text`, clamped to its length, with the column counted in
/// UTF-8 bytes or UTF-16 code units.
pub fn locate(text: &[u8], offset: usize, encoding: PositionEncoding) -> Position {
  let mut bounded = offset
  if bounded > text.length {
    bounded = text.length
  }
  let mut line = usize.ZERO
  let mut start = usize.ZERO
  let mut at = usize.ZERO
  while at < bounded {
    if text[at] == 10 {
      line = line + usize.ONE
      start = at + usize.ONE
    }
    at = at + usize.ONE
  }
  return Position { line: line, character: column(text, start, bounded, encoding) }
}

/// The column of byte `offset` on the line starting at byte `start`, in UTF-8 bytes or UTF-16
/// code units.
pub fn column(text: &[u8], start: usize, offset: usize, encoding: PositionEncoding) -> usize {
  if encoding == PositionEncoding.Utf8 {
    return offset - start
  }
  let mut character = usize.ZERO
  let mut at = start
  while at < offset {
    // Continuation bytes add nothing; a four-byte sequence is a surrogate pair.
    let byte = text[at]
    if byte >= 240 {
      character = character + 2
    } else if byte < 128 || byte >= 192 {
      character = character + usize.ONE
    }
    at = at + usize.ONE
  }
  return character
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}
