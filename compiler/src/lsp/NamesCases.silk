//! Names in headers resolve at module scope and names in bodies read their body's table; hover,
//! go to definition, inlay hints and signature help read them back.

import lsp.Names as Names { NameAt, Named }
import lsp.Navigation as Navigation { Destination, Help, Hint, Hover }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import semantic.DeclarationId { DeclarationId }
import semantic.ModuleId { InvalidModulePath, ModuleId }
import semantic.Query { Cycle }
import semantic.Semantic { Semantic }
import semantic.SemanticCaseSupport { makeSemantic, module, present }
import semantic.SourceIndex { RevisionMismatch }
import semantic.SourceRevision { Revision }
import semantic.Types { TypeTable, Types }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.text.string { String }
import silk.testing.testing { AssertionError, Testing }
import silk.num.usize

fn source() -> string<'static> {
  return """
struct Point {x: i32, y: i32}
fn keep<T>(value: T) -> T {
  return value
}
fn twice(value: i32) -> i32 {
  return value + value
}
fn sum(point: &Point) -> i32 {
  let total: i32 = twice(point.x)
  return total + point.y
}
"""
}

test effect fn namesResolveInHeadersAndBodies() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run nameClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn nameClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let id = run module("names.silk")
  let revision = run Revision.publish(&Revision.make(), &id, &run present(source()))
  let mut store = makeSemantic(move revision)
  Semantic.selectEditorTables(&mut store, true)
  let header = run Names.at(&mut store, &id, at(b"Point) ->") + usize.ONE)
  run Testing.expect(declaration(&header, b"Point", at(b"Point) ->")), "a parameter type names its struct")
  let call = run Names.at(&mut store, &id, at(b"twice(point"))
  run Testing.expect(declaration(&call, b"twice", at(b"twice(point")), "a call names its function")
  let projection = run Names.at(&mut store, &id, at(b"x)"))
  run Testing.expect(field(&projection, usize.ZERO), "a projection names its field")
  let use = run Names.at(&mut store, &id, at(b"total +"))
  run Testing.expect(local(&use, at(b"total:")), "a local use names its binding")
  let generic = run Names.at(&mut store, &id, at(b"T) -> T"))
  run Testing.expect(binder(&generic, at(b"T>(")), "a generic parameter names its binder")
  let nothing = run Names.at(&mut store, &id, at(b"+ value"))
  run Testing.expect(absent(&nothing), "an operator is no name")
  return ()
}

// The offset of the first occurrence of `needle` in the source.
fn at(needle: &[u8]) -> usize {
  let text = String.utf8Bytes(source())
  let mut start = usize.ZERO
  while start + needle.length <= text.length {
    let mut same = true
    let mut offset = usize.ZERO
    while offset < needle.length && same {
      same = text[start + offset] == needle[offset]
      offset = offset + usize.ONE
    }
    if same {
      return start
    }
    start = start + usize.ONE
  }
  return usize.MAX
}

fn declaration(found: &Option<NameAt>, name: &[u8], start: usize) -> bool {
  if let Option<NameAt>.Some { value } = &found.* {
    if let Named.Declaration { identity } = &value.named {
      return value.span.start == start && DeclarationId.named(&identity, name)
    }
  }
  return false
}

fn field(found: &Option<NameAt>, ordinal: usize) -> bool {
  if let Option<NameAt>.Some { value } = &found.* {
    if let Named.Field { index, .. } = &value.named {
      return index == ordinal
    }
  }
  return false
}

fn local(found: &Option<NameAt>, binder: usize) -> bool {
  if let Option<NameAt>.Some { value } = &found.* {
    if let Named.Local { binder: span, .. } = &value.named {
      return span.start == binder
    }
  }
  return false
}

fn binder(found: &Option<NameAt>, start: usize) -> bool {
  if let Option<NameAt>.Some { value } = &found.* {
    if let Named.Binder { binder: span } = &value.named {
      return span.start == start
    }
  }
  return false
}

fn absent(found: &Option<NameAt>) -> bool {
  if let Option<NameAt>.None = &found.* {
    return true
  }
  return false
}

fn navigated() -> string<'static> {
  return """
/// Doubles a value.
@inlineAlways
fn twice(value: i32) -> i32 {
  return value + value
}
fn sum(left: i32) -> i32 {
  let doubled = twice(left)
  return doubled
}
"""
}

test effect fn navigationAnswersFromTheStore() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run navigationClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn navigationClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let id = run module("navigation.silk")
  let revision = run Revision.publish(&Revision.make(), &id, &run present(navigated()))
  let mut store = makeSemantic(move revision)
  Semantic.selectEditorTables(&mut store, true)
  let text = String.utf8Bytes(navigated())
  let call = within(text, b"twice(left")
  if let Option<Hover>.Some { value } = move run Navigation.hover(&mut store, &id, text, call) {
    run Testing.expect(contains(Bytes.asSlice(&value.text), b"fn twice(value: i32) -> i32"), "a call's hover shows the callee's header")
    run Testing.expect(contains(Bytes.asSlice(&value.text), b"Doubles a value."), "a call's hover shows the callee's doc comment")
    run Testing.expect(!contains(Bytes.asSlice(&value.text), b"///") && !contains(Bytes.asSlice(&value.text), b"return value"),
      "the hover shows the comment without its markers and the header without the body")
  } else {
    run Testing.expect(false, "a call has a hover")
  }
  if let Option<Hover>.Some { value } = move run Navigation.hover(&mut store, &id, text, within(text, b"Always\n")) {
    run Testing.expect(contains(Bytes.asSlice(&value.text), b"@inlineAlways") && contains(Bytes.asSlice(&value.text), b"Asks every caller to inline this function."),
      "a directive's hover shows its summary")
    run Testing.expect(value.span.start == within(text, b"@inline"), "a directive's hover covers its `@`")
  } else {
    run Testing.expect(false, "a directive has a hover")
  }
  if let Option<Hover>.Some { value } = move run Navigation.hover(&mut store, &id, text, within(text, b"doubled\n")) {
    run Testing.expect(contains(Bytes.asSlice(&value.text), b"doubled: i32"), "a local's hover shows its type")
  } else {
    run Testing.expect(false, "a local has a hover")
  }
  if let Option<Destination>.Some { value } = move run Navigation.definition(&mut store, &id, text, call) {
    run Testing.expect(value.span.start == within(text, b"twice(value"), "a call goes to its callee's name")
  } else {
    run Testing.expect(false, "a call has a definition")
  }
  let hints = run Navigation.hints(&mut store, &id)
  let listed = List<Hint>.asSlice(&hints)
  run Testing.expect(
    listed.length == usize.ONE && listed[0].offset == within(text, b" = twice") && same(Bytes.asSlice(&listed[0].label), b": i32"),
    "an unannotated binding gets its inferred type"
  )
  if let Option<Help>.Some { value } = move run Navigation.help(&mut store, &id, within(text, b"left)")) {
    let parameters = List<Bytes>.asSlice(&value.parameters)
    run Testing.expect(
      same(Bytes.asSlice(&value.label), b"fn twice(value: i32) -> i32") && same(Bytes.asSlice(&value.documentation), b"Doubles a value.") && parameters.length == usize.ONE
        && same(Bytes.asSlice(&parameters[0]), b"value: i32") && value.active == usize.ZERO,
      "a call's arguments get its signature with the first parameter active"
    )
  } else {
    run Testing.expect(false, "a call's arguments have signature help")
  }
  return ()
}

fn residual() -> string<'static> {
  return """
fn labelled(static label: string<'static>, value: i32) -> i32 {
  return value
}
fn tagged(left: i32) -> i32 {
  let kept = labelled("x", left)
  return kept
}
"""
}

test effect fn bodiesWithStaticWorkAnswerFromTheirSelectedBody() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run residualClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// A body that calls a function with a static parameter is checked as its selected application,
// and hover, go to definition and inlay hints read that body's table.
effect fn residualClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let id = run module("residual.silk")
  let revision = run Revision.publish(&Revision.make(), &id, &run present(residual()))
  let mut store = makeSemantic(move revision)
  Semantic.selectEditorTables(&mut store, true)
  let text = String.utf8Bytes(residual())
  if let Option<Hover>.Some { value } = move run Navigation.hover(&mut store, &id, text, within(text, b"kept\n")) {
    run Testing.expect(contains(Bytes.asSlice(&value.text), b"kept: i32"), "a local of a body with static work has a hover")
  } else {
    run Testing.expect(false, "a local of a body with static work has a hover")
  }
  if let Option<Destination>.Some { value } = move run Navigation.definition(&mut store, &id, text, within(text, b"left)")) {
    run Testing.expect(value.span.start == within(text, b"left: i32"), "a parameter use goes to its binding")
  } else {
    run Testing.expect(false, "a parameter use of a body with static work has a definition")
  }
  let hints = run Navigation.hints(&mut store, &id)
  let listed = List<Hint>.asSlice(&hints)
  run Testing.expect(
    listed.length == usize.ONE && listed[0].offset == within(text, b" = labelled") && same(Bytes.asSlice(&listed[0].label), b": i32"),
    "an unannotated binding of a body with static work gets its inferred type"
  )
  return ()
}

fn introduced() -> string<'static> {
  return """
/// A point.
struct Point {x: i32, y: i32}
union Shape {
  Dot { at: Point },
  Empty,
}
fn show<Args>(args: &Args) -> i32 {
  return 0
}
fn area(shape: &Shape) -> i32 {
  let size = 2
  return show(&.{ width: size })
}
union Size {
  Wide { breadth: i32 },
  Narrow,
}
fn measure(size: &Size) -> i32 {
  let twice = fn(value: i32) -> i32 {
    return value + value
  }
  let mut measured = 0
  match &size.* {
    Size.Wide { breadth } => {
      measured = twice(breadth)
    }
    Size.Narrow => {
      measured = 1
    }
  }
  return measured
}
"""
}

test effect fn declarationsAndPrimitivesHaveHovers() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run introducedClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// A name where it is declared shows what a use of it shows, and a primitive type names itself.
effect fn introducedClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let id = run module("introduced.silk")
  let revision = run Revision.publish(&Revision.make(), &id, &run present(introduced()))
  let mut store = makeSemantic(move revision)
  Semantic.selectEditorTables(&mut store, true)
  let text = String.utf8Bytes(introduced())
  let function = run hovered(&mut store, &id, text, within(text, b"area("))
  run Testing.expect(contains(Bytes.asSlice(&function), b"fn area(shape: &Shape) -> i32"), "a function's own name shows its header")
  let structure = run hovered(&mut store, &id, text, within(text, b"Point {") + usize.ONE)
  run Testing.expect(contains(Bytes.asSlice(&structure), b"struct Point") && contains(Bytes.asSlice(&structure), b"A point."),
    "a struct's own name shows its header and doc comment")
  let field = run hovered(&mut store, &id, text, within(text, b"x: i32"))
  run Testing.expect(contains(Bytes.asSlice(&field), b"x: i32"), "a declared field shows its type")
  let variant = run hovered(&mut store, &id, text, within(text, b"Dot {"))
  run Testing.expect(contains(Bytes.asSlice(&variant), b"Dot { at: Point }"), "a declared variant shows its payload")
  let parameter = run hovered(&mut store, &id, text, within(text, b"shape: &Shape"))
  run Testing.expect(contains(Bytes.asSlice(&parameter), b"shape: &Shape"), "a parameter's binder shows its type")
  let binding = run hovered(&mut store, &id, text, within(text, b"size = 2"))
  run Testing.expect(contains(Bytes.asSlice(&binding), b"size: i32"), "a binding's binder shows its type")
  let key = run hovered(&mut store, &id, text, within(text, b"width:"))
  run Testing.expect(contains(Bytes.asSlice(&key), b"width: i32"), "a record key shows its value's type")
  let primitive = run hovered(&mut store, &id, text, within(text, b"i32 {\n  let") + usize.ONE)
  run Testing.expect(contains(Bytes.asSlice(&primitive), b"```silk\ni32\n```"), "a primitive type names itself")
  let closureParameter = run hovered(&mut store, &id, text, within(text, b"value: i32"))
  run Testing.expect(contains(Bytes.asSlice(&closureParameter), b"value: i32"), "a closure parameter's binder shows its type")
  let closure = run hovered(&mut store, &id, text, within(text, b"twice = fn"))
  run Testing.expect(contains(Bytes.asSlice(&closure), b"twice: fn(i32) -> i32"), "a closure binding shows its signature")
  let closureUse = run hovered(&mut store, &id, text, within(text, b"value + value"))
  run Testing.expect(contains(Bytes.asSlice(&closureUse), b"value: i32"), "a closure parameter's use shows its type")
  let patternBinder = run hovered(&mut store, &id, text, within(text, b"breadth }"))
  run Testing.expect(contains(Bytes.asSlice(&patternBinder), b"breadth: i32"), "a pattern binder shows its type")
  let patternUse = run hovered(&mut store, &id, text, within(text, b"breadth)"))
  run Testing.expect(contains(Bytes.asSlice(&patternUse), b"breadth: i32"), "a pattern binder's use shows its type")
  let selected = run hovered(&mut store, &id, text, within(text, b"Size.Wide") + 5)
  run Testing.expect(contains(Bytes.asSlice(&selected), b"Wide { breadth: i32 }"), "a variant a pattern selects shows its payload")
  let unit = run hovered(&mut store, &id, text, within(text, b"Size.Narrow") + 5)
  run Testing.expect(contains(Bytes.asSlice(&unit), b"```silk\nNarrow\n```"), "a unit variant a pattern selects shows itself")
  return ()
}

fn deferred() -> string<'static> {
  return """
pub struct Reflect {}
impl Reflect {
  pub static fn fields<Owner>() -> Intrinsic.Fields<Owner> {
    return Intrinsic.reflectFields<Owner>()
  }
  pub static fn fieldLabel<Owner, Value>(field: Intrinsic.Field<Owner, Value>) -> string<'static> {
    return Intrinsic.reflectFieldLabel<Owner, Value>(field)
  }
}
struct Spec {
  names: Intrinsic.StaticSequence<i32>,
}
static fn hasField<T>(label: string<'static>) -> bool {
  let mut found = false
  static for field in Reflect.fields<T>() {
    if Reflect.fieldLabel(field) == label {
      found = true
    }
  }
  return found
}
"""
}

test effect fn deferredStaticBodiesHaveHovers() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run deferredClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// A generic static body that waits for its instantiation still hovers: names show how they are
// written, qualified calls resolve by path, and compiler-provided types name themselves.
effect fn deferredClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let id = run module("deferred.silk")
  let revision = run Revision.publish(&Revision.make(), &id, &run present(deferred()))
  let mut store = makeSemantic(move revision)
  Semantic.selectEditorTables(&mut store, true)
  let text = String.utf8Bytes(deferred())
  let local = run hovered(&mut store, &id, text, within(text, b"return found") + 8)
  run Testing.expect(contains(Bytes.asSlice(&local), b"let mut found = false"), "a local's use shows how it is written")
  let binder = run hovered(&mut store, &id, text, within(text, b"field in"))
  run Testing.expect(contains(Bytes.asSlice(&binder), b"static for field in Reflect.fields<T>()"), "a static for binder shows its loop")
  let use = run hovered(&mut store, &id, text, within(text, b"field) =="))
  run Testing.expect(contains(Bytes.asSlice(&use), b"static for field in"), "a static for binder's use shows its loop")
  let parameter = run hovered(&mut store, &id, text, within(text, b"== label") + 3)
  run Testing.expect(contains(Bytes.asSlice(&parameter), b"label: string<'static>"), "a parameter's use shows its written type")
  let call = run hovered(&mut store, &id, text, within(text, b"fieldLabel(field)"))
  run Testing.expect(contains(Bytes.asSlice(&call), b"static fn fieldLabel<Owner, Value>"), "a qualified call resolves by its path")
  let parameterType = run hovered(&mut store, &id, text, within(text, b"T>(label"))
  run Testing.expect(contains(Bytes.asSlice(&parameterType), b"type parameter `T`"), "a type parameter names itself")
  let intrinsic = run hovered(&mut store, &id, text, within(text, b"StaticSequence<i32>"))
  run Testing.expect(contains(Bytes.asSlice(&intrinsic), b"Intrinsic.StaticSequence"), "a compiler-provided type names itself")
  return ()
}

// The hover text at `offset`, empty when there is none.
effect fn hovered(store: &mut Semantic, id: &ModuleId, text: &[u8], offset: usize) -> Bytes
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator | &mut Types {
  if let Option<Hover>.Some { value } = move run Navigation.hover(&mut store.*, id, text, offset) {
    return move value.text
  }
  return Bytes.make()
}

fn within(text: &[u8], needle: &[u8]) -> usize {
  let mut start = usize.ZERO
  while start + needle.length <= text.length {
    if same(Slice.view<u8>(text, start, needle.length), needle) {
      return start
    }
    start = start + usize.ONE
  }
  return usize.MAX
}

fn contains(text: &[u8], needle: &[u8]) -> bool {
  return within(text, needle) != usize.MAX
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}
