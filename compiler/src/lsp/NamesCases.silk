//! Names in headers resolve at module scope and names in bodies read their body's table; hover,
//! go to definition, inlay hints and signature help read them back.

import lsp.Names as Names { NameAt, Named }
import lsp.Navigation as Navigation { Destination, Help, Hint, Hover }
import silk.bytes { Bytes }
import silk.list { List }
import silk.slice { Slice }
import semantic.DeclarationId { DeclarationId }
import semantic.ModuleId { InvalidModulePath, ModuleId }
import semantic.Query { Cycle }
import semantic.Semantic { Semantic }
import semantic.SemanticCaseSupport { makeSemantic, module, present }
import semantic.SourceIndex { RevisionMismatch }
import semantic.SourceRevision { Revision }
import semantic.Types { TypeTable, Types }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.option { Option }
import silk.string { String }
import silk.testing { AssertionError, Testing }
import silk.usize

fn source() -> string<'static> {
  return """
struct Point {x: i32, y: i32}
fn keep<T>(value: T) -> T {
  return value
}
fn twice(value: i32) -> i32 {
  return value + value
}
fn sum(point: &Point) -> i32 {
  let total: i32 = twice(point.x)
  return total + point.y
}
"""
}

test effect fn namesResolveInHeadersAndBodies() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run nameClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn nameClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let id = run module("names.silk")
  let revision = run Revision.publish(&Revision.make(), &id, &run present(source()))
  let mut store = makeSemantic(move revision)
  Semantic.selectEditorTables(&mut store, true)
  let header = run Names.at(&mut store, &id, at(b"Point) ->") + usize.ONE)
  run Testing.expect(declaration(&header, b"Point", at(b"Point) ->")), "a parameter type names its struct")
  let call = run Names.at(&mut store, &id, at(b"twice(point"))
  run Testing.expect(declaration(&call, b"twice", at(b"twice(point")), "a call names its function")
  let projection = run Names.at(&mut store, &id, at(b"x)"))
  run Testing.expect(field(&projection, usize.ZERO), "a projection names its field")
  let use = run Names.at(&mut store, &id, at(b"total +"))
  run Testing.expect(local(&use, at(b"total:")), "a local use names its binding")
  let generic = run Names.at(&mut store, &id, at(b"T) -> T"))
  run Testing.expect(binder(&generic, at(b"T>(")), "a generic parameter names its binder")
  let nothing = run Names.at(&mut store, &id, at(b"+ value"))
  run Testing.expect(absent(&nothing), "an operator is no name")
  return ()
}

// The offset of the first occurrence of `needle` in the source.
fn at(needle: &[u8]) -> usize {
  let text = String.utf8Bytes(source())
  let mut start = usize.ZERO
  while start + needle.length <= text.length {
    let mut same = true
    let mut offset = usize.ZERO
    while offset < needle.length && same {
      same = text[start + offset] == needle[offset]
      offset = offset + usize.ONE
    }
    if same {
      return start
    }
    start = start + usize.ONE
  }
  return usize.MAX
}

fn declaration(found: &Option<NameAt>, name: &[u8], start: usize) -> bool {
  if let Option<NameAt>.Some { value } = &found.* {
    if let Named.Declaration { identity } = &value.named {
      return value.span.start == start && DeclarationId.named(&identity, name)
    }
  }
  return false
}

fn field(found: &Option<NameAt>, ordinal: usize) -> bool {
  if let Option<NameAt>.Some { value } = &found.* {
    if let Named.Field { index, .. } = &value.named {
      return index == ordinal
    }
  }
  return false
}

fn local(found: &Option<NameAt>, binder: usize) -> bool {
  if let Option<NameAt>.Some { value } = &found.* {
    if let Named.Local { binder: span, .. } = &value.named {
      return span.start == binder
    }
  }
  return false
}

fn binder(found: &Option<NameAt>, start: usize) -> bool {
  if let Option<NameAt>.Some { value } = &found.* {
    if let Named.Binder { binder: span } = &value.named {
      return span.start == start
    }
  }
  return false
}

fn absent(found: &Option<NameAt>) -> bool {
  if let Option<NameAt>.None = &found.* {
    return true
  }
  return false
}

fn navigated() -> string<'static> {
  return """
/// Doubles a value.
fn twice(value: i32) -> i32 {
  return value + value
}
fn sum(left: i32) -> i32 {
  let doubled = twice(left)
  return doubled
}
"""
}

test effect fn navigationAnswersFromTheStore() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run navigationClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn navigationClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let id = run module("navigation.silk")
  let revision = run Revision.publish(&Revision.make(), &id, &run present(navigated()))
  let mut store = makeSemantic(move revision)
  Semantic.selectEditorTables(&mut store, true)
  let text = String.utf8Bytes(navigated())
  let call = within(text, b"twice(left")
  if let Option<Hover>.Some { value } = move run Navigation.hover(&mut store, &id, text, call) {
    run Testing.expect(contains(Bytes.asSlice(&value.text), b"fn twice(value: i32) -> i32"), "a call's hover shows the callee's header")
    run Testing.expect(contains(Bytes.asSlice(&value.text), b"Doubles a value."), "a call's hover shows the callee's doc comment")
    run Testing.expect(!contains(Bytes.asSlice(&value.text), b"///") && !contains(Bytes.asSlice(&value.text), b"return value"),
      "the hover shows the comment without its markers and the header without the body")
  } else {
    run Testing.expect(false, "a call has a hover")
  }
  if let Option<Hover>.Some { value } = move run Navigation.hover(&mut store, &id, text, within(text, b"doubled\n")) {
    run Testing.expect(contains(Bytes.asSlice(&value.text), b"doubled: i32"), "a local's hover shows its type")
  } else {
    run Testing.expect(false, "a local has a hover")
  }
  if let Option<Destination>.Some { value } = move run Navigation.definition(&mut store, &id, text, call) {
    run Testing.expect(value.span.start == within(text, b"twice(value"), "a call goes to its callee's name")
  } else {
    run Testing.expect(false, "a call has a definition")
  }
  let hints = run Navigation.hints(&mut store, &id)
  let listed = List<Hint>.asSlice(&hints)
  run Testing.expect(
    listed.length == usize.ONE && listed[0].offset == within(text, b" = twice") && same(Bytes.asSlice(&listed[0].label), b": i32"),
    "an unannotated binding gets its inferred type"
  )
  if let Option<Help>.Some { value } = move run Navigation.help(&mut store, &id, within(text, b"left)")) {
    let parameters = List<Bytes>.asSlice(&value.parameters)
    run Testing.expect(
      same(Bytes.asSlice(&value.label), b"fn twice(value: i32) -> i32") && same(Bytes.asSlice(&value.documentation), b"Doubles a value.") && parameters.length == usize.ONE
        && same(Bytes.asSlice(&parameters[0]), b"value: i32") && value.active == usize.ZERO,
      "a call's arguments get its signature with the first parameter active"
    )
  } else {
    run Testing.expect(false, "a call's arguments have signature help")
  }
  return ()
}

fn residual() -> string<'static> {
  return """
fn labelled(static label: string<'static>, value: i32) -> i32 {
  return value
}
fn tagged(left: i32) -> i32 {
  let kept = labelled("x", left)
  return kept
}
"""
}

test effect fn bodiesWithStaticWorkAnswerFromTheirSelectedBody() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run residualClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// A body that calls a function with a static parameter is checked as its selected application,
// and hover, go to definition and inlay hints read that body's table.
effect fn residualClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let id = run module("residual.silk")
  let revision = run Revision.publish(&Revision.make(), &id, &run present(residual()))
  let mut store = makeSemantic(move revision)
  Semantic.selectEditorTables(&mut store, true)
  let text = String.utf8Bytes(residual())
  if let Option<Hover>.Some { value } = move run Navigation.hover(&mut store, &id, text, within(text, b"kept\n")) {
    run Testing.expect(contains(Bytes.asSlice(&value.text), b"kept: i32"), "a local of a body with static work has a hover")
  } else {
    run Testing.expect(false, "a local of a body with static work has a hover")
  }
  if let Option<Destination>.Some { value } = move run Navigation.definition(&mut store, &id, text, within(text, b"left)")) {
    run Testing.expect(value.span.start == within(text, b"left: i32"), "a parameter use goes to its binding")
  } else {
    run Testing.expect(false, "a parameter use of a body with static work has a definition")
  }
  let hints = run Navigation.hints(&mut store, &id)
  let listed = List<Hint>.asSlice(&hints)
  run Testing.expect(
    listed.length == usize.ONE && listed[0].offset == within(text, b" = labelled") && same(Bytes.asSlice(&listed[0].label), b": i32"),
    "an unannotated binding of a body with static work gets its inferred type"
  )
  return ()
}

fn within(text: &[u8], needle: &[u8]) -> usize {
  let mut start = usize.ZERO
  while start + needle.length <= text.length {
    if same(Slice.view<u8>(text, start, needle.length), needle) {
      return start
    }
    start = start + usize.ONE
  }
  return usize.MAX
}

fn contains(text: &[u8], needle: &[u8]) -> bool {
  return within(text, needle) != usize.MAX
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}
