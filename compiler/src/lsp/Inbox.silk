//! The handoff from the transport thread to the compiler thread: an unbounded queue of decoded
//! messages behind a lock, and a parker the compiler thread sleeps on while the queue is empty.

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.json.value { Value }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.concurrency.sync { Arc, Mutex, Parker, Unparker }

/// One thing the transport hands the compiler thread.
pub union Incoming {
  /// A decoded JSON-RPC message.
  Message { pub value: Value },
  /// A frame whose content is not one JSON value; the server answers it with a parse error.
  Unparsable,
  /// The input ended or lost its framing; nothing follows. Only the receiver returns it.
  Closed,
}

struct Queue {
  items: List<Incoming>,
  closed: bool,
}

/// The transport's end: it appends and wakes the compiler thread.
pub struct Sender {
  queue: Arc<Mutex<Queue>>,
  wake: Unparker,
}

/// The compiler thread's end: it takes items in arrival order and sleeps while there are none.
pub struct Receiver {
  queue: Arc<Mutex<Queue>>,
  parker: Parker,
}

/// Both ends of one inbox.
pub struct Inbox {
  pub sender: Sender,
  pub receiver: Receiver,
}

/// Makes an empty inbox.
pub effect fn make() -> Inbox
  ! OutOfMemoryError
  ? &mut Allocator {
  let locked = run Mutex<Queue>.make(Queue { items: List<Incoming>.make(), closed: false })
  let queue = run Arc<Mutex<Queue>>.make(move locked)
  let parker = run Parker.make()
  let sender = Sender { queue: queue.clone(), wake: parker.unparker() }
  return Inbox {
    sender: move sender,
    receiver: Receiver { queue: move queue, parker: move parker }
  }
}

impl Sender {
  /// Appends `item` and wakes the compiler thread.
  pub effect fn send(self: &Self, item: Incoming) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let _appended = run append(&self.queue, move item)
    self.wake.unpark()
    return ()
  }

  /// Marks the input finished: once the queue drains, the compiler thread receives `Closed`.
  ///
  /// # Details
  ///
  /// Closing allocates nothing, so a transport that ran out of memory can still close.
  pub fn close(self: &Self) -> () {
    let mut guard = self.queue.get().lock()
    let state = guard.getMut()
    state.closed = true
    drop guard
    self.wake.unpark()
    return ()
  }
}

effect fn append(queue: &Arc<Mutex<Queue>>, item: Incoming) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut guard = queue.get().lock()
  return run List<Incoming>.append(&mut guard.getMut().items, move item)
}

impl Receiver {
  /// Takes the oldest item without sleeping: none while the queue is empty and still open.
  pub fn tryReceive(self: &Self) -> Option<Incoming> {
    let mut guard = self.queue.get().lock()
    if List<Incoming>.length(&guard.get().items) > 0 {
      let state = guard.getMut()
      return Option<Incoming>.some(List<Incoming>.remove(&mut state.items, 0))
    }
    if guard.get().closed {
      return Option<Incoming>.some(Incoming.Closed)
    }
    return Option<Incoming>.none()
  }

  /// Takes the oldest item, sleeping until one arrives.
  pub fn receive(self: &Self) -> Incoming {
    while true {
      let mut guard = self.queue.get().lock()
      if List<Incoming>.length(&guard.get().items) > 0 {
        let state = guard.getMut()
        return List<Incoming>.remove(&mut state.items, 0)
      }
      if guard.get().closed {
        return Incoming.Closed
      }
      drop guard
      self.parker.park()
    }
    return Incoming.Closed
  }
}
