//! The compiler thread's side of the server: the lifecycle state machine every message passes
//! through.
//!
//! The server answers requests before `initialize` with ServerNotInitialized, accepts `initialize`
//! once, answers `shutdown` with `null`, refuses every request after it, and stops on `exit` or
//! when the input closes. It exits with status 0 only after a `shutdown` request.
//!
//! Document notifications only record text. The server refreshes the workspace, one store update
//! per changed package, and publishes the diagnostics it owes before it answers a request and
//! whenever the inbox runs dry, so a burst of edits is analyzed once. While the inbox stays dry,
//! it checks one queued module at a time and publishes what changed, so a request waits for at
//! most one module's check.

import lsp.Inbox { Incoming, Receiver }
import lsp.Features
import lsp.Message as Messages { Change, ErrorCode, PositionEncoding, Reply }
import lsp.Navigation { Help }
import lsp.Workspace { Changed, Location, Position, Published, Shown, Workspace }
import semantic.Semantic { Statistics }
import semantic.SourceUnit { SourceUnit }
import semantic.Types { Types }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileSystem }
import silk.json.scanner { JsonError }
import silk.json.value { Value }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.text.string { String }
import silk.num.usize
import silk.io.writer { Writer, WriterError }

/// Where the server is in its lifecycle.
pub enum Phase {
  /// Before `initialize`.
  Waiting,
  /// After `initialize`, until `shutdown`.
  Running,
  /// After `shutdown`; only `exit` remains.
  ShutDown,
}

/// The lifecycle state the compiler thread owns.
pub struct Server {
  pub phase: Phase,

  /// The position encoding `initialize` selected.
  pub encoding: PositionEncoding,

  /// The open documents and their packages.
  pub workspace: Workspace,
}

/// What the compiler thread does after one message.
pub union Step {
  Continue,
  /// The server stops and the process exits with `status`.
  Exit { pub status: i32 },
}

/// A server waiting for `initialize`, over an empty `workspace`.
pub fn make(workspace: Workspace) -> Server {
  return Server {
    phase: Phase.Waiting,
    encoding: PositionEncoding.Utf16,
    workspace: move workspace
  }
}

/// Handles messages from `receiver` until the server stops, and returns the exit status.
pub effect fn serve(receiver: &Receiver, workspace: Workspace) -> i32
  ! JsonError | WriterError | OutOfMemoryError
  ? &mut Writer | &mut FileSystem | &mut Allocator | &mut Types {
  let mut server = make(move workspace)
  while true {
    let mut incoming = Option<Incoming>.none()
    match move receiver.tryReceive() {
      Option<Incoming>.Some { value } => {
        incoming = Option<Incoming>.some(move value)
      }
      Option<Incoming>.None => {
        // Nothing else is queued, so the edits so far are the whole burst: they are analyzed
        // and their diagnostics published, then one queued module is checked, and the inbox is
        // read again; with no work left, the server sleeps until the next message.
        run pump(&mut server)
        if server.workspace.busy() {
          let worked = run server.workspace.work()
        } else {
          incoming = Option<Incoming>.some(receiver.receive())
        }
      }
    }
    if let Option<Incoming>.Some { value } = move incoming {
      let step = run handle(&mut server, move value)
      if let Step.Exit { status } = move step {
        return status
      }
    }
  }
  return 1
}

/// Refreshes the workspace and publishes the diagnostics the client has not seen.
pub effect fn pump(server: &mut Server) -> ()
  ! JsonError | WriterError | OutOfMemoryError
  ? &mut Writer | &mut FileSystem | &mut Allocator | &mut Types {
  if !server.workspace.stale() {
    return ()
  }
  run server.workspace.refresh()
  let published = run server.workspace.diagnostics(server.encoding)
  let listed = List<Published>.asSlice(&published)
  let mut at = usize.ZERO
  while at < listed.length {
    run Messages.publishDiagnostics(&listed[at])
    at = at + usize.ONE
  }
  return ()
}

/// Handles one incoming item, writing any response through the ambient Writer.
pub effect fn handle(server: &mut Server, incoming: Incoming) -> Step
  ! JsonError | WriterError | OutOfMemoryError
  ? &mut Writer | &mut FileSystem | &mut Allocator | &mut Types {
  return match move incoming {
    Incoming.Closed => Step.Exit { status: exitStatus(&server.*) }
    Incoming.Unparsable => {
      run Messages.respond(
        &Value.Null,
        &Reply.Failure { code: ErrorCode.ParseError, message: "the message is not valid JSON" }
      )
      return Step.Continue
    }
    Incoming.Message { value } => run message(&mut server.*, &value)
  }
}

effect fn message(server: &mut Server, value: &Value) -> Step
  ! JsonError | WriterError | OutOfMemoryError
  ? &mut Writer | &mut FileSystem | &mut Allocator | &mut Types {
  let method = Messages.method(value)
  if Messages.names(&method, "exit") {
    return Step.Exit { status: exitStatus(&server.*) }
  }

  // A message with no method is a response; the server sends no requests yet.
  if let Option<string>.None = &method {
    return Step.Continue
  }
  let id = match Messages.id(value) {
    Option<&Value>.Some { value: present } => present

    // Notifications need no answer; before `initialize` and after `shutdown` they are dropped.
    Option<&Value>.None => {
      if server.phase == Phase.Running {
        run notification(&mut server.*, &method, value)
      }
      return Step.Continue
    }
  }

  // A request sees every edit before it.
  run pump(&mut server.*)
  let mut reply = Reply.Failure {
    code: ErrorCode.MethodNotFound,
    message: "the server does not handle this method"
  }
  match server.phase {
    Phase.Waiting => {
      if Messages.names(&method, "initialize") {
        server.encoding = Messages.negotiate(value)
        server.phase = Phase.Running
        reply = Reply.Initialized { encoding: server.encoding, library: run server.workspace.libraryUri() }
      } else {
        reply = Reply.Failure {
          code: ErrorCode.ServerNotInitialized,
          message: "the server is not initialized"
        }
      }
    }
    Phase.Running => {
      if Messages.names(&method, "initialize") {
        reply = Reply.Failure {
          code: ErrorCode.InvalidRequest,
          message: "the server is already initialized"
        }
      } else if Messages.names(&method, "shutdown") {
        // What the session checked since the cache was last written is kept for the next one.
        run server.workspace.persistCaches()
        server.phase = Phase.ShutDown
        reply = Reply.Null
      } else if let Option<Reply>.Some { value: answered } = move run navigation(&mut server.*, &method, value) {
        reply = move answered
      } else if let Option<Reply>.Some { value: answered } = move run feature(
        &server.*,
        &method,
        value
      ) {
        reply = move answered
      }
    }
    Phase.ShutDown => {
      reply = Reply.Failure { code: ErrorCode.InvalidRequest, message: "the server is shut down" }
    }
  }
  run Messages.respond(id, &reply)
  return Step.Continue
}

// Answers a syntax feature request about an open document; `null` for a document that is not
// open, and none for a method that is not a feature.
effect fn feature(server: &Server, method: &Option<string>, value: &Value) -> Option<Reply>
  ! OutOfMemoryError
  ? &mut Allocator {
  let symbols = Messages.names(method, "textDocument/documentSymbol")
  let folding = Messages.names(method, "textDocument/foldingRange")
  let formatting = Messages.names(method, "textDocument/formatting")
  // `silk/statistics` reports the demand counters of the store that owns a document, so session
  // tests can hold invalidation to a budget.
  if Messages.names(method, "silk/statistics") {
    if let Option<string>.Some { value: uri } = move Messages.document(value, "uri") {
      if let Option<Statistics>.Some { value: counted } = move server.workspace.statistics(String.utf8Bytes(uri)) {
        return Option<Reply>.some(Reply.Counters { demands: counted.demands, hits: counted.hits, runs: counted.runs })
      }
    }
    return Option<Reply>.some(Reply.Null)
  }
  if !symbols && !folding && !formatting {
    return Option<Reply>.none()
  }
  let unit = match move Messages.document(value, "uri") {
    Option<string>.Some { value: uri } => match move server.workspace.unit(String.utf8Bytes(uri)) {
      Option<&SourceUnit>.Some { value: parsed } => parsed
      Option<&SourceUnit>.None => {
        return Option<Reply>.some(Reply.Null)
      }
    }
    Option<string>.None => {
      return Option<Reply>.some(Reply.Null)
    }
  }
  if symbols {
    return Option<Reply>.some(
      Reply.Symbols { symbols: run Features.symbols(unit, server.encoding) }
    )
  }
  if folding {
    return Option<Reply>.some(Reply.Folds { folds: run Features.folds(unit) })
  }
  return Option<Reply>.some(Reply.Edits { edits: run Features.format(unit, server.encoding) })
}

// The most declarations a workspace symbol search lists.
const SYMBOL_LIMIT: usize = 256

// Answers a request that reads the semantic store: hover, go to definition, inlay hints,
// signature help, completion, references, rename and workspace symbols; `null` when there is
// nothing to show, and none for any other method.
effect fn navigation(server: &mut Server, method: &Option<string>, value: &Value) -> Option<Reply>
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator | &mut Types {
  let hover = Messages.names(method, "textDocument/hover")
  let definition = Messages.names(method, "textDocument/definition")
  let hints = Messages.names(method, "textDocument/inlayHint")
  let signature = Messages.names(method, "textDocument/signatureHelp")
  let references = Messages.names(method, "textDocument/references")
  let rename = Messages.names(method, "textDocument/rename")
  let completion = Messages.names(method, "textDocument/completion")
  if Messages.names(method, "workspace/symbol") {
    let symbols = match move Messages.parameter(value, "query") {
      Option<string>.Some { value: query } => run server.workspace.symbols(String.utf8Bytes(query), server.encoding, SYMBOL_LIMIT)
      Option<string>.None => run server.workspace.symbols(b"", server.encoding, SYMBOL_LIMIT)
    }
    return Option<Reply>.some(Reply.Placements { symbols: move symbols })
  }
  if !hover && !definition && !hints && !signature && !references && !rename && !completion {
    return Option<Reply>.none()
  }
  let uri = match move Messages.document(value, "uri") {
    Option<string>.Some { value: present } => String.utf8Bytes(present)
    Option<string>.None => {
      return Option<Reply>.some(Reply.Null)
    }
  }
  if hints {
    return Option<Reply>.some(Reply.Hints { hints: run server.workspace.hints(uri, server.encoding) })
  }
  let position = match move Messages.position(value) {
    Option<Position>.Some { value: present } => present
    Option<Position>.None => {
      return Option<Reply>.some(Reply.Null)
    }
  }
  if completion {
    return Option<Reply>.some(Reply.Completions { items: run server.workspace.completion(uri, position, server.encoding) })
  }
  if references {
    return Option<Reply>.some(Reply.Locations {
      locations: run server.workspace.references(uri, position, server.encoding, Messages.includesDeclaration(value)),
    })
  }
  if rename {
    let name = match move Messages.parameter(value, "newName") {
      Option<string>.Some { value: present } => String.utf8Bytes(present)
      Option<string>.None => {
        return Option<Reply>.some(Reply.Null)
      }
    }
    return match move run server.workspace.rename(uri, position, server.encoding, name) {
      Option<List<Changed>>.Some { value: changes } => Option<Reply>.some(Reply.Renamed { changes: move changes })
      Option<List<Changed>>.None => Option<Reply>.some(Reply.Failure {
        code: ErrorCode.RequestFailed,
        message: "the name cannot be renamed: it names nothing this package declares, or the new name is not an identifier"
      })
    }
  }
  if hover {
    if let Option<Shown>.Some { value: shown } = move run server.workspace.hover(uri, position, server.encoding) {
      return Option<Reply>.some(Reply.Hovered { shown: move shown })
    }
  } else if definition {
    if let Option<Location>.Some { value: location } = move run server.workspace.definition(uri, position, server.encoding) {
      return Option<Reply>.some(Reply.Located { location: move location })
    }
  } else if let Option<Help>.Some { value: help } = move run server.workspace.signature(uri, position, server.encoding) {
    return Option<Reply>.some(Reply.Signature { help: move help })
  }
  return Option<Reply>.some(Reply.Null)
}

// Applies one document notification to the workspace; other notifications are ignored.
effect fn notification(server: &mut Server, method: &Option<string>, value: &Value) -> ()
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator | &mut Types {
  let uri = match move Messages.document(value, "uri") {
    Option<string>.Some { value: present } => String.utf8Bytes(present)
    Option<string>.None => {
      return ()
    }
  }
  if Messages.names(method, "textDocument/didOpen") {
    if let Option<string>.Some { value: text } = move Messages.document(value, "text") {
      run server.workspace.open(uri, Messages.version(value), String.utf8Bytes(text))
    }
  } else if Messages.names(method, "textDocument/didChange") {
    let changes = run Messages.changes(value)
    run server.workspace.edit(uri, Messages.version(value), List<Change>.asSlice(&changes), server.encoding)
  } else if Messages.names(method, "textDocument/didSave") {
    run server.workspace.save(uri)
  } else if Messages.names(method, "textDocument/didClose") {
    run server.workspace.close(uri)
  }
  return ()
}

fn exitStatus(server: &Server) -> i32 {
  return match server.phase {
    Phase.ShutDown => 0
    _ => 1
  }
}
