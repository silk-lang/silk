//! A language server for when no compiler can serve: `silk lsp` in a project whose pinned toolchain
//! is not installed. Editors that only spawn `silk lsp` would otherwise see a crashed server, so
//! this one answers `initialize` with no capabilities, shows why as an error message, and then
//! follows the protocol until the client exits.

import lsp.Framing as Framings { Frame }
import lsp.Message as Messages { ErrorCode, Reply }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.effect { Effect }
import silk.json_scanner { JsonError }
import silk.json_value { Json, Value }
import silk.option { Option }
import silk.result { Result }
import silk.slice { Slice }
import silk.standard_input { ReadOutcome, StandardInput, StreamReadError }
import silk.writer { Writer, WriterError }

const READ_SIZE: usize = 65536

/// Serves until the client sends `exit` or closes the input, showing `reason` once the client has
/// initialized. Returns 0 after `shutdown` then `exit`, as the protocol asks, and 1 otherwise.
pub effect fn serve(reason: &[u8]) -> i32
  ! JsonError | WriterError | OutOfMemoryError
  ? &mut StandardInput | &mut Writer | &mut Allocator {
  let mut pending = Bytes.make()
  let mut chunk = run Bytes.zeroed(READ_SIZE)
  let mut shutDown = false
  while true {
    let frame = Framings.next(Bytes.asSlice(&pending))
    match move frame {
      Frame.Complete { start, length } => {
        let content = Slice.view<u8>(Bytes.asSlice(&pending), start, length)
        let decoded = run Effect.result(Json.parse(content))
        match move decoded {
          Result<Value, JsonError | OutOfMemoryError>.Success { value } => {
            let method = Messages.method(&value)
            if Messages.names(&method, "exit") {
              if shutDown {
                return 0
              }
              return 1
            }
            if let Option<&Value>.Some { value: id } = Messages.id(&value) {
              if Messages.names(&method, "initialize") {
                run Messages.respond(id, &Reply.Unavailable)
                run Messages.showError(reason)
              } else {
                if Messages.names(&method, "shutdown") {
                  shutDown = true
                  run Messages.respond(id, &Reply.Null)
                } else {
                  run Messages.respond(
                    id,
                    &Reply.Failure {
                      code: ErrorCode.MethodNotFound,
                      message: "the selected Silk toolchain is not installed"
                    }
                  )
                }
              }
            }
          }
          Result<Value, JsonError | OutOfMemoryError>.Failure { error } => match move error {
            JsonError invalid => {
              run Messages.respond(
                &Value.Null,
                &Reply.Failure { code: ErrorCode.ParseError, message: "the message is not JSON" }
              )
            }
            OutOfMemoryError exhausted => {
              fail move exhausted
            }
          }
        }
        let rest = Slice.view<u8>(
          Bytes.asSlice(&pending),
          start + length,
          Bytes.length(&pending) - start - length
        )
        pending = run Bytes.copy(rest)
      }
      Frame.Incomplete => {
        let read = run Effect.result(StandardInput.read(Bytes.asMutSlice(&mut chunk)))
        let count = match move read {
          Result<ReadOutcome, StreamReadError>.Success { value } => StandardInput.count(&value)
          Result<ReadOutcome, StreamReadError>.Failure { error: _ } => 0
        }
        if count == 0 {
          return 1
        }
        run Bytes.append(&mut pending, Slice.view<u8>(Bytes.asSlice(&chunk), 0, count))
      }
      Frame.Malformed => {
        return 1
      }
    }
  }
  return 1
}
