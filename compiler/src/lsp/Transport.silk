//! Standard input's side of the server: reads framed messages and decodes each into a JSON value.
//!
//! A `Reader` pulls messages one at a time. The transport thread forwards them to the compiler
//! thread; a build that cannot start threads reads them on the compiler thread itself.

import lsp.Framing as Framings { Frame }
import lsp.Inbox { Incoming, Sender }
import lsp.Message
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.json.scanner { JsonError }
import silk.json.value { Json, Value }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.io.standard_input { ReadOutcome, StandardInput, StreamReadError }

const READ_SIZE: usize = 65536

/// Bytes read from standard input that do not yet make a whole message.
pub struct Reader {
  pending: Bytes,
  chunk: Bytes,
  closed: bool,
}

/// A reader that has read nothing.
pub effect fn make() -> Reader
  ! OutOfMemoryError
  ? &mut Allocator {
  return Reader { pending: Bytes.make(), chunk: run Bytes.zeroed(READ_SIZE), closed: false }
}

impl Reader {
  /// Takes the next message already read, without reading: none while the bytes so far make no
  /// whole message. After the input ends or its framing breaks, every call returns `Closed`.
  pub effect fn buffered(self: &mut Self) -> Option<Incoming>
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.closed {
      return Option<Incoming>.some(Incoming.Closed)
    }
    let frame = Framings.next(Bytes.asSlice(&self.pending))
    return match move frame {
      Frame.Complete { start, length } => {
        let content = Slice.view<u8>(Bytes.asSlice(&self.pending), start, length)
        let decoded = run Effect.result(Json.parse(content))
        let item = match move decoded {
          Result<Value, JsonError | OutOfMemoryError>.Success { value } => Incoming.Message {
            value: move value
          }
          Result<Value, JsonError | OutOfMemoryError>.Failure { error } => match move error {
            JsonError _invalid => Incoming.Unparsable
            OutOfMemoryError exhausted => {
              fail move exhausted
            }
          }
        }
        let rest = Slice.view<u8>(
          Bytes.asSlice(&self.pending),
          start + length,
          Bytes.length(&self.pending) - start - length
        )
        self.pending = run Bytes.copy(rest)
        return Option<Incoming>.some(move item)
      }
      Frame.Incomplete => Option<Incoming>.none()
      Frame.Malformed => {
        self.closed = true
        return Option<Incoming>.some(Incoming.Closed)
      }
    }
  }

  /// Takes the next message, reading standard input until one is whole. Returns `Closed` once the
  /// input ends or its framing breaks.
  pub effect fn next(self: &mut Self) -> Incoming
    ! OutOfMemoryError
    ? &mut StandardInput | &mut Allocator {
    while true {
      if let Option<Incoming>.Some { value } = move run self.buffered() {
        return move value
      }
      let read = run Effect.result(StandardInput.read(Bytes.asMutSlice(&mut self.chunk)))
      let count = match move read {
        Result<ReadOutcome, StreamReadError>.Success { value } => StandardInput.count(&value)
        Result<ReadOutcome, StreamReadError>.Failure {..} => 0
      }
      if count == 0 {
        self.closed = true
        return Incoming.Closed
      }
      run Bytes.append(&mut self.pending, Slice.view<u8>(Bytes.asSlice(&self.chunk), 0, count))
    }
    return Incoming.Closed
  }
}

/// Forwards messages until the input ends, its framing breaks, or the client sends `exit`, after
/// which the server reads nothing more.
pub effect fn forward(sender: &Sender) -> ()
  ! OutOfMemoryError
  ? &mut StandardInput | &mut Allocator {
  let mut reader = run make()
  while true {
    let item = run reader.next()
    let exiting = match &item {
      Incoming.Message { value } => Message.isExit(&value)
      Incoming.Closed => {
        sender.close()
        return ()
      }
      _ => false
    }
    run sender.send(move item)
    if exiting {
      return ()
    }
  }
  return ()
}
