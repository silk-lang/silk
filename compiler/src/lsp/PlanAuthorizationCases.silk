//! How the language server tells a project's own `Plan` command from the built-in one.

import driver.Project as Projects { ProjectError }
import lsp.PlanAuthorization
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.system.filesystem_native { OsFileSystem }
import silk.testing.testing { AssertionError, Testing }

test effect fn customPlansAreFoundWithoutRunningTasks() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run detection() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn detection() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let custom = b"union Tasks {\n  Lint { pub fix: bool },\n  Plan,\n}\npub effect fn main() -> i32 ? &mut HostInput { return run Task.main<Tasks>() }\n"
  run Testing.expect(
    run PlanAuthorization.declaresPlan(custom),
    "a Plan variant of the union Task.main runs is a custom plan",
  )
  let builtIn = b"/// Plan the work.\nunion Tasks {\n  // Plan\n  Deploy { pub Plan: bool },\n  CheckRoots,\n}\nunion Other { Plan }\npub effect fn main() -> i32 ? &mut HostInput { return run Task.main<Tasks>() }\n"
  run Testing.expect(
    !run PlanAuthorization.declaresPlan(builtIn),
    "comments, fields and other unions do not make a custom plan",
  )
  let imported = b"import tasks.commands { Commands }\npub effect fn main() -> i32 ? &mut HostInput { return run Task.main<Commands>() }\n"
  run Testing.expect(
    run PlanAuthorization.declaresPlan(imported),
    "a union declared elsewhere might have a Plan variant, so it counts as custom",
  )
  run Testing.expect(
    run PlanAuthorization.declaresPlan(b"pub effect fn main() -> i32 { return 0 }\n"),
    "a main that runs no Task.main counts as custom",
  )
}

fn temporaryParent() -> string<'static> {
  static if Intrinsic.targetOperatingSystem() == "darwin" { return "/private/tmp" }
  else { return "/tmp" }
}

effect fn ignoreCleanup(error: FileError | OutOfMemoryError) -> () {
  drop error
  return ()
}

effect fn cleanup(path: &Path) -> ()
  ? &mut FileSystem | &mut Allocator {
  return run Effect.catchAll(FileSystem.removeDirectoryRecursively(path), ignoreCleanup)
}

effect fn rootPrecedence(directory: &Path) -> ()
  ! AssertionError<'static> | FileError | ProjectError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let manifest = run Path.join(directory, "silk.toml")
  let source = run Path.join(directory, "src")
  run FileSystem.createDirectory(&source)
  run FileSystem.writeFile(&manifest, b"[package]\nname = \"plan-order\"\n")
  let custom = b"union Tasks { Plan }\npub effect fn main() -> i32 ? &mut HostInput { return run Task.main<Tasks>() }\n"
  let builtIn = b"union Tasks { Lint }\npub effect fn main() -> i32 ? &mut HostInput { return run Task.main<Tasks>() }\n"
  let fallback = run Path.join(&source, "tasks.silk")
  let root = run Path.join(directory, "tasks.silk")
  run FileSystem.writeFile(&fallback, custom)
  let project = run Projects.load(&manifest)
  run Testing.expect(
    run PlanAuthorization.custom(&project),
    "PlanAuthorization reads src/tasks.silk when no root tasks.silk exists",
  )
  run FileSystem.writeFile(&root, builtIn)
  run Testing.expect(
    !run PlanAuthorization.custom(&project),
    "root tasks.silk overrides src/tasks.silk for PlanAuthorization",
  )
  return ()
}

effect fn checkRootPrecedence() -> ()
  ! AssertionError<'static> | FileError | ProjectError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let parent = run Path.make(temporaryParent())
  let temporary = run FileSystem.temporaryDirectory(&parent, "silk-plan-auth-case")
  return run Effect.ensuring(rootPrecedence(&temporary.path), cleanup(&temporary.path))
}

test effect fn planAuthorizationReadsRootTasksBeforeSourceRoot() -> ()
  ! AssertionError<'static> | FileError | ProjectError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut files = run OsFileSystem.make("/") |> Effect.provideMut<Allocator>(&mut allocator)
  return run checkRootPrecedence()
    |> Effect.provideMut<FileSystem>(&mut files)
    |> Effect.provideMut<Allocator>(&mut allocator)
}
