//! Completion reads names in scope from the syntax and members from what the receiver names,
//! including in a body that is still half typed and does not check.

import lsp.Completion as Completion { Item }
import semantic.ModuleId { InvalidModulePath }
import semantic.Query { Cycle }
import semantic.Semantic { Semantic }
import semantic.SemanticCaseSupport { makeSemantic, module, present }
import semantic.SourceIndex { RevisionMismatch }
import semantic.SourceRevision { Revision }
import semantic.Types { TypeTable, Types }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.text.string { String }
import silk.testing.testing { AssertionError, Testing }
import silk.num.usize

fn library() -> string<'static> {
  return """
pub struct Point {pub x: i32, pub y: i32, hidden: i32}
impl Point {
  pub fn sum(self: &Self) -> i32 {
    return self.x + self.y
  }
}
pub union Shape { Dot, Line { pub length: i32 } }
fn internal() -> i32 {
  return 0
}
pub fn exported() -> i32 {
  return 1
}
"""
}

fn application() -> string<'static> {
  return """
import shape as geometry { Point, Shape }
fn measure<T>(point: &Point, count: i32) -> i32 {
  let total = count
  return point.
}
"""
}

fn statics() -> string<'static> {
  return """
import shape as geometry { Point, Shape }
fn pick() -> i32 {
  let first = Shape.
  let second = geometry.ex
  return 0
}
"""
}

test effect fn completionReadsScopeAndMembers() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run completionClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn completionClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let app = run module("app.silk")
  let other = run module("other.silk")
  let shape = run module("shape.silk")
  let first = run Revision.publish(&Revision.make(), &app, &run present(application()))
  let second = run Revision.publish(&first, &other, &run present(statics()))
  let revision = run Revision.publish(&second, &shape, &run present(library()))
  let mut store = makeSemantic(move revision)
  Semantic.selectEditorTables(&mut store, true)
  let appText = String.utf8Bytes(application())
  let otherText = String.utf8Bytes(statics())

  let returned = within(appText, b"point.\n")
  let everything = run Completion.scope(&mut store, &app, returned, b"")
  run Testing.expect(has(&everything, b"total", 6) && has(&everything, b"count", 6), "a half-typed body's scope holds its bindings and parameters")
  run Testing.expect(has(&everything, b"point", 6), "a parameter whose type is imported is in scope")
  run Testing.expect(has(&everything, b"T", 25), "a generic parameter is in scope")
  run Testing.expect(has(&everything, b"measure", 3), "the module's own declarations are in scope")
  run Testing.expect(has(&everything, b"Point", 22) && has(&everything, b"Shape", 13), "imported members are in scope by what they import")
  run Testing.expect(has(&everything, b"geometry", 9), "a module alias is in scope")
  let typed = run Completion.scope(&mut store, &app, returned, b"to")
  run Testing.expect(List<Item>.length(&typed) == 1 && has(&typed, b"total", 6), "a prefix narrows the scope")

  let members = run Completion.members(&mut store, &app, appText, returned + 5, b"")
  run Testing.expect(
    has(&members, b"x", 5) && has(&members, b"y", 5) && has(&members, b"sum", 2) && !has(&members, b"hidden", 5),
    "a parameter's written type gives its public fields and methods in a body that does not check"
  )

  let variants = run Completion.members(&mut store, &other, otherText, within(otherText, b".\n"), b"")
  run Testing.expect(has(&variants, b"Dot", 20) && has(&variants, b"Line", 20), "a union names its variants")
  let exports = run Completion.members(&mut store, &other, otherText, within(otherText, b".ex"), b"ex")
  run Testing.expect(
    List<Item>.length(&exports) == 1 && has(&exports, b"exported", 3),
    "a module alias lists its public declarations that start with the prefix"
  )
  return ()
}

fn has(items: &List<Item>, label: &[u8], kind: usize) -> bool {
  let listed = List<Item>.asSlice(items)
  let mut at = usize.ZERO
  while at < listed.length {
    if same(Bytes.asSlice(&listed[at].label), label) && listed[at].kind == kind {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

fn within(text: &[u8], needle: &[u8]) -> usize {
  let mut start = usize.ZERO
  while start + needle.length <= text.length {
    if same(Slice.view<u8>(text, start, needle.length), needle) {
      return start
    }
    start = start + usize.ONE
  }
  return usize.MAX
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}
