//! Find references reads every module that spells a name, resolves each written name as hover
//! does, and keeps the ones that name the target; a workspace symbol search lists declarations.

import lexer.Span { Span }
import lsp.References as References { Declared, Found, Listed, Sought, Target }
import semantic.ModuleId { InvalidModulePath, ModuleId }
import semantic.Query { Cycle }
import semantic.Semantic { Semantic }
import semantic.SemanticCaseSupport { makeSemantic, module, present }
import semantic.SourceIndex { RevisionMismatch }
import semantic.SourceRevision { Revision }
import semantic.Types { TypeTable, Types }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.collections.slice { Slice }
import silk.text.string { String }
import silk.testing.testing { AssertionError, Testing }
import silk.num.usize

fn library() -> string<'static> {
  return """
pub struct Point {pub x: i32, pub y: i32}
pub fn origin() -> Point {
  return Point { x: 0, y: 0 }
}
"""
}

fn application() -> string<'static> {
  return """
import shape { Point, origin }
fn norm(point: &Point) -> i32 {
  let total = point.x + point.y
  return total + total
}
fn start() -> i32 {
  let first = origin()
  return norm(&first)
}
"""
}

test effect fn referencesFollowNamesAcrossModules() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run referenceClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn referenceClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let app = run module("app.silk")
  let shape = run module("shape.silk")
  let initial = run Revision.publish(&Revision.make(), &app, &run present(application()))
  let revision = run Revision.publish(&initial, &shape, &run present(library()))
  let mut store = makeSemantic(move revision)
  Semantic.selectEditorTables(&mut store, true)
  let mut modules = List<ModuleId>.make()
  run List<ModuleId>.append(&mut modules, ModuleId.copy(&app))
  run List<ModuleId>.append(&mut modules, ModuleId.copy(&shape))
  let appText = String.utf8Bytes(application())
  let shapeText = String.utf8Bytes(library())

  // A type a header names, found where it is imported, written and declared.
  if let Option<Target>.Some { value: point } = move run References.target(&mut store, &app, within(appText, b"Point) ->")) {
    run Testing.expect(same(Bytes.asSlice(&point.spelling), b"Point"), "a type's target is spelled as it is declared")
    let found = run References.references(&mut store, List<ModuleId>.asSlice(&modules), &point, true)
    run Testing.expect(includes(&found, &app, within(appText, b"Point, origin")), "an import member names the type")
    run Testing.expect(includes(&found, &app, within(appText, b"Point) ->")), "a parameter type names the type")
    run Testing.expect(includes(&found, &shape, within(shapeText, b"Point {pub")), "the declaration's own name is included")
    run Testing.expect(includes(&found, &shape, within(shapeText, b"Point {\n")), "a return type names the type")
    run Testing.expect(includes(&found, &shape, within(shapeText, b"Point { x")), "a struct literal names the type")
    let without = run References.references(&mut store, List<ModuleId>.asSlice(&modules), &point, false)
    run Testing.expect(!includes(&without, &shape, within(shapeText, b"Point {pub")), "the declaration is left out when not asked for")
  } else {
    run Testing.expect(false, "a parameter type is a target")
  }

  // A local, found at its binder and its uses only.
  if let Option<Target>.Some { value: total } = move run References.target(&mut store, &app, within(appText, b"total + total")) {
    let found = run References.references(&mut store, List<ModuleId>.asSlice(&modules), &total, true)
    run Testing.expect(count(&found) == 3, "a local is named by its binder and its two uses")
    run Testing.expect(includes(&found, &app, within(appText, b"total =")), "a local's binder is its declaration")
  } else {
    run Testing.expect(false, "a local use is a target")
  }
  if let Option<Target>.Some { value: binder } = move run References.target(&mut store, &app, within(appText, b"total =")) {
    let found = run References.references(&mut store, List<ModuleId>.asSlice(&modules), &binder, false)
    run Testing.expect(count(&found) == 2, "a cursor on a local's binder finds its uses")
  } else {
    run Testing.expect(false, "a local's binder is a target")
  }

  // A declaration's own name and an import member are targets too.
  if let Option<Target>.Some { value: norm } = move run References.target(&mut store, &app, within(appText, b"norm(point")) {
    let found = run References.references(&mut store, List<ModuleId>.asSlice(&modules), &norm, false)
    run Testing.expect(count(&found) == 1 && includes(&found, &app, within(appText, b"norm(&first")), "a function's name finds its call")
  } else {
    run Testing.expect(false, "a declaration's own name is a target")
  }
  if let Option<Target>.Some { value: origin } = move run References.target(&mut store, &app, within(appText, b"origin }")) {
    let found = run References.references(&mut store, List<ModuleId>.asSlice(&modules), &origin, true)
    run Testing.expect(includes(&found, &shape, within(shapeText, b"origin()")), "an import member's target is the imported declaration")
    run Testing.expect(includes(&found, &app, within(appText, b"origin()")), "a call through the import names it")
  } else {
    run Testing.expect(false, "an import member is a target")
  }

  // A workspace symbol search matches names ignoring case.
  if let Option<Listed>.Some { value: listed } = move run References.declarations(&mut store, &shape, b"poi") {
    let declared = List<Declared>.asSlice(&listed.declared)
    run Testing.expect(
      declared.length == usize.ONE && same(Bytes.asSlice(&declared[0].name), b"Point") && declared[0].kind == 23
        && declared[0].span.start == within(shapeText, b"Point {pub"),
      "a symbol search lists the struct at its name"
    )
  } else {
    run Testing.expect(false, "a module lists its declarations")
  }
  return ()
}

fn includes(found: &List<Found>, module: &ModuleId, start: usize) -> bool {
  let listed = List<Found>.asSlice(found)
  let mut at = usize.ZERO
  while at < listed.length {
    if ModuleId.equals(&listed[at].module, module) {
      let spans = List<Span>.asSlice(&listed[at].spans)
      let mut place = usize.ZERO
      while place < spans.length {
        if spans[place].start == start {
          return true
        }
        place = place + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return false
}

fn count(found: &List<Found>) -> usize {
  let listed = List<Found>.asSlice(found)
  let mut total = usize.ZERO
  let mut at = usize.ZERO
  while at < listed.length {
    total = total + List<Span>.length(&listed[at].spans)
    at = at + usize.ONE
  }
  return total
}

fn within(text: &[u8], needle: &[u8]) -> usize {
  let mut start = usize.ZERO
  while start + needle.length <= text.length {
    if same(Slice.view<u8>(text, start, needle.length), needle) {
      return start
    }
    start = start + usize.ONE
  }
  return usize.MAX
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}
