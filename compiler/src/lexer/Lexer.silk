//! A source-byte lexer that returns tokens through the `Stream` interface.
//!
//! # When to use
//! Use [`Lexer`] to inspect tokens in source order without a token array.
//! Create the lexer with `Lexer.make`, then call `Stream.take` for each token.
//! The source must already be in memory; this module does not read files.
//!
//! # Details
//! The lexer borrows the source and retains whitespace and comments as tokens.
//! Token spans include the start byte offset and exclude the end byte offset.
//! Invalid tokens carry lexical diagnostics, so a consumer can continue after an error.
//! After the source, the stream returns one `Token.EndOfFile`, then `Option.None` on every call.
//!
//! # Gotchas
//! Identifiers use ASCII letters, digits, and underscores. Span offsets count bytes, not Unicode scalars.
//! Literal tokens identify source ranges; they do not contain decoded values.
//! A literal token does not prove that its escapes or UTF-8 bytes are valid.

import lexer.LexicalDiagnostic {LexicalDiagnostic}
import lexer.Span {Span}
import Stream {Stream}
import lexer.Token {Token, TokenKind}
import silk.text.byte_search
import silk.core.option {Option}
import silk.collections.slice {Slice}
import silk.num.i32
import silk.num.u8

/// A token stream over one borrowed, immutable source byte sequence.
///
/// # When to use
///
/// Use when a consumer needs each token in source order, including whitespace and comments.
///
/// # Details
///
/// `Lexer.make` borrows the complete source. `Stream.take` advances through it without a token array or source copy.
/// Tokens contain byte spans and, for invalid input, lexical diagnostics.
/// The lexer does not fail through the Effect error channel or require a provider.
///
/// # Gotchas
///
/// Keep the source alive for the lifetime of the lexer. Tokens contain offsets, not their source text.
/// Empty input still produces one `Token.EndOfFile` before `Option.None`.
/// A literal token does not validate decoded values, escapes, or UTF-8.
pub struct Lexer<'source> {
  // The caller owns these bytes; the lexer only advances its cursor.
  source: &'source [u8],
  // The first unconsumed byte, always at or before source.length.
  cursor: usize,
  eofEmitted: bool,
}

// Each scanner returns one token and the first byte after that token.
// A non-EOF scan must advance beyond its start, including on invalid input.
struct Scanned {
  token: Token,
  end: usize,
  // Why an invalid token is invalid; tokens do not carry it (see `failureAt`).
  failure: Option<LexicalDiagnostic>,
}

enum LiteralCategory {
  Text,
  Bytes,
  Character,
}

// A closed literal includes its closing delimiter in end.
// An unclosed literal stops before a line break or at the source end.
struct Boundary {
  end: usize,
  terminated: bool,
}

// Keep token extent separate from validity so malformed separators stay in one token.
struct DigitRun {
  end: usize,
  digits: bool,
  separated: bool,
}

struct Base {
  radix: u8,
  width: usize,
}

union DurationResult {
  Valid,
  Invalid {diagnostic: LexicalDiagnostic},
}

impl<'source> Lexer<'source> {
  /// Creates a lexer before the first byte without scanning or copying the source.
  ///
  /// # Details
  ///
  /// The returned lexer borrows `source`. Keep its owner alive until the lexer is no longer needed.
  /// Call `Stream.take` with a mutable lexer reference to obtain each token.
  /// Invalid source bytes become diagnostic tokens when read; construction does not validate the source.
  ///
  /// # Gotchas
  ///
  /// For empty input, the first read returns `Token.EndOfFile` at `0..0`.
  /// Later reads return `Option.None`.
  pub fn make(source: &'source [u8]) -> Lexer<'source> {
    return Lexer<'source> {source: source, cursor: 0, eofEmitted: false}
  }
}

// Lookahead uses zero outside the source. Callers compare against nonzero ASCII bytes;
// this helper does not distinguish an actual NUL byte from the source end.
fn byteAtOrZero(source: &[u8], index: usize) -> u8 {
  if index < source.length {
    return source[index]
  }
  return 0
}

fn isWhitespace(byte: u8) -> bool {
  return byte == ' ' || byte == '\t' || byte == '\n' || byte == '\r'
}

// Identifier recognition is deliberately ASCII-only. Non-ASCII source bytes reach
// invalid-token recovery unless they occur inside a literal or comment.
fn isAsciiLetter(byte: u8) -> bool {
  return (byte >= 'A' && byte <= 'Z') || (byte >= 'a' && byte <= 'z')
}

fn isDecimalDigit(byte: u8) -> bool {
  return byte >= '0' && byte <= '9'
}

fn isIdentifierStart(byte: u8) -> bool {
  return byte == '_' || isAsciiLetter(byte)
}

fn isIdentifierContinue(byte: u8) -> bool {
  return isIdentifierStart(byte) || isDecimalDigit(byte)
}

fn hasPair(source: &[u8], index: usize, first: u8, second: u8) -> bool {
  return byteAtOrZero(source, index) == first && byteAtOrZero(source, index + 1) == second
}

fn hasTriple(source: &[u8], index: usize, delimiter: u8) -> bool {
  return hasPair(source, index, delimiter, delimiter) && byteAtOrZero(source, index + 2) == delimiter
}

// Require the whole spelling to match, so a keyword prefix does not split an identifier.
fn matches(source: &[u8], start: usize, end: usize, spelling: &[u8]) -> bool {
  if end - start != spelling.length {
    return false
  }
  let mut index: usize = 0
  while index < spelling.length {
    if source[start + index] != spelling[index] {
      return false
    }
    index = index + 1
  }
  return true
}

fn tokenSpan(start: usize, end: usize) -> Span {
  return Span.make(start, end)
}

fn scanWhitespace(source: &[u8], start: usize) -> Scanned {
  let mut end = start + 1
  while end < source.length && isWhitespace(source[end]) {
    end = end + 1
  }
  let span = tokenSpan(start, end)
  return Scanned {token: Token.make(TokenKind.Whitespace, span), end: end, failure: Option<LexicalDiagnostic>.none()}
}

// The caller has consumed the decision for //, but not its bytes.
// Keep the line break for the next whitespace token. //! and exactly /// introduce
// documentation; four or more initial slashes remain an ordinary line comment.
fn scanComment(source: &[u8], start: usize) -> Scanned {
  let mut end = source.length
  if start + 2 < source.length {
    let rest = Slice.view(source, start + 2, source.length - start - 2)
    if let Option<usize>.Some {value} = move byte_search.find2(rest, '\n', '\r') {
      end = start + 2 + value
    }
  }
  let span = tokenSpan(start, end)
  if byteAtOrZero(source, start + 2) == '!' {
    return Scanned {token: Token.make(TokenKind.ModuleDocComment, span), end: end, failure: Option<LexicalDiagnostic>.none()}
  }
  if byteAtOrZero(source, start + 2) == '/' && byteAtOrZero(source, start + 3) != '/' {
    return Scanned {token: Token.make(TokenKind.DocComment, span), end: end, failure: Option<LexicalDiagnostic>.none()}
  }
  return Scanned {token: Token.make(TokenKind.LineComment, span), end: end, failure: Option<LexicalDiagnostic>.none()}
}

fn scanIdentifierEnd(source: &[u8], start: usize) -> usize {
  let mut end = start + 1
  while end < source.length && isIdentifierContinue(source[end]) {
    end = end + 1
  }
  return end
}

fn keywordToken(source: &[u8], start: usize, end: usize) -> Token {
  let span = tokenSpan(start, end)
  if matches(source, start, end, b"as") {
    return Token.make(TokenKind.AsKeyword, span)
  }
  if matches(source, start, end, b"static") {
    return Token.make(TokenKind.StaticKeyword, span)
  }
  if matches(source, start, end, b"compileError") {
    return Token.make(TokenKind.CompileErrorKeyword, span)
  }
  if matches(source, start, end, b"fn") {
    return Token.make(TokenKind.FnKeyword, span)
  }
  if matches(source, start, end, b"let") {
    return Token.make(TokenKind.LetKeyword, span)
  }
  if matches(source, start, end, b"move") {
    return Token.make(TokenKind.MoveKeyword, span)
  }
  if matches(source, start, end, b"pub") {
    return Token.make(TokenKind.PubKeyword, span)
  }
  if matches(source, start, end, b"return") {
    return Token.make(TokenKind.ReturnKeyword, span)
  }
  if matches(source, start, end, b"import") {
    return Token.make(TokenKind.ImportKeyword, span)
  }
  if matches(source, start, end, b"run") {
    return Token.make(TokenKind.RunKeyword, span)
  }
  if matches(source, start, end, b"fail") {
    return Token.make(TokenKind.FailKeyword, span)
  }
  if matches(source, start, end, b"drop") {
    return Token.make(TokenKind.DropKeyword, span)
  }
  if matches(source, start, end, b"unsafe") {
    return Token.make(TokenKind.UnsafeKeyword, span)
  }
  if matches(source, start, end, b"extern") {
    return Token.make(TokenKind.ExternKeyword, span)
  }
  if matches(source, start, end, b"export") {
    return Token.make(TokenKind.ExportKeyword, span)
  }
  if matches(source, start, end, b"impl") {
    return Token.make(TokenKind.ImplKeyword, span)
  }
  if matches(source, start, end, b"for") {
    return Token.make(TokenKind.ForKeyword, span)
  }
  if matches(source, start, end, b"effect") {
    return Token.make(TokenKind.EffectKeyword, span)
  }
  if matches(source, start, end, b"if") {
    return Token.make(TokenKind.IfKeyword, span)
  }
  if matches(source, start, end, b"else") {
    return Token.make(TokenKind.ElseKeyword, span)
  }
  if matches(source, start, end, b"mut") {
    return Token.make(TokenKind.MutKeyword, span)
  }
  if matches(source, start, end, b"once") {
    return Token.make(TokenKind.OnceKeyword, span)
  }
  if matches(source, start, end, b"match") {
    return Token.make(TokenKind.MatchKeyword, span)
  }
  if matches(source, start, end, b"while") {
    return Token.make(TokenKind.WhileKeyword, span)
  }
  if matches(source, start, end, b"break") {
    return Token.make(TokenKind.BreakKeyword, span)
  }
  if matches(source, start, end, b"continue") {
    return Token.make(TokenKind.ContinueKeyword, span)
  }
  if matches(source, start, end, b"const") {
    return Token.make(TokenKind.ConstKeyword, span)
  }
  if matches(source, start, end, b"param") {
    return Token.make(TokenKind.ParamKeyword, span)
  }
  if matches(source, start, end, b"struct") {
    return Token.make(TokenKind.StructKeyword, span)
  }
  if matches(source, start, end, b"tuple") {
    return Token.make(TokenKind.TupleKeyword, span)
  }
  if matches(source, start, end, b"enum") {
    return Token.make(TokenKind.EnumKeyword, span)
  }
  if matches(source, start, end, b"union") {
    return Token.make(TokenKind.UnionKeyword, span)
  }
  if matches(source, start, end, b"type") {
    return Token.make(TokenKind.TypeKeyword, span)
  }
  if matches(source, start, end, b"service") {
    return Token.make(TokenKind.ServiceKeyword, span)
  }
  if matches(source, start, end, b"interface") {
    return Token.make(TokenKind.InterfaceKeyword, span)
  }
  if matches(source, start, end, b"role") {
    return Token.make(TokenKind.RoleKeyword, span)
  }
  if matches(source, start, end, b"true") {
    return Token.make(TokenKind.TrueKeyword, span)
  }
  if matches(source, start, end, b"false") {
    return Token.make(TokenKind.FalseKeyword, span)
  }
  return Token.make(TokenKind.Identifier, span)
}

fn isPunctuation(byte: u8) -> bool {
  return byte == '(' || byte == ')' || byte == '{' || byte == '}' || byte == '[' || byte == ']' || byte == ':' || byte == ';' || byte == ',' || byte == '=' || byte == '-' || byte == '+' || byte == '*' || byte == '/' || byte == '%' || byte == '!' || byte == '?' || byte == '@' || byte == '#' || byte == '<' || byte == '>' || byte == '|' || byte == '&' || byte == '^' || byte == '~' || byte == '.'
}

// The caller has established isPunctuation. Test three bytes, then two, then one
// to preserve the longest operator. The final dot case depends on that precondition.
fn scanPunctuation(source: &[u8], start: usize) -> Scanned {
  if hasTriple(source, start, '.') {
    let end = start + 3
    let span = tokenSpan(start, end)
    return Scanned {token: Token.make(TokenKind.Ellipsis, span), end: end, failure: Option<LexicalDiagnostic>.none()}
  }
  let two = start + 2
  let compoundSpan = tokenSpan(start, two)
  if hasPair(source, start, '-', '>') {
    return Scanned {token: Token.make(TokenKind.Arrow, compoundSpan), end: two, failure: Option<LexicalDiagnostic>.none()}
  }
  if hasPair(source, start, '=', '=') {
    return Scanned {token: Token.make(TokenKind.EqualEqual, compoundSpan), end: two, failure: Option<LexicalDiagnostic>.none()}
  }
  if hasPair(source, start, '=', '>') {
    return Scanned {token: Token.make(TokenKind.FatArrow, compoundSpan), end: two, failure: Option<LexicalDiagnostic>.none()}
  }
  if hasPair(source, start, '!', '=') {
    return Scanned {token: Token.make(TokenKind.BangEqual, compoundSpan), end: two, failure: Option<LexicalDiagnostic>.none()}
  }
  if hasPair(source, start, '<', '=') {
    return Scanned {token: Token.make(TokenKind.LessEqual, compoundSpan), end: two, failure: Option<LexicalDiagnostic>.none()}
  }
  if hasPair(source, start, '>', '=') {
    return Scanned {token: Token.make(TokenKind.GreaterEqual, compoundSpan), end: two, failure: Option<LexicalDiagnostic>.none()}
  }
  if hasPair(source, start, '|', '>') {
    return Scanned {token: Token.make(TokenKind.PipeGreater, compoundSpan), end: two, failure: Option<LexicalDiagnostic>.none()}
  }
  if hasPair(source, start, '|', '|') {
    return Scanned {token: Token.make(TokenKind.PipePipe, compoundSpan), end: two, failure: Option<LexicalDiagnostic>.none()}
  }
  if hasPair(source, start, '&', '&') {
    return Scanned {token: Token.make(TokenKind.AmpersandAmpersand, compoundSpan), end: two, failure: Option<LexicalDiagnostic>.none()}
  }
  if hasPair(source, start, '.', '.') {
    return Scanned {token: Token.make(TokenKind.DotDot, compoundSpan), end: two, failure: Option<LexicalDiagnostic>.none()}
  }

  let end = start + 1
  let span = tokenSpan(start, end)
  let byte = source[start]
  if byte == '(' {
    return Scanned {token: Token.make(TokenKind.LeftParenthesis, span), end: end, failure: Option<LexicalDiagnostic>.none()}
  }
  if byte == ')' {
    return Scanned {token: Token.make(TokenKind.RightParenthesis, span), end: end, failure: Option<LexicalDiagnostic>.none()}
  }
  if byte == '{' {
    return Scanned {token: Token.make(TokenKind.LeftBrace, span), end: end, failure: Option<LexicalDiagnostic>.none()}
  }
  if byte == '}' {
    return Scanned {token: Token.make(TokenKind.RightBrace, span), end: end, failure: Option<LexicalDiagnostic>.none()}
  }
  if byte == '[' {
    return Scanned {token: Token.make(TokenKind.LeftBracket, span), end: end, failure: Option<LexicalDiagnostic>.none()}
  }
  if byte == ']' {
    return Scanned {token: Token.make(TokenKind.RightBracket, span), end: end, failure: Option<LexicalDiagnostic>.none()}
  }
  if byte == ':' {
    return Scanned {token: Token.make(TokenKind.Colon, span), end: end, failure: Option<LexicalDiagnostic>.none()}
  }
  if byte == ';' {
    return Scanned {token: Token.make(TokenKind.Semicolon, span), end: end, failure: Option<LexicalDiagnostic>.none()}
  }
  if byte == ',' {
    return Scanned {token: Token.make(TokenKind.Comma, span), end: end, failure: Option<LexicalDiagnostic>.none()}
  }
  if byte == '=' {
    return Scanned {token: Token.make(TokenKind.Equals, span), end: end, failure: Option<LexicalDiagnostic>.none()}
  }
  if byte == '-' {
    return Scanned {token: Token.make(TokenKind.Minus, span), end: end, failure: Option<LexicalDiagnostic>.none()}
  }
  if byte == '+' {
    return Scanned {token: Token.make(TokenKind.Plus, span), end: end, failure: Option<LexicalDiagnostic>.none()}
  }
  if byte == '*' {
    return Scanned {token: Token.make(TokenKind.Star, span), end: end, failure: Option<LexicalDiagnostic>.none()}
  }
  if byte == '/' {
    return Scanned {token: Token.make(TokenKind.Slash, span), end: end, failure: Option<LexicalDiagnostic>.none()}
  }
  if byte == '%' {
    return Scanned {token: Token.make(TokenKind.Percent, span), end: end, failure: Option<LexicalDiagnostic>.none()}
  }
  if byte == '!' {
    return Scanned {token: Token.make(TokenKind.Bang, span), end: end, failure: Option<LexicalDiagnostic>.none()}
  }
  if byte == '?' {
    return Scanned {token: Token.make(TokenKind.Question, span), end: end, failure: Option<LexicalDiagnostic>.none()}
  }
  if byte == '@' {
    return Scanned {token: Token.make(TokenKind.At, span), end: end, failure: Option<LexicalDiagnostic>.none()}
  }
  if byte == '#' {
    return Scanned {token: Token.make(TokenKind.Hash, span), end: end, failure: Option<LexicalDiagnostic>.none()}
  }
  if byte == '<' {
    return Scanned {token: Token.make(TokenKind.Less, span), end: end, failure: Option<LexicalDiagnostic>.none()}
  }
  if byte == '>' {
    return Scanned {token: Token.make(TokenKind.Greater, span), end: end, failure: Option<LexicalDiagnostic>.none()}
  }
  if byte == '|' {
    return Scanned {token: Token.make(TokenKind.Pipe, span), end: end, failure: Option<LexicalDiagnostic>.none()}
  }
  if byte == '&' {
    return Scanned {token: Token.make(TokenKind.Ampersand, span), end: end, failure: Option<LexicalDiagnostic>.none()}
  }
  if byte == '^' {
    return Scanned {token: Token.make(TokenKind.Caret, span), end: end, failure: Option<LexicalDiagnostic>.none()}
  }
  if byte == '~' {
    return Scanned {token: Token.make(TokenKind.Tilde, span), end: end, failure: Option<LexicalDiagnostic>.none()}
  }
  return Scanned {token: Token.make(TokenKind.Dot, span), end: end, failure: Option<LexicalDiagnostic>.none()}
}

// Locate the token boundary without decoding its body. Width is one or three.
// A backslash hides the next byte only in escaped forms. A single-delimiter
// literal cannot cross a line break, even when a backslash precedes that break.
fn literalBoundary(
  source: &[u8],
  contentStart: usize,
  delimiter: u8,
  delimiterWidth: usize,
  raw: bool,
) -> Boundary {
  let mut index = contentStart
  while index < source.length {
    let byte = source[index]
    if delimiterWidth == 1 && (byte == '\n' || byte == '\r') {
      return Boundary {end: index, terminated: false}
    }
    if byte == delimiter {
      if delimiterWidth == 1 {
        return Boundary {end: index + 1, terminated: true}
      }
      if hasTriple(source, index, delimiter) {
        return Boundary {end: index + 3, terminated: true}
      }
      index = index + 1
    } else {
      if !raw && byte == '\\' && index + 1 < source.length {
        let escaped = source[index + 1]
        if delimiterWidth == 1 && (escaped == '\n' || escaped == '\r') {
          index = index + 1
        } else {
          index = index + 2
        }
      } else {
        index = index + 1
      }
    }
  }
  return Boundary {end: source.length, terminated: false}
}

// Skip the continuation bytes that follow a non-escape scalar's first byte.
fn continuationEnd(source: &[u8], start: usize, end: usize) -> usize {
  let mut index = start
  while index < end {
    let byte = source[index]
    if byte < 128 || byte > 191 {
      break
    }
    index = index + 1
  }
  return index
}

// Skip one escape spelling that begins at `start`: a braced `u` escape, a two-digit `x` escape,
// or any other two-byte escape.
fn escapeEnd(source: &[u8], start: usize, end: usize) -> usize {
  let escaped = byteAtOrZero(source, start + 1)
  if escaped == 'u' && byteAtOrZero(source, start + 2) == '{' {
    let mut index = start + 3
    while index < end {
      if source[index] == '}' {
        break
      }
      index = index + 1
    }
    if index < end {
      index = index + 1
    }
    return index
  }
  if escaped == 'x' {
    return start + 4
  }
  return start + 2
}

// Count character-body units without allocating decoded text. For valid UTF-8,
// continuation bytes belong to the preceding scalar. Escape spellings count as
// one unit. This is a scalar-count check, not UTF-8 or escape validation.
fn scalarCount(source: &[u8], start: usize, end: usize) -> usize {
  let mut index = start
  let mut scalars: usize = 0
  while index < end {
    scalars = scalars + 1
    if source[index] != '\\' {
      index = continuationEnd(source, index + 1, end)
    } else {
      index = escapeEnd(source, index, end)
    }
  }
  return scalars
}

// Find the full token span before checking the character-body count.
// An unterminated body takes precedence over a scalar-count diagnostic.
fn scanLiteral(
  source: &[u8],
  start: usize,
  modifierWidth: usize,
  delimiterWidth: usize,
  delimiter: u8,
  category: LiteralCategory,
  raw: bool,
) -> Scanned {
  let contentStart = start + modifierWidth + delimiterWidth
  let boundary = literalBoundary(source, contentStart, delimiter, delimiterWidth, raw)
  let span = tokenSpan(start, boundary.end)
  let modifier = tokenSpan(start, start + modifierWidth)
  if !boundary.terminated {
    let diagnostic = LexicalDiagnostic.UnterminatedStaticLiteral {
      modifier: modifier,
      delimiter: delimiter,
      delimiterWidth: delimiterWidth,
      span: span,
    }
    return Scanned {
      token: Token.make(TokenKind.InvalidStaticLiteral, span),
      end: boundary.end,
      failure: Option<LexicalDiagnostic>.some(move diagnostic),
    }
  }
  if category == LiteralCategory.Character {
    let count = scalarCount(source, contentStart, boundary.end - delimiterWidth)
    if count != 1 {
      let diagnostic = LexicalDiagnostic.CharacterLiteralScalarCount {scalars: count, span: span}
      return Scanned {
        token: Token.make(TokenKind.InvalidStaticLiteral, span),
        end: boundary.end,
        failure: Option<LexicalDiagnostic>.some(move diagnostic),
      }
    }
  }
  let token = match category {
    LiteralCategory.Text => Token.make(TokenKind.TextLiteral, span)
    LiteralCategory.Bytes => Token.make(TokenKind.ByteStringLiteral, span)
    LiteralCategory.Character => Token.make(TokenKind.CharLiteral, span)
  }
  return Scanned {token: move token, end: boundary.end, failure: Option<LexicalDiagnostic>.none()}
}

// Consume an unknown modifier and its quoted body together for recovery.
// The modifier diagnostic remains primary even if the body has no closing quote.
fn scanUnknownLiteral(source: &[u8], start: usize, modifierEnd: usize) -> Scanned {
  let mut delimiterWidth: usize = 1
  if hasTriple(source, modifierEnd, '"') {
    delimiterWidth = 3
  }
  let boundary = literalBoundary(source, modifierEnd + delimiterWidth, '"', delimiterWidth, false)
  let span = tokenSpan(start, boundary.end)
  let diagnostic = LexicalDiagnostic.UnknownLiteralModifier {
    modifier: tokenSpan(start, modifierEnd),
    span: span,
  }
  return Scanned {
    token: Token.make(TokenKind.InvalidStaticLiteral, span),
    end: boundary.end,
    failure: Option<LexicalDiagnostic>.some(move diagnostic),
  }
}

// The caller has established a supported literal start. Apostrophes select
// characters; b selects bytes; r selects raw text; an unprefixed quote selects text.
fn scanRecognizedLiteral(source: &[u8], start: usize) -> Scanned {
  let byte = source[start]
  if byte == '\'' {
    return scanLiteral(source, start, 0, 1, '\'', LiteralCategory.Character, false)
  }
  if byte == '"' {
    let mut width: usize = 1
    if hasTriple(source, start, '"') {
      width = 3
    }
    return scanLiteral(source, start, 0, width, '"', LiteralCategory.Text, false)
  }
  let mut width: usize = 1
  if hasTriple(source, start + 1, '"') {
    width = 3
  }
  if byte == 'b' {
    return scanLiteral(source, start, 1, width, '"', LiteralCategory.Bytes, false)
  }
  return scanLiteral(source, start, 1, width, '"', LiteralCategory.Text, true)
}

fn isRecognizedLiteralStart(source: &[u8], start: usize) -> bool {
  let byte = byteAtOrZero(source, start)
  return byte == '"' || byte == '\'' || ((byte == 'b' || byte == 'r') && byteAtOrZero(
    source,
    start + 1,
  ) == '"')
}

// A recognized prefix consumes two bytes. Decimal input has no prefix.
// Only these four radices reach isBaseDigit.
fn baseAt(source: &[u8], start: usize) -> Base {
  if byteAtOrZero(source, start) != '0' {
    return Base {radix: 10, width: 0}
  }
  let second = byteAtOrZero(source, start + 1)
  if second == 'b' || second == 'B' {
    return Base {radix: 2, width: 2}
  }
  if second == 'o' || second == 'O' {
    return Base {radix: 8, width: 2}
  }
  if second == 'x' || second == 'X' {
    return Base {radix: 16, width: 2}
  }
  return Base {radix: 10, width: 0}
}

fn isBaseDigit(radix: u8, byte: u8) -> bool {
  if radix == 2 {
    return byte == '0' || byte == '1'
  }
  if radix == 8 {
    return byte >= '0' && byte <= '7'
  }
  if radix == 10 {
    return isDecimalDigit(byte)
  }
  return isDecimalDigit(byte) || (byte >= 'A' && byte <= 'F') || (byte >= 'a' && byte <= 'f')
}

// Consume digits and underscores before reporting validity. An underscore must
// have a digit on both sides; a run can also contain no digits at all.
fn scanDigitRun(source: &[u8], radix: u8, start: usize) -> DigitRun {
  let mut end = start
  let mut digits = false
  let mut separated = true
  let mut afterSeparator = false
  while end < source.length {
    let byte = source[end]
    if isBaseDigit(radix, byte) {
      digits = true
      afterSeparator = false
      end = end + 1
    } else {
      if byte != '_' {
        break
      }
      if end == start || afterSeparator {
        separated = false
      }
      afterSeparator = true
      end = end + 1
    }
  }
  if afterSeparator {
    separated = false
  }
  return DigitRun {end: end, digits: digits, separated: separated}
}

// Keep the identifier-shaped suffix in one duration candidate. Validation then
// reports a focused diagnostic without splitting the malformed token.
fn durationCandidateEnd(source: &[u8], start: usize) -> usize {
  let mut end = start
  while end < source.length && isIdentifierContinue(source[end]) {
    end = end + 1
  }
  return end
}

// Ranks order units from weeks to nanoseconds. A larger rank means a smaller unit;
// -1 denotes an unknown spelling and must be rejected before a bit shift.
fn unitRank(source: &[u8], start: usize, end: usize) -> i32 {
  if matches(source, start, end, b"w") {
    return 0
  }
  if matches(source, start, end, b"d") {
    return 1
  }
  if matches(source, start, end, b"h") {
    return 2
  }
  if matches(source, start, end, b"m") {
    return 3
  }
  if matches(source, start, end, b"s") {
    return 4
  }
  if matches(source, start, end, b"ms") {
    return 5
  }
  if matches(source, start, end, b"us") {
    return 6
  }
  if matches(source, start, end, b"ns") {
    return 7
  }
  return -1
}

// Only components after the first use these limits: days < 7, hours < 24,
// minutes and seconds < 60, and each subsecond component < 1000.
fn subordinateMaximum(rank: i32) -> usize {
  if rank == 1 {
    return 6
  }
  if rank == 2 {
    return 23
  }
  if rank == 3 || rank == 4 {
    return 59
  }
  return 999
}

// The caller supplies decimal digits and separators with a maximum of at most 999.
// Stop once the partial value exceeds that limit, before another multiplication
// can overflow. The first duration component does not use this bounded check.
fn amountExceeds(source: &[u8], start: usize, end: usize, maximum: usize) -> bool {
  let mut value: usize = 0
  let mut index = start
  while index < end {
    let byte = source[index]
    if byte != '_' {
      if value > maximum {
        return true
      }
      value = value * 10 + (byte - '0'
        |> u8.toUsize)
    }
    index = index + 1
  }
  return value > maximum
}

fn amountIsZero(source: &[u8], start: usize, end: usize) -> bool {
  let mut index = start
  while index < end {
    let byte = source[index]
    if byte != '_' && byte != '0' {
      return false
    }
    index = index + 1
  }
  return true
}

// Exclude a known unit suffix from the amount diagnostic, testing two letters first.
// Otherwise exclude trailing letters, or retain at least the first invalid byte.
fn invalidAmountEnd(source: &[u8], start: usize, end: usize) -> usize {
  if start + 2 <= end {
    let twoStart = end - 1 - 1
    if unitRank(source, twoStart, end) >= 0 {
      return twoStart
    }
  }
  if start + 1 <= end {
    let oneStart = end - 1
    if unitRank(source, oneStart, end) >= 0 {
      return oneStart
    }
  }
  let mut suffixStart = end
  while suffixStart > start {
    if isAsciiLetter(source[suffixStart - 1]) == false {
      break
    }
    suffixStart = suffixStart - 1
  }
  if suffixStart > start {
    return suffixStart
  }
  return start + 1
}

// Whether `source[start..end]` spells a numeric type, such as `u8`, `i64`, `usize` or `f64`.
fn numericTypeSuffix(source: &[u8], start: usize, end: usize) -> bool {
  return matches(source, start, end, b"u8") || matches(source, start, end, b"u16") || matches(source, start, end, b"u32")
    || matches(source, start, end, b"u64") || matches(source, start, end, b"u128") || matches(source, start, end, b"usize")
    || matches(source, start, end, b"i8") || matches(source, start, end, b"i16") || matches(source, start, end, b"i32")
    || matches(source, start, end, b"i64") || matches(source, start, end, b"i128") || matches(source, start, end, b"isize")
    || matches(source, start, end, b"f32") || matches(source, start, end, b"f64")
}

// Validate components from left to right and return the first diagnostic.
// This checks duration syntax, unit order, and subordinate limits; it does not
// calculate a total duration or check the first amount against a storage type.
fn parseDuration(source: &[u8], start: usize, end: usize) -> DurationResult {
  if byteAtOrZero(source, start) == '0' {
    let second = byteAtOrZero(source, start + 1)
    if second == 'x' || second == 'X' || second == 'b' || second == 'B' || second == 'o' || second == 'O' {
      let span = tokenSpan(start, invalidAmountEnd(source, start, end))
      return DurationResult.Invalid {
        diagnostic: LexicalDiagnostic.InvalidDurationAmount {span: span},
      }
    }
  }

  // Each canonical unit owns one bit, indexed by its checked rank (0 through 7).
  let mut seen: i32 = 0
  let mut index = start
  let mut previousRank = -1
  let mut previousUnit = tokenSpan(start, start)
  let mut component: usize = 0
  while index < end {
    let componentStart = index
    let digits = scanDigitRun(source, 10, index)
    index = digits.end
    if !digits.digits || !digits.separated {
      let span = tokenSpan(componentStart, digits.end)
      return DurationResult.Invalid {
        diagnostic: LexicalDiagnostic.InvalidDigitSeparator {span: span},
      }
    }
    let amountEnd = index
    if !(source
      |> byteAtOrZero(index)
      |> isAsciiLetter) {
      let span = tokenSpan(componentStart, invalidAmountEnd(source, componentStart, end))
      return DurationResult.Invalid {
        diagnostic: LexicalDiagnostic.InvalidDurationAmount {span: span},
      }
    }
    let unitStart = index
    while index < end && isAsciiLetter(source[index]) {
      index = index + 1
    }
    let unitEnd = index
    let rank = unitRank(source, unitStart, unitEnd)
    let unitSpan = tokenSpan(unitStart, unitEnd)
    if rank < 0 {
      // `7u8` is a type suffix from another language, not a duration; it names the literal.
      if component == 0 && numericTypeSuffix(source, unitStart, end) {
        return DurationResult.Invalid {
          diagnostic: LexicalDiagnostic.LiteralTypeSuffix {
            suffix: tokenSpan(unitStart, end),
            amount: tokenSpan(componentStart, amountEnd),
            span: tokenSpan(start, end),
          },
        }
      }
      // Reject exponent-like or base-prefix-like amounts before unknown-unit recovery.
      let exponentOrPrefix = matches(source, unitStart, unitEnd, b"e") || matches(
        source,
        unitStart,
        unitEnd,
        b"E",
      ) || (amountIsZero(source, componentStart, amountEnd) && (matches(
        source,
        unitStart,
        unitEnd,
        b"x",
      ) || matches(source, unitStart, unitEnd, b"X") || matches(source, unitStart, unitEnd, b"b") || matches(
        source,
        unitStart,
        unitEnd,
        b"B",
      ) || matches(source, unitStart, unitEnd, b"o") || matches(source, unitStart, unitEnd, b"O")))
      if exponentOrPrefix && index < end && isDecimalDigit(source[index]) {
        let span = tokenSpan(componentStart, invalidAmountEnd(source, componentStart, end))
        return DurationResult.Invalid {
          diagnostic: LexicalDiagnostic.InvalidDurationAmount {span: span},
        }
      }
      return DurationResult.Invalid {
        diagnostic: LexicalDiagnostic.UnknownDurationUnit {spelling: unitSpan, span: unitSpan},
      }
    }
    let unitBit = i32.shiftLeft(1, rank)
    if (seen & unitBit) != 0 {
      return DurationResult.Invalid {
        diagnostic: LexicalDiagnostic.RepeatedDurationUnit {unit: unitSpan, span: unitSpan},
      }
    }
    if previousRank >= 0 && rank < previousRank {
      return DurationResult.Invalid {
        diagnostic: LexicalDiagnostic.OutOfOrderDurationUnit {
          unit: unitSpan,
          previous: previousUnit,
          span: unitSpan,
        },
      }
    }
    if component > 0 {
      let maximum = subordinateMaximum(rank)
      if amountExceeds(source, componentStart, amountEnd, maximum) {
        let span = tokenSpan(componentStart, unitEnd)
        return DurationResult.Invalid {
          diagnostic: LexicalDiagnostic.SubordinateDurationOutOfRange {
            unit: unitSpan,
            amount: tokenSpan(componentStart, amountEnd),
            maximum: maximum,
            span: span,
          },
        }
      }
    }
    seen = seen | unitBit
    previousRank = rank
    previousUnit = unitSpan
    component = component + 1
    if index < end && isDecimalDigit(source[index]) == false {
      let span = tokenSpan(index, invalidAmountEnd(source, index, end))
      return DurationResult.Invalid {
        diagnostic: LexicalDiagnostic.InvalidDurationAmount {span: span},
      }
    }
  }
  return DurationResult.Valid
}

fn scanDuration(source: &[u8], start: usize, numericEnd: usize) -> Scanned {
  let end = durationCandidateEnd(source, numericEnd)
  let span = tokenSpan(start, end)
  return match move parseDuration(source, start, end) {
    DurationResult.Valid => Scanned {token: Token.make(TokenKind.DurationLiteral, span), end: end, failure: Option<LexicalDiagnostic>.none()}
    DurationResult.Invalid {diagnostic} => Scanned {
      token: Token.make(TokenKind.InvalidDurationLiteral, span),
      end: end,
      failure: Option<LexicalDiagnostic>.some(move diagnostic),
    }
  }
}

fn invalidNumber(start: usize, end: usize, diagnostic: LexicalDiagnostic) -> Scanned {
  let span = tokenSpan(start, end)
  return Scanned {token: Token.make(TokenKind.Invalid, span), end: end, failure: Option<LexicalDiagnostic>.some(move diagnostic)}
}

// Recognize the numeric extent before deciding whether an alphabetic suffix makes
// the token a duration candidate. DecimalInteger also represents base-prefixed integers.
fn scanNumber(source: &[u8], start: usize) -> Scanned {
  let base = baseAt(source, start)
  if base.radix != 10 {
    let digits = scanDigitRun(source, base.radix, start + base.width)
    // A prefixed amount is never a duration: a following digit or letter is outside the base,
    // and the literal runs through the rest of that word.
    if isIdentifierContinue(byteAtOrZero(source, digits.end)) {
      let end = durationCandidateEnd(source, digits.end)
      let diagnostic = LexicalDiagnostic.InvalidBaseDigit {
        radix: base.radix,
        digit: tokenSpan(digits.end, digits.end + 1),
        span: tokenSpan(start, end),
      }
      return invalidNumber(start, end, move diagnostic)
    }
    let span = tokenSpan(start, digits.end)
    if !digits.digits {
      let diagnostic = LexicalDiagnostic.MissingBaseDigits {radix: base.radix, span: span}
      return invalidNumber(start, digits.end, move diagnostic)
    }
    if !digits.separated {
      let diagnostic = LexicalDiagnostic.InvalidDigitSeparator {span: span}
      return invalidNumber(start, digits.end, move diagnostic)
    }
    return Scanned {token: Token.make(TokenKind.DecimalInteger, span), end: digits.end, failure: Option<LexicalDiagnostic>.none()}
  }

  let whole = scanDigitRun(source, 10, start)
  let mut end = whole.end
  let mut separated = whole.separated
  let mut floating = false
  // A fraction requires a digit. Leave a trailing dot or range operator unconsumed.
  if byteAtOrZero(source, end) == '.' && byteAtOrZero(source, end + 1) != '.' {
    let fraction = scanDigitRun(source, 10, end + 1)
    if fraction.digits {
      floating = true
      end = fraction.end
      separated = separated && fraction.separated
    }
  }
  let mut exponentDigits = true
  let exponent = byteAtOrZero(source, end)
  if exponent == 'e' || exponent == 'E' {
    floating = true
    end = end + 1
    let sign = byteAtOrZero(source, end)
    if sign == '+' || sign == '-' {
      end = end + 1
    }
    let exponentRun = scanDigitRun(source, 10, end)
    end = exponentRun.end
    exponentDigits = exponentRun.digits
    separated = separated && exponentRun.separated
  }
  if (source
    |> byteAtOrZero(end)
    |> isAsciiLetter) {
    // `1.5f32` is a float with a type suffix from another language, reported like `7u8`.
    let candidateEnd = durationCandidateEnd(source, end)
    if floating && separated && exponentDigits && numericTypeSuffix(source, end, candidateEnd) {
      let span = tokenSpan(start, candidateEnd)
      let diagnostic = LexicalDiagnostic.LiteralTypeSuffix {
        suffix: tokenSpan(end, candidateEnd),
        amount: tokenSpan(start, end),
        span: span,
      }
      return Scanned {
        token: Token.make(TokenKind.InvalidDurationLiteral, span),
        end: candidateEnd,
        failure: Option<LexicalDiagnostic>.some(move diagnostic),
      }
    }
    return source
      |> scanDuration(start, end)
  }
  let span = tokenSpan(start, end)
  if !separated {
    let diagnostic = LexicalDiagnostic.InvalidDigitSeparator {span: span}
    return invalidNumber(start, end, move diagnostic)
  }
  if !exponentDigits {
    let diagnostic = LexicalDiagnostic.MissingExponentDigits {span: span}
    return invalidNumber(start, end, move diagnostic)
  }
  if floating {
    return Scanned {token: Token.make(TokenKind.DecimalFloat, span), end: end, failure: Option<LexicalDiagnostic>.none()}
  }
  return Scanned {token: Token.make(TokenKind.DecimalInteger, span), end: end, failure: Option<LexicalDiagnostic>.none()}
}

fn isSupportedTokenStart(source: &[u8], index: usize) -> bool {
  let byte = byteAtOrZero(source, index)
  return isWhitespace(byte) || isIdentifierStart(byte) || isDecimalDigit(byte) || isRecognizedLiteralStart(
    source,
    index,
  ) || isPunctuation(byte)
}

// Consume at least one byte, then stop before the next supported token start.
// One diagnostic covers the unsupported run and leaves the next token untouched.
fn scanInvalid(source: &[u8], start: usize) -> Scanned {
  let mut end = start + 1
  while end < source.length {
    if isSupportedTokenStart(source, end) {
      break
    }
    end = end + 1
  }
  let span = tokenSpan(start, end)
  let diagnostic = LexicalDiagnostic.UnsupportedBytes {span: span}
  return Scanned {token: Token.make(TokenKind.Invalid, span), end: end, failure: Option<LexicalDiagnostic>.some(move diagnostic)}
}

/// Why the token that starts at `start` in `source` is invalid, or none for a valid token.
///
/// # Details
///
/// Scanning depends only on the bytes from `start` on, so rescanning an `Invalid`,
/// `InvalidStaticLiteral` or `InvalidDurationLiteral` token at its span's start recovers the exact
/// diagnostic the lexer found. Tokens do not carry it: every token would pay for the largest one.
pub fn failureAt(source: &[u8], start: usize) -> Option<LexicalDiagnostic> {
  if start >= source.length { return Option<LexicalDiagnostic>.none() }
  let Scanned {token: ignoredToken, end: ignoredEnd, failure} = move scanToken(source, start)
  return move failure
}

// Dispatch order resolves overlapping starts: comments before slash punctuation,
// lifetimes before character literals, and literal modifiers before identifiers.
// The caller guarantees start < source.length.
fn scanToken(source: &[u8], start: usize) -> Scanned {
  let byte = source[start]
  // A UTF-8 byte order mark, which some editors write at the start of a file, is whitespace.
  if start == 0 && source.length >= 3 && byte == 239 && source[1] == 187 && source[2] == 191 {
    return Scanned {token: Token.make(TokenKind.Whitespace, tokenSpan(0, 3)), end: 3, failure: Option<LexicalDiagnostic>.none()}
  }
  if isWhitespace(byte) {
    return source
      |> scanWhitespace(start)
  }
  if hasPair(source, start, '/', '/') {
    return source
      |> scanComment(start)
  }

  // A closing apostrophe or backslash keeps this in character-literal recovery.
  // Otherwise the apostrophe and identifier form a lifetime token.
  if byte == '\'' && (source
    |> byteAtOrZero(start + 1)
    |> isIdentifierStart) {
    let lifetimeEnd = scanIdentifierEnd(source, start + 1)
    let boundary = byteAtOrZero(source, lifetimeEnd)
    if boundary != '\'' && boundary != '\\' {
      let span = tokenSpan(start, lifetimeEnd)
      return Scanned {token: Token.make(TokenKind.Lifetime, span), end: lifetimeEnd, failure: Option<LexicalDiagnostic>.none()}
    }
  }

  if isRecognizedLiteralStart(source, start) {
    return source
      |> scanRecognizedLiteral(start)
  }
  if isIdentifierStart(byte) {
    let end = scanIdentifierEnd(source, start)
    if byteAtOrZero(source, end) == '"' {
      return source
        |> scanUnknownLiteral(start, end)
    }
    return Scanned {token: keywordToken(source, start, end), end: end, failure: Option<LexicalDiagnostic>.none()}
  }
  if isDecimalDigit(byte) {
    return source
      |> scanNumber(start)
  }
  if isPunctuation(byte) {
    return source
      |> scanPunctuation(start)
  }
  return source
    |> scanInvalid(start)
}

impl<'source> Stream<Token, never ? never> for Lexer<'source> {
  /// Returns the next token, one final EOF token, or `Option.None` after EOF.
  ///
  /// # Details
  ///
  /// Each read advances past one token, including whitespace, comments, and invalid input.
  /// Invalid tokens carry lexical diagnostics instead of an Effect failure.
  /// Token spans count source bytes and exclude their end offset.
  /// No allocator or other provider is required.
  ///
  /// # Gotchas
  ///
  /// The EOF token has an empty span at the source length, including for empty input.
  /// Only reads after that token return `Option.None`; all further reads also return `Option.None`.
  effect fn take(self: &mut Self) -> Option<Token> {
    if self.cursor < self.source.length {
      let Scanned {token, end, failure: ignoredFailure} = move scanToken(self.source, self.cursor)
      self.cursor = end
      return move token
        |> Option.some
    }
    if !self.eofEmitted {
      self.eofEmitted = true
      let span = tokenSpan(self.source.length, self.source.length)
      return Token.make(TokenKind.EndOfFile, span)
        |> Option.some
    }
    return Option<Token>.none()
  }
}
