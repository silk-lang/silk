import diagnostic.Catalog as Catalog {Code}
import lexer.Span {Span}
import silk.format {Format}
import silk.option {Option}
import silk.core.ownership {Copy}
import silk.io.writer {Writer, WriterError}

/// A lexical failure attached to an invalid token.
pub union LexicalDiagnostic {
  UnsupportedBytes {pub span: Span},
  UnknownLiteralModifier {pub modifier: Span, pub span: Span},
  UnterminatedStaticLiteral {
    pub modifier: Span,
    pub delimiter: u8,
    pub delimiterWidth: usize,
    pub span: Span,
  },
  MissingBaseDigits {pub radix: u8, pub span: Span},
  InvalidDigitSeparator {pub span: Span},
  MissingExponentDigits {pub span: Span},
  CharacterLiteralScalarCount {pub scalars: usize, pub span: Span},
  InvalidDurationAmount {pub span: Span},
  UnknownDurationUnit {pub spelling: Span, pub span: Span},
  RepeatedDurationUnit {pub unit: Span, pub span: Span},
  OutOfOrderDurationUnit {pub unit: Span, pub previous: Span, pub span: Span},
  SubordinateDurationOutOfRange {
    pub unit: Span,
    pub amount: Span,
    pub maximum: usize,
    pub span: Span,
  },
  InvalidBaseDigit {pub radix: u8, pub digit: Span, pub span: Span},
  LiteralTypeSuffix {pub suffix: Span, pub amount: Span, pub span: Span},
}

impl Copy for LexicalDiagnostic {}

effect fn writeLine(code: Code, reason: string, span: Span) -> () ! WriterError ? &mut Writer {
  run Writer.writeString("diagnostic ")
  run Writer.writeString(Catalog.spelling(code))
  run Writer.writeString(" ")
  run Writer.writeString(reason)
  run Writer.writeString(" ")
  run Format.display(&span.start)
  run Writer.writeString("..")
  run Format.display(&span.end)
  return run Writer.writeString("\n")
}

impl LexicalDiagnostic {
  /// The span of the `index`th source text this failure's message names, in variant order: the
  /// modifier of a literal, the spelling of an unknown unit, the unit and then the previous unit
  /// or amount of a duration component, or a type suffix and then its amount; none past the last.
  pub fn holeSpan(diagnostic: LexicalDiagnostic, index: usize) -> Option<Span> {
    return match move diagnostic {
      LexicalDiagnostic.UnknownLiteralModifier {modifier, span: _} => onlyHole(modifier, index)
      LexicalDiagnostic.UnterminatedStaticLiteral {
        modifier,
        delimiter: ignoredDelimiter,
        delimiterWidth: ignoredDelimiterWidth,
        span: ignoredSpan,
      } => onlyHole(modifier, index)
      LexicalDiagnostic.UnknownDurationUnit {spelling, span: _} => onlyHole(spelling, index)
      LexicalDiagnostic.RepeatedDurationUnit {unit, span: _} => onlyHole(unit, index)
      LexicalDiagnostic.OutOfOrderDurationUnit {unit, previous, span: _} => pairHole(unit, previous, index)
      LexicalDiagnostic.SubordinateDurationOutOfRange {unit, amount, maximum: _, span: ignoredSpan} => pairHole(unit, amount, index)
      LexicalDiagnostic.InvalidBaseDigit {radix: _, digit, span: ignoredSpan} => onlyHole(digit, index)
      LexicalDiagnostic.LiteralTypeSuffix {suffix, amount, span: _} => pairHole(suffix, amount, index)
      _ => Option<Span>.none()
    }
  }
  /// The focused source span of this lexical failure.
  pub fn span(diagnostic: LexicalDiagnostic) -> Span {
    return match move diagnostic {
      LexicalDiagnostic.UnsupportedBytes {span} => span
      LexicalDiagnostic.UnknownLiteralModifier {modifier: _, span} => span
      LexicalDiagnostic.UnterminatedStaticLiteral {
        modifier: ignoredModifier,
        delimiter: ignoredDelimiter,
        delimiterWidth: ignoredDelimiterWidth,
        span,
      } => span
      LexicalDiagnostic.MissingBaseDigits {radix: _, span} => span
      LexicalDiagnostic.InvalidDigitSeparator {span} => span
      LexicalDiagnostic.MissingExponentDigits {span} => span
      LexicalDiagnostic.CharacterLiteralScalarCount {scalars: _, span} => span
      LexicalDiagnostic.InvalidDurationAmount {span} => span
      LexicalDiagnostic.UnknownDurationUnit {spelling: _, span} => span
      LexicalDiagnostic.RepeatedDurationUnit {unit: _, span} => span
      LexicalDiagnostic.OutOfOrderDurationUnit {unit: ignoredUnit, previous: ignoredPrevious, span} => span
      LexicalDiagnostic.SubordinateDurationOutOfRange {
        unit: ignoredUnit,
        amount: ignoredAmount,
        maximum: ignoredMaximum,
        span,
      } => span
      LexicalDiagnostic.InvalidBaseDigit {radix: ignoredRadix, digit: ignoredDigit, span} => span
      LexicalDiagnostic.LiteralTypeSuffix {suffix: ignoredSuffix, amount: ignoredAmount, span} => span
    }
  }

  /// The stable diagnostic code of this lexical failure.
  pub fn code(diagnostic: LexicalDiagnostic) -> Code {
    return match move diagnostic {
      LexicalDiagnostic.UnsupportedBytes {..} => Code.UnsupportedBytes
      LexicalDiagnostic.UnknownLiteralModifier {..} => Code.UnknownLiteralModifier
      LexicalDiagnostic.UnterminatedStaticLiteral {..} => Code.UnterminatedStaticLiteral
      LexicalDiagnostic.MissingBaseDigits {..} => Code.MissingBaseDigits
      LexicalDiagnostic.InvalidDigitSeparator {..} => Code.InvalidDigitSeparator
      LexicalDiagnostic.MissingExponentDigits {..} => Code.MissingExponentDigits
      LexicalDiagnostic.CharacterLiteralScalarCount {..} => Code.CharacterLiteralScalarCount
      LexicalDiagnostic.InvalidDurationAmount {..} => Code.InvalidDurationAmount
      LexicalDiagnostic.UnknownDurationUnit {..} => Code.UnknownDurationUnit
      LexicalDiagnostic.RepeatedDurationUnit {..} => Code.RepeatedDurationUnit
      LexicalDiagnostic.OutOfOrderDurationUnit {..} => Code.OutOfOrderDurationUnit
      LexicalDiagnostic.SubordinateDurationOutOfRange {..} => Code.SubordinateDurationOutOfRange
      LexicalDiagnostic.InvalidBaseDigit {..} => Code.InvalidBaseDigit
      LexicalDiagnostic.LiteralTypeSuffix {..} => Code.LiteralTypeSuffix
    }
  }

  /// Writes the stable code, reason tag, and focused source span.
  pub effect fn write(diagnostic: LexicalDiagnostic) -> () ! WriterError ? &mut Writer {
    return match move diagnostic {
      LexicalDiagnostic.UnsupportedBytes {span} => run writeLine(Code.UnsupportedBytes, "UnsupportedBytes", span)
      LexicalDiagnostic.UnknownLiteralModifier {modifier: _, span} => run writeLine(
        Code.UnknownLiteralModifier,
        "UnknownLiteralModifier",
        span,
      )
      LexicalDiagnostic.UnterminatedStaticLiteral {
        modifier: ignoredModifier,
        delimiter: ignoredDelimiter,
        delimiterWidth: ignoredDelimiterWidth,
        span,
      } => run writeLine(Code.UnterminatedStaticLiteral, "UnterminatedStaticLiteral", span)
      LexicalDiagnostic.MissingBaseDigits {radix: _, span} => run writeLine(
        Code.MissingBaseDigits,
        "MissingBaseDigits",
        span,
      )
      LexicalDiagnostic.InvalidDigitSeparator {span} => run writeLine(
        Code.InvalidDigitSeparator,
        "InvalidDigitSeparator",
        span,
      )
      LexicalDiagnostic.MissingExponentDigits {span} => run writeLine(
        Code.MissingExponentDigits,
        "MissingExponentDigits",
        span,
      )
      LexicalDiagnostic.CharacterLiteralScalarCount {scalars: _, span} => run writeLine(
        Code.CharacterLiteralScalarCount,
        "CharacterLiteralScalarCount",
        span,
      )
      LexicalDiagnostic.InvalidDurationAmount {span} => run writeLine(
        Code.InvalidDurationAmount,
        "InvalidDurationAmount",
        span,
      )
      LexicalDiagnostic.UnknownDurationUnit {spelling: _, span} => run writeLine(
        Code.UnknownDurationUnit,
        "UnknownDurationUnit",
        span,
      )
      LexicalDiagnostic.RepeatedDurationUnit {unit: _, span} => run writeLine(
        Code.RepeatedDurationUnit,
        "RepeatedDurationUnit",
        span,
      )
      LexicalDiagnostic.OutOfOrderDurationUnit {unit: ignoredUnit, previous: ignoredPrevious, span} => run writeLine(
        Code.OutOfOrderDurationUnit,
        "OutOfOrderDurationUnit",
        span,
      )
      LexicalDiagnostic.SubordinateDurationOutOfRange {
        unit: ignoredUnit,
        amount: ignoredAmount,
        maximum: ignoredMaximum,
        span,
      } => run writeLine(Code.SubordinateDurationOutOfRange, "SubordinateDurationOutOfRange", span)
      LexicalDiagnostic.InvalidBaseDigit {radix: ignoredRadix, digit: ignoredDigit, span} => run writeLine(
        Code.InvalidBaseDigit,
        "InvalidBaseDigit",
        span,
      )
      LexicalDiagnostic.LiteralTypeSuffix {suffix: ignoredSuffix, amount: ignoredAmount, span} => run writeLine(
        Code.LiteralTypeSuffix,
        "LiteralTypeSuffix",
        span,
      )
    }
  }
}

fn onlyHole(first: Span, index: usize) -> Option<Span> {
  if index == 0 { return Option<Span>.some(first) }
  return Option<Span>.none()
}

fn pairHole(first: Span, second: Span, index: usize) -> Option<Span> {
  if index == 0 { return Option<Span>.some(first) }
  if index == 1 { return Option<Span>.some(second) }
  return Option<Span>.none()
}
