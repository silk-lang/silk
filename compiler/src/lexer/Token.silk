import lexer.LexicalDiagnostic {LexicalDiagnostic}
import lexer.Span {Span}
import silk.text.format {Format}
import silk.core.option {Option}
import silk.core.ownership {Copy}
import silk.io.writer {Writer, WriterError}
import silk.num.u32
import silk.num.usize

/// The lexical category of one token.
pub enum TokenKind {
  /// Whitespace between significant tokens.
  Whitespace,
  /// A non-documentation line comment.
  LineComment,
  /// A documentation comment for the next declaration.
  DocComment,
  /// A documentation comment for the current module.
  ModuleDocComment,
  /// An identifier.
  Identifier,
  /// A lifetime name.
  Lifetime,
  /// A decimal integer literal.
  DecimalInteger,
  /// A decimal floating-point literal.
  DecimalFloat,
  /// A duration literal.
  DurationLiteral,
  /// An invalid duration literal.
  InvalidDurationLiteral,
  /// A text literal.
  TextLiteral,
  /// A byte-string literal.
  ByteStringLiteral,
  /// A character literal.
  CharLiteral,
  /// An invalid static literal.
  InvalidStaticLiteral,
  /// The `static` keyword.
  StaticKeyword,
  /// The `compileError` keyword.
  CompileErrorKeyword,
  /// The `pub` keyword.
  PubKeyword,
  /// The `struct` keyword.
  StructKeyword,
  /// The `tuple` keyword.
  TupleKeyword,
  /// The `enum` keyword.
  EnumKeyword,
  /// The `union` keyword.
  UnionKeyword,
  /// The `type` keyword.
  TypeKeyword,
  /// The `service` keyword.
  ServiceKeyword,
  /// The `interface` keyword.
  InterfaceKeyword,
  /// The `role` keyword.
  RoleKeyword,
  /// The `Effect` keyword.
  EffectKeyword,
  /// The `fn` keyword.
  FnKeyword,
  /// The `run` keyword.
  RunKeyword,
  /// The `fail` keyword.
  FailKeyword,
  /// The `drop` keyword.
  DropKeyword,
  /// The `unsafe` keyword.
  UnsafeKeyword,
  /// The `extern` keyword.
  ExternKeyword,
  /// The `export` keyword.
  ExportKeyword,
  /// The `impl` keyword.
  ImplKeyword,
  /// The `for` keyword.
  ForKeyword,
  /// The `return` keyword.
  ReturnKeyword,
  /// The `import` keyword.
  ImportKeyword,
  /// The `as` keyword.
  AsKeyword,
  /// The `let` keyword.
  LetKeyword,
  /// The `const` keyword.
  ConstKeyword,
  /// The `param` keyword.
  ParamKeyword,
  /// The `mut` keyword.
  MutKeyword,
  /// The `once` keyword.
  OnceKeyword,
  /// The `move` keyword.
  MoveKeyword,
  /// The `match` keyword.
  MatchKeyword,
  /// The `if` keyword.
  IfKeyword,
  /// The `else` keyword.
  ElseKeyword,
  /// The `while` keyword.
  WhileKeyword,
  /// The `break` keyword.
  BreakKeyword,
  /// The `continue` keyword.
  ContinueKeyword,
  /// The `true` keyword.
  TrueKeyword,
  /// The `false` keyword.
  FalseKeyword,
  /// A left parenthesis.
  LeftParenthesis,
  /// A right parenthesis.
  RightParenthesis,
  /// A left brace.
  LeftBrace,
  /// A right brace.
  RightBrace,
  /// A left bracket.
  LeftBracket,
  /// A right bracket.
  RightBracket,
  /// A colon.
  Colon,
  /// A semicolon.
  Semicolon,
  /// A comma.
  Comma,
  /// An equals sign.
  Equals,
  /// An equality operator.
  EqualEqual,
  /// A fat arrow.
  FatArrow,
  /// A minus sign.
  Minus,
  /// A plus sign.
  Plus,
  /// A star.
  Star,
  /// A slash.
  Slash,
  /// A percent sign.
  Percent,
  /// An exclamation mark.
  Bang,
  /// An inequality operator.
  BangEqual,
  /// A question mark.
  Question,
  /// An at sign, which starts a directive.
  At,
  /// A number sign, which starts a reference type's role marker.
  Hash,
  /// A less-than sign.
  Less,
  /// A less-than-or-equal operator.
  LessEqual,
  /// A greater-than sign.
  Greater,
  /// A greater-than-or-equal operator.
  GreaterEqual,
  /// A pipe.
  Pipe,
  /// A pipeline operator.
  PipeGreater,
  /// A logical-or operator.
  PipePipe,
  /// An ampersand.
  Ampersand,
  /// A logical-and operator.
  AmpersandAmpersand,
  /// A caret.
  Caret,
  /// A tilde.
  Tilde,
  /// A dot.
  Dot,
  /// Two dots.
  DotDot,
  /// An ellipsis.
  Ellipsis,
  /// A thin arrow.
  Arrow,
  /// An invalid token.
  Invalid,
  /// The end of the source file.
  EndOfFile,
}

/// One lossless lexical item: its category and its half-open byte span. The offsets are 32-bit
/// so that a token is 12 bytes; every token of every module stays in memory for a whole
/// compilation.
pub struct Token {
  kind: TokenKind,
  start: u32,
  end: u32,
}

impl Copy for Token {}

/// Returns the lexical category of a token.
pub fn kind(token: Token) -> TokenKind {
  return token.kind
}

/// Returns the half-open source byte range of a token.
pub fn span(token: Token) -> Span {
  return Span.make(u32.toUsize(token.start), u32.toUsize(token.end))
}

/// How the bootstrap names a token kind in a diagnostic: its spelling in backticks, or its role.
pub fn describe(kind: TokenKind) -> string<'static> {
  return match kind {
    TokenKind.Whitespace => "whitespace"
    TokenKind.LineComment => "line comment"
    TokenKind.DocComment => "documentation comment"
    TokenKind.ModuleDocComment => "module documentation comment"
    TokenKind.Identifier => "identifier"
    TokenKind.Lifetime => "lifetime name"
    TokenKind.DecimalInteger => "decimal integer"
    TokenKind.DecimalFloat => "decimal floating-point literal"
    TokenKind.DurationLiteral => "duration literal"
    TokenKind.InvalidDurationLiteral => "invalid duration literal"
    TokenKind.TextLiteral => "text literal"
    TokenKind.ByteStringLiteral => "byte-string literal"
    TokenKind.CharLiteral => "character literal"
    TokenKind.InvalidStaticLiteral => "invalid static literal"
    TokenKind.StaticKeyword => "`static`"
    TokenKind.CompileErrorKeyword => "`compileError`"
    TokenKind.PubKeyword => "`pub`"
    TokenKind.StructKeyword => "`struct`"
    TokenKind.TupleKeyword => "`tuple`"
    TokenKind.EnumKeyword => "`enum`"
    TokenKind.UnionKeyword => "`union`"
    TokenKind.TypeKeyword => "`type`"
    TokenKind.ServiceKeyword => "`service`"
    TokenKind.InterfaceKeyword => "`interface`"
    TokenKind.RoleKeyword => "`role`"
    TokenKind.EffectKeyword => "`effect`"
    TokenKind.FnKeyword => "`fn`"
    TokenKind.RunKeyword => "`run`"
    TokenKind.FailKeyword => "`fail`"
    TokenKind.DropKeyword => "`drop`"
    TokenKind.UnsafeKeyword => "`unsafe`"
    TokenKind.ExternKeyword => "`extern`"
    TokenKind.ExportKeyword => "`export`"
    TokenKind.ImplKeyword => "`impl`"
    TokenKind.ForKeyword => "`for`"
    TokenKind.ReturnKeyword => "`return`"
    TokenKind.ImportKeyword => "`import`"
    TokenKind.AsKeyword => "`as`"
    TokenKind.LetKeyword => "`let`"
    TokenKind.ConstKeyword => "`const`"
    TokenKind.ParamKeyword => "`param`"
    TokenKind.MutKeyword => "`mut`"
    TokenKind.OnceKeyword => "`once`"
    TokenKind.MoveKeyword => "`move`"
    TokenKind.MatchKeyword => "`match`"
    TokenKind.IfKeyword => "`if`"
    TokenKind.ElseKeyword => "`else`"
    TokenKind.WhileKeyword => "`while`"
    TokenKind.BreakKeyword => "`break`"
    TokenKind.ContinueKeyword => "`continue`"
    TokenKind.TrueKeyword => "`true`"
    TokenKind.FalseKeyword => "`false`"
    TokenKind.LeftParenthesis => "`(`"
    TokenKind.RightParenthesis => "`)`"
    TokenKind.LeftBrace => "`{`"
    TokenKind.RightBrace => "`}`"
    TokenKind.LeftBracket => "`[`"
    TokenKind.RightBracket => "`]`"
    TokenKind.Colon => "`:`"
    TokenKind.Semicolon => "`;`"
    TokenKind.Comma => "`,`"
    TokenKind.Equals => "`=`"
    TokenKind.EqualEqual => "`==`"
    TokenKind.FatArrow => "`=>`"
    TokenKind.Minus => "`-`"
    TokenKind.Plus => "`+`"
    TokenKind.Star => "`*`"
    TokenKind.Slash => "`/`"
    TokenKind.Percent => "`%`"
    TokenKind.Bang => "`!`"
    TokenKind.BangEqual => "`!=`"
    TokenKind.Question => "`?`"
    TokenKind.At => "`@`"
    TokenKind.Hash => "`#`"
    TokenKind.Less => "`<`"
    TokenKind.LessEqual => "`<=`"
    TokenKind.Greater => "`>`"
    TokenKind.GreaterEqual => "`>=`"
    TokenKind.Pipe => "`|`"
    TokenKind.PipeGreater => "`|>`"
    TokenKind.PipePipe => "`||`"
    TokenKind.Ampersand => "`&`"
    TokenKind.AmpersandAmpersand => "`&&`"
    TokenKind.Caret => "`^`"
    TokenKind.Tilde => "`~`"
    TokenKind.Dot => "`.`"
    TokenKind.DotDot => "`..`"
    TokenKind.Ellipsis => "`...`"
    TokenKind.Arrow => "`->`"
    TokenKind.Invalid => "invalid byte"
    TokenKind.EndOfFile => "end of file"
  }
}

effect fn writeLine(name: string, span: Span) -> () ! WriterError ? &mut Writer {
  run Writer.writeString(name)
  run Writer.writeString(" ")
  run Format.display(&span.start)
  run Writer.writeString("..")
  run Format.display(&span.end)
  return run Writer.writeString("\n")
}

effect fn writeInvalid(name: string, span: Span, failure: Option<LexicalDiagnostic>) -> ()
! WriterError
? &mut Writer {
  run writeLine(name, span)
  if let Option<LexicalDiagnostic>.Some {value} = move failure { return run LexicalDiagnostic.write(move value) }
  return ()
}

impl Token {
  /// A token of category `kind` over `span`.
  pub fn make(kind: TokenKind, span: Span) -> Token {
    return Token {kind: kind, start: usize.toU32(span.start), end: usize.toU32(span.end)}
  }

  /// Writes one token and, for an invalid variant, `failure`: the diagnostic `lexer.Lexer.failureAt`
  /// recovers for it.
  pub effect fn write(token: Token, failure: Option<LexicalDiagnostic>) -> () ! WriterError ? &mut Writer {
    let written = span(token)
    return match token.kind {
      TokenKind.Whitespace => run writeLine("Whitespace", written)
      TokenKind.LineComment => run writeLine("LineComment", written)
      TokenKind.DocComment => run writeLine("DocComment", written)
      TokenKind.ModuleDocComment => run writeLine("ModuleDocComment", written)
      TokenKind.Identifier => run writeLine("Identifier", written)
      TokenKind.Lifetime => run writeLine("Lifetime", written)
      TokenKind.DecimalInteger => run writeLine("DecimalInteger", written)
      TokenKind.DecimalFloat => run writeLine("DecimalFloat", written)
      TokenKind.DurationLiteral => run writeLine("DurationLiteral", written)
      TokenKind.InvalidDurationLiteral => run writeInvalid(
        "InvalidDurationLiteral",
        written,
        move failure,
      )
      TokenKind.TextLiteral => run writeLine("TextLiteral", written)
      TokenKind.ByteStringLiteral => run writeLine("ByteStringLiteral", written)
      TokenKind.CharLiteral => run writeLine("CharLiteral", written)
      TokenKind.InvalidStaticLiteral => run writeInvalid(
        "InvalidStaticLiteral",
        written,
        move failure,
      )
      TokenKind.StaticKeyword => run writeLine("StaticKeyword", written)
      TokenKind.CompileErrorKeyword => run writeLine("CompileErrorKeyword", written)
      TokenKind.PubKeyword => run writeLine("PubKeyword", written)
      TokenKind.StructKeyword => run writeLine("StructKeyword", written)
      TokenKind.TupleKeyword => run writeLine("TupleKeyword", written)
      TokenKind.EnumKeyword => run writeLine("EnumKeyword", written)
      TokenKind.UnionKeyword => run writeLine("UnionKeyword", written)
      TokenKind.TypeKeyword => run writeLine("TypeKeyword", written)
      TokenKind.ServiceKeyword => run writeLine("ServiceKeyword", written)
      TokenKind.InterfaceKeyword => run writeLine("InterfaceKeyword", written)
      TokenKind.RoleKeyword => run writeLine("RoleKeyword", written)
      TokenKind.EffectKeyword => run writeLine("EffectKeyword", written)
      TokenKind.FnKeyword => run writeLine("FnKeyword", written)
      TokenKind.RunKeyword => run writeLine("RunKeyword", written)
      TokenKind.FailKeyword => run writeLine("FailKeyword", written)
      TokenKind.DropKeyword => run writeLine("DropKeyword", written)
      TokenKind.UnsafeKeyword => run writeLine("UnsafeKeyword", written)
      TokenKind.ExternKeyword => run writeLine("ExternKeyword", written)
      TokenKind.ExportKeyword => run writeLine("ExportKeyword", written)
      TokenKind.ImplKeyword => run writeLine("ImplKeyword", written)
      TokenKind.ForKeyword => run writeLine("ForKeyword", written)
      TokenKind.ReturnKeyword => run writeLine("ReturnKeyword", written)
      TokenKind.ImportKeyword => run writeLine("ImportKeyword", written)
      TokenKind.AsKeyword => run writeLine("AsKeyword", written)
      TokenKind.LetKeyword => run writeLine("LetKeyword", written)
      TokenKind.ConstKeyword => run writeLine("ConstKeyword", written)
      TokenKind.ParamKeyword => run writeLine("ParamKeyword", written)
      TokenKind.MutKeyword => run writeLine("MutKeyword", written)
      TokenKind.OnceKeyword => run writeLine("OnceKeyword", written)
      TokenKind.MoveKeyword => run writeLine("MoveKeyword", written)
      TokenKind.MatchKeyword => run writeLine("MatchKeyword", written)
      TokenKind.IfKeyword => run writeLine("IfKeyword", written)
      TokenKind.ElseKeyword => run writeLine("ElseKeyword", written)
      TokenKind.WhileKeyword => run writeLine("WhileKeyword", written)
      TokenKind.BreakKeyword => run writeLine("BreakKeyword", written)
      TokenKind.ContinueKeyword => run writeLine("ContinueKeyword", written)
      TokenKind.TrueKeyword => run writeLine("TrueKeyword", written)
      TokenKind.FalseKeyword => run writeLine("FalseKeyword", written)
      TokenKind.LeftParenthesis => run writeLine("LeftParenthesis", written)
      TokenKind.RightParenthesis => run writeLine("RightParenthesis", written)
      TokenKind.LeftBrace => run writeLine("LeftBrace", written)
      TokenKind.RightBrace => run writeLine("RightBrace", written)
      TokenKind.LeftBracket => run writeLine("LeftBracket", written)
      TokenKind.RightBracket => run writeLine("RightBracket", written)
      TokenKind.Colon => run writeLine("Colon", written)
      TokenKind.Semicolon => run writeLine("Semicolon", written)
      TokenKind.Comma => run writeLine("Comma", written)
      TokenKind.Equals => run writeLine("Equals", written)
      TokenKind.EqualEqual => run writeLine("EqualEqual", written)
      TokenKind.FatArrow => run writeLine("FatArrow", written)
      TokenKind.Minus => run writeLine("Minus", written)
      TokenKind.Plus => run writeLine("Plus", written)
      TokenKind.Star => run writeLine("Star", written)
      TokenKind.Slash => run writeLine("Slash", written)
      TokenKind.Percent => run writeLine("Percent", written)
      TokenKind.Bang => run writeLine("Bang", written)
      TokenKind.BangEqual => run writeLine("BangEqual", written)
      TokenKind.Question => run writeLine("Question", written)
      TokenKind.At => run writeLine("At", written)
      TokenKind.Hash => run writeLine("Hash", written)
      TokenKind.Less => run writeLine("Less", written)
      TokenKind.LessEqual => run writeLine("LessEqual", written)
      TokenKind.Greater => run writeLine("Greater", written)
      TokenKind.GreaterEqual => run writeLine("GreaterEqual", written)
      TokenKind.Pipe => run writeLine("Pipe", written)
      TokenKind.PipeGreater => run writeLine("PipeGreater", written)
      TokenKind.PipePipe => run writeLine("PipePipe", written)
      TokenKind.Ampersand => run writeLine("Ampersand", written)
      TokenKind.AmpersandAmpersand => run writeLine("AmpersandAmpersand", written)
      TokenKind.Caret => run writeLine("Caret", written)
      TokenKind.Tilde => run writeLine("Tilde", written)
      TokenKind.Dot => run writeLine("Dot", written)
      TokenKind.DotDot => run writeLine("DotDot", written)
      TokenKind.Ellipsis => run writeLine("Ellipsis", written)
      TokenKind.Arrow => run writeLine("Arrow", written)
      TokenKind.Invalid => run writeInvalid("Invalid", written, move failure)
      TokenKind.EndOfFile => run writeLine("EndOfFile", written)
    }
  }
}
