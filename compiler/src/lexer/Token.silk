import lexer.LexicalDiagnostic {LexicalDiagnostic}
import lexer.Span {Span}
import silk.format {Format}
import silk.ownership { Copy }
import silk.writer {Writer, WriterError}

/// The lexical category of one token.
pub enum TokenKind {
  /// Whitespace between significant tokens.
  Whitespace,
  /// A non-documentation line comment.
  LineComment,
  /// A documentation comment for the next declaration.
  DocComment,
  /// A documentation comment for the current module.
  ModuleDocComment,
  /// An identifier.
  Identifier,
  /// A lifetime name.
  Lifetime,
  /// A decimal integer literal.
  DecimalInteger,
  /// A decimal floating-point literal.
  DecimalFloat,
  /// A duration literal.
  DurationLiteral,
  /// An invalid duration literal.
  InvalidDurationLiteral,
  /// A text literal.
  TextLiteral,
  /// A byte-string literal.
  ByteStringLiteral,
  /// A character literal.
  CharLiteral,
  /// An invalid static literal.
  InvalidStaticLiteral,
  /// The `static` keyword.
  StaticKeyword,
  /// The `compileError` keyword.
  CompileErrorKeyword,
  /// The `pub` keyword.
  PubKeyword,
  /// The `struct` keyword.
  StructKeyword,
  /// The `tuple` keyword.
  TupleKeyword,
  /// The `enum` keyword.
  EnumKeyword,
  /// The `union` keyword.
  UnionKeyword,
  /// The `type` keyword.
  TypeKeyword,
  /// The `service` keyword.
  ServiceKeyword,
  /// The `interface` keyword.
  InterfaceKeyword,
  /// The `role` keyword.
  RoleKeyword,
  /// The `Effect` keyword.
  EffectKeyword,
  /// The `fn` keyword.
  FnKeyword,
  /// The `run` keyword.
  RunKeyword,
  /// The `fail` keyword.
  FailKeyword,
  /// The `drop` keyword.
  DropKeyword,
  /// The `unsafe` keyword.
  UnsafeKeyword,
  /// The `extern` keyword.
  ExternKeyword,
  /// The `export` keyword.
  ExportKeyword,
  /// The `impl` keyword.
  ImplKeyword,
  /// The `for` keyword.
  ForKeyword,
  /// The `return` keyword.
  ReturnKeyword,
  /// The `import` keyword.
  ImportKeyword,
  /// The `as` keyword.
  AsKeyword,
  /// The `let` keyword.
  LetKeyword,
  /// The `const` keyword.
  ConstKeyword,
  /// The `param` keyword.
  ParamKeyword,
  /// The `mut` keyword.
  MutKeyword,
  /// The `once` keyword.
  OnceKeyword,
  /// The `move` keyword.
  MoveKeyword,
  /// The `match` keyword.
  MatchKeyword,
  /// The `if` keyword.
  IfKeyword,
  /// The `else` keyword.
  ElseKeyword,
  /// The `while` keyword.
  WhileKeyword,
  /// The `break` keyword.
  BreakKeyword,
  /// The `continue` keyword.
  ContinueKeyword,
  /// The `true` keyword.
  TrueKeyword,
  /// The `false` keyword.
  FalseKeyword,
  /// A left parenthesis.
  LeftParenthesis,
  /// A right parenthesis.
  RightParenthesis,
  /// A left brace.
  LeftBrace,
  /// A right brace.
  RightBrace,
  /// A left bracket.
  LeftBracket,
  /// A right bracket.
  RightBracket,
  /// A colon.
  Colon,
  /// A semicolon.
  Semicolon,
  /// A comma.
  Comma,
  /// An equals sign.
  Equals,
  /// An equality operator.
  EqualEqual,
  /// A fat arrow.
  FatArrow,
  /// A minus sign.
  Minus,
  /// A plus sign.
  Plus,
  /// A star.
  Star,
  /// A slash.
  Slash,
  /// A percent sign.
  Percent,
  /// An exclamation mark.
  Bang,
  /// An inequality operator.
  BangEqual,
  /// A question mark.
  Question,
  /// An at sign.
  At,
  /// A less-than sign.
  Less,
  /// A less-than-or-equal operator.
  LessEqual,
  /// A greater-than sign.
  Greater,
  /// A greater-than-or-equal operator.
  GreaterEqual,
  /// A pipe.
  Pipe,
  /// A pipeline operator.
  PipeGreater,
  /// A logical-or operator.
  PipePipe,
  /// An ampersand.
  Ampersand,
  /// A logical-and operator.
  AmpersandAmpersand,
  /// A caret.
  Caret,
  /// A tilde.
  Tilde,
  /// A dot.
  Dot,
  /// Two dots.
  DotDot,
  /// An ellipsis.
  Ellipsis,
  /// A thin arrow.
  Arrow,
  /// An invalid token.
  Invalid,
  /// The end of the source file.
  EndOfFile,
}

/// One lossless lexical item. Every variant carries its half-open byte span.
pub union Token {
  Whitespace {pub span: Span},
  LineComment {pub span: Span},
  DocComment {pub span: Span},
  ModuleDocComment {pub span: Span},
  Identifier {pub span: Span},
  Lifetime {pub span: Span},
  DecimalInteger {pub span: Span},
  DecimalFloat {pub span: Span},
  DurationLiteral {pub span: Span},
  InvalidDurationLiteral {pub span: Span, pub diagnostic: LexicalDiagnostic},
  TextLiteral {pub span: Span},
  ByteStringLiteral {pub span: Span},
  CharLiteral {pub span: Span},
  InvalidStaticLiteral {pub span: Span, pub diagnostic: LexicalDiagnostic},
  StaticKeyword {pub span: Span},
  CompileErrorKeyword {pub span: Span},
  PubKeyword {pub span: Span},
  StructKeyword {pub span: Span},
  TupleKeyword {pub span: Span},
  EnumKeyword {pub span: Span},
  UnionKeyword {pub span: Span},
  TypeKeyword {pub span: Span},
  ServiceKeyword {pub span: Span},
  InterfaceKeyword {pub span: Span},
  RoleKeyword {pub span: Span},
  EffectKeyword {pub span: Span},
  FnKeyword {pub span: Span},
  RunKeyword {pub span: Span},
  FailKeyword {pub span: Span},
  DropKeyword {pub span: Span},
  UnsafeKeyword {pub span: Span},
  ExternKeyword {pub span: Span},
  ExportKeyword {pub span: Span},
  ImplKeyword {pub span: Span},
  ForKeyword {pub span: Span},
  ReturnKeyword {pub span: Span},
  ImportKeyword {pub span: Span},
  AsKeyword {pub span: Span},
  LetKeyword {pub span: Span},
  ConstKeyword {pub span: Span},
  ParamKeyword {pub span: Span},
  MutKeyword {pub span: Span},
  OnceKeyword {pub span: Span},
  MoveKeyword {pub span: Span},
  MatchKeyword {pub span: Span},
  IfKeyword {pub span: Span},
  ElseKeyword {pub span: Span},
  WhileKeyword {pub span: Span},
  BreakKeyword {pub span: Span},
  ContinueKeyword {pub span: Span},
  TrueKeyword {pub span: Span},
  FalseKeyword {pub span: Span},
  LeftParenthesis {pub span: Span},
  RightParenthesis {pub span: Span},
  LeftBrace {pub span: Span},
  RightBrace {pub span: Span},
  LeftBracket {pub span: Span},
  RightBracket {pub span: Span},
  Colon {pub span: Span},
  Semicolon {pub span: Span},
  Comma {pub span: Span},
  Equals {pub span: Span},
  EqualEqual {pub span: Span},
  FatArrow {pub span: Span},
  Minus {pub span: Span},
  Plus {pub span: Span},
  Star {pub span: Span},
  Slash {pub span: Span},
  Percent {pub span: Span},
  Bang {pub span: Span},
  BangEqual {pub span: Span},
  Question {pub span: Span},
  At {pub span: Span},
  Less {pub span: Span},
  LessEqual {pub span: Span},
  Greater {pub span: Span},
  GreaterEqual {pub span: Span},
  Pipe {pub span: Span},
  PipeGreater {pub span: Span},
  PipePipe {pub span: Span},
  Ampersand {pub span: Span},
  AmpersandAmpersand {pub span: Span},
  Caret {pub span: Span},
  Tilde {pub span: Span},
  Dot {pub span: Span},
  DotDot {pub span: Span},
  Ellipsis {pub span: Span},
  Arrow {pub span: Span},
  Invalid {pub span: Span, pub diagnostic: LexicalDiagnostic},
  EndOfFile {pub span: Span},
}

impl Copy for Token {}

/// Returns the lexical category of a token.
pub fn kind(token: Token) -> TokenKind {
  return match move token {
    Token.Whitespace {span: _} => TokenKind.Whitespace
    Token.LineComment {span: _} => TokenKind.LineComment
    Token.DocComment {span: _} => TokenKind.DocComment
    Token.ModuleDocComment {span: _} => TokenKind.ModuleDocComment
    Token.Identifier {span: _} => TokenKind.Identifier
    Token.Lifetime {span: _} => TokenKind.Lifetime
    Token.DecimalInteger {span: _} => TokenKind.DecimalInteger
    Token.DecimalFloat {span: _} => TokenKind.DecimalFloat
    Token.DurationLiteral {span: _} => TokenKind.DurationLiteral
    Token.InvalidDurationLiteral {span: ignoredSpan, diagnostic: ignoredDiagnostic} => TokenKind.InvalidDurationLiteral
    Token.TextLiteral {span: _} => TokenKind.TextLiteral
    Token.ByteStringLiteral {span: _} => TokenKind.ByteStringLiteral
    Token.CharLiteral {span: _} => TokenKind.CharLiteral
    Token.InvalidStaticLiteral {span: ignoredSpan, diagnostic: ignoredDiagnostic} => TokenKind.InvalidStaticLiteral
    Token.StaticKeyword {span: _} => TokenKind.StaticKeyword
    Token.CompileErrorKeyword {span: _} => TokenKind.CompileErrorKeyword
    Token.PubKeyword {span: _} => TokenKind.PubKeyword
    Token.StructKeyword {span: _} => TokenKind.StructKeyword
    Token.TupleKeyword {span: _} => TokenKind.TupleKeyword
    Token.EnumKeyword {span: _} => TokenKind.EnumKeyword
    Token.UnionKeyword {span: _} => TokenKind.UnionKeyword
    Token.TypeKeyword {span: _} => TokenKind.TypeKeyword
    Token.ServiceKeyword {span: _} => TokenKind.ServiceKeyword
    Token.InterfaceKeyword {span: _} => TokenKind.InterfaceKeyword
    Token.RoleKeyword {span: _} => TokenKind.RoleKeyword
    Token.EffectKeyword {span: _} => TokenKind.EffectKeyword
    Token.FnKeyword {span: _} => TokenKind.FnKeyword
    Token.RunKeyword {span: _} => TokenKind.RunKeyword
    Token.FailKeyword {span: _} => TokenKind.FailKeyword
    Token.DropKeyword {span: _} => TokenKind.DropKeyword
    Token.UnsafeKeyword {span: _} => TokenKind.UnsafeKeyword
    Token.ExternKeyword {span: _} => TokenKind.ExternKeyword
    Token.ExportKeyword {span: _} => TokenKind.ExportKeyword
    Token.ImplKeyword {span: _} => TokenKind.ImplKeyword
    Token.ForKeyword {span: _} => TokenKind.ForKeyword
    Token.ReturnKeyword {span: _} => TokenKind.ReturnKeyword
    Token.ImportKeyword {span: _} => TokenKind.ImportKeyword
    Token.AsKeyword {span: _} => TokenKind.AsKeyword
    Token.LetKeyword {span: _} => TokenKind.LetKeyword
    Token.ConstKeyword {span: _} => TokenKind.ConstKeyword
    Token.ParamKeyword {span: _} => TokenKind.ParamKeyword
    Token.MutKeyword {span: _} => TokenKind.MutKeyword
    Token.OnceKeyword {span: _} => TokenKind.OnceKeyword
    Token.MoveKeyword {span: _} => TokenKind.MoveKeyword
    Token.MatchKeyword {span: _} => TokenKind.MatchKeyword
    Token.IfKeyword {span: _} => TokenKind.IfKeyword
    Token.ElseKeyword {span: _} => TokenKind.ElseKeyword
    Token.WhileKeyword {span: _} => TokenKind.WhileKeyword
    Token.BreakKeyword {span: _} => TokenKind.BreakKeyword
    Token.ContinueKeyword {span: _} => TokenKind.ContinueKeyword
    Token.TrueKeyword {span: _} => TokenKind.TrueKeyword
    Token.FalseKeyword {span: _} => TokenKind.FalseKeyword
    Token.LeftParenthesis {span: _} => TokenKind.LeftParenthesis
    Token.RightParenthesis {span: _} => TokenKind.RightParenthesis
    Token.LeftBrace {span: _} => TokenKind.LeftBrace
    Token.RightBrace {span: _} => TokenKind.RightBrace
    Token.LeftBracket {span: _} => TokenKind.LeftBracket
    Token.RightBracket {span: _} => TokenKind.RightBracket
    Token.Colon {span: _} => TokenKind.Colon
    Token.Semicolon {span: _} => TokenKind.Semicolon
    Token.Comma {span: _} => TokenKind.Comma
    Token.Equals {span: _} => TokenKind.Equals
    Token.EqualEqual {span: _} => TokenKind.EqualEqual
    Token.FatArrow {span: _} => TokenKind.FatArrow
    Token.Minus {span: _} => TokenKind.Minus
    Token.Plus {span: _} => TokenKind.Plus
    Token.Star {span: _} => TokenKind.Star
    Token.Slash {span: _} => TokenKind.Slash
    Token.Percent {span: _} => TokenKind.Percent
    Token.Bang {span: _} => TokenKind.Bang
    Token.BangEqual {span: _} => TokenKind.BangEqual
    Token.Question {span: _} => TokenKind.Question
    Token.At {span: _} => TokenKind.At
    Token.Less {span: _} => TokenKind.Less
    Token.LessEqual {span: _} => TokenKind.LessEqual
    Token.Greater {span: _} => TokenKind.Greater
    Token.GreaterEqual {span: _} => TokenKind.GreaterEqual
    Token.Pipe {span: _} => TokenKind.Pipe
    Token.PipeGreater {span: _} => TokenKind.PipeGreater
    Token.PipePipe {span: _} => TokenKind.PipePipe
    Token.Ampersand {span: _} => TokenKind.Ampersand
    Token.AmpersandAmpersand {span: _} => TokenKind.AmpersandAmpersand
    Token.Caret {span: _} => TokenKind.Caret
    Token.Tilde {span: _} => TokenKind.Tilde
    Token.Dot {span: _} => TokenKind.Dot
    Token.DotDot {span: _} => TokenKind.DotDot
    Token.Ellipsis {span: _} => TokenKind.Ellipsis
    Token.Arrow {span: _} => TokenKind.Arrow
    Token.Invalid {span: ignoredSpan, diagnostic: ignoredDiagnostic} => TokenKind.Invalid
    Token.EndOfFile {span: _} => TokenKind.EndOfFile
  }
}

/// Returns the half-open source byte range of a token.
pub fn span(token: Token) -> Span {
  return match move token {
    Token.Whitespace {span} => span
    Token.LineComment {span} => span
    Token.DocComment {span} => span
    Token.ModuleDocComment {span} => span
    Token.Identifier {span} => span
    Token.Lifetime {span} => span
    Token.DecimalInteger {span} => span
    Token.DecimalFloat {span} => span
    Token.DurationLiteral {span} => span
    Token.InvalidDurationLiteral {span, diagnostic: ignoredDiagnostic} => span
    Token.TextLiteral {span} => span
    Token.ByteStringLiteral {span} => span
    Token.CharLiteral {span} => span
    Token.InvalidStaticLiteral {span, diagnostic: ignoredDiagnostic} => span
    Token.StaticKeyword {span} => span
    Token.CompileErrorKeyword {span} => span
    Token.PubKeyword {span} => span
    Token.StructKeyword {span} => span
    Token.TupleKeyword {span} => span
    Token.EnumKeyword {span} => span
    Token.UnionKeyword {span} => span
    Token.TypeKeyword {span} => span
    Token.ServiceKeyword {span} => span
    Token.InterfaceKeyword {span} => span
    Token.RoleKeyword {span} => span
    Token.EffectKeyword {span} => span
    Token.FnKeyword {span} => span
    Token.RunKeyword {span} => span
    Token.FailKeyword {span} => span
    Token.DropKeyword {span} => span
    Token.UnsafeKeyword {span} => span
    Token.ExternKeyword {span} => span
    Token.ExportKeyword {span} => span
    Token.ImplKeyword {span} => span
    Token.ForKeyword {span} => span
    Token.ReturnKeyword {span} => span
    Token.ImportKeyword {span} => span
    Token.AsKeyword {span} => span
    Token.LetKeyword {span} => span
    Token.ConstKeyword {span} => span
    Token.ParamKeyword {span} => span
    Token.MutKeyword {span} => span
    Token.OnceKeyword {span} => span
    Token.MoveKeyword {span} => span
    Token.MatchKeyword {span} => span
    Token.IfKeyword {span} => span
    Token.ElseKeyword {span} => span
    Token.WhileKeyword {span} => span
    Token.BreakKeyword {span} => span
    Token.ContinueKeyword {span} => span
    Token.TrueKeyword {span} => span
    Token.FalseKeyword {span} => span
    Token.LeftParenthesis {span} => span
    Token.RightParenthesis {span} => span
    Token.LeftBrace {span} => span
    Token.RightBrace {span} => span
    Token.LeftBracket {span} => span
    Token.RightBracket {span} => span
    Token.Colon {span} => span
    Token.Semicolon {span} => span
    Token.Comma {span} => span
    Token.Equals {span} => span
    Token.EqualEqual {span} => span
    Token.FatArrow {span} => span
    Token.Minus {span} => span
    Token.Plus {span} => span
    Token.Star {span} => span
    Token.Slash {span} => span
    Token.Percent {span} => span
    Token.Bang {span} => span
    Token.BangEqual {span} => span
    Token.Question {span} => span
    Token.At {span} => span
    Token.Less {span} => span
    Token.LessEqual {span} => span
    Token.Greater {span} => span
    Token.GreaterEqual {span} => span
    Token.Pipe {span} => span
    Token.PipeGreater {span} => span
    Token.PipePipe {span} => span
    Token.Ampersand {span} => span
    Token.AmpersandAmpersand {span} => span
    Token.Caret {span} => span
    Token.Tilde {span} => span
    Token.Dot {span} => span
    Token.DotDot {span} => span
    Token.Ellipsis {span} => span
    Token.Arrow {span} => span
    Token.Invalid {span, diagnostic: ignoredDiagnostic} => span
    Token.EndOfFile {span} => span
  }
}

effect fn writeLine(name: string, span: Span) -> () ! WriterError ? &mut Writer {
  run Writer.writeString(name)
  run Writer.writeString(" ")
  run Format.display(&span.start)
  run Writer.writeString("..")
  run Format.display(&span.end)
  return run Writer.writeString("\n")
}

effect fn writeInvalid(name: string, span: Span, diagnostic: LexicalDiagnostic) -> ()
! WriterError
? &mut Writer {
  run writeLine(name, span)
  return run LexicalDiagnostic.write(move diagnostic)
}

impl Token {
  /// Writes one token and any diagnostic carried by an invalid variant.
  pub effect fn write(token: Token) -> () ! WriterError ? &mut Writer {
    return match move token {
      Token.Whitespace {span} => run writeLine("Whitespace", span)
      Token.LineComment {span} => run writeLine("LineComment", span)
      Token.DocComment {span} => run writeLine("DocComment", span)
      Token.ModuleDocComment {span} => run writeLine("ModuleDocComment", span)
      Token.Identifier {span} => run writeLine("Identifier", span)
      Token.Lifetime {span} => run writeLine("Lifetime", span)
      Token.DecimalInteger {span} => run writeLine("DecimalInteger", span)
      Token.DecimalFloat {span} => run writeLine("DecimalFloat", span)
      Token.DurationLiteral {span} => run writeLine("DurationLiteral", span)
      Token.InvalidDurationLiteral {span, diagnostic} => run writeInvalid(
        "InvalidDurationLiteral",
        span,
        move diagnostic,
      )
      Token.TextLiteral {span} => run writeLine("TextLiteral", span)
      Token.ByteStringLiteral {span} => run writeLine("ByteStringLiteral", span)
      Token.CharLiteral {span} => run writeLine("CharLiteral", span)
      Token.InvalidStaticLiteral {span, diagnostic} => run writeInvalid(
        "InvalidStaticLiteral",
        span,
        move diagnostic,
      )
      Token.StaticKeyword {span} => run writeLine("StaticKeyword", span)
      Token.CompileErrorKeyword {span} => run writeLine("CompileErrorKeyword", span)
      Token.PubKeyword {span} => run writeLine("PubKeyword", span)
      Token.StructKeyword {span} => run writeLine("StructKeyword", span)
      Token.TupleKeyword {span} => run writeLine("TupleKeyword", span)
      Token.EnumKeyword {span} => run writeLine("EnumKeyword", span)
      Token.UnionKeyword {span} => run writeLine("UnionKeyword", span)
      Token.TypeKeyword {span} => run writeLine("TypeKeyword", span)
      Token.ServiceKeyword {span} => run writeLine("ServiceKeyword", span)
      Token.InterfaceKeyword {span} => run writeLine("InterfaceKeyword", span)
      Token.RoleKeyword {span} => run writeLine("RoleKeyword", span)
      Token.EffectKeyword {span} => run writeLine("EffectKeyword", span)
      Token.FnKeyword {span} => run writeLine("FnKeyword", span)
      Token.RunKeyword {span} => run writeLine("RunKeyword", span)
      Token.FailKeyword {span} => run writeLine("FailKeyword", span)
      Token.DropKeyword {span} => run writeLine("DropKeyword", span)
      Token.UnsafeKeyword {span} => run writeLine("UnsafeKeyword", span)
      Token.ExternKeyword {span} => run writeLine("ExternKeyword", span)
      Token.ExportKeyword {span} => run writeLine("ExportKeyword", span)
      Token.ImplKeyword {span} => run writeLine("ImplKeyword", span)
      Token.ForKeyword {span} => run writeLine("ForKeyword", span)
      Token.ReturnKeyword {span} => run writeLine("ReturnKeyword", span)
      Token.ImportKeyword {span} => run writeLine("ImportKeyword", span)
      Token.AsKeyword {span} => run writeLine("AsKeyword", span)
      Token.LetKeyword {span} => run writeLine("LetKeyword", span)
      Token.ConstKeyword {span} => run writeLine("ConstKeyword", span)
      Token.ParamKeyword {span} => run writeLine("ParamKeyword", span)
      Token.MutKeyword {span} => run writeLine("MutKeyword", span)
      Token.OnceKeyword {span} => run writeLine("OnceKeyword", span)
      Token.MoveKeyword {span} => run writeLine("MoveKeyword", span)
      Token.MatchKeyword {span} => run writeLine("MatchKeyword", span)
      Token.IfKeyword {span} => run writeLine("IfKeyword", span)
      Token.ElseKeyword {span} => run writeLine("ElseKeyword", span)
      Token.WhileKeyword {span} => run writeLine("WhileKeyword", span)
      Token.BreakKeyword {span} => run writeLine("BreakKeyword", span)
      Token.ContinueKeyword {span} => run writeLine("ContinueKeyword", span)
      Token.TrueKeyword {span} => run writeLine("TrueKeyword", span)
      Token.FalseKeyword {span} => run writeLine("FalseKeyword", span)
      Token.LeftParenthesis {span} => run writeLine("LeftParenthesis", span)
      Token.RightParenthesis {span} => run writeLine("RightParenthesis", span)
      Token.LeftBrace {span} => run writeLine("LeftBrace", span)
      Token.RightBrace {span} => run writeLine("RightBrace", span)
      Token.LeftBracket {span} => run writeLine("LeftBracket", span)
      Token.RightBracket {span} => run writeLine("RightBracket", span)
      Token.Colon {span} => run writeLine("Colon", span)
      Token.Semicolon {span} => run writeLine("Semicolon", span)
      Token.Comma {span} => run writeLine("Comma", span)
      Token.Equals {span} => run writeLine("Equals", span)
      Token.EqualEqual {span} => run writeLine("EqualEqual", span)
      Token.FatArrow {span} => run writeLine("FatArrow", span)
      Token.Minus {span} => run writeLine("Minus", span)
      Token.Plus {span} => run writeLine("Plus", span)
      Token.Star {span} => run writeLine("Star", span)
      Token.Slash {span} => run writeLine("Slash", span)
      Token.Percent {span} => run writeLine("Percent", span)
      Token.Bang {span} => run writeLine("Bang", span)
      Token.BangEqual {span} => run writeLine("BangEqual", span)
      Token.Question {span} => run writeLine("Question", span)
      Token.At {span} => run writeLine("At", span)
      Token.Less {span} => run writeLine("Less", span)
      Token.LessEqual {span} => run writeLine("LessEqual", span)
      Token.Greater {span} => run writeLine("Greater", span)
      Token.GreaterEqual {span} => run writeLine("GreaterEqual", span)
      Token.Pipe {span} => run writeLine("Pipe", span)
      Token.PipeGreater {span} => run writeLine("PipeGreater", span)
      Token.PipePipe {span} => run writeLine("PipePipe", span)
      Token.Ampersand {span} => run writeLine("Ampersand", span)
      Token.AmpersandAmpersand {span} => run writeLine("AmpersandAmpersand", span)
      Token.Caret {span} => run writeLine("Caret", span)
      Token.Tilde {span} => run writeLine("Tilde", span)
      Token.Dot {span} => run writeLine("Dot", span)
      Token.DotDot {span} => run writeLine("DotDot", span)
      Token.Ellipsis {span} => run writeLine("Ellipsis", span)
      Token.Arrow {span} => run writeLine("Arrow", span)
      Token.Invalid {span, diagnostic} => run writeInvalid("Invalid", span, move diagnostic)
      Token.EndOfFile {span} => run writeLine("EndOfFile", span)
    }
  }
}
