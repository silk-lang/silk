import lexer.Span {Span}
import silk.core.ownership {Copy}
import silk.io.writer {Writer, WriterError}
import silk.num.u32
import silk.num.usize
import silk.collections.slice {Slice}
import silk.text.string {String}

/// The lexical category of one token.
pub enum TokenKind {
  /// Whitespace between significant tokens.
  Whitespace,
  /// A non-documentation line comment.
  LineComment,
  /// A documentation comment for the next declaration.
  DocComment,
  /// A documentation comment for the current module.
  ModuleDocComment,
  /// An identifier.
  Identifier,
  /// A lifetime name.
  Lifetime,
  /// A decimal integer literal.
  DecimalInteger,
  /// A decimal floating-point literal.
  DecimalFloat,
  /// A duration literal.
  DurationLiteral,
  /// An invalid duration literal.
  InvalidDurationLiteral,
  /// A text literal.
  TextLiteral,
  /// A byte-string literal.
  ByteStringLiteral,
  /// A character literal.
  CharLiteral,
  /// An invalid static literal.
  InvalidStaticLiteral,
  /// The `static` keyword.
  StaticKeyword,
  /// The `compileError` keyword.
  CompileErrorKeyword,
  /// The `pub` keyword.
  PubKeyword,
  /// The `struct` keyword.
  StructKeyword,
  /// The `tuple` keyword.
  TupleKeyword,
  /// The `enum` keyword.
  EnumKeyword,
  /// The `union` keyword.
  UnionKeyword,
  /// The `type` keyword.
  TypeKeyword,
  /// The `service` keyword.
  ServiceKeyword,
  /// The `interface` keyword.
  InterfaceKeyword,
  /// The `role` keyword.
  RoleKeyword,
  /// The `Effect` keyword.
  EffectKeyword,
  /// The `fn` keyword.
  FnKeyword,
  /// The `run` keyword.
  RunKeyword,
  /// The `fail` keyword.
  FailKeyword,
  /// The `drop` keyword.
  DropKeyword,
  /// The `unsafe` keyword.
  UnsafeKeyword,
  /// The `extern` keyword.
  ExternKeyword,
  /// The `export` keyword.
  ExportKeyword,
  /// The `impl` keyword.
  ImplKeyword,
  /// The `for` keyword.
  ForKeyword,
  /// The `return` keyword.
  ReturnKeyword,
  /// The `import` keyword.
  ImportKeyword,
  /// The `as` keyword.
  AsKeyword,
  /// The `let` keyword.
  LetKeyword,
  /// The `const` keyword.
  ConstKeyword,
  /// The `param` keyword.
  ParamKeyword,
  /// The `mut` keyword.
  MutKeyword,
  /// The `once` keyword.
  OnceKeyword,
  /// The `move` keyword.
  MoveKeyword,
  /// The `match` keyword.
  MatchKeyword,
  /// The `if` keyword.
  IfKeyword,
  /// The `else` keyword.
  ElseKeyword,
  /// The `while` keyword.
  WhileKeyword,
  /// The `break` keyword.
  BreakKeyword,
  /// The `continue` keyword.
  ContinueKeyword,
  /// The `true` keyword.
  TrueKeyword,
  /// The `false` keyword.
  FalseKeyword,
  /// A left parenthesis.
  LeftParenthesis,
  /// A right parenthesis.
  RightParenthesis,
  /// A left brace.
  LeftBrace,
  /// A right brace.
  RightBrace,
  /// A left bracket.
  LeftBracket,
  /// A right bracket.
  RightBracket,
  /// A colon.
  Colon,
  /// A semicolon.
  Semicolon,
  /// A comma.
  Comma,
  /// An equals sign.
  Equals,
  /// An equality operator.
  EqualEqual,
  /// A fat arrow.
  FatArrow,
  /// A minus sign.
  Minus,
  /// A plus sign.
  Plus,
  /// A star.
  Star,
  /// A slash.
  Slash,
  /// A percent sign.
  Percent,
  /// An exclamation mark.
  Bang,
  /// An inequality operator.
  BangEqual,
  /// A question mark.
  Question,
  /// An at sign, which starts a directive.
  At,
  /// A number sign, which starts a reference type's role marker.
  Hash,
  /// A less-than sign.
  Less,
  /// A less-than-or-equal operator.
  LessEqual,
  /// A greater-than sign.
  Greater,
  /// A greater-than-or-equal operator.
  GreaterEqual,
  /// A pipe.
  Pipe,
  /// A pipeline operator.
  PipeGreater,
  /// A logical-or operator.
  PipePipe,
  /// An ampersand.
  Ampersand,
  /// A logical-and operator.
  AmpersandAmpersand,
  /// A caret.
  Caret,
  /// A tilde.
  Tilde,
  /// A dot.
  Dot,
  /// Two dots.
  DotDot,
  /// An ellipsis.
  Ellipsis,
  /// Two dots and an equals sign, closing an inclusive range pattern.
  DotDotEquals,
  /// A thin arrow.
  Arrow,
  /// An invalid token.
  Invalid,
  /// The end of the source file.
  EndOfFile,
}

/// One lossless lexical item: its category and its half-open byte span. The offsets are 32-bit
/// so that a token is 12 bytes; every token of every module stays in memory for a whole
/// compilation.
pub struct Token {
  kind: TokenKind,
  start: u32,
  end: u32,
}

impl Copy for Token {}

/// Returns the lexical category of a token.
pub fn kind(token: Token) -> TokenKind {
  return token.kind
}

/// Returns the half-open source byte range of a token.
pub fn span(token: Token) -> Span {
  return Span.make(u32.toUsize(token.start), u32.toUsize(token.end))
}

/// How the bootstrap names a token kind in a diagnostic: its spelling in backticks, or its role.
pub fn describe(kind: TokenKind) -> string<'static> {
  return match kind {
    TokenKind.Whitespace => "whitespace"
    TokenKind.LineComment => "line comment"
    TokenKind.DocComment => "documentation comment"
    TokenKind.ModuleDocComment => "module documentation comment"
    TokenKind.Identifier => "identifier"
    TokenKind.Lifetime => "lifetime name"
    TokenKind.DecimalInteger => "decimal integer"
    TokenKind.DecimalFloat => "decimal floating-point literal"
    TokenKind.DurationLiteral => "duration literal"
    TokenKind.InvalidDurationLiteral => "invalid duration literal"
    TokenKind.TextLiteral => "text literal"
    TokenKind.ByteStringLiteral => "byte-string literal"
    TokenKind.CharLiteral => "character literal"
    TokenKind.InvalidStaticLiteral => "invalid static literal"
    TokenKind.StaticKeyword => "`static`"
    TokenKind.CompileErrorKeyword => "`compileError`"
    TokenKind.PubKeyword => "`pub`"
    TokenKind.StructKeyword => "`struct`"
    TokenKind.TupleKeyword => "`tuple`"
    TokenKind.EnumKeyword => "`enum`"
    TokenKind.UnionKeyword => "`union`"
    TokenKind.TypeKeyword => "`type`"
    TokenKind.ServiceKeyword => "`service`"
    TokenKind.InterfaceKeyword => "`interface`"
    TokenKind.RoleKeyword => "`role`"
    TokenKind.EffectKeyword => "`effect`"
    TokenKind.FnKeyword => "`fn`"
    TokenKind.RunKeyword => "`run`"
    TokenKind.FailKeyword => "`fail`"
    TokenKind.DropKeyword => "`drop`"
    TokenKind.UnsafeKeyword => "`unsafe`"
    TokenKind.ExternKeyword => "`extern`"
    TokenKind.ExportKeyword => "`export`"
    TokenKind.ImplKeyword => "`impl`"
    TokenKind.ForKeyword => "`for`"
    TokenKind.ReturnKeyword => "`return`"
    TokenKind.ImportKeyword => "`import`"
    TokenKind.AsKeyword => "`as`"
    TokenKind.LetKeyword => "`let`"
    TokenKind.ConstKeyword => "`const`"
    TokenKind.ParamKeyword => "`param`"
    TokenKind.MutKeyword => "`mut`"
    TokenKind.OnceKeyword => "`once`"
    TokenKind.MoveKeyword => "`move`"
    TokenKind.MatchKeyword => "`match`"
    TokenKind.IfKeyword => "`if`"
    TokenKind.ElseKeyword => "`else`"
    TokenKind.WhileKeyword => "`while`"
    TokenKind.BreakKeyword => "`break`"
    TokenKind.ContinueKeyword => "`continue`"
    TokenKind.TrueKeyword => "`true`"
    TokenKind.FalseKeyword => "`false`"
    TokenKind.LeftParenthesis => "`(`"
    TokenKind.RightParenthesis => "`)`"
    TokenKind.LeftBrace => "`{`"
    TokenKind.RightBrace => "`}`"
    TokenKind.LeftBracket => "`[`"
    TokenKind.RightBracket => "`]`"
    TokenKind.Colon => "`:`"
    TokenKind.Semicolon => "`;`"
    TokenKind.Comma => "`,`"
    TokenKind.Equals => "`=`"
    TokenKind.EqualEqual => "`==`"
    TokenKind.FatArrow => "`=>`"
    TokenKind.Minus => "`-`"
    TokenKind.Plus => "`+`"
    TokenKind.Star => "`*`"
    TokenKind.Slash => "`/`"
    TokenKind.Percent => "`%`"
    TokenKind.Bang => "`!`"
    TokenKind.BangEqual => "`!=`"
    TokenKind.Question => "`?`"
    TokenKind.At => "`@`"
    TokenKind.Hash => "`#`"
    TokenKind.Less => "`<`"
    TokenKind.LessEqual => "`<=`"
    TokenKind.Greater => "`>`"
    TokenKind.GreaterEqual => "`>=`"
    TokenKind.Pipe => "`|`"
    TokenKind.PipeGreater => "`|>`"
    TokenKind.PipePipe => "`||`"
    TokenKind.Ampersand => "`&`"
    TokenKind.AmpersandAmpersand => "`&&`"
    TokenKind.Caret => "`^`"
    TokenKind.Tilde => "`~`"
    TokenKind.Dot => "`.`"
    TokenKind.DotDot => "`..`"
    TokenKind.Ellipsis => "`...`"
    TokenKind.DotDotEquals => "`..=`"
    TokenKind.Arrow => "`->`"
    TokenKind.Invalid => "invalid byte"
    TokenKind.EndOfFile => "end of file"
  }
}

impl Token {
  /// A token of category `kind` over `span`.
  pub fn make(kind: TokenKind, span: Span) -> Token {
    return Token {kind: kind, start: usize.toU32(span.start), end: usize.toU32(span.end)}
  }
}

/// Writes `text` between double quotes with `"`, `\`, and the line breaks escaped.
///
/// # Details
///
/// The HIR dump is read back by `compiler/scripts/lower-corpus.mjs`, which is line oriented: a field
/// occupies exactly one line and a quoted value ends at the first unescaped `"`. Interned text is
/// arbitrary source bytes — a module documentation block spans many lines and a text literal may
/// contain a quote — so writing it raw would let a symbol close a field early or open a line the
/// reader cannot classify. Every other byte, including non-ASCII UTF-8, passes through unchanged.
pub effect fn writeQuoted(text: &[u8]) -> () ! WriterError ? &mut Writer {
  run Writer.writeString("\"")
  let mut plain = usize.ZERO
  let mut index = usize.ZERO
  while index < text.length {
    let byte = text[index]
    let mut escape = ""
    if byte == 34 {
      escape = "\\\""
    } else if byte == 92 {
      escape = "\\\\"
    } else if byte == 10 {
      escape = "\\n"
    } else if byte == 13 {
      escape = "\\r"
    } else if byte == 9 {
      escape = "\\t"
    }
    if String.utf8Bytes(escape).length > usize.ZERO {
      run Writer.writeAll(Slice.view<u8>(text, plain, index - plain))
      run Writer.writeString(escape)
      plain = index + usize.ONE
    }
    index = index + usize.ONE
  }
  run Writer.writeAll(Slice.view<u8>(text, plain, text.length - plain))
  return run Writer.writeString("\"")
}
