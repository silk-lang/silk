//! Canonical expression layouts and their independent safety-sensitive boundaries.

import format.FormatError {FormatError}
import format.SyntaxFormatter
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.effect {Effect}
import silk.string {String}
import silk.testing {AssertionError, Testing}
import silk.u8
import silk.usize
import silk.writer {Writer, WriterError}
import silk.os_writer {StderrWriter}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at: usize = 0
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + 1
  }
  return true
}

effect fn assertFormatted(source: string<'static>, expected: string<'static>) -> ()
! FormatError | OutOfMemoryError | WriterError | AssertionError<'static>
? &mut Allocator {
  let formatted = run SyntaxFormatter.format(String.utf8Bytes(source))
  if !same(Bytes.asSlice(&formatted), String.utf8Bytes(expected)) {
    let mut stderr = StderrWriter.make()
    run Writer.writeAll(Bytes.asSlice(&formatted)) |> Effect.provideMut<Writer>(&mut stderr)
  }
  run Testing.expect(same(Bytes.asSlice(&formatted), String.utf8Bytes(expected)), "canonical expression layout")
  let repeated = run SyntaxFormatter.format(Bytes.asSlice(&formatted))
  return run Testing.expect(same(Bytes.asSlice(&formatted), Bytes.asSlice(&repeated)), "expression layout is idempotent")
}

test effect fn expressionOperatorsRetainPrecedenceAndPostfixAttachment() -> ()
! FormatError | OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run assertFormatted(
    """fn evaluate(value:Value)->i32{
let x=-(value.0+2)*3
let y=&mut value.field
let z=& &value
let numeric=1 .0
return run call<i32>(x,y,z)[0].field.* |> finish
}
""",
    """fn evaluate(value: Value) -> i32 {
  let x = -(value.0 + 2) * 3
  let y = &mut value.field
  let z = & &value
  let numeric = 1 .0
  return run call<i32>(x, y, z)[0].field.* |> finish
}
""",
  ) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn expressionListsBreakAndKeepAuthoredTrailingCommas() -> ()
! FormatError | OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run assertFormatted(
    """fn lists()->(){
let tupleValue=(1,)
let array=[1,2,]
let record=.{first:1,second:2,}
consume(firstMeaningfulArgumentName,secondMeaningfulArgumentName,thirdMeaningfulArgumentName,fourthMeaningfulArgumentName,)
}
""",
    """fn lists() -> () {
  let tupleValue = (1,)
  let array = [1, 2,]
  let record = .{ first: 1, second: 2, }
  consume(
    firstMeaningfulArgumentName,
    secondMeaningfulArgumentName,
    thirdMeaningfulArgumentName,
    fourthMeaningfulArgumentName,
  )
}
""",
  ) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn expressionControlFlowAndPatternBlocksNestConsistently() -> ()
! FormatError | OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run assertFormatted(
    """fn choose(value:Value)->i32{
let consume=fn(x:i32)->i32{return x+1}
while value.ready{if value.failed{break}else{continue}}
return match &mut value{
Choice.Some {value:item,..} if item>0=>{let adjusted=item+1
return adjusted}
_=>-1
}
}
""",
    """fn choose(value: Value) -> i32 {
  let consume = fn(x: i32) -> i32 {
    return x + 1
  }
  while value.ready {
    if value.failed {
      break
    } else {
      continue
    }
  }
  return match &mut value {
    Choice.Some { value: item, .. } if item > 0 => {
      let adjusted = item + 1
      return adjusted
    }
    _ => -1
  }
}
""",
  ) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn expressionMultilineLiteralsKeepTheirPhysicalBodies() -> ()
! FormatError | OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run assertFormatted(
    """fn literals()->(){
let text=\"\"\"first
 literal indentation  
last\"\"\"
let bytes=b\"\"\"first
    bytes stay here
last\"\"\"
}
""",
    """fn literals() -> () {
  let text = \"\"\"first
 literal indentation  
last\"\"\"
  let bytes = b\"\"\"first
    bytes stay here
last\"\"\"
}
""",
  ) |> Effect.provideMut<Allocator>(&mut allocator)
}
