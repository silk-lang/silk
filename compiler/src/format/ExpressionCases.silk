//! Canonical expression layouts and their independent safety-sensitive boundaries.

import format.FormatError {FormatError}
import format.SyntaxFormatter
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.effect {Effect}
import silk.string {String}
import silk.testing {AssertionError, Testing}
import silk.u8
import silk.usize
import silk.writer {Writer, WriterError}
import silk.os_writer {StderrWriter}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at: usize = 0
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + 1
  }
  return true
}

effect fn assertFormatted(source: string<'static>, expected: string<'static>) -> ()
! FormatError | OutOfMemoryError | WriterError | AssertionError<'static>
? &mut Allocator {
  let formatted = run SyntaxFormatter.format(String.utf8Bytes(source))
  if !same(Bytes.asSlice(&formatted), String.utf8Bytes(expected)) {
    let mut stderr = StderrWriter.make()
    run Writer.writeAll(Bytes.asSlice(&formatted)) |> Effect.provideMut<Writer>(&mut stderr)
  }
  run Testing.expect(same(Bytes.asSlice(&formatted), String.utf8Bytes(expected)), "canonical expression layout")
  let repeated = run SyntaxFormatter.format(Bytes.asSlice(&formatted))
  return run Testing.expect(same(Bytes.asSlice(&formatted), Bytes.asSlice(&repeated)), "expression layout is idempotent")
}

test effect fn expressionOperatorsRetainPrecedenceAndPostfixAttachment() -> ()
! FormatError | OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run assertFormatted(
    """fn evaluate(value:Value)->i32{
let x=-(value.0+2)*3
let y=&mut value.field
let z=& &value
let numeric=1 .0
return run call<i32>(x,y,z)[0].field.* |> finish
}
""",
    """fn evaluate(value: Value) -> i32 {
  let x = -(value.0 + 2) * 3
  let y = &mut value.field
  let z = & &value
  let numeric = 1 .0
  return run call<i32>(x, y, z)[0].field.* |> finish
}
""",
  ) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn expressionListsBreakAndKeepTrailingCommasOnlyWhenBroken() -> ()
! FormatError | OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run assertFormatted(
    """fn lists()->(){
let tupleValue=(1,)
let array=[1,2,]
let repeated=[make(1) ;size+2]
let nested=[[7;0];1]
let record=.{first:1,second:2,}
consume(firstMeaningfulArgumentName,secondMeaningfulArgumentName,thirdMeaningfulArgumentName,fourthMeaningfulArgumentName,)
}
""",
    """fn lists() -> () {
  let tupleValue = (1,)
  let array = [1, 2]
  let repeated = [make(1); size + 2]
  let nested = [[7; 0]; 1]
  let record = .{ first: 1, second: 2 }
  consume(
    firstMeaningfulArgumentName,
    secondMeaningfulArgumentName,
    thirdMeaningfulArgumentName,
    fourthMeaningfulArgumentName,
  )
}
""",
  ) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn expressionBrokenListsGainATrailingComma() -> ()
! FormatError | OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run assertFormatted(
    """fn long(alpha: i32, bravo: i32, charlie: i32, delta: i32, echo: i32, foxtrot: i32, golf: i32, hotel: i32) -> i32 {
consume(firstMeaningfulArgumentName,secondMeaningfulArgumentName,thirdMeaningfulArgumentName,fourthMeaningfulArgumentName)
return alpha
}
""",
    """fn long(
  alpha: i32,
  bravo: i32,
  charlie: i32,
  delta: i32,
  echo: i32,
  foxtrot: i32,
  golf: i32,
  hotel: i32,
) -> i32 {
  consume(
    firstMeaningfulArgumentName,
    secondMeaningfulArgumentName,
    thirdMeaningfulArgumentName,
    fourthMeaningfulArgumentName,
  )
  return alpha
}
""",
  ) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn expressionArmBodyAfterACommentStaysIndented() -> ()
! FormatError | OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run assertFormatted(
    """fn pick(n: i32) -> i32 {
return match n {
0 =>
// zero
10
_ => 20
}
}
""",
    """fn pick(n: i32) -> i32 {
  return match n {
    0 =>
      // zero
      10
    _ => 20
  }
}
""",
  ) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn expressionJoinedRecordLiteralsDropTheirTrailingComma() -> ()
! FormatError | OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run assertFormatted(
    """fn make() -> Draft {
  let call = add(
    1,
    2,
  )
  return Draft {
    title: 1,
    priority: 2,
  }
}
""",
    """fn make() -> Draft {
  let call = add(1, 2)
  return Draft { title: 1, priority: 2 }
}
""",
  ) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn expressionControlFlowAndPatternBlocksNestConsistently() -> ()
! FormatError | OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run assertFormatted(
    """fn choose(value:Value)->i32{
let consume=fn(x:i32)->i32{return x+1}
while value.ready{if value.failed{break}else{continue}}
return match &mut value{
Choice.Some {value:item,..} if item>0=>{let adjusted=item+1
return adjusted}
_=>-1
}
}
""",
    """fn choose(value: Value) -> i32 {
  let consume = fn(x: i32) -> i32 {
    return x + 1
  }
  while value.ready {
    if value.failed {
      break
    } else {
      continue
    }
  }
  return match &mut value {
    Choice.Some { value: item, .. } if item > 0 => {
      let adjusted = item + 1
      return adjusted
    }
    _ => -1
  }
}
""",
  ) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn expressionNegatedConditionsStayOnTheirKeywordLine() -> ()
! FormatError | OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run assertFormatted(
    """fn wait(done:bool,ready:bool)->bool{
while !done{if !ready{return !done}}
let flipped=!ready
return !flipped
}
""",
    """fn wait(done: bool, ready: bool) -> bool {
  while !done {
    if !ready {
      return !done
    }
  }
  let flipped = !ready
  return !flipped
}
""",
  ) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn expressionPatternLoopsFormatLikePatternConditionals() -> ()
! FormatError | OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run assertFormatted(
    """fn drain(queue:&mut Queue)->i32{
let mut total=0
while let Option<i32>.Some{value}=move run pop(&mut queue.*){if !ready(value){continue}
total=total+value}
while let Step.Take{amount,..}=&step{total=total+amount}
return total
}
""",
    """fn drain(queue: &mut Queue) -> i32 {
  let mut total = 0
  while let Option<i32>.Some { value } = move run pop(&mut queue.*) {
    if !ready(value) {
      continue
    }
    total = total + value
  }
  while let Step.Take { amount, .. } = &step {
    total = total + amount
  }
  return total
}
""",
  ) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn expressionMultilineLiteralsKeepTheirPhysicalBodies() -> ()
! FormatError | OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run assertFormatted(
    """fn literals()->(){
let text=\"\"\"first
 literal indentation  
last\"\"\"
let bytes=b\"\"\"first
    bytes stay here
last\"\"\"
}
""",
    """fn literals() -> () {
  let text = \"\"\"first
 literal indentation  
last\"\"\"
  let bytes = b\"\"\"first
    bytes stay here
last\"\"\"
}
""",
  ) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn expressionClosureArgumentsKeepTheirLastComment() -> ()
! FormatError | OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run assertFormatted(
    """fn call<F: mut fn() -> ()>(mut f: F) -> F {
  f()
  return move f
}

fn count() -> () {
  let mut n = 0
  drop call(fn() -> () {
    n = n + 1 // counted
  })
  drop call(fn() -> () {
    n = n + 1
    // after
  })
}
""",
    """fn call<F: mut fn() -> ()>(mut f: F) -> F {
  f()
  return move f
}

fn count() -> () {
  let mut n = 0
  drop call(
    fn() -> () {
      n = n + 1 // counted
    },
  )
  drop call(
    fn() -> () {
      n = n + 1
      // after
    },
  )
}
""",
  ) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn expressionBareReturnKeepsItsComment() -> ()
! FormatError | OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run assertFormatted(
    """fn f(n: i32) -> () {
  if n > 2 {
    return // nothing to do
  }
  if n > 1 {
    return
    // after
  }
}
""",
    """fn f(n: i32) -> () {
  if n > 2 {
    return // nothing to do
  }
  if n > 1 {
    return
    // after
  }
}
""",
  ) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn expressionWrappedPipelineCallIndentsItsArguments() -> ()
! FormatError | OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run assertFormatted(
    """fn chain() -> u32 {
  return add(1, 2)
    |> add(twice(1) |> add(1000000000) |> add(2000000000) |> add(3000000000) |> add(4000000000) |> add(4000000000))
    |> add(5)
}
""",
    """fn chain() -> u32 {
  return add(1, 2)
    |> add(
      twice(1) |> add(1000000000) |> add(2000000000) |> add(3000000000) |> add(4000000000)
        |> add(4000000000),
    )
    |> add(5)
}
""",
  ) |> Effect.provideMut<Allocator>(&mut allocator)
}
