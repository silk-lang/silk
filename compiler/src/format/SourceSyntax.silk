//! Lossless source parsing and damage rejection for syntax-only formatting.

import format.FormatError {FormatError, Reason}
import lexer.Lexer {Lexer}
import lexer.Span {Span}
import lexer.Token as Tokens {Token, TokenKind}
import parser.Parser
import parser.SyntaxTree {SyntaxTree}
import parser.Diagnostic {Diagnostic}
import parser.Element {Element}
import parser.Node {Node, NodeKind, elementsOf}
import Stream {Stream}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.option {Option}
import silk.collections.list {List}
import silk.num.usize

pub effect fn parse(source: Bytes) -> SyntaxTree ! OutOfMemoryError ? &mut Allocator {
  let mut lexer = Lexer.make(Bytes.asSlice(&source))
  let mut tokens = List<Token>.make()
  while true {
    let next = run Stream.take(&mut lexer)
    match move next {
      Option<Token>.Some {value} => { run List<Token>.append(&mut tokens, value) }
      Option<Token>.None => { break }
    }
  }
  drop lexer
  return run Parser.parse(move source, move tokens)
}

pub fn isComment(kind: TokenKind) -> bool {
  return kind == TokenKind.LineComment || kind == TokenKind.DocComment || kind == TokenKind.ModuleDocComment
}

pub effect fn validate(tree: &SyntaxTree) -> () ! FormatError {
  let tokens = List<Token>.asSlice(&tree.tokens)
  let mut at: usize = 0
  while at < tokens.length {
    let kind = Tokens.kind(tokens[at])
    if kind == TokenKind.Invalid || kind == TokenKind.InvalidStaticLiteral || kind == TokenKind.InvalidDurationLiteral {
      fail FormatError {span: Tokens.span(tokens[at]), reason: Reason.LexicalDamage}
    }
    at = at + 1
  }
  return run validateSyntax(tree)
}

/// Checks parser acceptance independently of lexical rejection policy.
pub effect fn validateSyntax(tree: &SyntaxTree) -> () ! FormatError {
  if List<Diagnostic>.length(&tree.diagnostics) > 0 {
    let diagnostic = List<Diagnostic>.get(&tree.diagnostics, 0)
    let span = match diagnostic {
      Diagnostic.MissingToken {expected: _, span} => span
      Diagnostic.UnexpectedToken {actual: _, span} => span
      Diagnostic.NestingLimit {limit: _, span} => span
      Diagnostic.ReservedTemplate {span} => span
      Diagnostic.ReservedImportBinding {span} => span
      Diagnostic.LoopStatement {span} => span
      Diagnostic.OptionalTypeSyntax {span} => span
      Diagnostic.TupleTypeSyntax {span} => span
      Diagnostic.IfExpression {span} => span
      Diagnostic.ForeignSpelling {habit: _, span} => span
      Diagnostic.WithClause {replacement: _, span} => span
    }
    fail FormatError {span: span, reason: Reason.SyntaxDamage}
  }
  let nodes = List<Node>.asSlice(&tree.nodes)
  let mut at: usize = 0
  while at < nodes.length {
    let node = &nodes[at]
    if node.kind == NodeKind.Error || node.kind == NodeKind.ErrorStatement || node.kind == NodeKind.ErrorPattern || node.kind == NodeKind.ServiceInvalidMember {
      fail FormatError {span: node.span, reason: Reason.SyntaxDamage}
    }
    let elements = elementsOf(&tree.elements, node)
    let mut item: usize = 0
    while item < elements.length {
      match elements[item] {
        Element.MissingToken {expected: _, span} => { fail FormatError {span: span, reason: Reason.SyntaxDamage} }
        _ => {}
      }
      item = item + 1
    }
    at = at + 1
  }
  return ()
}

/// Finds the first token whose start is at least the supplied byte offset.
pub fn lowerBound(tree: &SyntaxTree, offset: usize) -> usize {
  let tokens = List<Token>.asSlice(&tree.tokens)
  let mut low: usize = 0
  let mut high = tokens.length
  while low < high {
    let middle = low + (high - low) / 2
    if Tokens.span(tokens[middle]).start < offset { low = middle + 1 }
    else { high = middle }
  }
  return low
}
