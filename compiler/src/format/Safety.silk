//! Meaning-preservation checks over exact tokens, comments, and reparsed syntax structure.

import format.FormatError {FormatError, Reason}
import lexer.Span {Span}
import lexer.Token as Tokens {Token, TokenKind}
import parser.Element {Element}
import parser.Node {Node, elementsOf}
import parser.SyntaxTree {SyntaxTree}
import silk.collections.bytes {Bytes}
import silk.collections.slice {Slice}
import silk.collections.list {List}
import silk.num.usize
import silk.num.u8

pub fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at: usize = 0
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + 1
  }
  return true
}

fn closer(kind: TokenKind) -> bool {
  return kind == TokenKind.RightParenthesis || kind == TokenKind.RightBracket || kind == TokenKind.RightBrace
}

// The index of the first token after `at` that is not whitespace; `tokens.length` when none.
fn nextToken(tokens: &[Token], at: usize) -> usize {
  let mut next = at + 1
  while next < tokens.length && Tokens.kind(tokens[next]) == TokenKind.Whitespace { next = next + 1 }
  return next
}

// Whether the comma at `at` is followed, past whitespace and comments, by a closing delimiter.
fn trailingComma(tokens: &[Token], at: usize) -> bool {
  let mut next = at + 1
  while next < tokens.length && (Tokens.kind(tokens[next]) == TokenKind.Whitespace || isComment(Tokens.kind(tokens[next]))) { next = next + 1 }
  return next < tokens.length && closer(Tokens.kind(tokens[next]))
}

fn isComment(kind: TokenKind) -> bool {
  return kind == TokenKind.LineComment || kind == TokenKind.DocComment || kind == TokenKind.ModuleDocComment
}

fn commaElement(tokens: &[Token], element: Element) -> bool {
  return match element {
    Element.Token {id} => Tokens.kind(tokens[id.index]) == TokenKind.Comma
    _ => false
  }
}

// Whether element `at` is a comma token directly followed by a closing-delimiter token.
fn droppedComma(tokens: &[Token], elements: &[Element], at: usize) -> bool {
  if !commaElement(tokens, elements[at]) || at + 1 >= elements.length { return false }
  return match elements[at + 1] {
    Element.Token {id} => closer(Tokens.kind(tokens[id.index]))
    _ => false
  }
}

pub effect fn validate(before: &SyntaxTree, after: &SyntaxTree) -> () ! FormatError {
  let original = Bytes.asSlice(&before.source)
  let formatted = Bytes.asSlice(&after.source)
  let left = List<Token>.asSlice(&before.tokens)
  let right = List<Token>.asSlice(&after.tokens)
  let mut a: usize = 0
  let mut b: usize = 0
  while a < left.length || b < right.length {
    while a < left.length && Tokens.kind(left[a]) == TokenKind.Whitespace { a = a + 1 }
    while b < right.length && Tokens.kind(right[b]) == TokenKind.Whitespace { b = b + 1 }
    if a == left.length && b == right.length { break }
    let mut span = Span {start: original.length, end: original.length}
    if a < left.length { span = Tokens.span(left[a]) }
    // A trailing comma before a closing delimiter may be dropped when its list is joined.
    if a < left.length && Tokens.kind(left[a]) == TokenKind.Comma && (b == right.length || Tokens.kind(right[b]) != TokenKind.Comma)
      && trailingComma(left, a) && b < right.length && Tokens.kind(right[b]) == Tokens.kind(left[nextToken(left, a)]) {
      a = a + 1
      continue
    }
    // A trailing comma may be added when its list is broken.
    if b < right.length && Tokens.kind(right[b]) == TokenKind.Comma && (a == left.length || Tokens.kind(left[a]) != TokenKind.Comma)
      && trailingComma(right, b) && a < left.length && Tokens.kind(left[a]) == Tokens.kind(right[nextToken(right, b)]) {
      b = b + 1
      continue
    }
    if a == left.length || b == right.length { fail FormatError {span: span, reason: Reason.SafetyViolation} }
    let other = Tokens.span(right[b])
    if Tokens.kind(left[a]) != Tokens.kind(right[b]) || !same(Slice.view<u8>(original, span.start, span.end - span.start), Slice.view<u8>(formatted, other.start, other.end - other.start)) {
      fail FormatError {span: span, reason: Reason.SafetyViolation}
    }
    a = a + 1
    b = b + 1
  }
  let nodes = List<Node>.asSlice(&before.nodes)
  let others = List<Node>.asSlice(&after.nodes)
  a = 0
  while a < nodes.length && a < others.length {
    let current = &nodes[a]
    let other = &others[a]
    let elements = elementsOf(&before.elements, current)
    let otherElements = elementsOf(&after.elements, other)
    if current.kind != other.kind {
      fail FormatError {span: current.span, reason: Reason.SafetyViolation}
    }
    b = 0
    let mut c: usize = 0
    while b < elements.length {
      // The dropped trailing comma of a joined list has no element after formatting.
      if droppedComma(left, elements, b) && (c == otherElements.length || !commaElement(right, otherElements[c])) {
        b = b + 1
        continue
      }
      // The added trailing comma of a broken list has no element before formatting.
      if c < otherElements.length && droppedComma(right, otherElements, c) && !commaElement(left, elements[b]) {
        c = c + 1
        continue
      }
      if c == otherElements.length { fail FormatError {span: current.span, reason: Reason.SafetyViolation} }
      let consistent = match elements[b] {
        Element.Node {id} => match otherElements[c] {
          Element.Node {id: second} => id.index == second.index
          _ => false
        }
        Element.Token {id} => match otherElements[c] {
          Element.Token {id: second} => Tokens.kind(left[id.index]) == Tokens.kind(right[second.index])
          _ => false
        }
        Element.MissingToken {expected: ignoredExpected, span: ignoredSpan} => false
      }
      if !consistent { fail FormatError {span: current.span, reason: Reason.SafetyViolation} }
      b = b + 1
      c = c + 1
    }
    if c != otherElements.length { fail FormatError {span: current.span, reason: Reason.SafetyViolation} }
    a = a + 1
  }
  if nodes.length != others.length {
    let mut span = Span {start: original.length, end: original.length}
    if a < nodes.length { span = nodes[a].span }
    fail FormatError {span: span, reason: Reason.SafetyViolation}
  }
  return ()
}
