//! Meaning-preservation checks over exact tokens, comments, and reparsed syntax structure.

import format.FormatError {FormatError, Reason}
import lexer.Span {Span}
import lexer.Token as Tokens {Token, TokenKind}
import parser.Element {Element}
import parser.Node {Node}
import parser.SyntaxTree {SyntaxTree}
import silk.bytes {Bytes}
import silk.slice {Slice}
import silk.vector {Vector}
import silk.usize
import silk.u8

pub fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at: usize = 0
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + 1
  }
  return true
}

pub effect fn validate(before: &SyntaxTree, after: &SyntaxTree) -> () ! FormatError {
  let original = Bytes.asSlice(&before.source)
  let formatted = Bytes.asSlice(&after.source)
  let left = Vector.asSlice<Token>(&before.tokens)
  let right = Vector.asSlice<Token>(&after.tokens)
  let mut a: usize = 0
  let mut b: usize = 0
  while a < left.length || b < right.length {
    while a < left.length && Tokens.kind(left[a]) == TokenKind.Whitespace { a = a + 1 }
    while b < right.length && Tokens.kind(right[b]) == TokenKind.Whitespace { b = b + 1 }
    if a == left.length && b == right.length { break }
    let mut span = Span {start: original.length, end: original.length}
    if a < left.length { span = Tokens.span(left[a]) }
    if a == left.length || b == right.length { fail FormatError {span: span, reason: Reason.SafetyViolation} }
    let other = Tokens.span(right[b])
    if Tokens.kind(left[a]) != Tokens.kind(right[b]) || !same(Slice.view<u8>(original, span.start, span.end - span.start), Slice.view<u8>(formatted, other.start, other.end - other.start)) {
      fail FormatError {span: span, reason: Reason.SafetyViolation}
    }
    a = a + 1
    b = b + 1
  }
  let nodes = Vector.asSlice<Node>(&before.nodes)
  let others = Vector.asSlice<Node>(&after.nodes)
  a = 0
  while a < nodes.length && a < others.length {
    let current = &nodes[a]
    let other = &others[a]
    let elements = Vector.asSlice<Element>(&current.elements)
    let otherElements = Vector.asSlice<Element>(&other.elements)
    if current.kind != other.kind || elements.length != otherElements.length {
      fail FormatError {span: current.span, reason: Reason.SafetyViolation}
    }
    b = 0
    while b < elements.length {
      let consistent = match elements[b] {
        Element.Node {id} => match otherElements[b] {
          Element.Node {id: second} => id.index == second.index
          _ => false
        }
        Element.Token {id} => match otherElements[b] {
          Element.Token {id: second} => Tokens.kind(left[id.index]) == Tokens.kind(right[second.index])
          _ => false
        }
        Element.MissingToken {expected: ignoredExpected, span: ignoredSpan} => false
      }
      if !consistent { fail FormatError {span: current.span, reason: Reason.SafetyViolation} }
      b = b + 1
    }
    a = a + 1
  }
  if nodes.length != others.length {
    let mut span = Span {start: original.length, end: original.length}
    if a < nodes.length { span = nodes[a].span }
    fail FormatError {span: span, reason: Reason.SafetyViolation}
  }
  return ()
}
