//! Layout policy for declaration headers, members, import lists, and types.

import format.Policy {Shape, Separation}
import lexer.Token {TokenKind}
import parser.Node {NodeKind}

pub fn shape(kind: NodeKind) -> Shape {
  return match kind {
    NodeKind.SourceFile => Shape.Root
    NodeKind.Block => Shape.Block
    NodeKind.StructDeclaration => Shape.DeclarationBlock
    NodeKind.EnumDeclaration => Shape.DeclarationBlock
    NodeKind.UnionDeclaration => Shape.DeclarationBlock
    NodeKind.ServiceDeclaration => Shape.DeclarationBlock
    NodeKind.InterfaceDeclaration => Shape.DeclarationBlock
    NodeKind.RoleDeclaration => Shape.DeclarationBlock
    NodeKind.ImplDeclaration => Shape.DeclarationBlock
    NodeKind.DeclarationGroup => Shape.DeclarationBlock
    NodeKind.UnionVariant => Shape.SpacedList
    NodeKind.ImportMemberList => Shape.SpacedList
    NodeKind.TypeParameterList => Shape.List
    NodeKind.TypeArgumentList => Shape.List
    NodeKind.CallTypeArgumentList => Shape.List
    NodeKind.LifetimeBinderList => Shape.List
    NodeKind.ParameterList => Shape.List
    NodeKind.TupleDeclaration => Shape.List
    NodeKind.CallableType => Shape.List
    NodeKind.ForeignFunctionType => Shape.List
    _ => Shape.Inline
  }
}

pub fn separation(kind: NodeKind, left: TokenKind, right: TokenKind) -> Separation {
  if kind == NodeKind.TypePath || kind == NodeKind.ImportPath || kind == NodeKind.UnitType || kind == NodeKind.ParenthesizedType {
    return Separation.Tight
  }
  if kind == NodeKind.AppliedType {
    if left == TokenKind.OnceKeyword || left == TokenKind.MutKeyword { return Separation.Space }
    return Separation.Tight
  }
  if kind == NodeKind.SliceType {
    if left == TokenKind.Ampersand { return Separation.Tight }
    if left == TokenKind.Lifetime || left == TokenKind.MutKeyword { return Separation.Space }
    return Separation.Tight
  }
  if kind == NodeKind.EnumDeclaration && left == TokenKind.EnumKeyword && right == TokenKind.LeftParenthesis { return Separation.Tight }
  if kind == NodeKind.ReferenceType || kind == NodeKind.PointerType || kind == NodeKind.Requirement || kind == NodeKind.ProviderConstraint {
    if left == TokenKind.Ampersand || left == TokenKind.Star || left == TokenKind.Question { return Separation.Tight }
  }
  if right == TokenKind.LeftParenthesis && (kind == NodeKind.FunctionDeclaration || kind == NodeKind.ForeignFunctionDeclaration || kind == NodeKind.ServiceOperation || kind == NodeKind.CallableType || kind == NodeKind.ForeignFunctionType || kind == NodeKind.TupleDeclaration) { return Separation.Tight }
  if kind == NodeKind.WhereClause && left == TokenKind.Identifier { return Separation.Soft }
  if right == TokenKind.Less { return Separation.Tight }
  if left == TokenKind.Lifetime && right == TokenKind.Semicolon { return Separation.Tight }
  if right == TokenKind.Bang || right == TokenKind.Question { return Separation.Soft }
  if kind == NodeKind.UnionType && right == TokenKind.Pipe { return Separation.Soft }
  return Separation.Space
}
