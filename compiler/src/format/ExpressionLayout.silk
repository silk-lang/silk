//! Syntax-driven layouts for expressions, statements, and patterns.
//!
//! Lists retain their authored commas and grouping. Operator spacing follows the parser's
//! structural nodes, so formatting never reconstructs precedence or invents parentheses.

import format.Policy {Shape, Separation}
import lexer.Token {TokenKind}
import parser.Grammar
import parser.Node {NodeKind}

/// Selects the layout of a syntax node; a list without its delimiter remains inline.
pub fn shape(kind: NodeKind) -> Shape {
  return match kind {
    NodeKind.ArgumentList => Shape.List
    NodeKind.ArrayLiteralExpression => Shape.List
    NodeKind.TupleLiteralExpression => Shape.List
    NodeKind.StructLiteralExpression => Shape.SpacedList
    NodeKind.ContextualRecordLiteralExpression => Shape.SpacedList
    NodeKind.AppliedMemberExpression => Shape.SpacedList
    NodeKind.NominalPattern => Shape.SpacedList
    NodeKind.UnionVariantPattern => Shape.SpacedList
    NodeKind.Block => Shape.Block
    NodeKind.MatchExpression => Shape.Block
    _ => Shape.Inline
  }
}

/// Chooses separation between direct elements after common punctuation rules.
pub fn separation(kind: NodeKind, left: TokenKind, right: TokenKind) -> Separation {
  if kind == NodeKind.CallExpression || kind == NodeKind.FieldProjectionExpression || kind == NodeKind.OrdinalProjectionExpression || kind == NodeKind.ReferentProjectionExpression || kind == NodeKind.IndexProjectionExpression || kind == NodeKind.AppliedMemberSelector || kind == NodeKind.EnumMemberPattern {
    return Separation.Tight
  }
  if kind == NodeKind.PrefixExpression {
    return Separation.Tight
  }
  if kind == NodeKind.BorrowExpression || kind == NodeKind.MatchAccess || kind == NodeKind.MatchExpression {
    if left == TokenKind.Ampersand {
      // Two adjacent borrows must not turn into the logical-and token.
      if right == TokenKind.Ampersand { return Separation.Space }
      return Separation.Tight
    }
    return Separation.Space
  }
  if kind == NodeKind.IntegerLiteralExpression || kind == NodeKind.FloatingLiteralExpression || kind == NodeKind.IntegerPattern {
    if left == TokenKind.Minus { return Separation.Tight }
  }
  if kind == NodeKind.GroupedExpression || kind == NodeKind.UnitExpression || kind == NodeKind.CompileErrorExpression {
    return Separation.Tight
  }
  if kind == NodeKind.AnonymousCallableExpression && left == TokenKind.FnKeyword && right == TokenKind.LeftParenthesis {
    return Separation.Tight
  }
  if kind == NodeKind.InfixExpression || kind == NodeKind.PipelineExpression {
    if Grammar.precedence(left) > 0 { return Separation.Space }
    if Grammar.precedence(right) > 0 { return Separation.Soft }
  }
  if kind == NodeKind.ContextualRecordLiteralExpression && left == TokenKind.Dot && right == TokenKind.LeftBrace {
    return Separation.Tight
  }
  return Separation.Space
}
