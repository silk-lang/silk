//! Declaration, type, comment, and damage contracts for the native syntax formatter.

import format.FormatError {FormatError, Reason}
import format.SourceSyntax
import parser.SyntaxTree {SyntaxTree}
import silk.num.usize
import format.Safety
import format.SyntaxFormatter
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.effect {Effect}
import silk.core.result {Result}
import silk.text.string {String}
import silk.testing.testing {AssertionError, Testing}
import silk.io.writer {Writer, WriterError}
import silk.io.writer_native {StderrWriter}

effect fn formatted(source: string<'static>, expected: string<'static>) -> ()
! FormatError | OutOfMemoryError | WriterError | AssertionError<'static> ? &mut Allocator {
  let result = run SyntaxFormatter.format(String.utf8Bytes(source))
  if !Safety.same(Bytes.asSlice(&result), String.utf8Bytes(expected)) {
    let mut stderr = StderrWriter.make()
    run Writer.writeAll(Bytes.asSlice(&result)) |> Effect.provideMut<Writer>(&mut stderr)
  }
  run Testing.expect(Safety.same(Bytes.asSlice(&result), String.utf8Bytes(expected)), "canonical declaration bytes")
  let again = run SyntaxFormatter.format(Bytes.asSlice(&result))
  return run Testing.expect(Safety.same(Bytes.asSlice(&result), Bytes.asSlice(&again)), "declarations are idempotent")
}

test effect fn declarationImportsFieldsTypesAndBlankLines() -> ()
! FormatError | OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run formatted(
    """import silk.num.usize

// imports stay ordered

import other.Module {Thing,Other,}
pub struct Pair<T>{
left: T,
right: [ [i32 ;4] ; 3 ],
}
type Alias=Pair<i32>
""",
    """import silk.num.usize
// imports stay ordered
import other.Module { Thing, Other, }

pub struct Pair<T> {
  left: T,
  right: [[i32; 4]; 3],
}

type Alias = Pair<i32>
""",
  ) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn declarationCommentsRetainSpellingOrderAndAttachment() -> ()
! FormatError | OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run formatted(
    """//! Module prose

import silk.num.usize // import
/// detached import docs

/// imported docs
import other.Item
/// Pair docs
struct Pair{
/// Left docs
left:i32, // left

// right group
right:i32,
// final
}
/// unattached

type Alias=i32 // alias
""",
    """//! Module prose

import silk.num.usize // import
/// detached import docs

/// imported docs
import other.Item

/// Pair docs
struct Pair {
  /// Left docs
  left: i32, // left

  // right group
  right: i32,
  // final
}

/// unattached

type Alias = i32 // alias
""",
  ) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn rejected(source: &[u8], reason: Reason, start: usize) -> ()
! OutOfMemoryError | WriterError | AssertionError<'static> ? &mut Allocator {
  let result = run Effect.result(SyntaxFormatter.format(source))
  let correct = match move result {
    Result<Bytes, FormatError | OutOfMemoryError | WriterError>.Failure {error} => match move error {
      FormatError diagnostic => diagnostic.reason == reason && diagnostic.span.start == start
      OutOfMemoryError allocation => { fail move allocation }
      WriterError writer => { fail move writer }
    }
    Result<Bytes, FormatError | OutOfMemoryError | WriterError>.Success {value: _} => false
  }
  return run Testing.expect(correct, "damage is rejected at its source offset")
}

effect fn damage() -> ()
! OutOfMemoryError | WriterError | AssertionError<'static> ? &mut Allocator {
  run rejected(b"struct A {", Reason.SyntaxDamage, 10)
  run rejected(b"$", Reason.LexicalDamage, 0)
  return ()
}

test effect fn declarationDamageReportsOffsetsWithoutRepair() -> ()
! OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run damage() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn declarationFormattingDoesNotDemandSemanticsOrDocFences() -> ()
! FormatError | OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run formatted(
    """/// ```silk
/// invalid unfinished example {
/// ```
type Alias=MissingType
""",
    """/// ```silk
/// invalid unfinished example {
/// ```
type Alias = MissingType
""",
  ) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn declarationLifetimesForeignRecordsAndRepresentations() -> ()
! FormatError | OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run formatted(
    """pub extern "C" struct Buffer<'a>{
bytes: & 'a mut [ i32 ],
pointer: * mut u8,
}
enum ( u8 ) Mode{Read=1,Write,}
union Choice<T>{None,Some{pub value:T},}
pub unsafe extern "C" fn foreign( value : i32 ) -> i32 as "foreign"
unsafe extern "C" fn open(path: ?[*] const u8, flags: [*]mut u8) -> i32 with Intrinsic . foreign ( noCapture: ("path",) )
type Callback=for<'a> fn(&'a i32)->&'a i32
""",
    """pub extern "C" struct Buffer<'a> {
  bytes: &'a mut [i32],
  pointer: *mut u8,
}

enum(u8) Mode {
  Read = 1,
  Write,
}

union Choice<T> {
  None,
  Some { pub value: T },
}

pub unsafe extern "C" fn foreign(value: i32) -> i32 as "foreign"

unsafe extern "C" fn open(
  path: ?[*]const u8,
  flags: [*]mut u8,
) -> i32 with Intrinsic.foreign(noCapture: ("path",))

type Callback = for<'a> fn(&'a i32) -> &'a i32
""",
  ) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn declarationDirectivesTakeTheirOwnLines() -> ()
! FormatError | OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run formatted(
    """@ inline   @nonParking fn hinted( value : i32 ) -> i32 { return value }
@foreign ( memory : "read" , noCapture : ( "left" , "right" ) ) // facts the optimizer trusts
unsafe extern "C" fn read(left: ?*const u8, right: ?*const u8) -> i32
service Clock { @nonParking effect fn now() -> u64 }
fn sort(compare: @foreign(memory: "none")   extern "C" fn(i32, i32) -> i32) -> () { return () }
""",
    """@inline
@nonParking
fn hinted(value: i32) -> i32 {
  return value
}

@foreign(memory: "read", noCapture: ("left", "right")) // facts the optimizer trusts
unsafe extern "C" fn read(left: ?*const u8, right: ?*const u8) -> i32

service Clock {
  @nonParking
  effect fn now() -> u64
}

fn sort(compare: @foreign(memory: "none") extern "C" fn(i32, i32) -> i32) -> () {
  return ()
}
""",
  ) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn declarationLongSignaturesBreakValueParametersBeforeGenerics() -> ()
! FormatError | OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run formatted(
    """fn longName<'text>(text: string<'text>, startPosition: usize, endPosition: usize, other: usize) -> usize {
  return startPosition
}
""",
    """fn longName<'text>(
  text: string<'text>,
  startPosition: usize,
  endPosition: usize,
  other: usize,
) -> usize {
  return startPosition
}
""",
  ) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn declarationContractsImplsTupleAndConstants() -> ()
! FormatError | OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run formatted(
    """pub const answer:i32=42
tuple Pair<T>( T , i32 )
service Logger{effect fn log(value:i32)->() ? &mut Logger}
interface Show{fn show(self:&Self)->i32}
impl Show for Pair<i32>{show: Pair.show}
impl<T> Pair<T>{pub fn empty()->(){return ()}}
type Deferred<'env,A> =once Effect<'env;A ! Failure ? &Logger>
type BareOnce=once Effect
type BareMutable=mut Package.Effect
""",
    """pub const answer: i32 = 42

tuple Pair<T>(T, i32)

service Logger {
  effect fn log(value: i32) -> () ? &mut Logger
}

interface Show {
  fn show(self: &Self) -> i32
}

impl Show for Pair<i32> {
  show: Pair.show
}

impl<T> Pair<T> {
  pub fn empty() -> () {
    return ()
  }
}

type Deferred<'env, A> = once Effect<'env; A ! Failure ? &Logger>

type BareOnce = once Effect

type BareMutable = mut Package.Effect
""",
  ) |> Effect.provideMut<Allocator>(&mut allocator)
}


effect fn rejectsDifference(before: &SyntaxTree, source: &[u8], offset: usize) -> ()
! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let after = run SourceSyntax.parse(run Bytes.copy(source))
  let result = run Effect.result(Safety.validate(before, &after))
  let correct = match move result {
    Result<(), FormatError>.Failure {error} => error.reason == Reason.SafetyViolation && error.span.start == offset
    Result<(), FormatError>.Success {value: _} => false
  }
  return run Testing.expect(correct, "safety gate reports first authored difference")
}

effect fn changedTokensAndComments() -> ()
! FormatError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let before = run SourceSyntax.parse(run Bytes.copy(b"type A = i32 // first\n// second\n"))
  run rejectsDifference(&before, b"type A = u32 // first\n// second\n", 9)
  run rejectsDifference(&before, b"type A = i32 // second\n// first\n", 13)
  run rejectsDifference(&before, b"type A = i32 // first \n// second\n", 13)
  let spacing = run SourceSyntax.parse(run Bytes.copy(b"type  A=i32   // first\n  // second\n"))
  return run Safety.validate(&before, &spacing)
}

test effect fn safetyRejectsChangedTokensCommentsAndCommentOrder() -> ()
! FormatError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run changedTokensAndComments() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn changedStructure() -> ()
! FormatError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let before = run SourceSyntax.parse(run Bytes.copy(b"fn f(){a\n[1]\n}\n"))
  run SourceSyntax.validateSyntax(&before)
  let after = run SourceSyntax.parse(run Bytes.copy(b"fn f(){a[1]}\n"))
  run SourceSyntax.validateSyntax(&after)
  let result = run Effect.result(Safety.validate(&before, &after))
  let rejected = match move result {
    Result<(), FormatError>.Failure {error} => error.reason == Reason.SafetyViolation && error.span.start > 0
    Result<(), FormatError>.Success {value: _} => false
  }
  return run Testing.expect(rejected, "equal tokens can have different newline-sensitive syntax")
}

effect fn droppedTrailingCommas() -> ()
! FormatError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let before = run SourceSyntax.parse(run Bytes.copy(b"fn f(){g(1,\n)\nlet t=(1,)\n}\n"))
  let joined = run SourceSyntax.parse(run Bytes.copy(b"fn f(){g(1)\nlet t=(1,)\n}\n"))
  run Safety.validate(&before, &joined)
  let grouped = run SourceSyntax.parse(run Bytes.copy(b"fn f(){g(1,\n)\nlet t=(1)\n}\n"))
  let result = run Effect.result(Safety.validate(&before, &grouped))
  let rejected = match move result {
    Result<(), FormatError>.Failure {error} => error.reason == Reason.SafetyViolation
    Result<(), FormatError>.Success {value: _} => false
  }
  return run Testing.expect(rejected, "a list's trailing comma may be dropped, but a one-element tuple's comma may not")
}

test effect fn safetyAcceptsOnlyMeaninglessDroppedTrailingCommas() -> ()
! FormatError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run droppedTrailingCommas() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn safetyRejectsMeaningChangesWithIdenticalTokens() -> ()
! FormatError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run changedStructure() |> Effect.provideMut<Allocator>(&mut allocator)
}
