//! Declaration, type, comment, and damage contracts for the native syntax formatter.

import format.FormatError {FormatError, Reason}
import format.Safety
import format.SyntaxFormatter
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.effect {Effect}
import silk.result {Result}
import silk.string {String}
import silk.testing {AssertionError, Testing}
import silk.writer {Writer, WriterError}
import silk.os_writer {StderrWriter}

effect fn formatted(source: string<'static>, expected: string<'static>) -> ()
! FormatError | OutOfMemoryError | WriterError | AssertionError<'static> ? &mut Allocator {
  let result = run SyntaxFormatter.format(String.utf8Bytes(source))
  if !Safety.same(Bytes.asSlice(&result), String.utf8Bytes(expected)) {
    let mut stderr = StderrWriter.make()
    run Writer.writeAll(Bytes.asSlice(&result)) |> Effect.provideMut<Writer>(&mut stderr)
  }
  run Testing.expect(Safety.same(Bytes.asSlice(&result), String.utf8Bytes(expected)), "canonical declaration bytes")
  let again = run SyntaxFormatter.format(Bytes.asSlice(&result))
  return run Testing.expect(Safety.same(Bytes.asSlice(&result), Bytes.asSlice(&again)), "declarations are idempotent")
}

test effect fn declarationImportsFieldsTypesAndBlankLines() -> ()
! FormatError | OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run formatted(
    """import silk.usize

// imports stay ordered

import other.Module {Thing,Other,}
pub struct Pair<T>{
left: T
right: [ [i32 ;4] ; 3 ]
}
type Alias=Pair<i32>
""",
    """import silk.usize
// imports stay ordered
import other.Module { Thing, Other, }

pub struct Pair<T> {
  left: T
  right: [[i32; 4]; 3]
}

type Alias = Pair<i32>
""",
  ) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn declarationCommentsRetainSpellingOrderAndAttachment() -> ()
! FormatError | OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run formatted(
    """//! Module prose

import silk.usize // import
/// detached import docs

/// imported docs
import other.Item
/// Pair docs
struct Pair{
/// Left docs
left:i32 // left

// right group
right:i32
// final
}
/// unattached

type Alias=i32 // alias
""",
    """//! Module prose

import silk.usize // import
/// detached import docs

/// imported docs
import other.Item

/// Pair docs
struct Pair {
  /// Left docs
  left: i32 // left

  // right group
  right: i32
  // final
}

/// unattached

type Alias = i32 // alias
""",
  ) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn rejected(source: &[u8], reason: Reason, start: usize) -> ()
! OutOfMemoryError | WriterError | AssertionError<'static> ? &mut Allocator {
  let result = run Effect.result(SyntaxFormatter.format(source))
  let correct = match move result {
    Result<Bytes, FormatError | OutOfMemoryError | WriterError>.Failure {error} => match move error {
      FormatError diagnostic => diagnostic.reason == reason && diagnostic.span.start == start
      OutOfMemoryError allocation => { fail move allocation }
      WriterError writer => { fail move writer }
    }
    Result<Bytes, FormatError | OutOfMemoryError | WriterError>.Success {value: _} => false
  }
  return run Testing.expect(correct, "damage is rejected at its source offset")
}

effect fn damage() -> ()
! OutOfMemoryError | WriterError | AssertionError<'static> ? &mut Allocator {
  run rejected(b"struct A {", Reason.SyntaxDamage, 10)
  run rejected(b"$", Reason.LexicalDamage, 0)
  return ()
}

test effect fn declarationDamageReportsOffsetsWithoutRepair() -> ()
! OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run damage() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn declarationFormattingDoesNotDemandSemanticsOrDocFences() -> ()
! FormatError | OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run formatted(
    """/// ```silk
/// invalid unfinished example {
/// ```
type Alias=MissingType
""",
    """/// ```silk
/// invalid unfinished example {
/// ```
type Alias = MissingType
""",
  ) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn declarationLifetimesForeignRecordsAndRepresentations() -> ()
! FormatError | OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run formatted(
    """pub extern "C" struct Buffer<'a>{
bytes: & 'a mut [ i32 ]
pointer: * mut u8
}
enum ( u8 ) Mode{Read=1,Write,}
union Choice<T>{None,Some{pub value:T},}
pub unsafe extern "C" fn foreign( value : i32 ) -> i32 as "foreign"
type Callback=for<'a> fn(&'a i32)->&'a i32
""",
    """pub extern "C" struct Buffer<'a> {
  bytes: &'a mut [i32]
  pointer: *mut u8
}

enum(u8) Mode {
  Read = 1,
  Write,
}

union Choice<T> {
  None,
  Some { pub value: T },
}

pub unsafe extern "C" fn foreign(value: i32) -> i32 as "foreign"

type Callback = for<'a> fn(&'a i32) -> &'a i32
""",
  ) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn declarationContractsImplsTupleAndConstants() -> ()
! FormatError | OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run formatted(
    """pub const answer:i32=42
tuple Pair<T>( T , i32 )
service Logger{effect fn log(value:i32)->() ? &mut Logger}
interface Show{fn show(self:&Self)->i32}
impl Show for Pair<i32>{show: Pair.show}
impl<T> Pair<T>{pub fn empty()->(){return ()}}
type Deferred<'env,A> =once Effect<'env;A ! Failure ? &Logger>
""",
    """pub const answer: i32 = 42

tuple Pair<T>(T, i32)

service Logger {
  effect fn log(value: i32) -> () ? &mut Logger
}

interface Show {
  fn show(self: &Self) -> i32
}

impl Show for Pair<i32> {
  show: Pair.show
}

impl<T> Pair<T> {
  pub fn empty() -> () {
    return ()
  }
}

type Deferred<'env, A> = once Effect<'env; A ! Failure ? &Logger>
""",
  ) |> Effect.provideMut<Allocator>(&mut allocator)
}
