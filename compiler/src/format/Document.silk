//! An arena of width-aware formatting documents. Child identities belong to their arena.

import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.vector {Vector}
import silk.usize

pub struct Id { pub index: usize }
impl Copy for Id {}

pub union Node {
  Empty,
  Text {pub bytes: Bytes},
  Verbatim {pub bytes: Bytes},
  HardLine,
  Line {pub space: bool},
  Concat {pub left: Id, pub right: Id},
  Indent {pub child: Id},
  Group {pub child: Id},
  IfBreak {pub broken: Id, pub flat: Id},
}

pub struct Document { pub nodes: Vector<Node> }

pub fn make() -> Document { return Document {nodes: Vector.make<Node>()} }

pub effect fn add(self: &mut Document, node: Node) -> Id
! OutOfMemoryError ? &mut Allocator {
  let id = Id {index: Vector.length<Node>(&self.nodes)}
  run Vector.append<Node>(&mut self.nodes, move node)
  return id
}

pub effect fn text(self: &mut Document, bytes: &[u8]) -> Id
! OutOfMemoryError ? &mut Allocator {
  return run add(&mut self.*, Node.Text {bytes: run Bytes.copy(bytes)})
}

/// Copies protected token content without interpreting physical or horizontal whitespace.
pub effect fn verbatim(self: &mut Document, bytes: &[u8]) -> Id
! OutOfMemoryError ? &mut Allocator {
  return run add(&mut self.*, Node.Verbatim {bytes: run Bytes.copy(bytes)})
}

pub effect fn concat(self: &mut Document, left: Id, right: Id) -> Id
! OutOfMemoryError ? &mut Allocator {
  return run add(&mut self.*, Node.Concat {left: left, right: right})
}

pub effect fn join(self: &mut Document, separator: Id, values: &[Id]) -> Id
! OutOfMemoryError ? &mut Allocator {
  let mut result = run add(&mut self.*, Node.Empty)
  let mut at: usize = 0
  while at < values.length {
    if at > 0 { result = run concat(&mut self.*, result, separator) }
    result = run concat(&mut self.*, result, values[at])
    at = at + 1
  }
  return result
}

pub effect fn indent(self: &mut Document, child: Id) -> Id
! OutOfMemoryError ? &mut Allocator {
  return run add(&mut self.*, Node.Indent {child: child})
}

pub effect fn group(self: &mut Document, child: Id) -> Id
! OutOfMemoryError ? &mut Allocator {
  return run add(&mut self.*, Node.Group {child: child})
}
