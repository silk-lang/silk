//! An arena of width-aware formatting documents. Child identities belong to their arena.

import silk.allocator {Allocator, OutOfMemoryError}
import silk.vector {Vector}
import silk.usize

pub struct Id { pub index: usize }
impl Copy for Id {}

pub union Node<'text> {
  Empty,
  Text {pub bytes: &'text [u8]},
  Verbatim {pub bytes: &'text [u8]},
  HardLine,
  Line {pub space: bool},
  Concat {pub left: Id, pub right: Id},
  Indent {pub child: Id},
  Group {pub child: Id},
  IfBreak {pub broken: Id, pub flat: Id},
}

pub struct Document<'text> { pub nodes: Vector<Node<'text>> }

pub fn make<'text>() -> Document<'text> { return Document<'text> {nodes: Vector.make<Node<'text>>()} }

pub effect fn add<'text>(self: &mut Document<'text>, node: Node<'text>) -> Id
! OutOfMemoryError ? &mut Allocator {
  let id = Id {index: Vector.length<Node<'text>>(&self.nodes)}
  run Vector.append<Node<'text>>(&mut self.nodes, move node)
  return id
}

pub effect fn text<'text>(self: &mut Document<'text>, bytes: &'text [u8]) -> Id
! OutOfMemoryError ? &mut Allocator {
  return run add(&mut self.*, Node<'text>.Text {bytes: bytes})
}

/// Borrows protected token content without interpreting physical or horizontal whitespace.
pub effect fn verbatim<'text>(self: &mut Document<'text>, bytes: &'text [u8]) -> Id
! OutOfMemoryError ? &mut Allocator {
  return run add(&mut self.*, Node<'text>.Verbatim {bytes: bytes})
}

pub effect fn concat<'text>(self: &mut Document<'text>, left: Id, right: Id) -> Id
! OutOfMemoryError ? &mut Allocator {
  return run add(&mut self.*, Node<'text>.Concat {left: left, right: right})
}

pub effect fn join<'text>(self: &mut Document<'text>, separator: Id, values: &[Id]) -> Id
! OutOfMemoryError ? &mut Allocator {
  let mut result = run add(&mut self.*, Node<'text>.Empty)
  let mut at: usize = 0
  while at < values.length {
    if at > 0 { result = run concat(&mut self.*, result, separator) }
    result = run concat(&mut self.*, result, values[at])
    at = at + 1
  }
  return result
}

pub effect fn indent<'text>(self: &mut Document<'text>, child: Id) -> Id
! OutOfMemoryError ? &mut Allocator {
  return run add(&mut self.*, Node<'text>.Indent {child: child})
}

pub effect fn group<'text>(self: &mut Document<'text>, child: Id) -> Id
! OutOfMemoryError ? &mut Allocator {
  return run add(&mut self.*, Node<'text>.Group {child: child})
}
