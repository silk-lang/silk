//! Allocation-free Writer providers for measuring and collecting a rendered document.

import silk.writer {Writer, WriterError}
import silk.usize
import silk.bytes {Bytes}
import silk.allocator {Allocator, OutOfMemoryError}

pub struct Counter { pub length: usize }

impl Counter {
  effect fn writeAll(self: &mut Self, bytes: &[u8]) -> () ! WriterError {
    if bytes.length > usize.MAX - self.length { fail Writer.failure() }
    self.length = self.length + bytes.length
    return ()
  }
  effect fn flush(self: &mut Self) -> () ! WriterError { return () }
}

impl Writer for Counter { writeAll: Counter.writeAll flush: Counter.flush }

pub struct Buffer {
  pub bytes: Bytes
  pub length: usize
}

impl Buffer {
  effect fn writeAll(self: &mut Self, bytes: &[u8]) -> () ! WriterError {
    if self.length > Bytes.length(&self.bytes) || bytes.length > Bytes.length(&self.bytes) - self.length { fail Writer.failure() }
    let mut target = Bytes.asMutSlice(&mut self.bytes)
    let mut at: usize = 0
    while at < bytes.length {
      target[self.length] = bytes[at]
      self.length = self.length + 1
      at = at + 1
    }
    return ()
  }
  effect fn flush(self: &mut Self) -> () ! WriterError { return () }
}

impl Writer for Buffer { writeAll: Buffer.writeAll flush: Buffer.flush }

/// Reserves the final output once; writer operations never allocate.
pub effect fn make(length: usize) -> Buffer ! OutOfMemoryError ? &mut Allocator {
  let mut bytes = Bytes.make()
  run Bytes.reserveExact(&mut bytes, length)
  let mut at: usize = 0
  while at < length {
    run Bytes.append(&mut bytes, b"\0")
    at = at + 1
  }
  return Buffer {bytes: move bytes, length: 0}
}
