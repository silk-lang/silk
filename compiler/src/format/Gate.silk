//! Standalone CI safety gate. Its arguments are the sorted repository-owned Silk source paths.
//! It formats each source in memory and verifies the result, leaving the checkout unchanged so the
//! corpus job builds and runs the committed text. This is a build target, separate from the
//! sub-second source test suite.

import format.FormatError {FormatError}
import format.Safety
import format.SourceSyntax
import format.SyntaxFormatter
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.effect {Effect}
import silk.filesystem {FileSystem, FileError, Path}
import silk.format {Format}
import silk.host_input {HostInput, HostInputError}
import silk.option {Option}
import silk.os_filesystem {OsFileSystem}
import silk.os_writer {StdoutWriter}
import silk.result {Result}
import silk.u8
import silk.usize
import silk.writer {Writer, WriterError}

pub struct GateFailure {
  offset: usize
  rule: string<'static>
}

effect fn inspect(path: &Path) -> bool
! GateFailure | OutOfMemoryError | WriterError | FileError ? &mut Allocator | &mut Writer | &mut FileSystem {
  let source = run FileSystem.readFile(path)
  let tree = run SourceSyntax.parse(move source)
  let accepted = run Effect.result(SourceSyntax.validateSyntax(&tree))
  if let Result<(), FormatError>.Failure {error} = move accepted {
    run Writer.writeAll(b"FORMAT_PARSER_REJECTED ")
    run Writer.writeAll(Path.rawBytes(path))
    run Writer.writeAll(b" offset=")
    run Format.display<usize>(&error.span.start)
    run Writer.writeAll(b"\n")
    return false
  }
  let attempted = run Effect.result(SyntaxFormatter.formatTree(&tree))
  let formatted = match move attempted {
    Result<Bytes, FormatError | OutOfMemoryError | WriterError>.Success {value} => move value
    Result<Bytes, FormatError | OutOfMemoryError | WriterError>.Failure {error} => match move error {
      FormatError invalid => { fail GateFailure {offset: invalid.span.start, rule: "formatter rejected parser-accepted source"} }
      OutOfMemoryError allocation => { fail move allocation }
      WriterError writer => { fail move writer }
    }
  }
  let reparsed = run SourceSyntax.parse(move formatted)
  let retained = run Effect.result(Safety.validate(&tree, &reparsed))
  if let Result<(), FormatError>.Failure {error} = move retained {
    fail GateFailure {offset: error.span.start, rule: "significant token, comment, or syntax shape changed"}
  }
  let complete = run Effect.result(SourceSyntax.validateSyntax(&reparsed))
  if let Result<(), FormatError>.Failure {error} = move complete {
    fail GateFailure {offset: error.span.start, rule: "output no longer parses (formatted byte offset)"}
  }
  let repeated = run Effect.result(SyntaxFormatter.formatTree(&reparsed))
  let again = match move repeated {
    Result<Bytes, FormatError | OutOfMemoryError | WriterError>.Success {value} => move value
    Result<Bytes, FormatError | OutOfMemoryError | WriterError>.Failure {error} => match move error {
      FormatError invalid => { fail GateFailure {offset: invalid.span.start, rule: "formatter rejected its own output (formatted byte offset)"} }
      OutOfMemoryError allocation => { fail move allocation }
      WriterError writer => { fail move writer }
    }
  }
  let left = Bytes.asSlice(&reparsed.source)
  let right = Bytes.asSlice(&again)
  if !Safety.same(left, right) {
    let mut offset: usize = 0
    while offset < left.length && offset < right.length && left[offset] == right[offset] { offset = offset + 1 }
    fail GateFailure {offset: offset, rule: "non-idempotent output (formatted byte offset)"}
  }
  return true
}

effect fn argument(index: usize) -> Bytes ! HostInputError | GateFailure | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  let found = run HostInput.argument(index)
  return match move found {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => { fail GateFailure {offset: 0, rule: "missing source path"} }
  }
}

effect fn program() -> i32
! GateFailure | OutOfMemoryError | WriterError | FileError | HostInputError ? &mut Allocator | &mut Writer | &mut FileSystem | &mut HostInput {
  let cwdBytes = run HostInput.workingDirectory()
  let cwd = run Path.fromBytes(Bytes.asSlice(&cwdBytes))
  let count = run HostInput.argumentCount()
  if count <= 1 { fail GateFailure {offset: 0, rule: "no repository sources selected"} }
  let mut checked: usize = 0
  let mut rejected: usize = 0
  let mut at: usize = 1
  while at < count {
    let name = run argument(at)
    let path = run Path.joinBytes(&cwd, Bytes.asSlice(&name))
    let result = run Effect.result(inspect(&path))
    match move result {
      Result<bool, GateFailure | OutOfMemoryError | WriterError | FileError>.Success {value} => {
        if value { checked = checked + 1 }
        else { rejected = rejected + 1 }
      }
      Result<bool, GateFailure | OutOfMemoryError | WriterError | FileError>.Failure {error} => {
        run Writer.writeAll(b"FORMAT_FAILURE ")
        run Writer.writeAll(Path.rawBytes(&path))
        return match move error {
          GateFailure failure => {
            run Writer.writeAll(b" offset=")
            run Format.display<usize>(&failure.offset)
            run Writer.writeAll(b" ")
            run Writer.writeString(failure.rule)
            run Writer.writeAll(b"\n")
            return 1
          }
          OutOfMemoryError allocation => {
            run Writer.writeAll(b" offset=0 allocation failure\n")
            return 2
          }
          WriterError writer => { fail move writer }
          FileError filesystem => {
            run Writer.writeAll(b" offset=0 filesystem failure, operation=")
            run Format.display<i32>(&filesystem.operation.code)
            run Writer.writeAll(b" reason=")
            run Format.display<i32>(&filesystem.reason.code)
            run Writer.writeAll(b"\n")
            return 2
          }
        }
      }
    }
    at = at + 1
  }
  run Writer.writeAll(b"FORMAT_SAFETY checked=")
  run Format.display<usize>(&checked)
  run Writer.writeAll(b" parser-rejected=")
  run Format.display<usize>(&rejected)
  run Writer.writeAll(b"\n")
  if checked == 0 { fail GateFailure {offset: 0, rule: "no parser-accepted source was checked"} }
  return 0
}

pub effect fn main() -> i32
! GateFailure | OutOfMemoryError | WriterError | FileError | HostInputError ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut files = run OsFileSystem.make(b"/")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut output = StdoutWriter.make()
  return run program()
    |> Effect.provideMut<Allocator>(&mut allocator)
    |> Effect.provideMut<FileSystem>(&mut files)
    |> Effect.provideMut<Writer>(&mut output)
}
