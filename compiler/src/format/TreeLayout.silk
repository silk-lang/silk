//! Postorder syntax-to-document construction, retaining source tokens and comment attachment.

import format.Document as Documents {Document, Id, Node as DocumentNode}
import format.DeclarationLayout
import format.ExpressionLayout
import format.Policy {Shape, Separation}
import format.SourceSyntax
import format.Trivia {Gap}
import format.Trivia
import lexer.Span {Span}
import lexer.Token as Tokens {Token, TokenKind}
import parser.Element {Element}
import parser.Node {Node, NodeKind, elementsOf}
import parser.SyntaxTree {SyntaxTree}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.ownership {Copy}
import silk.collections.slice {Slice}
import silk.collections.list {List}
import silk.num.usize

pub struct Layout<'tree> {
  pub document: Document<'tree>,
  pub root: Id,
}

struct Item {
  span: Span,
  first: TokenKind,
  last: TokenKind,
  kind: NodeKind,
  child: bool,
  document: Id,
}
impl Copy for Item {}

fn tokenBounds(tree: &SyntaxTree, span: Span) -> Span {
  let tokens = List<Token>.asSlice(&tree.tokens)
  let mut first = SourceSyntax.lowerBound(tree, span.start)
  let mut end = SourceSyntax.lowerBound(tree, span.end)
  while first < end && (Tokens.kind(tokens[first]) == TokenKind.Whitespace || SourceSyntax.isComment(Tokens.kind(tokens[first]))) { first = first + 1 }
  while end > first && (Tokens.kind(tokens[end - 1]) == TokenKind.Whitespace || SourceSyntax.isComment(Tokens.kind(tokens[end - 1]))) { end = end - 1 }
  return Span {start: first, end: end}
}

effect fn item<'tree>(document: &mut Document<'tree>, tree: &'tree SyntaxTree, rendered: &[Id], element: Element) -> Item
! OutOfMemoryError ? &mut Allocator {
  let nodes = List<Node>.asSlice(&tree.nodes)
  let tokens = List<Token>.asSlice(&tree.tokens)
  return match element {
    Element.Node {id} => {
      let node = &nodes[id.index]
      let bounds = tokenBounds(tree, node.span)
      let mut first = TokenKind.EndOfFile
      let mut last = TokenKind.EndOfFile
      // A node spans its own tokens: one that ends in a supplied child, such as a bare `return`'s
      // implied `()`, leaves the comments after its last token to its parent.
      let mut span = node.span
      if bounds.start < bounds.end {
        first = Tokens.kind(tokens[bounds.start])
        last = Tokens.kind(tokens[bounds.end - 1])
        span = Span {start: Tokens.span(tokens[bounds.start]).start, end: Tokens.span(tokens[bounds.end - 1]).end}
      }
      return Item {span: span, first: first, last: last, kind: node.kind, child: true, document: rendered[id.index]}
    }
    Element.Token {id} => {
      let token = tokens[id.index]
      let span = Tokens.span(token)
      let kind = Tokens.kind(token)
      let bytes = Slice.view<u8>(Bytes.asSlice(&tree.source), span.start, span.end - span.start)
      let text = run Documents.verbatim(&mut document.*, bytes)
      return Item {span: span, first: kind, last: kind, kind: NodeKind.SourceFile, child: false, document: text}
    }
    Element.MissingToken {expected: _, span} => {
      return Item {span: span, first: TokenKind.EndOfFile, last: TokenKind.EndOfFile, kind: NodeKind.Error, child: false, document: run Documents.add(&mut document.*, DocumentNode<'tree>.Empty)}
    }
  }
}

// Lists whose trailing comma carries no meaning, written exactly when the list is broken; a
// one-element tuple's comma is its syntax.
fn droppableTrailingComma(kind: NodeKind) -> bool {
  return kind == NodeKind.StructLiteralExpression || kind == NodeKind.ContextualRecordLiteralExpression
    || kind == NodeKind.ArgumentList || kind == NodeKind.ArrayLiteralExpression || kind == NodeKind.ParameterList
}

// The first token kind of a direct element; `EndOfFile` for a node or a missing token.
fn elementKind(tree: &SyntaxTree, element: Element) -> TokenKind {
  return match element {
    Element.Token {id} => Tokens.kind(List<Token>.asSlice(&tree.tokens)[id.index])
    _ => TokenKind.EndOfFile
  }
}

// Whether a direct element is a directive node.
fn directive(tree: &SyntaxTree, element: Element) -> bool {
  return match element {
    Element.Node {id} => List<Node>.asSlice(&tree.nodes)[id.index].kind == NodeKind.Directive
    _ => false
  }
}

fn closes(opening: TokenKind, kind: TokenKind) -> bool {
  return (opening == TokenKind.LeftBrace && kind == TokenKind.RightBrace) || (opening == TokenKind.LeftParenthesis && kind == TokenKind.RightParenthesis)
    || (opening == TokenKind.LeftBracket && kind == TokenKind.RightBracket)
}

fn opens(kind: TokenKind) -> bool {
  return kind == TokenKind.LeftBrace || kind == TokenKind.LeftBracket || kind == TokenKind.LeftParenthesis || kind == TokenKind.Less
}

fn common(kind: NodeKind, left: TokenKind, right: TokenKind) -> Separation {
  if kind == NodeKind.InfixExpression || kind == NodeKind.PipelineExpression {
    return ExpressionLayout.separation(kind, left, right)
  }
  if right == TokenKind.Dot && (left == TokenKind.DecimalInteger || left == TokenKind.DecimalFloat) { return Separation.Space }
  if right == TokenKind.Comma || right == TokenKind.Colon || right == TokenKind.Semicolon || left == TokenKind.Dot { return Separation.Tight }
  if left == TokenKind.LeftParenthesis || left == TokenKind.LeftBracket || left == TokenKind.Less || right == TokenKind.RightParenthesis || right == TokenKind.RightBracket || right == TokenKind.Greater { return Separation.Tight }
  if left == TokenKind.Comma { return Separation.Soft }
  if left == TokenKind.Colon || left == TokenKind.Semicolon { return Separation.Space }
  let expression = ExpressionLayout.separation(kind, left, right)
  if expression != Separation.Space { return expression }
  return DeclarationLayout.separation(kind, left, right)
}

effect fn separator<'text>(document: &mut Document<'text>, selected: Separation) -> Id
! OutOfMemoryError ? &mut Allocator {
  return match selected {
    Separation.Tight => run Documents.add(&mut document.*, DocumentNode<'text>.Empty)
    Separation.Space => run Documents.text(&mut document.*, b" ")
    Separation.Soft => run Documents.add(&mut document.*, DocumentNode<'text>.Line {space: true})
  }
}

effect fn node<'tree>(document: &mut Document<'tree>, tree: &'tree SyntaxTree, rendered: &[Id], syntax: &Node) -> Id
! OutOfMemoryError ? &mut Allocator {
  let mut shape = DeclarationLayout.shape(syntax.kind)
  if shape == Shape.Inline { shape = ExpressionLayout.shape(syntax.kind) }
  let elements = elementsOf(&tree.elements, syntax)
  let empty = run Documents.add(&mut document.*, DocumentNode<'tree>.Empty)
  let mut header = empty
  let mut body = empty
  let mut suffix = empty
  let mut opened = false
  let mut delimiter = TokenKind.EndOfFile
  let mut closed = false
  let mut previous = Item {span: Span {start: syntax.span.start, end: syntax.span.start}, first: TokenKind.EndOfFile, last: TokenKind.EndOfFile, kind: NodeKind.SourceFile, child: false, document: empty}
  let mut before = false
  // An operator that moved to a continuation line carries its right operand with it, so a call
  // there that breaks indents its arguments past the operator's line.
  let operands = syntax.kind == NodeKind.InfixExpression || syntax.kind == NodeKind.PipelineExpression
  let mut continued = false
  let mut at: usize = 0
  // Leading directives each take their own line ahead of the declaration, outside its group, so
  // they never break the header's soft lines. A foreign function type keeps them inline.
  let mut prefix = empty
  let mut prefixed = false
  if syntax.kind != NodeKind.ForeignFunctionType {
    while at < elements.length && directive(tree, elements[at]) {
      let current = run item(&mut document.*, tree, rendered, elements[at])
      if before {
        let trivia = run Trivia.between(&mut document.*, tree, previous.span.end, current.span.start, true, 1, false)
        let mut gap = run Trivia.lines(&mut document.*, 1)
        if trivia.comments {
          let after = run Trivia.lines(&mut document.*, trivia.after)
          gap = run Documents.concat(&mut document.*, trivia.document, after)
        }
        prefix = run Documents.concat(&mut document.*, prefix, gap)
      }
      prefix = run Documents.concat(&mut document.*, prefix, current.document)
      prefixed = true
      previous = current
      before = true
      at = at + 1
    }
    if prefixed && at < elements.length {
      let next = run item(&mut document.*, tree, rendered, elements[at])
      let trivia = run Trivia.between(&mut document.*, tree, previous.span.end, next.span.start, true, 1, false)
      let mut gap = run Trivia.lines(&mut document.*, 1)
      if trivia.comments {
        let after = run Trivia.lines(&mut document.*, trivia.after)
        gap = run Documents.concat(&mut document.*, trivia.document, after)
      }
      prefix = run Documents.concat(&mut document.*, prefix, gap)
      // The declaration starts fresh after the directives' own lines and comments.
      previous = Item {span: Span {start: next.span.start, end: next.span.start}, first: TokenKind.EndOfFile, last: TokenKind.EndOfFile, kind: NodeKind.SourceFile, child: false, document: empty}
      before = false
    }
  }
  while at < elements.length {
    let mut current = run item(&mut document.*, tree, rendered, elements[at])
    // A list's written trailing comma is kept only when the list is broken.
    if opened && !current.child && current.first == TokenKind.Comma && droppableTrailingComma(syntax.kind)
      && at + 1 < elements.length && closes(delimiter, elementKind(tree, elements[at + 1])) {
      let flat = run Documents.add(&mut document.*, DocumentNode<'tree>.Empty)
      current.document = run Documents.add(&mut document.*, DocumentNode<'tree>.IfBreak {broken: current.document, flat: flat})
    }
    let closing = opened && !current.child && ((delimiter == TokenKind.LeftBrace && current.first == TokenKind.RightBrace) || (delimiter == TokenKind.LeftParenthesis && current.first == TokenKind.RightParenthesis) || (delimiter == TokenKind.LeftBracket && current.first == TokenKind.RightBracket) || (delimiter == TokenKind.Less && current.first == TokenKind.Greater))
    let blockShape = shape == Shape.Block || shape == Shape.DeclarationBlock
    let opening = !opened && shape != Shape.Inline && shape != Shape.Root && !current.child && opens(current.first) && (!blockShape || current.first == TokenKind.LeftBrace)
    let mut minimum: usize = 0
    let mut gap = empty
    let mut continuation = false
    if before && current.first != TokenKind.EndOfFile {
      if shape == Shape.Root && current.child && previous.child {
        minimum = 2
        if current.kind == NodeKind.ImportDeclaration && previous.kind == NodeKind.ImportDeclaration { minimum = 1 }
        gap = run Trivia.lines(&mut document.*, minimum)
      } else if opened && !closed && (shape == Shape.Block || shape == Shape.DeclarationBlock) {
        if closing && previous.last == TokenKind.LeftBrace {
          gap = empty
        } else if closing || previous.last == TokenKind.LeftBrace || current.child && previous.child {
          minimum = 1
          if !closing && previous.last != TokenKind.LeftBrace && Trivia.lineCount(Bytes.asSlice(&tree.source), previous.span.end, current.span.start) > 1 { minimum = 2 }
          if !closing && previous.child && current.child && (current.kind == NodeKind.FunctionDeclaration || current.kind == NodeKind.ImplOperation || current.kind == NodeKind.ServiceOperation) { minimum = 2 }
          gap = run Trivia.lines(&mut document.*, minimum)
        } else {
        let selected = common(syntax.kind, previous.last, current.first)
        continuation = selected == Separation.Soft && !opened
        gap = run separator(&mut document.*, selected)
      }
      } else if opened && !closed && (previous.last == TokenKind.LeftBrace || previous.last == TokenKind.LeftParenthesis || previous.last == TokenKind.LeftBracket || previous.last == TokenKind.Less || closing) {
        if !(closing && opens(previous.last)) {
          gap = run Documents.add(&mut document.*, DocumentNode<'tree>.Line {space: shape == Shape.SpacedList})
        }
      } else {
        let selected = common(syntax.kind, previous.last, current.first)
        continuation = selected == Separation.Soft && !opened
        gap = run separator(&mut document.*, selected)
      }
    }
    // A node the parser supplies without source tokens, such as a closure's implied `return ()`,
    // leaves the comments before it to the next element, so they are written once.
    let supplied = current.child && current.first == TokenKind.EndOfFile
    let mut trivia = Gap {document: empty, comments: false, after: 0}
    if !supplied {
      trivia = run Trivia.between(&mut document.*, tree, previous.span.end, current.span.start, before, minimum, shape == Shape.Root && current.kind == NodeKind.ImportDeclaration && previous.kind == NodeKind.ImportDeclaration)
    }
    // A broken list ends with a comma, whether or not the source wrote one.
    if closing && droppableTrailingComma(syntax.kind) && previous.last != TokenKind.Comma && previous.last != TokenKind.Ellipsis
      && !opens(previous.last) {
      let comma = run Documents.text(&mut document.*, b",")
      let flat = run Documents.add(&mut document.*, DocumentNode<'tree>.Empty)
      let trailing = run Documents.add(&mut document.*, DocumentNode<'tree>.IfBreak {broken: comma, flat: flat})
      body = run Documents.concat(&mut document.*, body, trailing)
    }
    if trivia.comments {
      // An arm body after a comment stays indented under its `=>`, not at the pattern's column.
      if !opened && previous.last == TokenKind.FatArrow { continuation = true }
      let after = run Trivia.lines(&mut document.*, trivia.after)
      if closing {
        body = run Documents.concat(&mut document.*, body, trivia.document)
        gap = after
      } else {
        gap = run Documents.concat(&mut document.*, trivia.document, after)
      }
    }
    let mut part = run Documents.concat(&mut document.*, gap, current.document)
    if continuation || (continued && !opened) { part = run Documents.indent(&mut document.*, part) }
    if continuation && operands { continued = true }
    if closing {
      suffix = run Documents.concat(&mut document.*, suffix, part)
      closed = true
    } else if opened && !closed { body = run Documents.concat(&mut document.*, body, part) }
    else if closed { suffix = run Documents.concat(&mut document.*, suffix, part) }
    else { header = run Documents.concat(&mut document.*, header, part) }
    if opening {
      opened = true
      delimiter = current.first
    }
    if current.first != TokenKind.EndOfFile {
      previous = current
      before = true
    }
    at = at + 1
  }
  let indented = run Documents.indent(&mut document.*, body)
  let leading = run Documents.concat(&mut document.*, header, indented)
  let complete = run Documents.concat(&mut document.*, leading, suffix)
  let grouped = run Documents.group(&mut document.*, complete)
  if prefixed { return run Documents.concat(&mut document.*, prefix, grouped) }
  return grouped
}

pub effect fn make<'tree>(tree: &'tree SyntaxTree) -> Layout<'tree>
! OutOfMemoryError ? &mut Allocator {
  let mut document = Documents.make<'tree>()
  let mut rendered = List<Id>.make()
  let nodes = List<Node>.asSlice(&tree.nodes)
  let mut at: usize = 0
  while at < nodes.length {
    let result = run node(&mut document, tree, List<Id>.asSlice(&rendered), &nodes[at])
    run List<Id>.append(&mut rendered, result)
    at = at + 1
  }
  return Layout<'tree> {document: move document, root: List<Id>.get(&rendered, tree.root.index)}
}
