//! Canonical syntax-only source formatting with token, comment, and parse-shape safety checks.

import format.FormatError {FormatError, Reason}
import silk.effect {Effect}
import silk.result {Result}
import format.Printer
import format.Safety
import format.SourceSyntax
import format.TreeLayout
import parser.SyntaxTree {SyntaxTree}
import lexer.Span {Span}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.writer {Writer, WriterError}

/// Returns canonical source bytes, rejecting damage or any change to tokens or syntax shape.
pub effect fn formatTree(tree: &SyntaxTree) -> Bytes
! FormatError | OutOfMemoryError | WriterError ? &mut Allocator {
  run SourceSyntax.validate(tree)
  let layout = run TreeLayout.make(tree)
  let bytes = run Printer.render(&layout.document, layout.root)
  let reparsed = run SourceSyntax.parse(move bytes)
  run Safety.validate(tree, &reparsed)
  let complete = run Effect.result(SourceSyntax.validate(&reparsed))
  if let Result<(), FormatError>.Failure {error: ignored} = move complete {
    fail FormatError {span: Span {start: 0, end: 0}, reason: Reason.SafetyViolation}
  }
  let SyntaxTree {source: formatted, tokens: ignoredTokens, nodes: ignoredNodes, root: ignoredRoot, diagnostics: ignoredDiagnostics} = move reparsed
  return move formatted
}

/// Parses borrowed source bytes once and formats its complete lossless artifact.
pub effect fn format(source: &[u8]) -> Bytes
! FormatError | OutOfMemoryError | WriterError ? &mut Allocator {
  let tree = run SourceSyntax.parse(run Bytes.copy(source))
  return run formatTree(&tree)
}

/// Writes validated canonical source through the supplied Writer.
pub effect fn write(source: &[u8]) -> ()
! FormatError | OutOfMemoryError | WriterError ? &mut Allocator | &mut Writer {
  let bytes = run format(source)
  return run Writer.writeAll(Bytes.asSlice(&bytes))
}
