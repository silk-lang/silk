//! Deterministic 100-column document rendering with two-space indentation.

import format.Document {Document, Id, Node}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.writer {Writer, WriterError}
import silk.effect {Effect}
import format.Output as Output {Counter, Buffer}
import silk.vector {Vector}
import silk.slice {Slice}
import silk.usize
import silk.bool
import silk.u8

struct Command {
  id: Id
  indentation: usize
  flat: bool
}
impl Copy for Command {}

effect fn push(stack: &mut Vector<Command>, id: Id, indentation: usize, flat: bool) -> ()
! OutOfMemoryError ? &mut Allocator {
  return run Vector.append<Command>(&mut stack.*, Command {id: id, indentation: indentation, flat: flat})
}

// Inspect the candidate and pending suffixes until the first physical break or width overflow.
effect fn fits<'text>(document: &Document<'text>, id: Id, available: usize, continuation: &[Command]) -> bool
! OutOfMemoryError ? &mut Allocator {
  let mut stack = Vector.make<Command>()
  let mut remaining = continuation.length
  run push(&mut stack, id, 0, true)
  let mut width: usize = 0
  while Vector.length<Command>(&stack) > 0 || remaining > 0 {
    let mut command = Command {id: id, indentation: 0, flat: true}
    if Vector.length<Command>(&stack) > 0 {
      let last = Vector.length<Command>(&stack) - 1
      command = Vector.get<Command>(&stack, last)
      Vector.truncate<Command>(&mut stack, last)
    } else {
      remaining = remaining - 1
      command = continuation[remaining]
    }
    let nodes = Vector.asSlice<Node<'text>>(&document.nodes)
    match & nodes[command.id.index] {
      Node<'text>.Empty => {}
      Node<'text>.Text {bytes} => { width = width + bytes.length }
      Node<'text>.Verbatim {bytes} => {
        let content = bytes
        let mut at: usize = 0
        while at < content.length {
          if content[at] == 10 || content[at] == 13 { return false }
          width = width + 1
          at = at + 1
        }
      }
      Node<'text>.HardLine => { return !command.flat }
      Node<'text>.Line {space} => {
        if !command.flat { return true }
        if space { width = width + 1 }
      }
      Node<'text>.Concat {left, right} => {
        run push(&mut stack, right, 0, command.flat)
        run push(&mut stack, left, 0, command.flat)
      }
      Node<'text>.Indent {child} => { run push(&mut stack, child, 0, command.flat) }
      Node<'text>.Group {child} => { run push(&mut stack, child, 0, true) }
      Node<'text>.IfBreak {broken, flat} => {
        if command.flat { run push(&mut stack, flat, 0, true) }
        else { run push(&mut stack, broken, 0, false) }
      }
    }
    if width > available { return false }
  }
  return true
}

effect fn padding(count: usize) -> () ! WriterError ? &mut Writer {
  let spaces = b"                                                                "
  let mut remaining = count
  while remaining >= spaces.length {
    run Writer.writeAll(spaces)
    remaining = remaining - spaces.length
  }
  if remaining > 0 { run Writer.writeAll(Slice.view<u8>(spaces, 0, remaining)) }
  return ()
}

/// Renders one arena root. Layout lines use LF
/// Verbatim bytes are copied exactly.
/// The root must belong to the supplied arena. Exactly one final layout LF is emitted.
pub effect fn write<'text>(document: &Document<'text>, root: Id) -> ()
! OutOfMemoryError | WriterError ? &mut Allocator | &mut Writer {
  let mut stack = Vector.make<Command>()
  run push(&mut stack, root, 0, false)
  let mut column: usize = 0
  let mut pending: usize = 0
  let mut lines: usize = 0
  while Vector.length<Command>(&stack) > 0 {
    let last = Vector.length<Command>(&stack) - 1
    let command = Vector.get<Command>(&stack, last)
    Vector.truncate<Command>(&mut stack, last)
    let nodes = Vector.asSlice<Node<'text>>(&document.nodes)
    match & nodes[command.id.index] {
      Node<'text>.Empty => {}
      Node<'text>.HardLine => {
        lines = lines + 1
        pending = command.indentation
        column = command.indentation
      }
      Node<'text>.Line {space} => {
        if command.flat {
          if space { pending = pending + 1
          column = column + 1 }
        } else {
          lines = lines + 1
          pending = command.indentation
          column = command.indentation
        }
      }
      Node<'text>.Text {bytes} => {
        if bytes.length > 0 {
          let mut at: usize = 0
          while at < lines { run Writer.writeAll( b"\n")
          at = at + 1 }
          lines = 0
          run padding(pending)
          pending = 0
          run Writer.writeAll( bytes)
          column = column + bytes.length
        }
      }
      Node<'text>.Verbatim {bytes} => {
        if bytes.length > 0 {
          let mut at: usize = 0
          while at < lines { run Writer.writeAll( b"\n")
          at = at + 1 }
          lines = 0
          run padding(pending)
          pending = 0
          let content = bytes
          run Writer.writeAll( content)
          at = 0
          while at < content.length {
            if content[at] == 10 || content[at] == 13 { column = 0 }
            else { column = column + 1 }
            at = at + 1
          }
        }
      }
      Node<'text>.Concat {left, right} => {
        run push(&mut stack, right, command.indentation, command.flat)
        run push(&mut stack, left, command.indentation, command.flat)
      }
      Node<'text>.Indent {child} => {
        run push(&mut stack, child, command.indentation + 2, command.flat)
      }
      Node<'text>.Group {child} => {
        let mut flat = command.flat
        if !flat && column <= 100 { flat = run fits(document, child, 100 - column, Vector.asSlice<Command>(&stack)) }
        run push(&mut stack, child, command.indentation, flat)
      }
      Node<'text>.IfBreak {broken, flat} => {
        if command.flat { run push(&mut stack, flat, command.indentation, true) }
        else { run push(&mut stack, broken, command.indentation, false) }
      }
    }
  }
  run Writer.writeAll( b"\n")
  return ()
}

/// Collects output using one exact-size byte allocation and the streaming Writer path.
pub effect fn render<'text>(document: &Document<'text>, root: Id) -> Bytes
! OutOfMemoryError | WriterError ? &mut Allocator {
  let mut counter = Counter {length: 0}
  run write(document, root) |> Effect.provideMut<Writer>(&mut counter)
  let mut output = run Output.make(counter.length)
  run write(document, root) |> Effect.provideMut<Writer>(&mut output)
  let Buffer {bytes: rendered, length: _} = move output
  return move rendered
}
