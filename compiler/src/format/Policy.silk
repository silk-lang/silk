//! Syntax layout shapes shared by declaration and expression policy.

pub enum Shape {
  Inline,
  List,
  SpacedList,
  Block,
  DeclarationBlock,
  Root,
}

pub enum Separation {
  Tight,
  Space,
  Soft,
  /// A line break taken whether or not the content fits, as between the steps of a chained `|>`.
  Hard,
}
