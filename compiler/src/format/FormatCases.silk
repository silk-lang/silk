//! Focused native formatting contracts; fixtures exercise the source-written printer directly.

import format.DeclarationCases
import format.CommandCases
import format.ExpressionCases
import format.Document as Documents {Document, Id, Node}
import silk.usize
import silk.u8
import format.Printer
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.effect {Effect}
import silk.writer {Writer, WriterError}
import silk.result {Result}
import silk.testing {AssertionError, Testing}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at: usize = 0
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + 1
  }
  return true
}

effect fn assertOutput(document: &Document, root: Id, expected: &[u8]) -> ()
! WriterError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let output = run Printer.render(document, root)
  return run Testing.expect(same(Bytes.asSlice(&output), expected), "canonical document bytes")
}

effect fn boundary() -> ()
! WriterError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut document = Documents.make<'static>()
  let prefix = run Documents.text(&mut document, b"123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789")
  let line = run Documents.add(&mut document, Node<'static>.Line {space: true})
  let item = run Documents.text(&mut document, b"x")
  let pair = run Documents.concat(&mut document, line, item)
  let grouped = run Documents.group(&mut document, pair)
  let root = run Documents.concat(&mut document, prefix, grouped)
  run assertOutput(&document, root, b"123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789\nx\n")
  let shorter = run Documents.text(&mut document, b"12345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678")
  let fits = run Documents.concat(&mut document, shorter, grouped)
  run assertOutput(&document, fits, b"12345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678 x\n")
  let close = run Documents.text(&mut document, b")")
  let suffixed = run Documents.concat(&mut document, fits, close)
  run assertOutput(&document, suffixed, b"12345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678\nx)\n")
  let physical = run Documents.verbatim(&mut document, b" \"\"\"\nbody\n\"\"\"")
  let literalSuffix = run Documents.concat(&mut document, grouped, physical)
  run assertOutput(&document, literalSuffix, b" x \"\"\"\nbody\n\"\"\"\n")
  let hard = run Documents.add(&mut document, Node<'static>.HardLine)
  let later = run Documents.concat(&mut document, hard, item)
  let blockSuffix = run Documents.concat(&mut document, grouped, later)
  return run assertOutput(&document, blockSuffix, b" x\nx\n")
}

test effect fn documentGroupsRespectRemainingWidth() -> ()
! WriterError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run boundary() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn nesting() -> ()
! WriterError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut document = Documents.make<'static>()
  let open = run Documents.text(&mut document, b"{")
  let line = run Documents.add(&mut document, Node<'static>.HardLine)
  let item = run Documents.text(&mut document, b"item")
  let empty = run Documents.add(&mut document, Node<'static>.Empty)
  let comma = run Documents.text(&mut document, b",")
  let conditional = run Documents.add(&mut document, Node<'static>.IfBreak {broken: comma, flat: empty})
  let marked = run Documents.concat(&mut document, item, conditional)
  let content = run Documents.concat(&mut document, line, marked)
  let nested = run Documents.indent(&mut document, content)
  let body = run Documents.concat(&mut document, open, nested)
  let close = run Documents.text(&mut document, b"}")
  let ending = run Documents.concat(&mut document, line, close)
  let complete = run Documents.concat(&mut document, body, ending)
  let root = run Documents.group(&mut document, complete)
  run assertOutput(&document, root, b"{\n  item,\n}\n")
  let blank = run Documents.concat(&mut document, line, line)
  let separated = run Documents.concat(&mut document, blank, item)
  let inner = run Documents.indent(&mut document, separated)
  let outer = run Documents.indent(&mut document, inner)
  let deep = run Documents.concat(&mut document, open, outer)
  return run assertOutput(&document, deep, b"{\n\n    item\n")
}

test effect fn documentNestsWithoutTrailingLayoutWhitespace() -> ()
! WriterError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run nesting() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn protectedText() -> ()
! WriterError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut document = Documents.make<'static>()
  let literal = run Documents.verbatim(&mut document, b"\"\"\"\r\n  literal  \t\r\n\"\"\"")
  let line = run Documents.add(&mut document, Node<'static>.Line {space: true})
  let suffix = run Documents.text(&mut document, b"next")
  let ending = run Documents.concat(&mut document, line, suffix)
  let content = run Documents.concat(&mut document, literal, ending)
  let root = run Documents.group(&mut document, content)
  run assertOutput(&document, root, b"\"\"\"\r\n  literal  \t\r\n\"\"\"\nnext\n")
  let empty = run Documents.add(&mut document, Node<'static>.Empty)
  return run assertOutput(&document, empty, b"\n")
}

test effect fn documentPreservesVerbatimBytesAndFinalNewline() -> ()
! WriterError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run protectedText() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn nestedGroups() -> ()
! WriterError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut document = Documents.make<'static>()
  let open = run Documents.text(&mut document, b"[")
  let close = run Documents.text(&mut document, b"]")
  let a = run Documents.text(&mut document, b"a")
  let b = run Documents.text(&mut document, b"b")
  let line = run Documents.add(&mut document, Node<'static>.Line {space: true})
  let zero = run Documents.add(&mut document, Node<'static>.Line {space: false})
  let comma = run Documents.text(&mut document, b",")
  let empty = run Documents.add(&mut document, Node<'static>.Empty)
  let conditional = run Documents.add(&mut document, Node<'static>.IfBreak {broken: comma, flat: empty})
  let joined = run Documents.join(&mut document, line, &[a, b])
  let marked = run Documents.concat(&mut document, joined, conditional)
  let group = run Documents.group(&mut document, marked)
  let body = run Documents.concat(&mut document, zero, group)
  let indented = run Documents.indent(&mut document, body)
  let leading = run Documents.concat(&mut document, open, indented)
  let ending = run Documents.concat(&mut document, zero, close)
  let complete = run Documents.concat(&mut document, leading, ending)
  let compact = run Documents.group(&mut document, complete)
  run assertOutput(&document, compact, b"[a b]\n")
  let hard = run Documents.add(&mut document, Node<'static>.HardLine)
  let forced = run Documents.concat(&mut document, complete, hard)
  let broken = run Documents.group(&mut document, forced)
  return run assertOutput(&document, broken, b"[\n  a b\n]\n")
}

test effect fn documentNestedGroupsChooseIndependentLayouts() -> ()
! WriterError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run nestedGroups() |> Effect.provideMut<Allocator>(&mut allocator)
}

struct RejectedOutput { writes: usize }

impl RejectedOutput {
  effect fn writeAll(self: &mut Self, bytes: &[u8]) -> () ! WriterError {
    self.writes = self.writes + 1
    fail Writer.failure()
  }
  effect fn flush(self: &mut Self) -> () ! WriterError { return () }
}
impl Writer for RejectedOutput { writeAll: RejectedOutput.writeAll flush: RejectedOutput.flush }

effect fn failedWriter() -> ()
! WriterError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut document = Documents.make<'static>()
  let first = run Documents.text(&mut document, b"first")
  let second = run Documents.text(&mut document, b"second")
  let root = run Documents.concat(&mut document, first, second)
  let mut output = RejectedOutput {writes: 0}
  let result = run Effect.result(Printer.write(&document, root) |> Effect.provideMut<Writer>(&mut output))
  let rejected = match move result {
    Result<(), WriterError | OutOfMemoryError>.Failure {error} => match move error {
      WriterError ignored => true
      OutOfMemoryError ignoredAllocation => false
    }
    Result<(), WriterError | OutOfMemoryError>.Success {value: _} => false
  }
  run Testing.expect(rejected, "writer failure remains typed")
  return run Testing.expect(output.writes == 1, "failure stops subsequent writes")
}

test effect fn documentWriterFailureStopsSubsequentWrites() -> ()
! WriterError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run failedWriter() |> Effect.provideMut<Allocator>(&mut allocator)
}
