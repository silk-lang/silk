//! Command policy tests use lexical filesystem and writer providers, without host I/O or builds.

import format.Command as Commands {Command, CommandError, FileOutcome, Outcome, Reason}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.effect {Effect}
import silk.system.filesystem {AtomicWriteError, DirectoryEntry, DirectoryInfo, Durability, FileError, FileInfo, FileSystem, Path, PublicationPolicy}
import silk.option {Option}
import silk.core.result {Result}
import silk.text.string {String}
import silk.testing.testing {AssertionError, Testing}
import silk.toml.scanner {TomlError}
import silk.num.usize
import silk.collections.list {List}
import silk.io.writer {Writer, WriterError}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at: usize = 0
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + 1
  }
  return true
}

struct Files {
  damage: bool,
  readFailure: bool,
  writeFailure: bool,
  nestedManifest: bool,
  rootedManifest: bool,
  badVersion: bool,
  // No manifest exists anywhere.
  loose: bool,
  writes: usize,
  writesValid: bool,
  damagedWrite: bool,
  wroteA: bool,
  wroteZ: bool,
}

fn files() -> Files {
  return Files {
    damage: false, readFailure: false, writeFailure: false, nestedManifest: false, rootedManifest: false, badVersion: false, loose: false, writes: 0,
    writesValid: true, damagedWrite: false, wroteA: false, wroteZ: false,
  }
}

impl Files {
  effect fn readFile(self: &mut Self, path: &Path) -> Bytes
  ! FileError | OutOfMemoryError ? &mut Allocator {
    let name = Path.rawBytes(path)
    if self.loose && same(name, b"/project/silk.toml") {
      fail FileSystem.error(FileSystem.readFileOperation(), FileSystem.notFound())
    }
    if self.badVersion && same(name, b"/project/silk.toml") {
      return run Bytes.copy(String.utf8Bytes("""
[package]
version = "1.0"
"""))
    }
    if self.rootedManifest && same(name, b"/project/silk.toml") {
      return run Bytes.copy(String.utf8Bytes("""
[package]
version = "0.1.0"
main = "nested/b.silk"
"""))
    }
    if same(name, b"/project/silk.toml") {
      return run Bytes.copy(String.utf8Bytes("""
[package]
version = "0.1.0"
"""))
    }
    if self.nestedManifest && same(name, b"/project/src/nested/silk.toml") {
      return run Bytes.copy(String.utf8Bytes("""
[package]
version = "0.1.0"
source = "."
main = "b.silk"
"""))
    }
    if same(name, b"/project/src/a.silk") {
      if self.damage { return run Bytes.copy(b"fn broken( {") }
      return run Bytes.copy(b"fn a(){}")
    }
    if same(name, b"/project/src/nested/b.silk") { return run Bytes.copy(b"// canonical\n") }
    if same(name, b"/project/src/z.silk") {
      if self.readFailure {
        fail FileSystem.error(FileSystem.readFileOperation(), FileSystem.permissionDenied())
      }
      if self.damage { return run Bytes.copy(b"fn z(){}") }
      return run Bytes.copy(b"// canonical\n")
    }
    fail FileSystem.error(FileSystem.readFileOperation(), FileSystem.notFound())
  }

  effect fn writeFile(self: &mut Self, path: &Path, bytes: &[u8]) -> () ! FileError {
    let name = Path.rawBytes(path)
    let isA = same(name, b"/project/src/a.silk")
    let isZ = same(name, b"/project/src/z.silk")
    if self.damage && isA { self.damagedWrite = true }
    if !((!self.damage && isA && same(bytes, b"fn a() {}\n"))
      || (self.damage && isZ && same(bytes, b"fn z() {}\n"))) {
      self.writesValid = false
    }
    if self.writeFailure {
      fail FileSystem.error(FileSystem.writeFileOperation(), FileSystem.permissionDenied())
    }
    if isA { self.wroteA = true }
    if isZ { self.wroteZ = true }
    self.writes = self.writes + 1
  }

  effect fn createFile(self: &mut Self, path: &Path, bytes: &[u8]) -> () ! FileError {
    fail FileSystem.error(FileSystem.createFileOperation(), FileSystem.unsupported())
  }

  effect fn writeFileAtomic(
    self: &mut Self,
    path: &Path,
    bytes: &[u8],
    policy: PublicationPolicy,
    durability: Durability,
  ) -> () ! AtomicWriteError {
    fail AtomicWriteError {
      published: false,
      cause: FileSystem.error(FileSystem.writeFileAtomicOperation(), FileSystem.unsupported()),
      cleanupError: Option<FileError>.None,
      stagingName: Bytes.make(),
    }
  }

  effect fn syncDirectory(self: &mut Self, path: &Path) -> () ! FileError {
    fail FileSystem.error(FileSystem.syncDirectoryOperation(), FileSystem.unsupported())
  }

  effect fn stat(self: &mut Self, path: &Path) -> FileInfo | DirectoryInfo ! FileError {
    let name = Path.rawBytes(path)
    if same(name, b"/project") || same(name, b"/project/src") || same(name, b"/project/src/nested") || same(name, b"/project/src-other") {
      return FileSystem.directoryInfo()
    }
    if same(name, b"/project/src/a.silk") || same(name, b"/project/src/z.silk")
      || same(name, b"/project/src/nested/b.silk") || same(name, b"/project/src/notes.txt")
      || same(name, b"/project/src-other/file.silk") {
      return FileSystem.fileInfo(0)
    }
    fail FileSystem.error(FileSystem.statOperation(), FileSystem.notFound())
  }

  effect fn listDirectory(self: &mut Self, path: &Path) -> List<DirectoryEntry>
  ! FileError | OutOfMemoryError ? &mut Allocator {
    let mut entries = List<DirectoryEntry>.make()
    if same(Path.rawBytes(path), b"/project/src") {
      run List<DirectoryEntry>.append(&mut entries, FileSystem.directoryEntry(run Path.make("/project/src/a.silk"), FileSystem.file()))
      run List<DirectoryEntry>.append(&mut entries, FileSystem.directoryEntry(run Path.make("/project/src/nested"), FileSystem.directory()))
      run List<DirectoryEntry>.append(&mut entries, FileSystem.directoryEntry(run Path.make("/project/src/notes.txt"), FileSystem.file()))
      run List<DirectoryEntry>.append(&mut entries, FileSystem.directoryEntry(run Path.make("/project/src/z.silk"), FileSystem.file()))
      return move entries
    }
    if same(Path.rawBytes(path), b"/project/src/nested") {
      run List<DirectoryEntry>.append(&mut entries, FileSystem.directoryEntry(run Path.make("/project/src/nested/b.silk"), FileSystem.file()))
      return move entries
    }
    fail FileSystem.error(FileSystem.listDirectoryOperation(), FileSystem.notFound())
  }

  effect fn createDirectory(self: &mut Self, path: &Path) -> () ! FileError {
    fail FileSystem.error(FileSystem.createDirectoryOperation(), FileSystem.unsupported())
  }
  effect fn removeFile(self: &mut Self, path: &Path) -> () ! FileError {
    fail FileSystem.error(FileSystem.removeFileOperation(), FileSystem.unsupported())
  }
  effect fn removeDirectory(self: &mut Self, path: &Path) -> () ! FileError {
    fail FileSystem.error(FileSystem.removeDirectoryOperation(), FileSystem.unsupported())
  }
  effect fn createTemporaryDirectory(self: &mut Self, path: &Path, prefix: &[u8]) -> Path
  ! FileError | OutOfMemoryError ? &mut Allocator {
    fail FileSystem.error(FileSystem.createTemporaryDirectoryOperation(), FileSystem.unsupported())
  }
}

impl FileSystem for Files {
  readFile: Files.readFile
  writeFile: Files.writeFile
  createFile: Files.createFile
  writeFileAtomic: Files.writeFileAtomic
  syncDirectory: Files.syncDirectory
  stat: Files.stat
  listDirectory: Files.listDirectory
  createDirectory: Files.createDirectory
  removeFile: Files.removeFile
  removeDirectory: Files.removeDirectory
  createTemporaryDirectory: Files.createTemporaryDirectory
}

effect fn arguments(values: &[string<'static>]) -> List<Bytes>
! OutOfMemoryError ? &mut Allocator {
  let mut result = List<Bytes>.make()
  let mut at: usize = 0
  while at < values.length {
    run List<Bytes>.append(&mut result, run Bytes.copy(String.utf8Bytes(values[at])))
    at = at + 1
  }
  return move result
}

effect fn selectionPolicy() -> ()
! AssertionError<'static> | CommandError | FileError | TomlError | OutOfMemoryError ? &mut Allocator {
  let mut provider = files()
  let working = run Path.make("/project/src")
  let command = Command {paths: List<Bytes>.make(), check: false, manifest: Option<Bytes>.none()}
  let selected = run Commands.select(&command, &working)
    |> Effect.provideMut<FileSystem>(&mut provider)
  let paths = List<Path>.asSlice(&selected)
  run Testing.expect(paths.length == 3, "default selects exact Silk extensions recursively")
  run Testing.expect(same(Path.rawBytes(&paths[0]), b"/project/src/a.silk"), "first path is sorted")
  run Testing.expect(same(Path.rawBytes(&paths[1]), b"/project/src/nested/b.silk"), "nested path is retained")
  run Testing.expect(same(Path.rawBytes(&paths[2]), b"/project/src/z.silk"), "last path is sorted")
  let supplied = run arguments(&["z.silk", "./nested/../a.silk", "/project/src/nested/", "a.silk"])
  let explicit = run Commands.make(move supplied)
  let explicitSelected = run Commands.select(&explicit, &working)
    |> Effect.provideMut<FileSystem>(&mut provider)
  let explicitPaths = List<Path>.asSlice(&explicitSelected)
  run Testing.expect(explicitPaths.length == 3, "overlapping selections are deduplicated")
  run Testing.expect(same(Path.rawBytes(&explicitPaths[0]), b"/project/src/a.silk"), "explicit inputs are sorted after normalization")
  provider.nestedManifest = true
  let nested = run Path.make("/project/src/nested")
  let nestedSelected = run Commands.select(&command, &nested)
    |> Effect.provideMut<FileSystem>(&mut provider)
  let nestedPaths = List<Path>.asSlice(&nestedSelected)
  run Testing.expect(nestedPaths.length == 1 && same(Path.rawBytes(&nestedPaths[0]), b"/project/src/nested/b.silk"), "nearest manifest controls the source root")
  let named = run arguments(&["--manifest-path", "src/nested/silk.toml", "--check"])
  let manifestCommand = run Commands.make(move named)
  let root = run Path.make("/project")
  let namedSelected = run Commands.select(&manifestCommand, &root)
    |> Effect.provideMut<FileSystem>(&mut provider)
  let namedPaths = List<Path>.asSlice(&namedSelected)
  run Testing.expect(
    manifestCommand.check && namedPaths.length == 1 && same(Path.rawBytes(&namedPaths[0]), b"/project/src/nested/b.silk"),
    "--manifest-path names the manifest, resolved against the working directory, without discovery"
  )
  let mut rooted = files()
  rooted.rootedManifest = true
  let rootedSelected = run Commands.select(&command, &root)
    |> Effect.provideMut<FileSystem>(&mut rooted)
  run Testing.expect(List<Path>.length(&rootedSelected) == 3, "[package].source, not the main module's directory, is the source root")
  let outside = run arguments(&["../src-other/file.silk"])
  let outsideCommand = run Commands.make(move outside)
  let outsideSelected = run Commands.select(&outsideCommand, &working)
    |> Effect.provideMut<FileSystem>(&mut provider)
  let outsidePaths = List<Path>.asSlice(&outsideSelected)
  run Testing.expect(
    outsidePaths.length == 1 && same(Path.rawBytes(&outsidePaths[0]), b"/project/src-other/file.silk"),
    "an exact file outside the source root is selected"
  )
  let mut loose = files()
  loose.loose = true
  let looseArguments = run arguments(&["src/a.silk"])
  let looseCommand = run Commands.make(move looseArguments)
  let looseSelected = run Commands.select(&looseCommand, &root)
    |> Effect.provideMut<FileSystem>(&mut loose)
  let loosePaths = List<Path>.asSlice(&looseSelected)
  run Testing.expect(
    loosePaths.length == 1 && same(Path.rawBytes(&loosePaths[0]), b"/project/src/a.silk"),
    "an exact file needs no silk.toml"
  )
  let mut whole = files()
  let dotArguments = run arguments(&["."])
  let dotCommand = run Commands.make(move dotArguments)
  let dotSelected = run Commands.select(&dotCommand, &root)
    |> Effect.provideMut<FileSystem>(&mut whole)
  let dotPaths = List<Path>.asSlice(&dotSelected)
  run Testing.expect(
    dotPaths.length == 3 && same(Path.rawBytes(&dotPaths[0]), b"/project/src/a.silk"),
    "a directory that holds the source root selects all of it"
  )
}

test effect fn commandSelectionIsNormalizedSortedUniqueAndProjectScoped() -> ()
! AssertionError<'static> | CommandError | FileError | TomlError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run selectionPolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn rejectsSelection(values: &[string<'static>], reason: Reason) -> ()
! AssertionError<'static> | CommandError | FileError | TomlError | OutOfMemoryError ? &mut Allocator {
  return run rejectsFrom(files(), values, reason)
}

effect fn rejectsFrom(provided: Files, values: &[string<'static>], reason: Reason) -> ()
! AssertionError<'static> | CommandError | FileError | TomlError | OutOfMemoryError ? &mut Allocator {
  let mut provider = move provided
  let supplied = run arguments(values)
  let command = run Commands.make(move supplied)
  let working = run Path.make("/project")
  let attempted = run Effect.result(Commands.select(&command, &working))
    |> Effect.provideMut<FileSystem>(&mut provider)
  let correct = match move attempted {
    Result<List<Path>, CommandError | FileError | TomlError | OutOfMemoryError>.Success {value: _} => false
    Result<List<Path>, CommandError | FileError | TomlError | OutOfMemoryError>.Failure {error} => match move error {
      CommandError failure => failure.reason == reason
      FileError failure => { fail move failure }
      TomlError failure => { fail move failure }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  run Testing.expect(correct, "selection fails with its typed policy reason")
}

effect fn invalidSelections() -> ()
! AssertionError<'static> | CommandError | FileError | TomlError | OutOfMemoryError ? &mut Allocator {
  run rejectsSelection(&["src-other"], Reason.OutsideRoot)
  let mut loose = files()
  loose.loose = true
  run rejectsFrom(move loose, &["src"], Reason.MissingProject)
  let mut looseDefault = files()
  looseDefault.loose = true
  run rejectsFrom(move looseDefault, &[], Reason.MissingProject)
  run rejectsSelection(&["src/missing.silk"], Reason.MissingSelection)
  run rejectsSelection(&["missing.silk"], Reason.MissingSelection)
  run rejectsSelection(&["src/notes.txt"], Reason.InvalidSelection)
  run rejectsSelection(&["--manifest-path", "other/silk.toml"], Reason.MissingProject)
  let mut badVersion = files()
  badVersion.badVersion = true
  run rejectsFrom(move badVersion, &["src/a.silk"], Reason.InvalidVersion)
  let repeated = run arguments(&["--manifest-path", "silk.toml", "--manifest-path", "silk.toml"])
  let valueless = run arguments(&["--manifest-path"])
  let repeatedRefused = match move run Effect.result(Commands.make(move repeated)) {
    Result<Command, CommandError | OutOfMemoryError>.Success {value: _} => false
    Result<Command, CommandError | OutOfMemoryError>.Failure {error} => match move error {
      CommandError failure => failure.reason == Reason.InvalidArgument
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let valuelessRefused = match move run Effect.result(Commands.make(move valueless)) {
    Result<Command, CommandError | OutOfMemoryError>.Success {value: _} => false
    Result<Command, CommandError | OutOfMemoryError>.Failure {error} => match move error {
      CommandError failure => failure.reason == Reason.InvalidArgument
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  run Testing.expect(repeatedRefused && valuelessRefused, "a repeated or valueless --manifest-path is refused")
  let supplied = run arguments(&["--unknown"])
  let attempted = run Effect.result(Commands.make(move supplied))
  let correct = match move attempted {
    Result<Command, CommandError | OutOfMemoryError>.Success {value: _} => false
    Result<Command, CommandError | OutOfMemoryError>.Failure {error} => match move error {
      CommandError failure => failure.reason == Reason.InvalidArgument
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  run Testing.expect(correct, "unknown options are rejected")
  let literalSupplied = run arguments(&["--check", "--", "-literal.silk"])
  let command = run Commands.make(move literalSupplied)
  let paths = List<Bytes>.asSlice(&command.paths)
  run Testing.expect(command.check && paths.length == 1 && same(Bytes.asSlice(&paths[0]), b"-literal.silk"), "end-of-options preserves a literal dash filename")
}

test effect fn commandSelectionsAndOptionsRejectInvalidInputs() -> ()
! AssertionError<'static> | CommandError | FileError | TomlError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run invalidSelections() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A letter naming the outcome's kind: unchanged, formatted, needs formatting, damaged or failed.
fn reported(file: &FileOutcome) -> u8 {
  return match &file.outcome {
    Outcome.Unchanged => 117
    Outcome.Formatted => 102
    Outcome.NeedsFormatting => 110
    Outcome.Damaged {..} => 100
    Outcome.Failed {..} => 120
  }
}

effect fn writeAndCheckPolicy() -> ()
! AssertionError<'static> | CommandError | FileError | TomlError | OutOfMemoryError | WriterError ? &mut Allocator {
  let mut provider = files()
  let working = run Path.make("/project")
  let mut command = Command {paths: List<Bytes>.make(), check: true, manifest: Option<Bytes>.none()}
  let checkOutcomes = run Commands.execute(&command, &working)
    |> Effect.provideMut<FileSystem>(&mut provider)
  let checkStatus = Commands.status(List<FileOutcome>.asSlice(&checkOutcomes))
  run Testing.expect(checkStatus == 1 && provider.writes == 0, "check drift returns one without writing")
  let checked = List<FileOutcome>.asSlice(&checkOutcomes)
  run Testing.expect(
    checked.length == 3 && reported(&checked[0]) == 110 && !Commands.toStandardOutput(&checked[0])
      && reported(&checked[1]) == 117 && Commands.toStandardOutput(&checked[1]),
    "check reports drift on standard error and unchanged files on standard output"
  )
  run Testing.expect(!provider.wroteA && !provider.wroteZ && provider.writesValid, "check performs no replacement writes")
  command.check = false
  let writeOutcomes = run Commands.execute(&command, &working)
    |> Effect.provideMut<FileSystem>(&mut provider)
  let writeStatus = Commands.status(List<FileOutcome>.asSlice(&writeOutcomes))
  run Testing.expect(writeStatus == 0 && provider.writes == 1, "write mode updates only changed files and succeeds")
  let written = List<FileOutcome>.asSlice(&writeOutcomes)
  run Testing.expect(written.length == 3 && reported(&written[0]) == 102 && Commands.toStandardOutput(&written[0]),
    "a formatted file reports on standard output")
  run Testing.expect(provider.wroteA && !provider.wroteZ && provider.writesValid, "changed source is replaced at its own path with canonical bytes")
  provider.damage = true
  let damagedOutcomes = run Commands.execute(&command, &working)
    |> Effect.provideMut<FileSystem>(&mut provider)
  let damagedStatus = Commands.status(List<FileOutcome>.asSlice(&damagedOutcomes))
  run Testing.expect(damagedStatus == 1 && provider.writes == 2, "damaged files stay untouched while other files are written")
  let damagedFiles = List<FileOutcome>.asSlice(&damagedOutcomes)
  let mut codes = false
  if let Outcome.Damaged {codes: listed} = &damagedFiles[0].outcome {
    let text = Bytes.asSlice(&listed)
    codes = text.length >= 7 && text[0] == 80 && text[1] == 65 && text[2] == 82
  }
  run Testing.expect(codes && !Commands.toStandardOutput(&damagedFiles[0]),
    "damaged source reports its syntax diagnostic codes on standard error")
  run Testing.expect(provider.wroteZ && provider.writesValid && !provider.damagedWrite, "later changed source receives canonical bytes and damaged source is never written")
}

test effect fn commandCheckIsReadOnlyAndDamagedFilesDoNotBlockWrites() -> ()
! AssertionError<'static> | CommandError | FileError | TomlError | OutOfMemoryError | WriterError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run writeAndCheckPolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn failurePriority() -> ()
! AssertionError<'static> | CommandError | FileError | TomlError | OutOfMemoryError | WriterError ? &mut Allocator {
  let mut provider = files()
  let working = run Path.make("/project")
  let mut command = Command {paths: List<Bytes>.make(), check: true, manifest: Option<Bytes>.none()}
  provider.readFailure = true
  let readOutcomes = run Commands.execute(&command, &working)
    |> Effect.provideMut<FileSystem>(&mut provider)
  let readStatus = Commands.status(List<FileOutcome>.asSlice(&readOutcomes))
  run Testing.expect(readStatus == 2 && provider.writes == 0, "read failure takes priority over check drift")
  provider.readFailure = false
  provider.damage = true
  provider.writeFailure = true
  command.check = false
  let failureOutcomes = run Commands.execute(&command, &working)
    |> Effect.provideMut<FileSystem>(&mut provider)
  let failureStatus = Commands.status(List<FileOutcome>.asSlice(&failureOutcomes))
  run Testing.expect(failureStatus == 2 && provider.writes == 0, "later write failure takes priority over earlier damaged syntax")
  run Testing.expect(provider.writesValid && !provider.damagedWrite, "failed replacement targets only intact changed source with canonical bytes")
}

test effect fn commandInfrastructureFailuresTakePriorityOverSourceFailures() -> ()
! AssertionError<'static> | CommandError | FileError | TomlError | OutOfMemoryError | WriterError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run failurePriority() |> Effect.provideMut<Allocator>(&mut allocator)
}
