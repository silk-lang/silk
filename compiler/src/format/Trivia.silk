//! Comment attachment and bounded physical blank lines between syntax elements.

import format.Document as Documents {Document, Id, Node}
import format.SourceSyntax
import lexer.Token as Tokens {Token, TokenKind}
import parser.SyntaxTree {SyntaxTree}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.slice {Slice}
import silk.vector {Vector}
import silk.usize
import silk.u8

pub struct Gap {
  pub document: Id
  pub comments: bool
  pub after: usize
}

pub fn lineCount(bytes: &[u8], start: usize, end: usize) -> usize {
  let mut count: usize = 0
  let mut at = start
  while at < end {
    if bytes[at] == 10 { count = count + 1 }
    else if bytes[at] == 13 && (at + 1 == end || bytes[at + 1] != 10) { count = count + 1 }
    at = at + 1
  }
  return count
}

pub effect fn lines<'text>(document: &mut Document<'text>, count: usize) -> Id
! OutOfMemoryError ? &mut Allocator {
  let mut output = run Documents.add(&mut document.*, Node<'text>.Empty)
  let line = run Documents.add(&mut document.*, Node<'text>.HardLine)
  let mut at: usize = 0
  while at < count {
    output = run Documents.concat(&mut document.*, output, line)
    at = at + 1
  }
  return output
}

/// Returns comments and their preceding layout, leaving the final break to the owner.
pub effect fn between<'tree>(document: &mut Document<'tree>, tree: &'tree SyntaxTree, start: usize, end: usize, before: bool, minimum: usize, compact: bool) -> Gap
! OutOfMemoryError ? &mut Allocator {
  let source = Bytes.asSlice(&tree.source)
  let tokens = Vector.asSlice<Token>(&tree.tokens)
  let mut at = SourceSyntax.lowerBound(tree, start)
  let mut cursor = start
  let mut output = run Documents.add(&mut document.*, Node<'tree>.Empty)
  let mut found = false
  let mut boundary = false
  let mut documentation = false
  while at < tokens.length && Tokens.span(tokens[at]).start < end {
    let token = tokens[at]
    let span = Tokens.span(token)
    if SourceSyntax.isComment(Tokens.kind(token)) {
      let authored = lineCount(source, cursor, span.start)
      let mut separator = run Documents.add(&mut document.*, Node<'tree>.Empty)
      if authored == 0 {
        if before || found { separator = run Documents.text(&mut document.*, b" ") }
      } else if before || found {
        let mut count: usize = 1
        if authored > 1 && (!compact || documentation) { count = 2 }
        if !boundary && before && count < minimum { count = minimum }
        boundary = true
        separator = run lines(&mut document.*, count)
      }
      output = run Documents.concat(&mut document.*, output, separator)
      let text = run Documents.verbatim(&mut document.*, Slice.view<u8>(source, span.start, span.end - span.start))
      output = run Documents.concat(&mut document.*, output, text)
      cursor = span.end
      found = true
      documentation = Tokens.kind(token) == TokenKind.DocComment
    }
    at = at + 1
  }
  let mut after: usize = 1
  if lineCount(source, cursor, end) > 1 && (!compact || documentation) { after = 2 }
  return Gap {document: output, comments: found, after: after}
}
