//! Project source selection and the native formatter command's stable exit classes.

import driver.CommandPath
import driver.ManifestFields
import driver.Project as Projects {Member, ProjectError, Workspace}
import diagnostic.Catalog as Catalog {Code}
import format.FormatError {FormatError, Reason as FormatReason}
import format.SourceSyntax
import format.SyntaxFormatter
import lexer.LexicalDiagnostic {LexicalDiagnostic}
import lexer.Lexer {failureAt}
import lexer.Token {Token, span as tokenSpan}
import parser.Diagnostic {Diagnostic}
import parser.SyntaxTree {SyntaxTree}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.effect {Effect}
import silk.system.filesystem {DirectoryEntry, DirectoryInfo, FileError, FileInfo, FileSystem, Path}
import silk.format {Format}
import silk.system.host_input {HostInput, HostInputError}
import silk.option {Option}
import silk.core.result {Result}
import silk.collections.slice {Slice}
import silk.text.string {InvalidUtf8, String}
import silk.toml.scanner {TomlError}
import silk.toml.value {Toml, Value as TomlValue}
import silk.num.usize
import silk.collections.list {List}
import silk.io.writer {Writer, WriterError}

/// A parsed format request. Paths are relative to the caller's working directory.
pub struct Command {
  pub paths: List<Bytes>,
  pub check: bool,
  /// The manifest `--manifest-path` names, as written; absent to discover the nearest one.
  pub manifest: Option<Bytes>,
}

pub enum Reason { InvalidArgument, MissingProject, InvalidRoot, InvalidVersion, OutsideRoot, InvalidSelection, InvalidEncoding, InvalidWorkspace, MissingSelection }

/// A request or project-selection failure before any source is rewritten.
pub struct CommandError {
  pub reason: Reason,
  pub path: Bytes,
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at: usize = 0
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + 1
  }
  return true
}

fn begins(value: &[u8], prefix: &[u8]) -> bool {
  if value.length < prefix.length { return false }
  let mut at: usize = 0
  while at < prefix.length {
    if value[at] != prefix[at] { return false }
    at = at + 1
  }
  return true
}

effect fn reject(reason: Reason, path: &[u8]) -> never
! CommandError | OutOfMemoryError ? &mut Allocator {
  fail CommandError {reason: reason, path: run Bytes.copy(path)}
}

/// Parses arguments following `format`: paths, `--check` and `--manifest-path <path>`; `--`
/// permits filenames beginning with a dash.
pub effect fn make(arguments: List<Bytes>) -> Command
! CommandError | OutOfMemoryError ? &mut Allocator {
  let mut paths = move arguments
  let mut check = false
  let mut manifest = Option<Bytes>.none()
  let mut literal = false
  let mut at: usize = 0
  while at < List<Bytes>.length(&paths) {
    let values = List<Bytes>.asSlice(&paths)
    let argument = Bytes.asSlice(&values[at])
    if !literal && same(argument, b"--") {
      literal = true
      drop List<Bytes>.remove(&mut paths, at)
    } else if !literal && same(argument, b"--check") {
      check = true
      drop List<Bytes>.remove(&mut paths, at)
    } else if !literal && same(argument, b"--manifest-path") {
      let unset = match &manifest {
        Option<Bytes>.Some {..} => false
        Option<Bytes>.None => true
      }
      if !unset || at + 1 >= values.length {
        return run reject(Reason.InvalidArgument, argument)
      }
      drop List<Bytes>.remove(&mut paths, at)
      manifest = Option<Bytes>.some(List<Bytes>.remove(&mut paths, at))
    } else {
      if !literal && begins(argument, b"-") {
        return run reject(Reason.InvalidArgument, argument)
      }
      at = at + 1
    }
  }
  return Command {paths: move paths, check: check, manifest: move manifest}
}

effect fn resolve(base: &Path, bytes: &[u8]) -> Path
! CommandError | FileError | OutOfMemoryError ? &mut Allocator {
  let text = match move String.fromUtf8(bytes) {
    Result<string, InvalidUtf8>.Success {value} => value
    Result<string, InvalidUtf8>.Failure {error: _} => {
      return run reject(Reason.InvalidEncoding, bytes)
    }
  }
  if begins(bytes, b"/") {
    let root = run Path.root()
    let relative = Slice.view<u8>(String.utf8Bytes(text), 1, bytes.length - 1)
    let decoded = match move String.fromUtf8(relative) {
      Result<string, InvalidUtf8>.Success {value} => value
      Result<string, InvalidUtf8>.Failure {error: _} => {
        return run reject(Reason.InvalidEncoding, bytes)
      }
    }
    return run Path.resolve(&root, decoded)
  }
  return run Path.resolve(base, text)
}

effect fn readOptional(path: &Path) -> Option<Bytes>
! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let loaded = run Effect.result(FileSystem.readFile(path))
  return match move loaded {
    Result<Bytes, FileError | OutOfMemoryError>.Success {value} => Option<Bytes>.some(move value)
    Result<Bytes, FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError failure => {
        if failure.reason.code == FileSystem.notFound().code { return Option<Bytes>.none() }
        fail move failure
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

// The source root the manifest at `manifest`, whose text is `contents`, declares: its
// `[package].source` (driver/ManifestFields), which must hold its root module.
effect fn packageRoot(manifest: &Path, contents: &Bytes) -> Path
! CommandError | FileError | TomlError | OutOfMemoryError ? &mut Allocator {
  let directory = match move run Path.parent(manifest) {
    Option<Path>.Some {value} => move value
    Option<Path>.None => { return run reject(Reason.InvalidRoot, Path.rawBytes(manifest)) }
  }
  let document = run Toml.parse(Bytes.asSlice(contents))
  // A written version must be a semantic version, as every command requires.
  if let Option<&TomlValue>.Some {value: written} = move Toml.fieldAt(Toml.field(&document, "package"), "version") {
    let versioned = match move Toml.asString(Option<&TomlValue>.some(written)) {
      Option<string>.Some {value} => Projects.isSemanticVersion(String.utf8Bytes(value))
      Option<string>.None => false
    }
    if !versioned { return run reject(Reason.InvalidVersion, Path.rawBytes(manifest)) }
  }
  let root = run ManifestFields.sourceRoot(&directory, &document)
  let entry = run ManifestFields.main(&document, &root)
  if !within(&directory, &entry) || !silkFile(&entry) || !within(&root, &entry) {
    return run reject(Reason.InvalidRoot, Path.rawBytes(manifest))
  }
  return move root
}

// The source roots of the manifest `self` names, else of the nearest `silk.toml` at or above
// `working`: its package's, or, for a manifest that only defines a workspace, the source root of
// each member whose root module exists.
effect fn sourceRoots(self: &Command, working: &Path) -> List<Path>
! CommandError | FileError | TomlError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let mut manifest = run Path.root()
  let mut contents = Bytes.make()
  if let Option<Bytes>.Some {value: written} = &self.manifest {
    manifest = run resolve(working, Bytes.asSlice(&written))
    contents = match move run readOptional(&manifest) {
      Option<Bytes>.Some {value} => move value
      Option<Bytes>.None => run reject(Reason.MissingProject, Path.rawBytes(&manifest))
    }
  } else {
    let mut directory = run Path.fromBytes(Path.rawBytes(working))
    while true {
      let candidate = run Path.join(&directory, "silk.toml")
      if let Option<Bytes>.Some {value} = move run readOptional(&candidate) {
        manifest = move candidate
        contents = move value
        break
      }
      let parent = run Path.parent(&directory)
      if let Option<Path>.Some {value} = move parent {
        directory = move value
      } else {
        return run reject(Reason.MissingProject, Path.rawBytes(working))
      }
    }
  }
  let mut roots = List<Path>.make()
  let document = run Toml.parse(Bytes.asSlice(&contents))
  let packaged = match move Toml.field(&document, "package") {
    Option<&TomlValue>.Some {value: _} => true
    Option<&TomlValue>.None => false
  }
  let grouped = match move Toml.field(&document, "workspace") {
    Option<&TomlValue>.Some {value: _} => true
    Option<&TomlValue>.None => false
  }
  if packaged || !grouped {
    run List<Path>.append(&mut roots, run packageRoot(&manifest, &contents))
    return move roots
  }
  let loaded = run Effect.result(Projects.workspace(&manifest))
  let workspace = match move loaded {
    Result<Option<Workspace>, ProjectError | FileError | OutOfMemoryError>.Success {value} => match move value {
      Option<Workspace>.Some {value: found} => move found
      Option<Workspace>.None => run reject(Reason.InvalidRoot, Path.rawBytes(&manifest))
    }
    Result<Option<Workspace>, ProjectError | FileError | OutOfMemoryError>.Failure {error} => match move error {
      ProjectError invalid => {
        drop invalid
        return run reject(Reason.InvalidWorkspace, Path.rawBytes(&manifest))
      }
      FileError failure => { fail move failure }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let members = List<Member>.asSlice(&workspace.members)
  let mut at = usize.ZERO
  while at < members.length {
    if members[at].rooted {
      let member = run Path.join(&members[at].directory, "silk.toml")
      let text = match move run readOptional(&member) {
        Option<Bytes>.Some {value} => move value
        Option<Bytes>.None => run reject(Reason.MissingProject, Path.rawBytes(&member))
      }
      run List<Path>.append(&mut roots, run packageRoot(&member, &text))
    }
    at = at + usize.ONE
  }
  return move roots
}

fn within(root: &Path, candidate: &Path) -> bool {
  let prefix = Path.rawBytes(root)
  let value = Path.rawBytes(candidate)
  if !begins(value, prefix) { return false }
  return Path.isRoot(root) || value.length == prefix.length || value[prefix.length] == 47
}

fn silkFile(path: &Path) -> bool {
  let bytes = Path.rawBytes(path)
  if bytes.length < 5 { return false }
  return same(Slice.view<u8>(bytes, bytes.length - 5, 5), b".silk")
}

fn compare(left: &[u8], right: &[u8]) -> i32 {
  let mut at: usize = 0
  while at < left.length && at < right.length {
    if left[at] < right[at] { return -1 }
    if left[at] > right[at] { return 1 }
    at = at + 1
  }
  if left.length < right.length { return -1 }
  if left.length > right.length { return 1 }
  return 0
}

effect fn include(selected: &mut List<Path>, path: Path) -> ()
! OutOfMemoryError ? &mut Allocator {
  let paths = List<Path>.asSlice(&selected.*)
  let mut at: usize = 0
  while at < paths.length {
    let order = compare(Path.rawBytes(&path), Path.rawBytes(&paths[at]))
    if order == 0 { return () }
    if order < 0 { break }
    at = at + 1
  }
  run List<Path>.insert(&mut selected.*, at, move path)
}

effect fn walk(selected: &mut List<Path>, root: &Path, directory: &Path) -> ()
! CommandError | FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let mut entries = run FileSystem.listDirectory(directory)
  while List<DirectoryEntry>.length(&entries) > 0 {
    let popped = List<DirectoryEntry>.pop(&mut entries)
    let child = match move popped {
      Option<DirectoryEntry>.Some {value} => move value
      Option<DirectoryEntry>.None => { return () }
    }
    if !within(root, &child.path) || same(Path.rawBytes(directory), Path.rawBytes(&child.path)) {
      return run reject(Reason.OutsideRoot, Path.rawBytes(&child.path))
    }
    if child.kind.code == FileSystem.directory().code {
      run walk(&mut selected.*, root, &child.path)
    } else if child.kind.code == FileSystem.file().code && silkFile(&child.path) {
      run include(&mut selected.*, move child.path)
    }
  }
}

// The source roots `sourceRoots` finds, or none when no manifest was named and none is found:
// a selection of exact files needs no package.
effect fn optionalSourceRoots(self: &Command, working: &Path) -> List<Path>
! CommandError | FileError | TomlError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let named = match &self.manifest {
    Option<Bytes>.Some {..} => true
    Option<Bytes>.None => false
  }
  return match move run Effect.result(sourceRoots(self, working)) {
    Result<List<Path>, CommandError | FileError | TomlError | OutOfMemoryError>.Success {value} => move value
    Result<List<Path>, CommandError | FileError | TomlError | OutOfMemoryError>.Failure {error} => match move error {
      CommandError failure => {
        if failure.reason == Reason.MissingProject && !named { return List<Path>.make() }
        fail move failure
      }
      FileError failure => { fail move failure }
      TomlError failure => { fail move failure }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

/// Selects sorted, duplicate-free exact `.silk` files under the package's source root: the
/// manifest `--manifest-path` names, else the nearest one. At a manifest that only defines a
/// workspace, every member's source root is selected from. An exact `.silk` file argument is
/// selected wherever it is, so a file outside any package can be formatted; a directory argument
/// must lie under a source root or hold one.
pub effect fn select(self: &Command, working: &Path) -> List<Path>
! CommandError | FileError | TomlError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let arguments = List<Bytes>.asSlice(&self.paths)
  if arguments.length > 0 { return run selectArguments(self, working) }
  let found = run sourceRoots(self, working)
  let roots = List<Path>.asSlice(&found)
  let mut selected = List<Path>.make()
  let mut index = usize.ZERO
  while index < roots.length {
    run walk(&mut selected, &roots[index], &roots[index])
    index = index + usize.ONE
  }
  return move selected
}

effect fn selectArguments(self: &Command, working: &Path) -> List<Path>
! CommandError | FileError | TomlError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let found = run optionalSourceRoots(self, working)
  let roots = List<Path>.asSlice(&found)
  let mut selected = List<Path>.make()
  let arguments = List<Bytes>.asSlice(&self.paths)
  let mut at: usize = 0
  while at < arguments.length {
    let path = run resolve(working, Bytes.asSlice(&arguments[at]))
    // A path that names nothing is reported as missing, wherever it would be.
    let info = match move run Effect.result(FileSystem.stat(&path)) {
      Result<FileInfo | DirectoryInfo, FileError>.Success {value} => move value
      Result<FileInfo | DirectoryInfo, FileError>.Failure {error: _} => run reject(Reason.MissingSelection, Path.rawBytes(&path))
    }
    match move info {
      DirectoryInfo directory => {
        if roots.length == 0 { return run reject(Reason.MissingProject, Path.rawBytes(&path)) }
        // A directory inside a source root selects from there; one that holds source roots, such
        // as the package's or the workspace's own directory, selects each of them whole.
        let mut owner = usize.ZERO
        while owner < roots.length && !within(&roots[owner], &path) {
          owner = owner + usize.ONE
        }
        if owner < roots.length {
          run walk(&mut selected, &roots[owner], &path)
        } else {
          let mut held = usize.ZERO
          let mut root = usize.ZERO
          while root < roots.length {
            if within(&path, &roots[root]) {
              run walk(&mut selected, &roots[root], &roots[root])
              held = held + usize.ONE
            }
            root = root + usize.ONE
          }
          if held == 0 { return run reject(Reason.OutsideRoot, Path.rawBytes(&path)) }
        }
      }
      FileInfo file => {
        if !silkFile(&path) { return run reject(Reason.InvalidSelection, Path.rawBytes(&path)) }
        run include(&mut selected, move path)
      }
    }
    at = at + 1
  }
  return move selected
}

/// What formatting or checking one selected file did, as the TypeScript `FormatWorkflow` reports it.
pub union Outcome {
  /// The file is already canonical.
  Unchanged,
  /// The file was rewritten with its canonical bytes.
  Formatted,
  /// `--check` found the file not canonical and left it untouched.
  NeedsFormatting,
  /// The file has lexical or syntax damage; `codes` lists their distinct stable codes, joined by
  /// `, `, in source then discovery order.
  Damaged {pub codes: Bytes},
  /// The file could not be read, formatted safely, or written.
  Failed {pub message: Bytes},
}

/// One selected file and its outcome.
pub struct FileOutcome {
  pub path: Path,
  pub outcome: Outcome,
}

/// A finished run: its exit status and every selected file's outcome, in selection order.
pub struct Run {
  pub status: i32,
  pub outcomes: List<FileOutcome>,
}

/// The exit status of `outcomes`: 2 when any failed, else 1 when any is damaged or needs
/// formatting, else 0.
pub fn status(outcomes: &[FileOutcome]) -> i32 {
  let mut worst = 0
  let mut at = usize.ZERO
  while at < outcomes.length {
    let rank = match &outcomes[at].outcome {
      Outcome.Failed {..} => 2
      Outcome.Damaged {..} => 1
      Outcome.NeedsFormatting => 1
      _ => 0
    }
    if rank > worst { worst = rank }
    at = at + usize.ONE
  }
  return worst
}

/// Whether the outcome's line belongs on standard output: unchanged and formatted files do, and
/// drift, damage and failures go to standard error, as the TypeScript CLI writes them.
pub fn toStandardOutput(self: &FileOutcome) -> bool {
  return match &self.outcome {
    Outcome.Unchanged => true
    Outcome.Formatted => true
    _ => false
  }
}

/// The outcome's report line, `<path>: <outcome>` and a newline.
pub effect fn line(self: &FileOutcome) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut text = run Bytes.copy(Path.rawBytes(&self.path))
  run Bytes.append(&mut text, b": ")
  match &self.outcome {
    Outcome.Unchanged => { run Bytes.append(&mut text, b"unchanged") }
    Outcome.Formatted => { run Bytes.append(&mut text, b"formatted") }
    Outcome.NeedsFormatting => { run Bytes.append(&mut text, b"needs formatting") }
    Outcome.Damaged {codes} => {
      run Bytes.append(&mut text, b"cannot format damaged source")
      if Bytes.asSlice(&codes).length > usize.ZERO {
        run Bytes.append(&mut text, b" (")
        run Bytes.append(&mut text, Bytes.asSlice(&codes))
        run Bytes.append(&mut text, b")")
      }
    }
    Outcome.Failed {message} => { run Bytes.append(&mut text, Bytes.asSlice(&message)) }
  }
  run Bytes.append(&mut text, b"\n")
  return move text
}

// The message `<prefix> <path>` a failed outcome reports.
effect fn failed(prefix: &[u8], path: &Path) -> Outcome ! OutOfMemoryError ? &mut Allocator {
  let mut message = run Bytes.copy(prefix)
  run Bytes.append(&mut message, b" ")
  run Bytes.append(&mut message, Path.rawBytes(path))
  return Outcome.Failed {message: move message}
}

effect fn fileFailure(error: &FileError) -> () ! WriterError ? &mut Writer {
  run Writer.writeAll(b"filesystem failure (operation ")
  run Format.display<i32>(&error.operation.code)
  run Writer.writeAll(b", reason ")
  run Format.display<i32>(&error.reason.code)
  let code = FileSystem.providerCode(error)
  if let Option<i32>.Some {value} = move code {
    run Writer.writeAll(b", provider ")
    run Format.display<i32>(&value)
  }
  run Writer.writeAll(b")")
}

// Appends the spelling of `code` to the `, `-joined `codes` unless it is already listed.
effect fn note(codes: &mut Bytes, seen: &mut List<Code>, code: Code) -> () ! OutOfMemoryError ? &mut Allocator {
  let listed = List<Code>.asSlice(&seen.*)
  let mut at = usize.ZERO
  while at < listed.length {
    if listed[at] == code { return () }
    at = at + usize.ONE
  }
  run List<Code>.append(&mut seen.*, code)
  if Bytes.asSlice(&codes.*).length > usize.ZERO { run Bytes.append(&mut codes.*, b", ") }
  run Bytes.append(&mut codes.*, String.utf8Bytes(Catalog.spelling(code)))
  return ()
}

// The distinct codes of the tree's lexical failures, in source order, then of its syntax
// diagnostics, in discovery order.
effect fn damageCodes(tree: &SyntaxTree) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut codes = Bytes.make()
  let mut seen = List<Code>.make()
  let tokens = List<Token>.asSlice(&tree.tokens)
  let mut at = usize.ZERO
  while at < tokens.length {
    let invalid = match tokens[at] {
      Token.Invalid {..} => true
      Token.InvalidStaticLiteral {..} => true
      Token.InvalidDurationLiteral {..} => true
      _ => false
    }
    if invalid {
      if let Option<LexicalDiagnostic>.Some {value: diagnostic} = move failureAt(Bytes.asSlice(&tree.source), tokenSpan(tokens[at]).start) {
        run note(&mut codes, &mut seen, LexicalDiagnostic.code(diagnostic))
      }
    }
    at = at + usize.ONE
  }
  let diagnostics = List<Diagnostic>.asSlice(&tree.diagnostics)
  at = usize.ZERO
  while at < diagnostics.length {
    run note(&mut codes, &mut seen, Diagnostic.code(diagnostics[at]))
    at = at + usize.ONE
  }
  return move codes
}

// Formats or checks one file. A read or write failure, or formatting that would change the
// syntax, is a failed outcome; lexical or syntax damage leaves the file untouched.
effect fn process(path: &Path, check: bool) -> Outcome
! OutOfMemoryError | WriterError ? &mut FileSystem | &mut Allocator {
  let read = run Effect.result(FileSystem.readFile(path))
  let source = match move read {
    Result<Bytes, FileError | OutOfMemoryError>.Success {value} => move value
    Result<Bytes, FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError unreadable => {
        drop unreadable
        return run failed(b"Cannot read source file", path)
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let tree = run SourceSyntax.parse(move source)
  let attempted = run Effect.result(SyntaxFormatter.formatTree(&tree))
  let formatted = match move attempted {
    Result<Bytes, FormatError | OutOfMemoryError | WriterError>.Success {value} => move value
    Result<Bytes, FormatError | OutOfMemoryError | WriterError>.Failure {error} => match move error {
      FormatError refused => {
        if refused.reason == FormatReason.SafetyViolation {
          return run failed(b"Cannot format without changing the syntax of source file", path)
        }
        return Outcome.Damaged {codes: run damageCodes(&tree)}
      }
      OutOfMemoryError exhausted => { fail move exhausted }
      WriterError failure => { fail move failure }
    }
  }
  if same(Bytes.asSlice(&tree.source), Bytes.asSlice(&formatted)) { return Outcome.Unchanged }
  if check { return Outcome.NeedsFormatting }
  let written = run Effect.result(FileSystem.writeFile(path, Bytes.asSlice(&formatted)))
  if let Result<(), FileError>.Failure {error} = move written {
    drop error
    return run failed(b"Cannot commit formatted source file", path)
  }
  return Outcome.Formatted
}

/// Formats every selected file, continuing after file failures; infrastructure failures stop the
/// run. Outcomes follow the sorted selection.
pub effect fn execute(self: &Command, working: &Path) -> List<FileOutcome>
! CommandError | FileError | TomlError | OutOfMemoryError | WriterError
? &mut FileSystem | &mut Allocator {
  let selected = run select(self, working)
  let paths = List<Path>.asSlice(&selected)
  let mut outcomes = List<FileOutcome>.make()
  let mut at: usize = 0
  while at < paths.length {
    let outcome = run process(&paths[at], self.check)
    run List<FileOutcome>.append(&mut outcomes, FileOutcome {path: run Path.fromBytes(Path.rawBytes(&paths[at])), outcome: move outcome})
    at = at + 1
  }
  return move outcomes
}

effect fn fromHost() -> List<FileOutcome>
! CommandError | FileError | TomlError | HostInputError | OutOfMemoryError | WriterError
? &mut HostInput | &mut FileSystem | &mut Allocator {
  let mut arguments = run HostInput.arguments()
  if List<Bytes>.length(&arguments) < 2 { return run reject(Reason.InvalidArgument, b"format") }
  drop List<Bytes>.remove(&mut arguments, 0)
  drop List<Bytes>.remove(&mut arguments, 0)
  let command = run make(move arguments)
  let directory = run HostInput.workingDirectory()
  let working = run Path.fromBytes(Bytes.asSlice(&directory))
  return run execute(&command, &working)
}

fn reasonName(reason: Reason) -> &'static [u8] {
  return match reason {
    Reason.InvalidArgument => b"unknown option (usage: silk format [paths] [--check] [--manifest-path <path>])"
    Reason.MissingProject => b"no silk.toml found"
    Reason.InvalidRoot => b"invalid [package].main"
    Reason.InvalidVersion => b"package.version must be a valid semantic version"
    Reason.OutsideRoot => b"selection is outside the package source root"
    Reason.InvalidSelection => b"expected a directory or exact .silk file"
    Reason.InvalidEncoding => b"path is not valid UTF-8"
    Reason.InvalidWorkspace => b"invalid [workspace]; run silk check there for the details"
    Reason.MissingSelection => b"no such file or directory"
  }
}

effect fn reportFailure(error: CommandError | FileError | TomlError | HostInputError | OutOfMemoryError | WriterError) -> ()
! WriterError ? &mut Writer {
  run Writer.writeAll(b"silk format: ")
  match move error {
    CommandError failure => {
      run Writer.writeAll(Bytes.asSlice(&failure.path))
      run Writer.writeAll(b": ")
      run Writer.writeAll(reasonName(failure.reason))
    }
    FileError failure => { run fileFailure(&failure)
      run Writer.writeAll(b" during project discovery or selection") }
    TomlError failure => { run Writer.writeAll(b"invalid silk.toml at byte ")
      run Format.display<usize>(&failure.offset) }
    HostInputError failure => { run Writer.writeAll(b"cannot read process arguments or working directory") }
    OutOfMemoryError exhausted => { run Writer.writeAll(b"allocation failure") }
    WriterError failure => { fail move failure }
  }
  run Writer.writeAll(b"\n")
}

/// Runs `format` through the supplied host and filesystem providers. An infrastructure failure is
/// reported on the diagnostic writer and answers status 2 with no outcomes; otherwise the caller
/// writes each outcome's line to standard output or standard error.
pub effect fn runHost() -> Run
? &mut HostInput | &mut FileSystem | &mut Allocator | &mut Writer {
  let attempted = run Effect.result(fromHost())
  return match move attempted {
    Result<List<FileOutcome>, CommandError | FileError | TomlError | HostInputError | OutOfMemoryError | WriterError>.Success {value} => {
      let finished = status(List<FileOutcome>.asSlice(&value))
      return Run {status: finished, outcomes: move value}
    }
    Result<List<FileOutcome>, CommandError | FileError | TomlError | HostInputError | OutOfMemoryError | WriterError>.Failure {error} => {
      let reported = run Effect.result(reportFailure(move error))
      drop reported
      return Run {status: 2, outcomes: List<FileOutcome>.make()}
    }
  }
}
