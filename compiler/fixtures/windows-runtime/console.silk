import silk.platform.windows.console { WindowsConsole }

unsafe extern "C" fn fixture_console_begin() -> i32
unsafe extern "C" fn fixture_console_end() -> i32

pub effect fn main() -> i32 {
  if unsafe fixture_console_begin() == 0 { return 1 }
  if !(run WindowsConsole.enableAnsi(1)) { return 8 }
  let mut error: i32 = 0
  let parts: [&[u8]; 4] = [b"\x82", b"", b"\xac", b"B"]
  if !(run WindowsConsole.writeAllGather(1, b"A\xe2", &parts, &mut error)) || error != 0 { return 2 }
  let emoji: [&[u8]; 3] = [b"\x9f", b"\x92", b"\xa9"]
  if !(run WindowsConsole.writeAllGather(1, b"\xf0", &emoji, &mut error)) || error != 0 { return 3 }
  let invalid: [&[u8]; 1] = [b"A"]
  if (run WindowsConsole.writeAllGather(1, b"\xe2", &invalid, &mut error)) || error != 1113 { return 4 }
  let low: [&[u8]; 1] = [b"\xed\xb0\x80"]
  if (run WindowsConsole.writeAllGather(1, b"\xed\xa0\x80", &low, &mut error)) || error != 1113 { return 5 }
  let empty: [&[u8]; 0] = []
  if (run WindowsConsole.writeAllGather(1, b"\xe2", &empty, &mut error)) || error != 1113 { return 6 }
  return unsafe fixture_console_end()
}
