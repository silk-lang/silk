import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.core.result {Result}
import silk.io.byte_duplex {ByteDuplex, ByteIoError, ReadTransfer}
import silk.net.address {Endpoint, IpAddress, Ipv4Address, Port}
import silk.net.socket_native {AcceptedView, AttemptFailure, BoundAddress, ConnectOptions, Connection, ListenOptions, Listener, NativeSocketError, accept, connectResolvedOwned, listen, withAccepted}
import silk.system.monotonic_clock {MonotonicClock}
import silk.system.monotonic_clock_native {OsMonotonicClock}
import silk.system.system_clock {Instant}
import silk.collections.slice {Slice}
import silk.num.u32
import silk.num.u16

unsafe extern "C" fn fixture_socket_state() -> i32
unsafe extern "C" fn fixture_socket_prepare(port: u32) -> u32
unsafe extern "C" fn fixture_socket_accept() -> i32
unsafe extern "C" fn fixture_socket_send() -> i32
unsafe extern "C" fn fixture_socket_receive() -> i32
unsafe extern "C" fn fixture_socket_finish() -> i32

effect fn exchange(connection: &mut Connection) -> i32 ! ByteIoError ? &mut MonotonicClock {
  if unsafe fixture_socket_send() != 1 { return 1 }
  let mut input: [u8; 5] = [0; 5]
  let mut count: usize = 0
  while count < 5 {
    match move run ByteDuplex.readSome(Slice.viewMut(&mut input, count, 5 - count), Option<Instant>.none())
      |> Effect.provideMut<ByteDuplex>(&mut connection.*) {
      ReadTransfer.Data {count: received} => { count = count + received }
      ReadTransfer.End => { return 2 }
    }
  }
  if input[0] != 0 || input[1] != 67 || input[2] != 255 || input[3] != 33 || input[4] != 10 { return 3 }
  // A gathered write must preserve order and the embedded NUL, including across partial writes.
  let parts: [&[u8]; 3] = [b"Si", b"lk", b"\0!"]
  let written = run ByteDuplex.writeSomeVectored(&parts, Option<Instant>.none())
    |> Effect.provideMut<ByteDuplex>(&mut connection.*)
  if written == 0 || written > 6 { return 4 }
  let payload: [u8; 6] = [83, 105, 108, 107, 0, 33]
  let mut sent = written
  while sent < 6 {
    sent = sent + run ByteDuplex.writeSome(Slice.view(&payload, sent, 6 - sent), Option<Instant>.none())
      |> Effect.provideMut<ByteDuplex>(&mut connection.*)
  }
  run ByteDuplex.shutdownWrite(Option<Instant>.none()) |> Effect.provideMut<ByteDuplex>(&mut connection.*)
  if unsafe fixture_socket_receive() != 1 { return 5 }
  match move run ByteDuplex.readSome(&mut input, Option<Instant>.none()) |> Effect.provideMut<ByteDuplex>(&mut connection.*) {
    ReadTransfer.End => {}
    _ => { return 6 }
  }
  return 0
}

effect fn accepted<'call>(view: &'call mut AcceptedView<'call>) -> i32 ! ByteIoError ? &mut MonotonicClock {
  return run exchange(&mut view.connection.*)
}

effect fn check() -> i32 ! NativeSocketError | ByteIoError ? &mut MonotonicClock {
  if unsafe fixture_socket_state() != 0 { return 10 }
  let port = unsafe fixture_socket_prepare(0)
  if port == 0 || port > 65535 { return 11 }
  let endpoint = Endpoint.make(IpAddress.V4 {value: Ipv4Address.fromOctets([127, 0, 0, 1])}, Port.fromU16(u32.toU16(port)))
  let mut client = run connectResolvedOwned(&[endpoint], ConnectOptions.defaults(), Option<Instant>.none())
  if unsafe fixture_socket_accept() != 1 { return 12 }
  let clientResult = run exchange(&mut client)
  if clientResult != 0 { return clientResult }
  run Connection.close(&mut client)
  if unsafe fixture_socket_finish() != 1 || unsafe fixture_socket_state() != 0 { return 13 }
  drop client

  let local = Endpoint.make(IpAddress.V4 {value: Ipv4Address.fromOctets([127, 0, 0, 1])}, Port.fromU16(0))
  let mut listener = run listen(local, ListenOptions.defaults())
  let bound = match Listener.boundAddress(&listener) {
    BoundAddress.Tcp {endpoint: address} => address
    _ => { return 14 }
  }
  let selectedPort = Endpoint.port(&bound)
  if unsafe fixture_socket_prepare(u16.toU32(Port.value(&selectedPort))) == 0 { return 15 }
  let peer = run accept(&mut listener, Option<Instant>.none())
  run Listener.close(&mut listener)
  let serverResult = run withAccepted<i32, ByteIoError>(move peer, accepted)
  if serverResult != 0 { return serverResult }
  if unsafe fixture_socket_finish() != 1 || unsafe fixture_socket_state() != 0 { return 16 }
  drop listener
  let refusedPort = unsafe fixture_socket_prepare(65536)
  if refusedPort == 0 || refusedPort > 65535 { return 17 }
  let refusedEndpoint = Endpoint.make(IpAddress.V4 {value: Ipv4Address.fromOctets([127, 0, 0, 1])}, Port.fromU16(u32.toU16(refusedPort)))
  let refused = run Effect.result(connectResolvedOwned(&[refusedEndpoint], ConnectOptions.defaults(), Option<Instant>.none()))
  match move refused {
    Result<Connection, NativeSocketError>.Failure {error} => match move error {
      NativeSocketError.AttemptsExhausted {last, ..} => match move last {
        AttemptFailure.ConnectionRefused => {}
        _ => { return 18 }
      }
      _ => { return 19 }
    }
    _ => { return 20 }
  }
  if unsafe fixture_socket_finish() != 1 || unsafe fixture_socket_state() != 0 { return 21 }
  return 0
}

pub effect fn main() -> i32 ! NativeSocketError | ByteIoError {
  let mut clock = OsMonotonicClock.make()
  return run check() |> Effect.provideMut<MonotonicClock>(&mut clock)
}
