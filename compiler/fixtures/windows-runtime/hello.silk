import silk.platform.windows.console { WindowsConsole }
import silk.core.effect { Effect }
import silk.io.writer { Writer, WriterError }

pub effect fn main() -> i32 ! WriterError {
  let mut output = WindowsConsole.stdout()
  run Writer.writeString("Hello from Silk: \u{1f4a9}\n") |> Effect.provideMut<Writer>(&mut output)
  return 0
}
