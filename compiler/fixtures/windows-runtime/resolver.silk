import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.core.result {Result}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.net.address {AddressError, Endpoint, Host, IpAddress, Ipv4Address, Port}
import silk.net.resolver {FamilySelection, ResolveRequest, ResolvedEndpoints, Resolver, ResolverError}
import silk.net.resolver_native {NativeSystemResolver}
import silk.platform.windows.winsock {WinsockSession}
import silk.system.monotonic_clock {MonotonicClock}
import silk.system.monotonic_clock_native {OsMonotonicClock}
import silk.system.system_clock {Instant, SystemClock}

unsafe extern "C" fn fixture_winsock_active() -> i32

effect fn lookup(deadline: Option<Instant>) -> i32 ! ResolverError | OutOfMemoryError
? &mut Allocator | &mut MonotonicClock {
  let host = match move Host.parse("localhost") {
    Result<Host, AddressError>.Success {value} => move value
    Result<Host, AddressError>.Failure {error} => { drop error
      return 1 }
  }
  let request = match move ResolveRequest.make(move host, Port.fromU16(43123), FamilySelection.V4, 4, move deadline) {
    Result<ResolveRequest, ResolverError>.Success {value} => move value
    Result<ResolveRequest, ResolverError>.Failure {error} => { fail move error }
  }
  let mut provider = NativeSystemResolver.make()
  let result = run Resolver.resolve(&request) |> Effect.provideMut<Resolver>(&mut provider)
  if ResolvedEndpoints.length(&result) == 0 { return 2 }
  let mut at: usize = 0
  while at < ResolvedEndpoints.length(&result) {
    let endpoint = ResolvedEndpoints.get(&result, at)
    let port = Endpoint.port(&endpoint)
    if Port.value(&port) != 43123 { return 3 }
    match Endpoint.address(&endpoint) {
      IpAddress.V4 {value} => {
        let octets = Ipv4Address.octets(&value)
        if octets[0] != 127 { return 4 }
      }
      _ => { return 5 }
    }
    at = at + 1
  }
  return 0
}

pub effect fn main() -> i32 ! ResolverError | OutOfMemoryError ? &mut Allocator {
  let mut clock = OsMonotonicClock.make()
  if unsafe fixture_winsock_active() != 0 { return 10 }
  let first = run lookup(Option<Instant>.none()) |> Effect.provideMut<MonotonicClock>(&mut clock)
  if first != 0 { return first }
  if unsafe fixture_winsock_active() != 0 { return 11 }
  let session = match move WinsockSession.make() {
    Result<WinsockSession, i32>.Success {value} => move value
    Result<WinsockSession, i32>.Failure {error} => { return 12 }
  }
  if unsafe fixture_winsock_active() != 1 { return 13 }
  let nested = run lookup(Option<Instant>.none()) |> Effect.provideMut<MonotonicClock>(&mut clock)
  if nested != 0 { return nested }
  if unsafe fixture_winsock_active() != 1 { return 14 }
  drop session
  if unsafe fixture_winsock_active() != 0 { return 15 }
  let limited = run Effect.result(lookup(Option<Instant>.some(SystemClock.make(9223372036854775807, 0))))
    |> Effect.provideMut<MonotonicClock>(&mut clock)
  match move limited {
    Result<i32, ResolverError | OutOfMemoryError>.Failure {error} => match move error {
      ResolverError.DeadlineUnsupported => {}
      _ => { return 16 }
    }
    _ => { return 17 }
  }
  if unsafe fixture_winsock_active() != 0 { return 18 }
  return 0
}
