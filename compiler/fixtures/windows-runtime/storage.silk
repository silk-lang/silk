import silk.concurrency.execution_storage {ExecutionStorage}
import silk.core.option {Option}
import silk.mem.allocator {OutOfMemoryError}
import silk.mem.layout {Layout}
import silk.mem.pointer {Pointer}
import silk.mem.raw_buffer {RawBuffer}
import silk.num.usize
import silk.platform.windows.heap {WindowsHeap}

effect fn systemStorage() -> Intrinsic.Allocation ! Intrinsic.StorageFailure {
  return run Intrinsic.systemAllocationAcquire(Layout {bytes: 8192, alignment: 4096})
}

effect fn refused(error: Intrinsic.StorageFailure) -> Intrinsic.Allocation ! OutOfMemoryError {
  drop error
  fail OutOfMemoryError {}
}

effect fn impossibleAllocation() -> bool ! Intrinsic.StorageFailure {
  // This fits MIR's usize arithmetic but cannot fit the Windows virtual address space. Refusal
  // reaches the generated free(null) edge before StorageFailure is delivered.
  let allocation = run Intrinsic.systemAllocationAcquire(Layout {bytes: usize.MAX, alignment: 1})
  drop allocation
  return false
}

effect fn expectedRefusal(error: Intrinsic.StorageFailure) -> bool {
  drop error
  return true
}

pub effect fn main() -> i32 ! OutOfMemoryError {
  // Both ownership paths must link even without optimization: source-adopted storage and the
  // sealed primitive's system storage. The over-alignment must survive their different reclaim.
  let adopted = run WindowsHeap.allocate(Layout {bytes: 8192, alignment: 4096})
  let system = run Intrinsic.catchFailure<Intrinsic.StorageFailure>(systemStorage(), refused)
  let mut adoptedBuffer = unsafe RawBuffer.from<u8>(move adopted, 8192)
  RawBuffer.fill(&mut adoptedBuffer, 0, 8192, 17)
  let adoptedBytes = unsafe RawBuffer.view<u8>(&adoptedBuffer, 0, 8192)
  if Pointer.addressMany(Intrinsic.pointerFromSlice<u8>(adoptedBytes)) % 4096 != 0 { return 9 }
  drop adoptedBytes
  let mut buffer = unsafe RawBuffer.from<u8>(move system, 8192)
  RawBuffer.fill(&mut buffer, 0, 8192, 42)
  let systemBytes = unsafe RawBuffer.view<u8>(&buffer, 0, 8192)
  if Pointer.addressMany(Intrinsic.pointerFromSlice<u8>(systemBytes)) % 4096 != 0 { return 10 }
  drop systemBytes
  if !(unsafe RawBuffer.resize<u8>(&mut buffer, 65536)) { return 6 }
  if unsafe RawBuffer.read<u8>(&buffer, 8191) != 42 { return 7 }
  RawBuffer.fill(&mut buffer, 65535, 1, 99)
  if unsafe RawBuffer.read<u8>(&buffer, 65535) != 99 { return 8 }
  if unsafe RawBuffer.resize<u8>(&mut buffer, usize.MAX) { return 11 }
  if RawBuffer.count<u8>(&buffer) != 65536 || unsafe RawBuffer.read<u8>(&buffer, 8191) != 42
    || unsafe RawBuffer.read<u8>(&buffer, 65535) != 99 { return 12 }
  drop buffer
  drop adoptedBuffer
  if !(run Intrinsic.catchFailure<Intrinsic.StorageFailure>(impossibleAllocation(), expectedRefusal)) { return 13 }
  let mut frames = run ExecutionStorage.make(65536)
  let frame = unsafe ExecutionStorage.acquire(&mut frames, 32768, 4096)
  let address = match move Pointer.nonNullMut(frame) {
    Option<*mut u8>.Some {value} => value
    Option<*mut u8>.None => { return 2 }
  }
  if Pointer.address(address) % 4096 != 0 { return 3 }
  unsafe Pointer.write(address, 42)
  if unsafe Pointer.read(address) != 42 { return 4 }
  unsafe ExecutionStorage.release(&mut frames, frame)
  if ExecutionStorage.used(&frames) != 0 { return 5 }
  return 0
}
