import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.layout { Layout }
import silk.mem.raw_buffer { RawBuffer }
import silk.mem.slot { Slot }
import silk.mem.pointer { Pointer }
import silk.system.host_input { HostInput, HostInputError }
import silk.platform.windows.wtf8 { Wtf8, InvalidWtf8 }
import silk.platform.windows.console { WindowsConsole }
import silk.text.string { String }
import silk.io.writer { Writer, WriterError }
import silk.num.usize

@foreign(noCapture: ("name", "value"))
unsafe extern "C" fn SetEnvironmentVariableW(name: ?[*]const u16, value: ?[*]const u16) -> i32

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at: usize = 0
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + 1
  }
  return true
}

fn found(value: Option<Bytes>, expected: &[u8]) -> bool {
  return match move value {
    Option<Bytes>.Some { value: bytes } => same(Bytes.asSlice(&bytes), expected)
    Option<Bytes>.None => false
  }
}

effect fn oversized() -> bool ! OutOfMemoryError ? &mut Allocator {
  let allocation = run Allocator.allocate(Layout { bytes: usize.MAX, alignment: 4096 })
  return false
}
effect fn refused(error: OutOfMemoryError) -> bool { return true }

effect fn check() -> i32 ! HostInputError | OutOfMemoryError | InvalidWtf8 | WriterError ? &mut Allocator | &mut HostInput {
  if (run HostInput.argumentCount()) != 3 { return 1 }
  if !found(run HostInput.argument(1), b"") { return 2 }
  if !found(run HostInput.argument(2), b"a b") { return 3 }
  if !found(run HostInput.variableNamed("silk_\u{e9}"), &[237, 160, 128]) { return 4 }
  // Mutating the OS environment must not change the startup snapshot supplied to this main.
  let mut name = run Wtf8.decodeBytes(String.utf8Bytes("SILK_\u{c9}"))
  run List<u16>.append(&mut name, 0)
  let changed: [u16; 2] = [120, 0]
  if unsafe SetEnvironmentVariableW(Pointer.fromSlice(List<u16>.asSlice(&name)), Pointer.fromSlice(&changed)) == 0 { return 5 }
  if !found(run HostInput.variableNamed("silk_\u{e9}"), &[237, 160, 128]) { return 6 }
  let allocation = run Allocator.allocate(Layout { bytes: 7, alignment: 4096 })
  let mut buffer = unsafe RawBuffer.from<u8>(move allocation, 7)
  let at = Slot.address(RawBuffer.slot<u8>(&mut buffer, 0))
  if Pointer.address(at) % 4096 != 0 { return 7 }
  unsafe Pointer.write(at, 42)
  if unsafe Pointer.read(at) != 42 { return 8 }
  drop buffer
  if !(run Intrinsic.catchFailure<OutOfMemoryError>(oversized(), refused)) { return 9 }
  let mut output = WindowsConsole.stdout()
  run Writer.writeString("Windows runtime: ok \u{1f4a9}\n") |> Effect.provideMut<Writer>(&mut output)
  return 0
}

pub effect fn main() -> i32 ! HostInputError | OutOfMemoryError | InvalidWtf8 | WriterError ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run check() |> Effect.provideMut<Allocator>(&mut allocator)
}
