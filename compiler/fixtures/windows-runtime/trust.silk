import silk.core.effect {Effect}
import silk.core.result {Result}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.mem.pointer {Pointer}
import silk.tls.certificate {Certificate}
import silk.tls.trust_anchor {TrustAnchor}
import silk.tls.trust_source {TrustSource}
import silk.tls.trust_source_windows {WindowsRootTrustSource}
import silk.tls.trust_snapshot {TrustLoadLimits, TrustSnapshot, TrustSourceError, TrustLimitKind}
import silk.num.u32
import silk.num.usize

unsafe extern "C" fn fixture_root_count() -> i32
@foreign(noCapture: ("bytes",))
unsafe extern "C" fn fixture_root_contains(bytes: ?[*]const u8, length: u32) -> i32

effect fn check() -> i32 ! TrustSourceError | OutOfMemoryError ? &mut Allocator {
  let mut provider = WindowsRootTrustSource.make()
  let snapshot = run TrustSource.load(TrustLoadLimits.defaults()) |> Effect.provideMut<TrustSource>(&mut provider)
  let certificates = TrustSnapshot.anchors(&snapshot)
  let count = unsafe fixture_root_count()
  if count < 0 || usize.toI32(certificates.length) != count { return 1 }
  let mut index: usize = 0
  while index < certificates.length {
    let der = Certificate.der(TrustAnchor.certificate(&certificates[index]))
    if unsafe fixture_root_contains(Pointer.fromSlice(der), usize.toU32(der.length)) != 1 { return 2 }
    index = index + 1
  }
  if certificates.length > 0 {
    let mut limits = TrustLoadLimits.defaults()
    limits.snapshot.anchors = 0
    let refused = run Effect.result(TrustSource.load(limits)) |> Effect.provideMut<TrustSource>(&mut provider)
    match move refused {
      Result<TrustSnapshot, TrustSourceError | OutOfMemoryError>.Failure {error} => match move error {
        TrustSourceError.LimitExceeded {kind, limit} => {
          if kind != TrustLimitKind.AnchorCount || limit != 0 { return 3 }
        }
        _ => { return 4 }
      }
      _ => { return 5 }
    }
    // The earlier snapshot still owns its certificate after the failed subsequent load.
    let der = Certificate.der(TrustAnchor.certificate(&certificates[0]))
    if unsafe fixture_root_contains(Pointer.fromSlice(der), usize.toU32(der.length)) != 1 { return 6 }
  }
  return 0
}

pub effect fn main() -> i32 ! TrustSourceError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run check() |> Effect.provideMut<Allocator>(&mut allocator)
}
