import silk.core.effect { Effect }
import silk.collections.slice { Slice }
import silk.system.system_clock { Instant, SystemClock }
import silk.system.system_clock_native { OsSystemClock }
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.monotonic_clock_native { OsMonotonicClock }
import silk.system.random { Random }
import silk.system.random_native { OsRandom }
import silk.io.standard_input { StandardInput, StreamReadError }
import silk.io.standard_input_native { OsStandardInput }
import silk.platform.windows.input { WindowsInput }

unsafe extern "C" fn fixture_input(mode: u32) -> i32

effect fn failedRead() -> bool ! StreamReadError {
  let mut input = OsStandardInput.make()
  let mut buffer: [u8; 1] = [0]
  let outcome = run StandardInput.receive(&mut buffer) |> Effect.provideMut<StandardInput>(&mut input)
  return false
}
effect fn caught(error: StreamReadError) -> bool { return true }

fn canonical(value: &Instant) -> bool {
  return SystemClock.nanoseconds(value) >= 0 && SystemClock.nanoseconds(value) < 1000000000
}

pub effect fn main() -> i32 ! StreamReadError {
  let mut wall = OsSystemClock.make()
  let now = run SystemClock.now() |> Effect.provideMut<SystemClock>(&mut wall)
  if !canonical(&now) { return 1 }
  let wallResolution = run SystemClock.getResolution() |> Effect.provideMut<SystemClock>(&mut wall)
  if wallResolution != 100 { return 2 }
  let mut clock = OsMonotonicClock.make()
  let mark = run MonotonicClock.now() |> Effect.provideMut<MonotonicClock>(&mut clock)
  if !canonical(&mark) || SystemClock.seconds(&mark) < 0 { return 3 }
  let clockResolution = run MonotonicClock.getResolution() |> Effect.provideMut<MonotonicClock>(&mut clock)
  if clockResolution == 0 { return 4 }
  run MonotonicClock.waitUntil(SystemClock.make(0, 0)) |> Effect.provideMut<MonotonicClock>(&mut clock)
  run MonotonicClock.waitFor(0) |> Effect.provideMut<MonotonicClock>(&mut clock)
  let mut random = OsRandom.make()
  let mut empty: [u8; 0] = []
  run Random.fillBytes(&mut empty) |> Effect.provideMut<Random>(&mut random)
  let mut bytes: [u8; 34] = [0; 34]
  bytes[0] = 37
  bytes[33] = 91
  run Random.fillBytes(Slice.viewMut(&mut bytes, 1, 32)) |> Effect.provideMut<Random>(&mut random)
  if bytes[0] != 37 || bytes[33] != 91 { return 5 }
  if unsafe fixture_input(0) == 0 { return 6 }
  let mut input = OsStandardInput.make()
  let mut buffer: [u8; 8] = [99; 8]
  let outcome = run StandardInput.receive(&mut buffer) |> Effect.provideMut<StandardInput>(&mut input)
  if StandardInput.isEndOfInput(&outcome) || StandardInput.count(&outcome) != 4 { return 7 }
  if buffer[0] != 0 || buffer[1] != 255 || buffer[2] != 26 || buffer[3] != 10 || buffer[4] != 99 { return 8 }
  let end = run StandardInput.receive(&mut buffer) |> Effect.provideMut<StandardInput>(&mut input)
  if !StandardInput.isEndOfInput(&end) { return 9 }
  if unsafe fixture_input(1) == 0 { return 10 }
  let sticky = run StandardInput.receive(&mut buffer) |> Effect.provideMut<StandardInput>(&mut input)
  if !StandardInput.isEndOfInput(&sticky) { return 11 }
  let zero = run StandardInput.receive(&mut empty) |> Effect.provideMut<StandardInput>(&mut input)
  if StandardInput.isEndOfInput(&zero) || StandardInput.count(&zero) != 0 { return 12 }
  if !(run Intrinsic.catchFailure<StreamReadError>(failedRead(), caught)) { return 13 }
  if unsafe fixture_input(2) == 0 { return 14 }
  if !(run Intrinsic.catchFailure<StreamReadError>(failedRead(), caught)) { return 15 }
  if unsafe fixture_input(3) == 0 { return 16 }
  let mut count: usize = 99
  let mut error: i32 = 0
  if (run WindowsInput.read(&mut buffer, &mut count, &mut error)) || count != 0 || error != 5 { return 17 }
  if !(run Intrinsic.catchFailure<StreamReadError>(failedRead(), caught)) { return 18 }
  if unsafe fixture_input(1) == 0 { return 19 }
  return 0
}
