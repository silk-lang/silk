import silk.collections.bytes {Bytes}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.core.result {Result}
import silk.http.client {Http, HttpCause, HttpError, HttpErrorKind, Request, Response}
import silk.http.client_native {NativeHttp}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.system.host_input {HostInput, HostInputError}
import silk.tls.connection {ConnectionError}
import silk.tls.client {TlsError}
import silk.tls.certificate_path {ValidationReason}

effect fn check() -> i32 ! HttpError | HostInputError | OutOfMemoryError ? &mut Allocator | &mut HostInput {
  let urlBytes = match move run HostInput.argument(1) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => { return 1 }
  }
  let bundleBytes = match move run HostInput.argument(2) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => { return 2 }
  }
  let url = match HostInput.text(Bytes.asSlice(&urlBytes)) {
    Result.Success {value} => value
    Result.Failure {error} => { return 6 }
  }
  let bundle = match HostInput.text(Bytes.asSlice(&bundleBytes)) {
    Result.Success {value} => value
    Result.Failure {error} => { return 7 }
  }
  let mut client = NativeHttp.make().trustBundle(bundle)
  let response = run Http.send(Request.get(url)) |> Effect.provideMut<Http>(&mut client)
  if Response.status(&response) != 200 || Response.body(&response).length == 0 { return 3 }
  let mut fromEnvironment = run NativeHttp.fromEnvironment()
  let environmentResponse = run Http.send(Request.get(url)) |> Effect.provideMut<Http>(&mut fromEnvironment)
  if Response.status(&environmentResponse) != 200 { return 8 }
  // An unrelated system-root snapshot must not authenticate the locally signed server.
  let mut system = NativeHttp.make()
  let refused = run Effect.result(Http.send(Request.get(url))) |> Effect.provideMut<Http>(&mut system)
  return match move refused {
    Result<Response, HttpError | OutOfMemoryError>.Success {value} => 4
    Result<Response, HttpError | OutOfMemoryError>.Failure {error} => match move error {
      HttpError failure => {
        if failure.kind != HttpErrorKind.Tls { return 5 }
        return match move failure.cause {
          HttpCause.Tls {error: ConnectionError.Tls {error: TlsError.CertificatePath {error: rejected}}} =>
            if rejected.reason == ValidationReason.NoIssuer { 0 } else { 9 }
          _ => 10
        }
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

pub effect fn main() -> i32 ! HttpError | HostInputError | OutOfMemoryError ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run check() |> Effect.provideMut<Allocator>(&mut allocator)
}
