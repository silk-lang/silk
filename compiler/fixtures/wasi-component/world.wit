package silk:test;
interface left { add: func(value: u32) -> u32; }
interface right { add: func(value: u32) -> u32; }
interface counters { resource counter { constructor(value: u32); add: func(value: u32) -> u32; } }
interface values {
  record summary { label: string, total: u32 }
}
world consumer {
  import left;
  import right;
  import counters;
  use values.{summary};
  export summarize: func(label: string, values: list<u32>) -> summary;
}
world provider { export left; export right; export counters; }
