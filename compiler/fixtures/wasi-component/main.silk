import silk.mem.pointer {Pointer}
import silk.option {Option}
import silk.core.ownership {Copy}
import silk.num.u32
unsafe extern "C" fn left(value: u32) -> u32 as "left_add" with Intrinsic.foreign(module: "silk:test/left", name: "add")
unsafe extern "C" fn right(value: u32) -> u32 as "right_add" with Intrinsic.foreign(module: "silk:test/right", name: "add")
unsafe extern "C" fn makeCounter(value: u32) -> u32 with Intrinsic.foreign(module: "silk:test/counters", name: "[constructor]counter")
unsafe extern "C" fn addCounter(handle: u32, value: u32) -> u32 with Intrinsic.foreign(module: "silk:test/counters", name: "[method]counter.add")
unsafe extern "C" fn dropCounter(handle: u32) -> () with Intrinsic.foreign(module: "silk:test/counters", name: "[resource-drop]counter")
extern "C" struct Summary { label: ?[*]mut u8, length: u32, total: u32 }
impl Copy for Summary {}
unsafe extern "C" fn allocate(size: usize) -> ?*mut Summary as "malloc"
unsafe extern "C" fn free(pointer: ?[*]const u8) -> ()
export "C" fn summarize(label: ?[*]mut u8, length: u32, values: ?[*]mut u32, count: u32) -> *mut Summary {
 unsafe {
  let mut total: u32 = 0
  if count > 0 {
   let source = match move Pointer.nonNullMany(values) { Option<[*]const u32>.Some {value} => value Option<[*]const u32>.None => Intrinsic.trap("null list") }
   let mut at: usize = 0
   while at < u32.toUsize(count) { total = total + Pointer.read(Pointer.at(source, at)) at = at + 1 }
   free(Pointer.bytes(Pointer.at(source, 0)))
  }
  let output = match move Pointer.nonNullMut(allocate(12)) { Option<*mut Summary>.Some {value} => value Option<*mut Summary>.None => Intrinsic.trap("allocation failed") }
  let counter = makeCounter(left(total))
  let result = addCounter(counter, right(total))
  dropCounter(counter)
  Pointer.write(output, Summary {label: label, length: length, total: result})
  return output
 }
}
export "C" fn release(output: *mut Summary) -> () as "cabi_post_summarize" {
 unsafe {
  let value = Pointer.read(output)
  if value.length > 0 { free(value.label) }
  free(Pointer.bytes(output))
 }
}
