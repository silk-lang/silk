export "C" fn left(value: u32) -> u32 as "silk:test/left#add" { return value + 10 }
export "C" fn right(value: u32) -> u32 as "silk:test/right#add" { return value + 20 }

import silk.mem.pointer {Pointer}
import silk.option {Option}
unsafe extern "C" fn newCounter(value: *mut u32) -> u32 with Intrinsic.foreign(module: "[export]silk:test/counters", name: "[resource-new]counter")
unsafe extern "C" fn allocate(size: usize) -> ?*mut u32 as "malloc"
unsafe extern "C" fn free(pointer: *mut u32) -> ()
export "C" fn makeCounter(value: u32) -> u32 as "silk:test/counters#[constructor]counter" {
 unsafe {
  let pointer = match move Pointer.nonNullMut(allocate(4)) {
   Option<*mut u32>.Some {value: allocated} => allocated
   Option<*mut u32>.None => Intrinsic.trap("counter allocation failed")
  }
  Pointer.write(pointer, value)
  return newCounter(pointer)
 }
}
export "C" fn addCounter(pointer: *mut u32, value: u32) -> u32 as "silk:test/counters#[method]counter.add" {
 unsafe {
  let next = Pointer.read(pointer) + value
  Pointer.write(pointer, next)
  return next
 }
}
export "C" fn dropCounter(pointer: *mut u32) -> () as "silk:test/counters#[dtor]counter" { unsafe free(pointer) }
