import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.system.filesystem { FileSystem, FileError, AtomicWriteError, Path }
import silk.system.host_input { HostInput, HostInputError }
import silk.collections.list { List }
import silk.io.logger { LogError }
import silk.system.monotonic_clock { MonotonicClock }
import silk.core.option { Option }
import silk.system.filesystem_native { OsFileSystem }
import silk.io.logger_native { StdoutLogger }
import silk.system.monotonic_clock_native { OsMonotonicClock }
import silk.system.random_native { OsRandom }
import silk.io.standard_input_native { OsStandardInput }
import silk.system.system_clock_native { OsSystemClock }
import silk.io.writer_native { StdoutWriter, StderrWriter }
import silk.system.random { Random }
import silk.core.result { Result }
import silk.io.standard_input { StandardInput, StreamReadError }
import silk.system.system_clock { SystemClock }
import silk.core.target { Target, Arch, OperatingSystem, pointerBits }
import silk.testing.testing { Testing, AssertionError }
import silk.io.writer { Writer, WriterError }

// Shared service behavior is exercised on each WASI ABI by test-wasi.ts.
effect fn files() -> ()
  ! FileError | OutOfMemoryError | AtomicWriteError | AssertionError<'static>
  ? &mut FileSystem | &mut Allocator {
  let directory = run Path.make("/files")
  run FileSystem.createDirectory(&directory)
  let path = run Path.make("/files/data")

  // Grow and recycle Silk's heap after host calls have allocated the component adapter's state.
  let mut large = run Bytes.zeroed(262144)
  let bytes = Bytes.asMutSlice(&mut large)
  bytes[131072] = 42
  drop bytes
  run FileSystem.writeFile(&path, Bytes.asSlice(&large))
  let readBack = run FileSystem.readFile(&path)
  run Testing.expect(
    Bytes.length(&readBack) == 262144 && Bytes.asSlice(&readBack)[131072] == 42,
    "host transfers preserve allocations across heap growth"
  )
  drop readBack
  drop large
  run FileSystem.removeFile(&path)
  run FileSystem.createFile(&path, b"old")
  let duplicate = run Effect.result(FileSystem.createFile(&path, b"must not replace"))
  let exists = match move duplicate {
    Result<(), FileError>.Success { value } => false
    Result<(), FileError>.Failure { error } => error.reason.code == FileSystem.alreadyExists().code
  }
  run Testing.expect(exists, "exclusive creation preserves an existing file")
  run FileSystem.writeFileAtomic(
    &path,
    b"new contents",
    FileSystem.replaceExisting(),
    FileSystem.buffered()
  )
  let copied = run FileSystem.readFile(&path)
  run Testing.expect(
    Bytes.length(&copied) == 12 && Bytes.asSlice(&copied)[0] == 110,
    "atomic replacement publishes complete contents"
  )
  let other = run Path.make("/files/new")
  run FileSystem.writeFileAtomic(&other, b"created", FileSystem.createNew(), FileSystem.buffered())
  let entries = run FileSystem.listDirectory(&directory)
  run Testing.expect(List.length(&entries) == 2, "directory iteration excludes staging files")
  let scratch = run FileSystem.temporaryDirectory(&directory, "scratch")
  run FileSystem.release(move scratch)
  let symlink = run Path.make("/escape")
  let refused = run Effect.result(FileSystem.readFile(&symlink))
  let protected = match move refused {
    Result<Bytes, FileError | OutOfMemoryError>.Success { value } => false
    Result<Bytes, FileError | OutOfMemoryError>.Failure { error } => true
  }
  run Testing.expect(protected, "paths cannot follow a symbolic link outside the preopen")
  run FileSystem.removeFile(&path)
  run FileSystem.removeFile(&other)
  run FileSystem.removeDirectory(&directory)
}

effect fn systemServices() -> ()
  ! AssertionError<'static> {
  let mut clock = OsMonotonicClock.make()
  let now = run MonotonicClock.now() |> Effect.provideMut<MonotonicClock>(&mut clock)
  run MonotonicClock.waitUntil(move now) |> Effect.provideMut<MonotonicClock>(&mut clock)
  let resolution = run MonotonicClock.getResolution()
    |> Effect.provideMut<MonotonicClock>(&mut clock)
  run Testing.expect(resolution > 0, "clock resolution is valid")
  let mut wall = OsSystemClock.make()
  let date = run SystemClock.now() |> Effect.provideMut<SystemClock>(&mut wall)
  run Testing.expect(
    SystemClock.nanoseconds(&date) >= 0 && SystemClock.nanoseconds(&date) < 1000000000,
    "wall clock nanoseconds are normalized"
  )
  let mut random = OsRandom.make()
  let mut bytes: [u8; 16] = [0; 16]
  run Random.fillBytes(&mut bytes) |> Effect.provideMut<Random>(&mut random)
  let mut empty: [u8; 0] = []
  run Random.fillBytes(&mut empty) |> Effect.provideMut<Random>(&mut random)
}

pub effect fn main() -> i32
  ! FileError
    | OutOfMemoryError
    | AtomicWriteError
    | LogError
    | HostInputError
    | StreamReadError
    | WriterError
    | AssertionError<'static>
  ? &mut HostInput {
  static if Target.arch() != Arch.Wasm32 || Target.operatingSystem() != OperatingSystem.Wasi
    || pointerBits != 32 {
    compileError("the WASI fixture must observe its selected target")
  }
  let mut allocator = Allocator.systemAllocatorProvider()
  let count = run HostInput.argumentCount()
  run Testing.expect(count == 2, "command arguments reach the guest")
  let environment = run HostInput.variableNamed("SILK_WASI_TEST")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let present = match move environment {
    Option<Bytes>.Some { value } => Bytes.length(&value) == 5
    Option<Bytes>.None => false
  }
  run Testing.expect(present, "environment snapshot reaches the guest")
  let mut fs = run OsFileSystem.make("/") |> Effect.provideMut<Allocator>(&mut allocator)
  run files() |> Effect.provideMut<FileSystem>(&mut fs)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run systemServices()
  let mut input = OsStandardInput.make()
  let mut buffer: [u8; 32] = [0; 32]
  let mut total: usize = 0
  while true {
    let result = run StandardInput.receive(&mut buffer)
      |> Effect.provideMut<StandardInput>(&mut input)
    if StandardInput.isEndOfInput(&result) {
      break
    }
    total = total + StandardInput.count(&result)
  }
  run Testing.expect(total == 5, "standard input is read to end of input")
  let mut out = StdoutWriter.make()
  run Writer.writeVectored(&[b"gather:", b"a", b"", b"b\n"]) |> Effect.provideMut<Writer>(&mut out)
  let mut err = StderrWriter.make()
  run Writer.writeString("wasi stderr\n") |> Effect.provideMut<Writer>(&mut err)
  let mut logger = StdoutLogger.make()
  run Effect.log("wasi services passed\n", &()) |> Effect.provideMut(&mut logger)
  return 0
}

test effect fn clocksAndRandomness() -> ()
  ! AssertionError<'static> {
  run systemServices()
}

test effect fn targetFacts() -> ()
  ! AssertionError<'static> {
  run Testing.expect(pointerBits == 32, "WASI tests use the guest pointer width")
}
