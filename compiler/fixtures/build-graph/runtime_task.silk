import silk.build.graph { Build, Compilation, Deferred, Options, BuildError }
import silk.cli.command { Command, CommandLine }
import silk.cli.task { Task, TaskSet }
import silk.mem.allocator { Allocator }
import silk.system.filesystem { FileSystem }
import silk.system.host_input { HostInput }
import silk.text.string { String }

// Selects the manifest's `standalone` runtime for bare WebAssembly and its default elsewhere, so a
// plan for `wasm32-unknown-unknown` publishes a request the manifest's default runtime cannot start.
union Tasks {
  Plan { pub options: Options },
}

impl CommandLine for Tasks {
  static fn command() -> Command<Tasks> {
    return Command<Tasks>.make("tasks", "Publish a plan that selects the runtime by target")
      |> Command.flatten("options")
  }
}

impl TaskSet for Tasks {
  effect fn perform(self: Self) -> ()
    ! BuildError
    ? &mut Allocator | &mut FileSystem | &mut HostInput {
    match move self {
      Tasks.Plan { options } => {
        let mut compilation = run Compilation.fromPackage(&options)
        let mut target = ""
        if options.target.length() > 0 {
          target = options.target.asSlice()[0].view()
        }
        if target == "wasm32-unknown-unknown" {
          let original = move compilation
          compilation = run original.runtime(run Deferred<String>.value(run String.copy("standalone")))
        }
        let graph = run Build.make()
        let ready = run graph.add(move compilation)
        drop run ready.write()
      }
    }
  }
}

pub effect fn main() -> i32
  ? &mut HostInput {
  return run Task.main<Tasks>()
}
