import silk.build.graph { Build, Compilation, Options, BuildError, Step, Key, Make }
import silk.build.step { Deferred, StepFailure }
import silk.cli.command { Command, CommandLine }
import silk.cli.task { Task, TaskSet }
import silk.mem.allocator { Allocator }
import silk.system.filesystem { FileSystem, Path }
import silk.system.host_input { HostInput }

union Tasks {
  Build { pub options: Options },
}

impl CommandLine for Tasks {
  static fn command() -> Command<Tasks> {
    return Command<Tasks>.make("tasks", "A graph that mixes custom and standard steps")
      |> Command.variant("Build", "Build through custom and standard steps")
      |> Command.flatten("options")
  }
}

// Runs in the task program and feeds the compilation, which the compiler runs.
struct Stamp {}

impl Step for Stamp {
  effect fn key(self: &Self, key: &mut Key) -> ()
    ! StepFailure
    ? &mut Allocator {
    return run key.text("stamp-v1")
  }

  effect fn make(self: &Self, make: &mut Make) -> ()
    ! StepFailure
    ? &mut Allocator {
    return run make.write("stamp.bin", b"stamped")
  }
}

// Runs in the task program after the compiler built the artifact it reads.
struct Size {
  artifact: Deferred<Path>,
}

impl Step for Size {
  effect fn key(self: &Self, key: &mut Key) -> ()
    ! StepFailure
    ? &mut Allocator {
    return run key.file(&self.artifact)
  }

  effect fn make(self: &Self, make: &mut Make) -> ()
    ! StepFailure
    ? &mut Allocator {
    let bytes = run make.read(&self.artifact)
    if bytes.length() > 1000 {
      return run make.write("size.txt", b"big\n")
    }
    return run make.write("size.txt", b"small\n")
  }
}

impl TaskSet for Tasks {
  effect fn perform(self: Self) -> ()
    ! BuildError
    ? &mut Allocator | &mut FileSystem | &mut HostInput {
    match move self {
      Tasks.Build { options } => {
        let stamp = run Step.register(Stamp {})
        let base = run Compilation.fromPackage(&options)
        let compilation = run base.embed("stamp", run stamp.output("stamp.bin"))
        let size = run Step.register(Size { artifact: run compilation.artifact() })
        let build = run Build.make()
        let graph = run build.add(move compilation)
        let whole = run graph.addStep(move size, "size.txt")
        drop run whole.compile()
      }
    }
  }
}

pub effect fn main() -> i32
  ? &mut HostInput {
  return run Task.main<Tasks>()
}
