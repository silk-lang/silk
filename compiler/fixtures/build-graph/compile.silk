import silk.cli.task { TaskError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.build.graph { Build, Compilation, Built, Artifact, Package }
import silk.build.request { Request }
import silk.build.definition { Definition }
import silk.build.step { Deferred, StepError, StepFailure }
import silk.concurrency.fiber { Cancelled }
import silk.concurrency.thread_native { SpawnError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator }
import silk.schema.toml { SchemaToml }
import silk.system.filesystem { FileSystem, Path }
import silk.system.filesystem_machine { MachineFileSystem }
import silk.system.host_input { HostInput }
import silk.system.child_process { ChildProcess }
import silk.system.child_process_native { OsChildProcess }
import silk.text.string { String }

type Failure = StepFailure | SpawnError | Cancelled | TaskError

effect fn program() -> i32
  ! Failure
  ? &mut Allocator | &mut FileSystem | &mut HostInput | &mut ChildProcess {
  if let Option<Bytes>.Some { value: launchFile } = move run HostInput.variableNamed(
    "SILK_TEST_LAUNCH_REQUEST",
  ) {
    let path = run Path.fromBytes(launchFile.asSlice())
    let bytes = run FileSystem.readFile(&path)
    let request = run SchemaToml.decode<Request>(bytes.asSlice())
    let mut artifacts = List<Artifact>.make()
    run artifacts.append(
      Artifact {
        name: run String.copy(request.name.view()),
        path: run Path.make(request.output.view()),
        request: Option<Path>.some(move path),
      },
    )
    let built = Built { artifacts: move artifacts }
    run built.launch(&["argument with spaces"])
    return 0
  }
  let cwd = run HostInput.workingDirectory()
  let root = run Path.fromBytes(cwd.asSlice())
  let file = run Path.join(&root, "definition.toml")
  let contents = run FileSystem.readFile(&file)
  let compiler = run HostInput.variableNamed("SILK_TEST_COMPILER")
  let compilerPath = match move compiler {
    Option<Bytes>.Some { value } => run Path.fromBytes(value.asSlice())
    Option<Bytes>.None => {
      fail StepError { message: run String.copy("SILK_TEST_COMPILER is required") }
    }
  }
  let name = match move Path.view(&compilerPath) {
    Option<string>.Some { value } => value
    Option<string>.None => {
      fail StepError { message: run String.copy("compiler path must be UTF-8") }
    }
  }
  let parent = match move run Path.parent(&root) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      fail StepError { message: run String.copy("fixture needs a parent directory") }
    }
  }
  let mut definition = run SchemaToml.decode<Definition>(contents.asSlice())
  let originalRoot = match move definition.settings.root {
    Option<String>.Some { value } => move value
    Option<String>.None => run String.copy(
      Path.view(&run Path.join(&root, "main.silk")).unwrapOr(""),
    )
  }
  definition.settings.root = Option<String>.some(
    run String.copy("/missing/replaced-definition-root.silk"),
  )
  let initial = run Compilation.fromDefinition(move definition, run Deferred<Path>.external(name))
  let replaced = run initial.root(
    run Deferred<Path>.external("/missing/replaced-deferred-root.silk"),
  )
  let selected = run replaced.root(run Deferred<Path>.external(originalRoot.view()))
  let configured = run selected.emit(run Deferred<String>.value(run String.copy("final")))
  let embedded = run configured.embed("payload", run Package.path("dep", "asset.bin"))
  let compilation = run embedded.module(
    "extra",
    run Deferred<String>.value(run String.copy("pub const VALUE: i32 = 5")),
  )
  let graph = run Build.at(run Path.fromBytes(Path.rawBytes(&parent)), b"compilation-test-v1")
  let populated = run graph.add(move compilation)
  let planned = run populated.write()
  let artifact = run Path.fromBytes(Path.rawBytes(&planned.artifacts.asSlice()[0].path))
  if run FileSystem.exists(&artifact) {
    return 1
  }
  let written = match &planned.artifacts.asSlice()[0].request {
    Option<Path>.Some { value } => run Path.fromBytes(Path.rawBytes(&value))
    Option<Path>.None => {
      return 4
    }
  }
  if !run FileSystem.exists(&written) {
    return 2
  }
  let plannedText = run FileSystem.readFile(&written)
  let publishedRequest = run SchemaToml.decode<Request>(plannedText.asSlice())
  if publishedRequest.packages.asSlice()[0].modules.asSlice().length != 3 {
    return 7
  }
  let plannedPath = run Path.make(publishedRequest.output.view())
  if Path.view(&plannedPath).unwrapOr("") != Path.view(&artifact).unwrapOr("") {
    return 5
  }
  let mut rebuilt = run SchemaToml.decode<Definition>(contents.asSlice())
  rebuilt.settings.root = Option<String>.some(
    run String.copy("/missing/replaced-definition-root.silk"),
  )
  let initialBuild = run Compilation.fromDefinition(move rebuilt, run Deferred<Path>.external(name))
  let replacedBuild = run initialBuild.root(
    run Deferred<Path>.external("/missing/replaced-deferred-root.silk"),
  )
  let selectedBuild = run replacedBuild.root(run Deferred<Path>.external(originalRoot.view()))
  let configuredBuild = run selectedBuild.emit(run Deferred<String>.value(run String.copy("final")))
  let embeddedBuild = run configuredBuild.embed("payload", run Package.path("dep", "asset.bin"))
  let build = run embeddedBuild.module(
    "extra",
    run Deferred<String>.value(run String.copy("pub const VALUE: i32 = 5")),
  )
  let second = run Build.at(run Path.fromBytes(Path.rawBytes(&parent)), b"compilation-test-v1")
  let complete = run second.add(move build)
  let built = run complete.compile()
  if !run FileSystem.exists(&artifact) {
    return 3
  }
  let arguments: [string; 0] = []
  run built.launch(&arguments)
  let copied = run built.write("dist")
  run copied.launch(&arguments)
  if !run FileSystem.exists(&copied.artifacts.asSlice()[0].path) {
    return 6
  }
  return 0
}

pub effect fn main() -> i32
  ! Failure
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut files = run MachineFileSystem.make() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut processes = OsChildProcess.make()
  return run program()
    |> Effect.provideMut<ChildProcess>(&mut processes)
    |> Effect.provideMut<FileSystem>(&mut files)
    |> Effect.provideMut<Allocator>(&mut allocator)
}
