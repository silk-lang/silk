import silk.cli.task { TaskError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.build.graph { Build, Compilation, Built, Artifact }
import silk.build.request { Request }
import silk.build.step { Deferred, StepError, StepFailure }
import silk.concurrency.fiber { Cancelled }
import silk.concurrency.thread_native { SpawnError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator }
import silk.schema.toml { SchemaToml }
import silk.system.filesystem { FileSystem, Path }
import silk.system.filesystem_machine { MachineFileSystem }
import silk.system.host_input { HostInput }
import silk.text.string { String }

type Failure = StepFailure | SpawnError | Cancelled | TaskError

effect fn program() -> i32 ! Failure ? &mut Allocator | &mut FileSystem | &mut HostInput {
  if let Option<Bytes>.Some {value: launchFile} = move run HostInput.variableNamed("SILK_TEST_LAUNCH_REQUEST") {
    let path = run Path.fromBytes(launchFile.asSlice())
    let bytes = run FileSystem.readFile(&path)
    let request = run SchemaToml.decode<Request>(bytes.asSlice())
    let mut artifacts = List<Artifact>.make()
    run artifacts.append(Artifact {name: run String.copy(request.name.view()),
      path: run Path.make(request.output.view()), request: Option<Path>.some(move path)})
    let built = Built {artifacts: move artifacts}
    run built.launch(&["argument with spaces"])
    return 0
  }
  let cwd = run HostInput.workingDirectory()
  let root = run Path.fromBytes(cwd.asSlice())
  let file = run Path.join(&root, "request.toml")
  let contents = run FileSystem.readFile(&file)
  let compiler = run HostInput.variableNamed("SILK_TEST_COMPILER")
  let compilerPath = match move compiler {
    Option<Bytes>.Some {value} => run Path.fromBytes(value.asSlice())
    Option<Bytes>.None => { fail StepError {message: run String.copy("SILK_TEST_COMPILER is required")} }
  }
  let name = match move Path.view(&compilerPath) {
    Option<string>.Some {value} => value
    Option<string>.None => { fail StepError {message: run String.copy("compiler path must be UTF-8")} }
  }
  let parent = match move run Path.parent(&root) {
    Option<Path>.Some {value} => move value
    Option<Path>.None => { fail StepError {message: run String.copy("fixture needs a parent directory")} }
  }
  let request = run SchemaToml.decode<Request>(contents.asSlice())
  let initial = run Compilation.fromRequest(move request, run Deferred<Path>.external(name))
  let configured = run initial.emit(run Deferred<String>.value(run String.copy("final")))
  let compilation = run configured.module("extra", run Deferred<String>.value(run String.copy("pub const VALUE: i32 = 5")))
  let graph = run Build.at(run Path.fromBytes(Path.rawBytes(&parent)), b"compilation-test-v1")
  let populated = run graph.add(move compilation)
  let planned = run populated.write()
  let artifact = run Path.fromBytes(Path.rawBytes(&planned.artifacts.asSlice()[0].path))
  if run FileSystem.exists(&artifact) { return 1 }
  let written = match &planned.artifacts.asSlice()[0].request {
    Option<Path>.Some {value} => run Path.fromBytes(Path.rawBytes(&value))
    Option<Path>.None => { return 4 }
  }
  if !run FileSystem.exists(&written) { return 2 }
  let plannedText = run FileSystem.readFile(&written)
  let publishedRequest = run SchemaToml.decode<Request>(plannedText.asSlice())
  if publishedRequest.packages.asSlice()[0].modules.asSlice().length != 2 { return 7 }
  let plannedPath = run Path.make(publishedRequest.output.view())
  if Path.view(&plannedPath).unwrapOr("") != Path.view(&artifact).unwrapOr("") { return 5 }
  let rebuilt = run SchemaToml.decode<Request>(contents.asSlice())
  let initialBuild = run Compilation.fromRequest(move rebuilt, run Deferred<Path>.external(name))
  let configuredBuild = run initialBuild.emit(run Deferred<String>.value(run String.copy("final")))
  let build = run configuredBuild.module("extra", run Deferred<String>.value(run String.copy("pub const VALUE: i32 = 5")))
  let second = run Build.at(run Path.fromBytes(Path.rawBytes(&parent)), b"compilation-test-v1")
  let complete = run second.add(move build)
  let built = run complete.compile()
  if !run FileSystem.exists(&artifact) { return 3 }
  let arguments: [string; 0] = []
  run built.launch(&arguments)
  let copied = run built.write("dist")
  run copied.launch(&arguments)
  if !run FileSystem.exists(&copied.artifacts.asSlice()[0].path) { return 6 }
  return 0
}

pub effect fn main() -> i32 ! Failure ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut files = run MachineFileSystem.make() |> Effect.provideMut<Allocator>(&mut allocator)
  return run program() |> Effect.provideMut<FileSystem>(&mut files) |> Effect.provideMut<Allocator>(&mut allocator)
}
