import silk.build.options { Options, Optimize }
import silk.cli.command { Command, CommandLine }
import silk.cli.parse { Cli, CliError, Parsed }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }

struct CommandOptions { pub options: Options }
impl CommandLine for CommandOptions {
  static fn command() -> Command<Self> {
    return Command<Self>.make("build", "Build the project") |> Command.flatten("options")
  }
}

effect fn check() -> i32 ! OutOfMemoryError ? &mut Allocator {
  match move run Cli.parse<CommandOptions>(&["build", "--release", "--target", "wasm32-wasip1", "--target=x86_64-unknown-linux-gnu", "--debug", "true"]) {
    Parsed<CommandOptions>.Run {value} => {
      if value.options.optimize != Optimize.Speed { return 11 }
      if !value.options.debugInfo() { return 12 }
      if value.options.target.asSlice().length != 2 { return 2 }
    }
    _ => { return 3 }
  }
  match move run Cli.parse<Options>(&["build", "--release", "--optimization", "none"]) {
    Parsed<Options>.Failed {error: CliError.Repeated {..}, ..} => {}
    _ => { return 4 }
  }
  match move run Cli.parse<Options>(&["build", "--release=false"]) {
    Parsed<Options>.Failed {error: CliError.UnexpectedValue {..}, ..} => {}
    _ => { return 5 }
  }
  match move run Cli.parse<Options>(&["build", "--optimization", "size", "--debug=false"]) {
    Parsed<Options>.Run {value} => {
      if value.optimize != Optimize.Size || value.debugInfo() { return 6 }
    }
    _ => { return 7 }
  }
  return 0
}

pub effect fn main() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run check() |> Effect.provideMut<Allocator>(&mut allocator)
}
