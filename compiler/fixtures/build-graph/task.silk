import silk.build.graph { BuildError }
import silk.build.step { StepError }
import silk.cli.command { Command, CommandLine }
import silk.cli.task { Task, TaskSet }
import silk.mem.allocator { Allocator }
import silk.system.host_input { HostInput }
import silk.text.string { String }

union Tasks {
  Fail
}

impl CommandLine for Tasks {
  static fn command() -> Command<Self> {
    return Command<Self>.make("graph-task", "Build graph task errors")
  }
}

impl TaskSet for Tasks {
  effect fn perform(self: Self) -> ()
    ! BuildError
    ? &mut Allocator {
    drop self
    fail StepError { message: run String.copy("declared build input is missing") }
  }
}

pub const COMMANDS: string = Task.commands<Tasks>()

pub effect fn main() -> i32
  ? &mut HostInput {
  return run Task.main<Tasks>()
}
