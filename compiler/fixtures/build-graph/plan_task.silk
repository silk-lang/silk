import silk.build.graph { Build, Compilation, Options, BuildError }
import silk.build.options { Optimize }
import silk.build.step { Deferred, StepError }
import silk.cli.command { Command, CommandLine }
import silk.cli.task { Task, TaskSet }
import silk.mem.allocator { Allocator }
import silk.system.filesystem { FileSystem }
import silk.system.host_input { HostInput }
import silk.text.string { String }

union Tasks {
  Plan
}

impl CommandLine for Tasks {
  static fn command() -> Command<Tasks> {
    return Command<Tasks>.make("tasks", "Publish a custom plan")
  }
}

impl TaskSet for Tasks {
  effect fn perform(self: Self) -> ()
    ! BuildError
    ? &mut Allocator | &mut FileSystem | &mut HostInput {
    let speed = run Deferred<Optimize>.value(Optimize.Speed)
    let base = run Compilation.fromPackage(&Options.make())
    // A plain lambda returns the transform's Effect; an effect lambda runs steps in its body.
    let fast = run base.when(true, |c| c.optimize(move speed))
    let quiet = run fast.when(true, effect |c| run c.debug(run Deferred<bool>.value(false)))
    // A false condition never calls the transform, so this one's failure never happens.
    let compilation = run quiet.when(false, effect |c| {
      drop c
      fail StepError { message: run String.copy("a false condition must not call the transform") }
    })
    let graph = run Build.make()
    let ready = run graph.add(move compilation)
    drop run ready.write()
  }
}

pub effect fn main() -> i32
  ? &mut HostInput {
  return run Task.main<Tasks>()
}
