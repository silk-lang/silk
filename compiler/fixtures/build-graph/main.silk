import silk.build.run { Run }
import silk.build.write_files { WriteFiles }
import silk.build.step { Deferred, Key, Make, Runner, Step, StepError, StepFailure }
import silk.collections.list { List }
import silk.concurrency.execution { Execution, TransferableWake }
import silk.concurrency.fiber { Cancelled }
import silk.concurrency.sync { Arc, Mutex }
import silk.concurrency.thread_native { SpawnError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator }
import silk.system.filesystem { FileSystem, Path }
import silk.system.filesystem_machine { MachineFileSystem }
import silk.system.host_input { HostInput }
import silk.text.string { String }

type Failure = StepFailure | SpawnError | Cancelled
struct Copy {
  source: Deferred<Path>,
  calls: Arc<Mutex<i32>>,
  always: bool,
  declared: bool,
}

struct Tool {}
impl Step for Tool {
  effect fn key(self: &Self, key: &mut Key) -> () ! StepFailure ? &mut Allocator { return run key.text("tool") }
  effect fn make(self: &Self, make: &mut Make) -> () ! StepFailure ? &mut Allocator {
    if make.shouldCompile() { run make.write("result", b"tool") }
  }
  fn compilation(self: &Self) -> bool { return true }
}
impl Step for Copy {
  effect fn key(self: &Self, key: &mut Key) -> () ! StepFailure ? &mut Allocator {
    if self.always { key.always() }
    if self.declared { run key.file(&self.source) }
    return ()
  }
  effect fn make(self: &Self, make: &mut Make) -> () ! StepFailure ? &mut Allocator {
    run Execution.parkTransferable(|wake: TransferableWake| -> () { Execution.wakeTransferable(move wake) })
    let mut calls = self.calls.get().lock()
    let counter = calls.getMut()
    counter.* = counter.* + 1
    drop calls
    let content = run make.read(&self.source)
    return run make.write("result", content.asSlice())
  }
}

fn count(calls: &Arc<Mutex<i32>>) -> i32 {
  let held = calls.get().lock()
  return held.get().*
}

effect fn verify(condition: bool, message: string) -> () ! StepFailure ? &mut Allocator {
  if !condition { fail StepError {message: run String.copy(message)} }
}

effect fn graph(root: &Path, calls: &Arc<Mutex<i32>>, always: bool, declared: bool) -> List<Path>
! Failure ? &mut Allocator | &mut FileSystem | &mut HostInput {
  let producer = run Step.register(Copy {source: run Deferred<Path>.source("input"), calls: calls.clone(), always: always, declared: declared})
  let consumer = run Step.register(Copy {source: run producer.output("result"), calls: calls.clone(), always: false, declared: true})
  let runner = run Runner.make(run Path.fromBytes(Path.rawBytes(root)), run Path.join(root, "steps"), b"build-graph-fixture-v1")
  return run runner.execute(&[move producer, move consumer], true)
}

fn greeting(input: String) -> String { return move input }
effect fn capturedArgument(process: Run) -> Run ! StepFailure ? &mut Allocator {
  return run process.argument("captured")
}

effect fn check(root: &Path) -> () ! Failure ? &mut Allocator | &mut FileSystem | &mut HostInput {
  let tool = run Step.register(Tool {})
  let toolCalls = run Arc<Mutex<i32>>.make(run Mutex<i32>.make(0))
  let toolConsumer = run Step.register(Copy {source: run tool.output("result"), calls: toolCalls.clone(), always: false, declared: true})
  let toolRunner = run Runner.make(run Path.fromBytes(Path.rawBytes(root)), run Path.join(root, "tools"), b"tool-v1")
  let _toolPaths = run toolRunner.execute(&[move tool, move toolConsumer], false)
  run verify(count(&toolCalls) == 1, "planning must compile a requested compilation when another root needs it as a tool")
  let process = run Run.program("printf")
  let withArgument = run process.when(true, capturedArgument)
  let captured = run withArgument.captureText()
  let files = run WriteFiles.make().value("captured", move captured)
  let captureStep = run files.register()
  let captureRunner = run Runner.make(run Path.fromBytes(Path.rawBytes(root)), run Path.join(root, "capture"), b"capture-v1")
  let capturedPaths = run captureRunner.execute(&[move captureStep], true)
  let capturedPath = run Path.join(&capturedPaths.asSlice()[0], "captured")
  let capturedBytes = run FileSystem.readFile(&capturedPath)
  run verify(capturedBytes.length() == 8, "captured output must feed a deferred value")
  let known = run Deferred<String>.value(run String.copy("mapped"))
  let mapped = run known.map<String>(greeting)
  let generated = run WriteFiles.make().value("generated", move mapped)
  let registered = run generated.register()
  let mappedRunner = run Runner.make(run Path.fromBytes(Path.rawBytes(root)), run Path.join(root, "values"), b"values-v1")
  let values = run mappedRunner.execute(&[move registered], true)
  let mappedFile = run Path.join(&values.asSlice()[0], "generated")
  let mappedBytes = run FileSystem.readFile(&mappedFile)
  run verify(mappedBytes.length() == 6, "mapped values must feed generated files")
  let source = run Path.join(root, "input")
  run FileSystem.writeFile(&source, b"first")
  let duplicateCalls = run Arc<Mutex<i32>>.make(run Mutex<i32>.make(0))
  let duplicateA = run Step.register(Copy {source: run Deferred<Path>.source("input"), calls: duplicateCalls.clone(), always: false, declared: true})
  let duplicateB = run Step.register(Copy {source: run Deferred<Path>.source("input"), calls: duplicateCalls.clone(), always: false, declared: true})
  let duplicates = run Runner.make(run Path.fromBytes(Path.rawBytes(root)), run Path.join(root, "duplicates"), b"duplicate-v1")
  let duplicatePaths = run duplicates.execute(&[move duplicateA, move duplicateB], true)
  run verify(count(&duplicateCalls) == 1 && duplicatePaths.asSlice().length == 2,
    "distinct registrations with one key must execute once and serve both roots")
  let calls = run Arc<Mutex<i32>>.make(run Mutex<i32>.make(0))
  let first = run graph(root, &calls, false, true)
  run verify(count(&calls) == 2, "producer and consumer must both run")
  let consumer = run Path.join(&first.asSlice()[1], "result")
  let content = run FileSystem.readFile(&consumer)
  run verify(content.length() == 5, "the consumer must see its producer's file")
  let _warm = run graph(root, &calls, false, true)
  run verify(count(&calls) == 2, "a warm graph must run no work")
  run FileSystem.writeFile(&consumer, b"corrupt")
  let _repaired = run graph(root, &calls, false, true)
  run verify(count(&calls) == 3, "corrupt output must rerun its producer")
  run FileSystem.writeFile(&source, b"second")
  let second = run graph(root, &calls, false, true)
  run verify(count(&calls) == 5, "changing an input must invalidate its consumers")
  run verify(Path.rawBytes(&first.asSlice()[1]).length == Path.rawBytes(&second.asSlice()[1]).length,
    "cache names must use fixed-length digests")
  let _always = run graph(root, &calls, true, true)
  let _alwaysAgain = run graph(root, &calls, true, true)
  run verify(count(&calls) == 9, "always must propagate to consumers")
  let refused = run Effect.result(graph(root, &calls, false, false))
  let rejected = match move refused {
    Result<List<Path>, Failure>.Success {..} => false
    Result<List<Path>, Failure>.Failure {error} => match move error {
      StepError _error => true
      _ => false
    }
  }
  run verify(rejected, "undeclared inputs must fail on the first read")
}

effect fn program() -> i32 ! Failure ? &mut Allocator | &mut FileSystem | &mut HostInput {
  let cwd = run HostInput.workingDirectory()
  let root = run Path.fromBytes(cwd.asSlice())
  run check(&root)
  return 0
}

pub effect fn main() -> i32 ! Failure ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut files = run MachineFileSystem.make() |> Effect.provideMut<Allocator>(&mut allocator)
  return run program() |> Effect.provideMut<FileSystem>(&mut files) |> Effect.provideMut<Allocator>(&mut allocator)
}
