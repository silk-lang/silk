import silk.build.run { Run }
import silk.build.step { Deferred, Runner, StepFailure }
import silk.concurrency.fiber { Cancelled }
import silk.concurrency.thread_native { SpawnError }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator }
import silk.system.filesystem { FileSystem, Path }
import silk.system.filesystem_machine { MachineFileSystem }
import silk.system.host_input { HostInput }
import silk.text.string { String }

type Failure = StepFailure | SpawnError | Cancelled

effect fn argument(process: Run, text: string) -> Run ! StepFailure ? &mut Allocator {
  return run process.argument(run Deferred<String>.value(run String.copy(text)))
}

effect fn check() -> i32 ! Failure ? &mut Allocator | &mut FileSystem | &mut HostInput {
  let cwd = run HostInput.workingDirectory()
  let root = run Path.fromBytes(cwd.asSlice())
  let allowed = run Path.join(&root, "allowed")
  let denied = run Path.join(&root, "denied")
  let forbidden = run Path.join(&root, "forbidden")
  run FileSystem.writeFile(&allowed, b"allowed")
  run FileSystem.writeFile(&denied, b"private")
  let shell = run Run.program("sh")
  let confined = run shell.confined()
  let selected = run argument(move confined, "-c")
  let script = run argument(move selected, "cat \"$1\" > \"$4\" || exit 20; if cat \"$2\"; then exit 21; fi; if echo bad > \"$3\"; then exit 22; fi; exit 0")
  let named = run argument(move script, "sandbox-test")
  let input = run named.inputFile(run Deferred<Path>.source("allowed"))
  let readDenied = run argument(move input, Path.view(&denied).unwrapOr(""))
  let writeDenied = run argument(move readDenied, Path.view(&forbidden).unwrapOr(""))
  let output = run writeDenied.outputFile("result")
  let step = run output.register()
  let runner = run Runner.make(move root, run Path.join(&run Path.fromBytes(cwd.asSlice()), "steps"), b"sandbox-test-v1")
  let paths = run runner.execute(&[move step], true)
  let result = run FileSystem.readFile(&run Path.join(&paths.asSlice()[0], "result"))
  if result.length() != 7 { return 1 }
  if run FileSystem.exists(&forbidden) { return 2 }
  return 0
}

pub effect fn main() -> i32 ! Failure ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut files = run MachineFileSystem.make() |> Effect.provideMut<Allocator>(&mut allocator)
  return run check() |> Effect.provideMut<FileSystem>(&mut files) |> Effect.provideMut<Allocator>(&mut allocator)
}
