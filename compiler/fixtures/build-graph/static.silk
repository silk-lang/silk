import silk.build.run { Run }
import silk.build.write_files { WriteFiles }
import silk.build.step { suppliedPath, Runner, Step, StepFailure, StepError }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator }
import silk.system.filesystem { FileSystem, Path }
import silk.system.filesystem_machine { MachineFileSystem }
import silk.system.host_input { HostInput }
import silk.concurrency.thread_native { SpawnError }
import silk.concurrency.fiber { Cancelled }
import silk.text.string { String }

type Failure = StepFailure | SpawnError | Cancelled

static fn copying() -> Run {
  let files = WriteFiles.empty() |> WriteFiles.literal("input", "static producer")
  return Run.executable(suppliedPath("/bin/cp"))
    |> Run.input(WriteFiles.result(&files, "input"))
    |> Run.output("copied")
}
const COPY: Run = copying()

effect fn program() -> i32 ! Failure ? &mut Allocator | &mut FileSystem | &mut HostInput {
  let cwd = run HostInput.workingDirectory()
  let root = run Path.fromBytes(cwd.asSlice())
  let runner = run Runner.make(run Path.fromBytes(Path.rawBytes(&root)), run Path.join(&root, "steps"), b"static-descriptor")
  let step = run Step.register(COPY)
  let paths = run runner.execute(&[move step], true)
  let output = run Path.join(&paths.asSlice()[0], "copied")
  let bytes = run FileSystem.readFile(&output)
  if bytes.asSlice() != b"static producer" { fail StepError {message: run String.copy("the static producer did not feed its consumer")} }
  return 0
}

pub effect fn main() -> i32 ! Failure ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut files = run MachineFileSystem.make() |> Effect.provideMut<Allocator>(&mut allocator)
  return run program() |> Effect.provideMut<FileSystem>(&mut files) |> Effect.provideMut<Allocator>(&mut allocator)
}
