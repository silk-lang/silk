import silk.wasi_http_server {Exchange}
import silk.wasi_http {Field}
import silk.http_client {HttpError}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.effect {Effect}
import silk.monotonic_clock {MonotonicClock}
import silk.os_monotonic_clock {OsMonotonicClock}
import silk.option {Option}
import silk.string {String}
import silk.system_clock {Instant}

effect fn answer(exchange: Exchange) -> () ! HttpError | OutOfMemoryError ? &mut Allocator | &mut MonotonicClock {
 let mut request = move exchange
 let metadata = run Exchange.metadata(&request)
 if String.view(&metadata.method) != "POST" { Intrinsic.trap("Expected POST") }
 let body = run Exchange.readBody(&mut request, 1000000, Option<Instant>.none())
 let fields: [Field; 0] = []
 run Exchange.respond(move request, 201, &fields, Bytes.asSlice(&body), Option<Instant>.none())
}
effect fn failed(error: HttpError | OutOfMemoryError) -> () { drop error }
export "C" fn handle(request: u32, response: u32) -> () as "wasi:http/incoming-handler@0.2.12#handle" {
 let exchange = unsafe Exchange.take(request, response)
 let mut allocator = Allocator.systemAllocatorProvider()
 let mut clock = OsMonotonicClock.make()
 run Effect.catchAll(answer(move exchange), failed) |> Effect.provideMut<MonotonicClock>(&mut clock)
   |> Effect.provideMut<Allocator>(&mut allocator)
}
