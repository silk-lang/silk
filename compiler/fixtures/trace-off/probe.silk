import silk.core.ownership { Drop }

pub ambient service Probe default Off {
  effect fn enter<T>(static name: string<'static>, args: &T) -> () ? &Probe
  effect fn exit() -> () ? &Probe
}

struct Off {}

impl Probe for Off {
  @inlineAlways
  effect fn enter<T>(self: &Self, static name: string<'static>, args: &T) -> () {}

  @inlineAlways
  effect fn exit(self: &Self) -> () {}
}

pub struct Guard {}

impl Drop for Guard {
  @inlineAlways
  fn drop(self: &mut Self) -> () { run Probe.exit() }
}

@inlineAlways
pub fn span<T>(static name: string<'static>, args: &T) -> Guard {
  run Probe.enter(name, args)
  return Guard {}
}
