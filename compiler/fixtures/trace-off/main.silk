import silk.core.effect { Effect }
import silk.probe { span }

fn plain(value: i32) -> i32 {
  let _guard = span("plain", &.{ value: &value })
  return value + 1
}

fn generic<T>(value: T) -> T {
  let _guard = span("generic", &.{ value: &value })
  return move value
}

effect fn suspended(value: i32) -> i32 {
  let _guard = span("suspended", &.{ value: &value })
  let next = run Effect.suspend(effect { return plain(value) })
  return generic(next)
}

pub fn main() -> i32 {
  let result = run suspended(41)
  return result - 42
}
