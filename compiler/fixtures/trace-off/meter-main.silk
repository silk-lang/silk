import silk.concurrency.sync { Arc }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.trace { Trace, Tracer }
import silk.trace { Metric }
import silk.trace.record { Config, Recorder, Span }

effect fn runWork(value: i32) -> i32 {
  let _span = Trace.span("work")
  Metric.count("visits", 1)
  Metric.adjustWith("active", -1, &.{ id: value })
  Metric.gauge("load", 3.25)
  Metric.recordWith("latency", 10.0, &.{ id: value })
  return value
}

effect fn exercise() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let recorder = run Arc<Recorder>.make(run Recorder.make(Config.make("identity")))
  let result = run runWork(0) |> Effect.provideAmbient<Tracer>(&recorder)
  if let Option<Span>.Some {value} = recorder.get().takeSpan() {
    if value.name != "work" { return 2 }
  } else { return 3 }
  if recorder.get().signals.metricCapacity() != 0 { return 5 }
  if recorder.get().signals.metricAt(0, recorder.get().now()).isSome() { return 4 }
  return result
}
effect fn failed(error: OutOfMemoryError) -> i32 { return 1 }
pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(exercise() |> Effect.provideMut<Allocator>(&mut allocator), failed)
}
