import silk.core.effect { Effect }
import silk.trace { SpanKind, Trace } // observation

fn plain(value: i32) -> i32 {
  let _guard = Trace.span("plain") // observation
  Trace.set("value", &value) // observation
  Trace.event("entered") // observation
  return value + 1
}

fn generic<T>(value: T) -> T {
  let _guard = Trace.spanOf("generic", SpanKind.Internal) // observation
  Trace.eventWith("input", &.{ value: &value }) // observation
  return move value
}

effect fn suspended(value: i32) -> i32 {
  let _guard = Trace.span("suspended") // observation
  let next = run Effect.suspend(effect { return plain(value) })
  return generic(next)
}

pub fn main() -> i32 {
  let result = run suspended(41)
  return result - 42
}
