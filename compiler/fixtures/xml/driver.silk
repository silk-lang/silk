import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.io.standard_input { StandardInput, StreamReadError }
import silk.io.standard_input_native { OsStandardInput }
import silk.xml.document { XmlDocument, XmlError, XmlNodeId, XmlNodeKind }
import silk.core.option { Option }
import silk.text.string { String }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter }
import silk.num.usize

effect fn check() -> i32
  ! XmlError | OutOfMemoryError | StreamReadError | WriterError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut input = OsStandardInput.make()
  let mut bytes = Bytes.make()
  let mut buffer: [u8; 4096] = [0; 4096]
  while true {
    let read = run StandardInput.receive(&mut buffer)
      |> Effect.provideMut<StandardInput>(&mut input)
    if StandardInput.isEndOfInput(&read) {
      break
    }
    run Bytes.append(&mut bytes, Slice.view<u8>(&buffer, 0, StandardInput.count(&read)))
      |> Effect.provideMut<Allocator>(&mut allocator)
  }
  let doc = run XmlDocument.parse(Bytes.asSlice(&bytes))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut out = StdoutWriter.make()
  run declarations(&doc) |> Effect.provideMut<Writer>(&mut out)
  let nodes = XmlDocument.nodes(&doc)
  let mut i: usize = 0
  while i < nodes.length {
    if nodes[i].parent.isNone() {
      run canonical(&doc, XmlNodeId { index: i }) |> Effect.provideMut<Writer>(&mut out)
    }
    i = i + 1
  }
  return 0
}

// The XML test suite's pre-C14N canonical form, used only as an independent output oracle.
effect fn escaped(text: string) -> ()
  ! WriterError
  ? &mut Writer {
  let bytes = String.utf8Bytes(text)
  let mut i: usize = 0
  let mut begin: usize = 0
  while i < bytes.length {
    let escape = match bytes[i] {
      9 => "&#9;"
      10 => "&#10;"
      13 => "&#13;"
      34 => "&quot;"
      38 => "&amp;"
      60 => "&lt;"
      62 => "&gt;"
      _ => ""
    }
    if escape != "" {
      run Writer.writeAll(Slice.view<u8>(bytes, begin, i - begin))
      run Writer.writeString(escape)
      begin = i + 1
    }
    i = i + 1
  }
  run Writer.writeAll(Slice.view<u8>(bytes, begin, bytes.length - begin))
}

fn before(a: string, b: string) -> bool {
  let aa = String.utf8Bytes(a)
  let bb = String.utf8Bytes(b)
  let mut i: usize = 0
  while i < aa.length && i < bb.length {
    if aa[i] != bb[i] {
      return aa[i] < bb[i]
    }
    i = i + 1
  }
  return aa.length < bb.length
}

effect fn canonical(doc: &XmlDocument, id: XmlNodeId) -> ()
  ! WriterError
  ? &mut Writer {
  let kind = XmlDocument.kind(doc, id)
  if kind == XmlNodeKind.Text {
    return run escaped(XmlDocument.text(doc, id))
  }
  if kind == XmlNodeKind.Comment {
    return ()
  }
  if kind == XmlNodeKind.ProcessingInstruction {
    run Writer.writeString("<?")
    run Writer.writeString(XmlDocument.qualifiedName(doc, id))
    run Writer.writeString(" ")
    run Writer.writeString(XmlDocument.text(doc, id))
    return run Writer.writeString("?>")
  }
  run Writer.writeString("<")
  run Writer.writeString(XmlDocument.qualifiedName(doc, id))
  let attrs = XmlDocument.attributes(doc, id)
  let mut written: usize = 0
  let mut previous = attrs.length
  while written < attrs.length {
    let mut selected = attrs.length
    let mut i: usize = 0
    while i < attrs.length {
      let key = XmlDocument.attributeQualifiedName(doc, attrs[i])
      if (previous == attrs.length
        || before(XmlDocument.attributeQualifiedName(doc, attrs[previous]), key))
        && (selected == attrs.length
          || before(key, XmlDocument.attributeQualifiedName(doc, attrs[selected]))) {
        selected = i
      }
      i = i + 1
    }
    previous = selected
    run Writer.writeString(" ")
    run Writer.writeString(XmlDocument.attributeQualifiedName(doc, attrs[selected]))
    run Writer.writeString("=\"")
    run escaped(XmlDocument.attributeValue(doc, attrs[selected]))
    run Writer.writeString("\"")
    written = written + 1
  }
  run Writer.writeString(">")
  let mut child = XmlDocument.firstChild(doc, id)
  while let Option<XmlNodeId>.Some { value } = child {
    run canonical(doc, value)
    child = XmlDocument.nextSibling(doc, value)
  }
  run Writer.writeString("</")
  run Writer.writeString(XmlDocument.qualifiedName(doc, id))
  run Writer.writeString(">")
}

effect fn declarations(doc: &XmlDocument) -> ()
  ! WriterError
  ? &mut Writer {
  let entries = XmlDocument.notations(doc)
  if entries.length == 0 {
    return ()
  }
  run Writer.writeString("<!DOCTYPE ")
  run Writer.writeString(XmlDocument.qualifiedName(doc, XmlDocument.root(doc)))
  run Writer.writeString(" [\n")
  let mut written: usize = 0
  let mut previous = entries.length
  while written < entries.length {
    let mut selected = entries.length
    let mut i: usize = 0
    while i < entries.length {
      let key = String.view(&entries[i].name)
      if (previous == entries.length || before(String.view(&entries[previous].name), key))
        && (selected == entries.length || before(key, String.view(&entries[selected].name))) {
        selected = i
      }
      i = i + 1
    }
    previous = selected
    let item = &entries[selected]
    run Writer.writeString("<!NOTATION ")
    run Writer.writeString(String.view(&item.name))
    match &item.externalId.publicId {
      Option<String>.Some { value } => {
        run Writer.writeString(" PUBLIC '")
        run Writer.writeString(String.view(&value))
        run Writer.writeString("'")
      }
      _ => {
        run Writer.writeString(" SYSTEM")
      }
    }
    match &item.externalId.systemId {
      Option<String>.Some { value } => {
        run Writer.writeString(" '")
        run Writer.writeString(String.view(&value))
        run Writer.writeString("'")
      }
      _ => {}
    }
    run Writer.writeString(">\n")
    written = written + 1
  }
  run Writer.writeString("]>\n")
}

effect fn failed(error: XmlError | OutOfMemoryError | StreamReadError | WriterError) -> i32 {
  return match move error {
    XmlError _problem => 2
    _ => 3
  }
}

pub effect fn main() -> i32 {
  return run Effect.catchAll(check(), failed)
}
