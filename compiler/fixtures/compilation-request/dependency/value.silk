import silk.num.i32

pub param answer: i32 = 1

pub struct Value {}

impl Value {
  pub fn answer() -> i32 {
    return i32.wrappingNegate(i32.wrappingNegate(answer))
  }
}

/// A generic defined by the dependency and instantiated by its caller.
pub fn identity<T>(value: T) -> T { return move value }
