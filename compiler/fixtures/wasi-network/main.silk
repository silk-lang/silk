import silk.net.datagram_wasi {UdpSocket, Datagram}
import silk.net.resolver_wasi {WasiResolver}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.net.resolver {Resolver, ResolverError, ResolveRequest, ResolvedEndpoints, FamilySelection}
import silk.net.address {Host, AddressError}
import silk.core.result {Result}
import silk.net.socket_wasi {Network, SocketAddress, Listener, Connection, SocketError}
import silk.io.byte_duplex {ByteDuplex, ByteIoError, ReadTransfer}
import silk.system.monotonic_clock {MonotonicClock}
import silk.system.monotonic_clock_native {OsMonotonicClock}
import silk.core.effect {Effect}
import silk.option {Option}
import silk.system.system_clock {Instant, SystemClock}
import silk.net.address {Endpoint, IpAddress, Ipv4Address, Port}

pub effect fn main() -> i32 ! SocketError | ByteIoError | ResolverError | OutOfMemoryError {
  let mut clock = OsMonotonicClock.make()
  let mut allocator = Allocator.systemAllocatorProvider()
  return run program() |> Effect.provideMut<MonotonicClock>(&mut clock) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn program() -> i32 ! SocketError | ByteIoError | ResolverError | OutOfMemoryError ? &mut MonotonicClock | &mut Allocator {
  let network = Network.make()
  let local = SocketAddress.make(Endpoint.make(IpAddress.V4 {value: Ipv4Address.fromOctets([127,0,0,1])}, Port.fromU16(0)))

  let expired = run Effect.result(Network.listen(&network, &local, Option<Instant>.some(SystemClock.make(0, 0))))
  match move expired {
    Result<Listener, SocketError>.Success {value} => { drop value return 6 }
    Result<Listener, SocketError>.Failure {error} => { if error.code != 5 { return 7 } }
  }
  let mut listener = run Network.listen(&network, &local, Option<Instant>.none())
  let bound = run Listener.address(&listener)
  let mut client = run Network.connect(&network, &bound, Option<Instant>.none())
  let mut server = run Listener.accept(&mut listener, Option<Instant>.none())
  let count = run ByteDuplex.writeSome(b"hello", Option<Instant>.none()) |> Effect.provideMut<ByteDuplex>(&mut client)
  run ByteDuplex.flush(Option<Instant>.none()) |> Effect.provideMut<ByteDuplex>(&mut client)
  let mut output: [u8; 5] = [0; 5]
  let read = run ByteDuplex.readSome(&mut output, Option<Instant>.none()) |> Effect.provideMut<ByteDuplex>(&mut server)
  if count != 5 || output[0] != 104 || output[4] != 111 { return 1 }
  run ByteDuplex.shutdownWrite(Option<Instant>.none()) |> Effect.provideMut<ByteDuplex>(&mut client)
  run ByteDuplex.close() |> Effect.provideMut<ByteDuplex>(&mut client)
  run ByteDuplex.close() |> Effect.provideMut<ByteDuplex>(&mut server)
  let mut udp = run UdpSocket.bind(&network, &local, Option<&SocketAddress>.none(), Option<Instant>.none())
  let destination = run UdpSocket.address(&udp)
  run UdpSocket.send(&mut udp, b"packet", Option<&SocketAddress>.some(&destination), Option<Instant>.none())
  let packet = run UdpSocket.receive(&mut udp, Option<Instant>.none())
  if Bytes.length(&packet.data) != 6 { return 2 }
  run UdpSocket.send(&mut udp, b"", Option<&SocketAddress>.some(&destination), Option<Instant>.none())
  let empty = run UdpSocket.receive(&mut udp, Option<Instant>.none())
  if Bytes.length(&empty.data) != 0 { return 3 }
  UdpSocket.close(&mut udp)
  let host = match move Host.parse("localhost") {
    Result<Host, AddressError>.Success {value} => move value
    Result<Host, AddressError>.Failure {error: _} => { return 4 }
  }
  let request = match move ResolveRequest.make(move host, Port.fromU16(80), FamilySelection.V4, 1, Option<Instant>.none()) {
    Result<ResolveRequest, ResolverError>.Success {value} => move value
    Result<ResolveRequest, ResolverError>.Failure {error} => { fail move error }
  }
  let mut resolver = WasiResolver.make()
  let addresses = run Resolver.resolve(&request) |> Effect.provideMut<Resolver>(&mut resolver)
  if ResolvedEndpoints.length(&addresses) == 0 { return 5 }
  return 0
}
