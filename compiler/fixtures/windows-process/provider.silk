import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.collections.bytes { Bytes }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.host_input { HostInput, HostInputError }
import silk.system.filesystem { Path, FileError }
import silk.system.child_process { ChildProcess, ProcessRequest, ProcessError }
import silk.system.child_process_native { OsChildProcess }
import silk.platform.windows.path { WindowsPath }
import silk.num.u8

effect fn request(path: &Path, status: string) -> ProcessRequest ! OutOfMemoryError ? &mut Allocator {
  let mut value = run ChildProcess.request(path)
  run ChildProcess.addArgument(&mut value, "a b")
  run ChildProcess.addArgument(&mut value, "")
  run ChildProcess.addArgumentBytes(&mut value, b"\xed\xa0\x80")
  run ChildProcess.addArgument(&mut value, "\\\"\\")
  run ChildProcess.setVariable(&mut value, "SILK_TEST_STATUS", status)
  run ChildProcess.setVariableBytes(&mut value, b"SILK_\xc3\x89", b"\xed\xa0\x80")
  return move value
}
effect fn invalid(request: &ProcessRequest) -> bool ! ProcessError | OutOfMemoryError ? &mut Allocator | &mut ChildProcess {
  let result = run ChildProcess.submit(request)
  return false
}
effect fn refused(error: ProcessError) -> bool {
  return error.operation.code == 0 && error.reason.code == 2
}
effect fn check() -> i32 ! FileError | HostInputError | OutOfMemoryError | ProcessError ? &mut Allocator | &mut HostInput | &mut ChildProcess {
  let native = match move run HostInput.argument(1) {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => { return 1 }
  }
  let path = run WindowsPath.fromNativeBytes(Bytes.asSlice(&native))
  let normal = run request(&path, "normal")
  let result = run ChildProcess.submit(&normal)
  if Option<i32>.unwrapOr(ChildProcess.exitCode(&result), -1) != 0 { return 2 }
  let output = ChildProcess.outputBytes(&result)
  let errors = ChildProcess.errorBytes(&result)
  if output.length != 65536 || errors.length != 65536 { return 3 }
  let mut at: usize = 0
  while at < output.length {
    // The C child writes 16 independently repeated 4096-byte blocks.
    if u8.toUsize(output[at]) != (at % 4096) % 251 || u8.toUsize(errors[at]) != 255 - (at % 4096) % 251 { return 4 }
    at = at + 1
  }
  let active = run request(&path, "259")
  let completed = run ChildProcess.submit(&active)
  if Option<i32>.unwrapOr(ChildProcess.exitCode(&completed), -1) != 259 { return 5 }
  let high = run request(&path, "high")
  let preserved = run ChildProcess.submit(&high)
  if Option<i32>.unwrapOr(ChildProcess.exitCode(&preserved), 0) != -1073741819 || ChildProcess.isSignaled(&preserved) { return 6 }
  let batch = run Path.make("/C:/silk-do-not-execute.cmd")
  let bad = run ChildProcess.request(&batch)
  if !(run Intrinsic.catchFailure<ProcessError>(invalid(&bad), refused)) { return 7 }
  let mut duplicate = run request(&path, "normal")
  run ChildProcess.setVariable(&mut duplicate, "silk_test_status", "high")
  if !(run Intrinsic.catchFailure<ProcessError>(invalid(&duplicate), refused)) { return 8 }
  return 0
}
pub effect fn main() -> i32 ! FileError | HostInputError | OutOfMemoryError | ProcessError ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut processes = OsChildProcess.make()
  return run check() |> Effect.provideMut<ChildProcess>(&mut processes) |> Effect.provideMut<Allocator>(&mut allocator)
}
