// The C fixture supplies names and retained handles independently of the Silk implementation.
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.system.filesystem { FileSystem, FileError, AtomicWriteError, Path, DirectoryEntry, FileInfo, DirectoryInfo }
import silk.system.filesystem_native { OsFileSystem }
import silk.system.filesystem_machine { MachineFileSystem }
import silk.platform.windows.path { WindowsPath }
import silk.platform.windows.filesystem { WindowsFileSystem }
import silk.text.string { String }
import silk.num.u32

@foreign(noCapture: ("bytes",))
unsafe extern "C" fn FsFixtureSetup(bytes: ?[*]mut u8, capacity: u32) -> u32
unsafe extern "C" fn FsFixtureLinks() -> u32
unsafe extern "C" fn FsFixtureHoldOld() -> ?*mut u8
unsafe extern "C" fn FsFixtureBlockDelete() -> ?*mut u8
unsafe extern "C" fn FsFixtureReadOnly(enabled: u32) -> ()
unsafe extern "C" fn FsFixtureOldByte(handle: ?*mut u8) -> u32
unsafe extern "C" fn FsFixtureClose(handle: ?*mut u8) -> ()
unsafe extern "C" fn FsFixtureOutsideByte() -> u32

fn same(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length { return false }
  let mut at: usize = 0
  while at < a.length { if a[at] != b[at] { return false }
    at = at + 1 }
  return true
}
fn refused(result: Result<(), FileError>, operation: i32, reason: i32) -> bool {
  return match move result {
    Result<(), FileError>.Success { value } => false
    Result<(), FileError>.Failure { error } => error.operation.code == operation && error.reason.code == reason
  }
}
fn unpublished(result: Result<(), AtomicWriteError>, reason: i32) -> bool {
  return match move result {
    Result<(), AtomicWriteError>.Success { value } => false
    Result<(), AtomicWriteError>.Failure { error } => !error.published && error.cause.reason.code == reason && Option<FileError>.isNone(&error.cleanupError) && Bytes.length(&error.stagingName) == 0
  }
}
effect fn scenario() -> i32 ! FileError | AtomicWriteError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let root = run Path.root()
  let old = run Path.join(&root, "old")
  let surrogate = run Path.fromBytes(&[47, 237, 160, 128, 120])
  let contents = run FileSystem.readFile(&surrogate)
  if !same(Bytes.asSlice(&contents), b"U") { return 10 }
  let entries = run FileSystem.listDirectory(&root)
  let listed = List<DirectoryEntry>.asSlice(&entries)
  if listed.length != 5 { return 11 }
  if !same(Path.rawBytes(&listed[0].path), String.utf8Bytes("/dangling")) || listed[0].kind.code != 2 { return 12 }
  if !same(Path.rawBytes(&listed[1].path), String.utf8Bytes("/escape")) || listed[1].kind.code != 2 { return 13 }
  if !same(Path.rawBytes(&listed[2].path), String.utf8Bytes("/junction")) || listed[2].kind.code != 2 { return 14 }
  if !same(Path.rawBytes(&listed[3].path), String.utf8Bytes("/old")) || listed[3].kind.code != 0 { return 15 }
  if !same(Path.rawBytes(&listed[4].path), Path.rawBytes(&surrogate)) { return 16 }
  let stat = run FileSystem.stat(&old)
  let size = match move stat { FileInfo info => info.byteLength == 1
    DirectoryInfo directory => false }
  if !size { return 17 }
  let escaped = run Path.make("/escape/sentinel")
  if !refused(run Effect.result(FileSystem.writeFile(&escaped, b"BAD")), 1, 8) { return 18 }
  let junction = run Path.make("/junction/sentinel")
  if !refused(run Effect.result(FileSystem.writeFile(&junction, b"BAD")), 1, 8) { return 19 }
  if unsafe FsFixtureOutsideByte() != 88 { return 20 }
  let malformed = run Path.fromBytes(&[47, 237, 160, 128, 237, 176, 128])
  if !refused(run Effect.result(FileSystem.writeFile(&malformed, b"BAD")), 1, 3) { return 21 }
  let stream = run Path.make("/old:stream")
  if !refused(run Effect.result(FileSystem.writeFile(&stream, b"BAD")), 1, 3) { return 22 }
  let escapedSeparator = run Path.make("/escape\\sentinel")
  if !refused(run Effect.result(FileSystem.writeFile(&escapedSeparator, b"BAD")), 1, 3) { return 23 }
  let held = unsafe FsFixtureHoldOld()
  run FileSystem.writeFileAtomic(&old, b"B", FileSystem.replaceExisting(), FileSystem.buffered())
  let oldByte = unsafe FsFixtureOldByte(held)
  unsafe FsFixtureClose(held)
  if oldByte != 65 { return 24 }
  let current = run FileSystem.readFile(&old)
  if !same(Bytes.asSlice(&current), b"B") { return 25 }
  let beforeFailedPublication = run FileSystem.listDirectory(&root)
  unsafe FsFixtureReadOnly(1)
  let readOnlyRejected = unpublished(run Effect.result(FileSystem.writeFileAtomic(&old, b"readonly", FileSystem.replaceExisting(), FileSystem.buffered())), 2)
  unsafe FsFixtureReadOnly(0)
  if !readOnlyRejected { return 36 }
  let afterFailedPublication = run FileSystem.listDirectory(&root)
  if List<DirectoryEntry>.length(&beforeFailedPublication) != List<DirectoryEntry>.length(&afterFailedPublication) { return 37 }
  let blocking = unsafe FsFixtureBlockDelete()
  let removed = run Effect.result(FileSystem.removeFile(&old))
  unsafe FsFixtureClose(blocking)
  let sharing = match move removed {
    Result<(), FileError>.Success { value } => false
    Result<(), FileError>.Failure { error } => match move FileSystem.providerCode(&error) {
      Option<i32>.Some { value } => value == -1073741757 && error.reason.code == 9
      Option<i32>.None => false
    }
  }
  if !sharing { return 38 }
  if !unpublished(run Effect.result(FileSystem.writeFileAtomic(&old, b"C", FileSystem.createNew(), FileSystem.buffered())), 1) { return 26 }
  if !unpublished(run Effect.result(FileSystem.writeFileAtomic(&old, b"D", FileSystem.replaceExisting(), FileSystem.synchronized())), 8) { return 27 }
  if !refused(run Effect.result(FileSystem.syncDirectory(&root)), 12, 8) { return 28 }
  let preserved = run FileSystem.readFile(&old)
  if !same(Bytes.asSlice(&preserved), b"B") { return 29 }
  let fresh = run Path.make("/fresh")
  run FileSystem.writeFileAtomic(&fresh, b"complete", FileSystem.createNew(), FileSystem.buffered())
  run FileSystem.writeFile(&fresh, b"x")
  let truncated = run FileSystem.readFile(&fresh)
  if !same(Bytes.asSlice(&truncated), b"x") { return 30 }
  if !refused(run Effect.result(FileSystem.createFile(&fresh, b"wrong")), 9, 1) { return 31 }
  let dangling = run Path.make("/dangling")
  if !unpublished(run Effect.result(FileSystem.writeFileAtomic(&dangling, b"wrong", FileSystem.createNew(), FileSystem.buffered())), 1) { return 32 }
  run FileSystem.writeFileAtomic(&dangling, b"link replaced", FileSystem.replaceExisting(), FileSystem.buffered())
  let directory = run Path.make("/dir")
  run FileSystem.createDirectory(&directory)
  if !unpublished(run Effect.result(FileSystem.writeFileAtomic(&directory, b"wrong", FileSystem.replaceExisting(), FileSystem.buffered())), 4) { return 33 }
  let child = run Path.join(&directory, "child")
  run FileSystem.createFile(&child, b"child")
  if !refused(run Effect.result(FileSystem.removeDirectory(&directory)), 6, 5) { return 34 }
  run FileSystem.removeFile(&child)
  run FileSystem.removeDirectory(&directory)
  let temporary = run FileSystem.temporaryDirectory(&root, "temporary-")
  run FileSystem.release(move temporary)
  let escapeLink = run Path.make("/escape")
  let junctionLink = run Path.make("/junction")
  run FileSystem.removeFile(&escapeLink)
  run FileSystem.removeFile(&junctionLink)
  if unsafe FsFixtureOutsideByte() != 88 { return 35 }
  return 0
}
// The native fixture creates the file; machine routing must reach that same object and return
// machine paths from enumeration and temporary-directory allocation, not confined local paths.
effect fn machineScenario(root: &Path) -> i32 ! FileError | AtomicWriteError | OutOfMemoryError
? &mut FileSystem | &mut Allocator {
  let old = run Path.join(root, "old")
  let bytes = run FileSystem.readFile(&old)
  if !same(Bytes.asSlice(&bytes), b"B") { return 40 }
  let entries = run FileSystem.listDirectory(root)
  let listed = List<DirectoryEntry>.asSlice(&entries)
  let mut found = false
  let mut at: usize = 0
  while at < listed.length {
    if same(Path.rawBytes(&listed[at].path), Path.rawBytes(&old)) { found = true }
    at = at + 1
  }
  if !found { return 41 }
  let first = run FileSystem.temporaryDirectory(root, "machine-")
  let second = run FileSystem.temporaryDirectory(root, "machine-")
  if same(Path.rawBytes(&first.path), Path.rawBytes(&second.path)) { return 42 }
  let child = run Path.join(&first.path, "child")
  run FileSystem.createFile(&child, b"machine")
  run FileSystem.writeFileAtomic(&child, b"complete", FileSystem.replaceExisting(), FileSystem.buffered())
  let written = run FileSystem.readFile(&child)
  if !same(Bytes.asSlice(&written), b"complete") { return 43 }
  run FileSystem.release(move first)
  run FileSystem.release(move second)
  let noVolume = run Path.root()
  if !refused(run Effect.result(FileSystem.writeFile(&noVolume, b"bad")), 1, 3) { return 44 }
  if !unpublished(run Effect.result(FileSystem.writeFileAtomic(&noVolume, b"bad", FileSystem.replaceExisting(), FileSystem.buffered())), 3) { return 45 }
  let network = run Path.make("/UNC/server/share/file")
  if !refused(run Effect.result(FileSystem.removeFile(&network)), 5, 8) { return 46 }
  return 0
}

effect fn check() -> i32 ! FileError | AtomicWriteError | OutOfMemoryError ? &mut Allocator {
  if !WindowsFileSystem.validRootBytes(String.utf8Bytes("C:\\")) { return 1 }
  if !WindowsFileSystem.validRootBytes(&[67, 58, 92, 237, 160, 128]) { return 2 }
  if WindowsFileSystem.validRootBytes(String.utf8Bytes("C:relative")) || WindowsFileSystem.validRootBytes(String.utf8Bytes("/C:/root")) || WindowsFileSystem.validRootBytes(String.utf8Bytes("\\\\?\\C:\\root")) || WindowsFileSystem.validRootBytes(String.utf8Bytes("C:\\a\\..\\b")) { return 3 }
  if WindowsFileSystem.validRootBytes(&[67, 58, 92, 237, 160, 128, 237, 176, 128]) { return 4 }
  let mut bytes: [u8; 32768] = [0; 32768]
  let length = unsafe FsFixtureSetup(Pointer.fromMutSlice(&mut bytes), 32768)
  let links = unsafe FsFixtureLinks()
  if links == 1314 { return 77 }
  if links != 0 { return 5 }
  let mut files = run OsFileSystem.makeBytes(Slice.view(&bytes, 0, u32.toUsize(length)))
  let confined = run scenario() |> Effect.provideMut<FileSystem>(&mut files)
  if confined != 0 { return confined }
  let machineRoot = run WindowsPath.fromNativeBytes(Slice.view(&bytes, 0, u32.toUsize(length)))
  let mut machine = run MachineFileSystem.make()
  return run machineScenario(&machineRoot) |> Effect.provideMut<FileSystem>(&mut machine)
}
pub effect fn main() -> i32 ! FileError | AtomicWriteError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run check() |> Effect.provideMut<Allocator>(&mut allocator)
}
