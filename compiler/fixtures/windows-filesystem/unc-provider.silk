// Actual UNC operations against the localhost NTFS administrative share. Setup is independent C.
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.core.result {Result}
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.collections.slice {Slice}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.mem.pointer {Pointer}
import silk.system.filesystem {FileSystem, FileError, AtomicWriteError, Path, FileInfo, DirectoryInfo, DirectoryEntry}
import silk.system.filesystem_native {OsFileSystem}
import silk.system.filesystem_machine {MachineFileSystem}
import silk.platform.windows.path {WindowsPath}
import silk.num.u32

@foreign(noCapture: ("bytes",))
unsafe extern "C" fn FsFixtureSetup(bytes: ?[*]mut u8, capacity: u32) -> u32
@foreign(noCapture: ("bytes",))
unsafe extern "C" fn FsFixtureUncRoot(bytes: ?[*]mut u8, capacity: u32) -> u32

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at: usize = 0
  while at < left.length { if left[at] != right[at] { return false }
    at = at + 1 }
  return true
}

effect fn scenario(root: &Path, leaf: string, directory: string) -> i32
! FileError | AtomicWriteError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let old = run Path.join(root, "old")
  let initial = run FileSystem.readFile(&old)
  if !same(Bytes.asSlice(&initial), b"A") { return 1 }
  let created = run Path.join(root, leaf)
  run FileSystem.createFile(&created, b"new")
  match move run Effect.result(FileSystem.createFile(&created, b"wrong")) {
    Result<(), FileError>.Success {..} => { return 2 }
    Result<(), FileError>.Failure {error} => { if error.reason.code != FileSystem.alreadyExists().code { return 3 } }
  }
  run FileSystem.writeFile(&created, b"changed")
  let value = run FileSystem.readFile(&created)
  if !same(Bytes.asSlice(&value), b"changed") { return 4 }
  let info = run FileSystem.stat(&created)
  if !match move info { FileInfo file => file.byteLength == 7
    DirectoryInfo folder => false } { return 5 }
  let folder = run Path.join(root, directory)
  run FileSystem.createDirectory(&folder)
  let listed = run FileSystem.listDirectory(root)
  let entries = List<DirectoryEntry>.asSlice(&listed)
  let mut found = false
  let mut at: usize = 0
  while at < entries.length {
    if same(Path.rawBytes(&entries[at].path), Path.rawBytes(&created)) { found = true }
    at = at + 1
  }
  if !found { return 6 }
  match move run Effect.result(FileSystem.writeFileAtomic(&old, b"wrong", FileSystem.replaceExisting(), FileSystem.buffered())) {
    Result<(), AtomicWriteError>.Success {..} => { return 7 }
    Result<(), AtomicWriteError>.Failure {error} => {
      if error.published || error.cause.reason.code != FileSystem.unsupported().code
          || !Option<FileError>.isNone(&error.cleanupError) || Bytes.length(&error.stagingName) != 0 { return 8 }
    }
  }
  let after = run FileSystem.listDirectory(root)
  if List<DirectoryEntry>.length(&after) != entries.length { return 9 }
  let retained = run FileSystem.readFile(&old)
  if !same(Bytes.asSlice(&retained), b"A") { return 10 }
  match move run Effect.result(FileSystem.removeFile(&created)) {
    Result<(), FileError>.Success {..} => { return 11 }
    Result<(), FileError>.Failure {error} => { if error.reason.code != FileSystem.unsupported().code { return 12 } }
  }
  let stillThere = run FileSystem.readFile(&created)
  if !same(Bytes.asSlice(&stillThere), b"changed") { return 13 }
  return 0
}

effect fn check() -> i32 ! FileError | AtomicWriteError | OutOfMemoryError ? &mut Allocator {
  let mut bytes: [u8; 32768] = [0; 32768]
  let setup = unsafe FsFixtureSetup(Pointer.fromMutSlice(&mut bytes), 32768)
  let length = unsafe FsFixtureUncRoot(Pointer.fromMutSlice(&mut bytes), 32768)
  let native = Slice.view(&bytes, 0, u32.toUsize(length))
  let mut confined = run OsFileSystem.makeBytes(native)
  let root = run Path.root()
  let first = run scenario(&root, "confined", "confined-directory") |> Effect.provideMut<FileSystem>(&mut confined)
  if first != 0 { return first }
  let machineRoot = run WindowsPath.fromNativeBytes(native)
  let mut machine = run MachineFileSystem.make()
  return run scenario(&machineRoot, "machine", "machine-directory") |> Effect.provideMut<FileSystem>(&mut machine)
}

pub effect fn main() -> i32 ! FileError | AtomicWriteError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run check() |> Effect.provideMut<Allocator>(&mut allocator)
}
