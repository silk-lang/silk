import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
struct Holder { n: i32, m: i32 }
fn make() -> Holder { return Holder {n: 1, m: 2} }
effect fn transferred() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let listOwner = make()
  let mut v = List<&Holder>.make()
  let mut w = List<&Holder>.make()
  run List<&Holder>.append(&mut v, &listOwner)
  run List<&Holder>.append(&mut w, List<&Holder>.asSlice(&v)[0])
  drop v
  drop listOwner
  return List<&Holder>.asSlice(&w)[0].n
}
effect fn sourceDropped() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let h = make()
  let mut v = List<&Holder>.make()
  let mut w = List<&Holder>.make()
  run List<&Holder>.append(&mut v, &h)
  run List<&Holder>.append(&mut w, List<&Holder>.asSlice(&v)[0])
  drop v
  return List<&Holder>.asSlice(&w)[0].n
}
effect fn before() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let h = make()
  let mut v = List<&Holder>.make()
  let mut w = List<&Holder>.make()
  run List<&Holder>.append(&mut v, &h)
  run List<&Holder>.append(&mut w, List<&Holder>.asSlice(&v)[0])
  drop v
  let n = List<&Holder>.asSlice(&w)[0].n
  drop w
  drop h
  return n
}
pub fn main() -> i32 { return 0 }
