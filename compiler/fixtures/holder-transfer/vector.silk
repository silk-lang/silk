import silk.allocator { Allocator, OutOfMemoryError }
import silk.vector { Vector }
struct Holder { n: i32  m: i32 }
fn make() -> Holder { return Holder {n: 1, m: 2} }
effect fn transferred() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut v = Vector<&Holder>.make()
  let mut w = Vector<&Holder>.make()
  let vectorOwner = make()
  run Vector<&Holder>.append(&mut v, &vectorOwner)
  run Vector<&Holder>.append(&mut w, Vector<&Holder>.asSlice(&v)[0])
  drop v
  drop vectorOwner
  return Vector<&Holder>.asSlice(&w)[0].n
}
effect fn sourceDropped() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let h = make()
  let mut v = Vector<&Holder>.make()
  let mut w = Vector<&Holder>.make()
  run Vector<&Holder>.append(&mut v, &h)
  run Vector<&Holder>.append(&mut w, Vector<&Holder>.asSlice(&v)[0])
  drop v
  return Vector<&Holder>.asSlice(&w)[0].n
}
effect fn before() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let h = make()
  let mut v = Vector<&Holder>.make()
  let mut w = Vector<&Holder>.make()
  run Vector<&Holder>.append(&mut v, &h)
  run Vector<&Holder>.append(&mut w, Vector<&Holder>.asSlice(&v)[0])
  drop v
  let n = Vector<&Holder>.asSlice(&w)[0].n
  drop w
  drop h
  return n
}
pub fn main() -> i32 { return 0 }
