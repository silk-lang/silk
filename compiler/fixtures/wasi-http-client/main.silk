import silk.http.client_wasi {WasiHttp}
import silk.http.client {Http, Request, Response, HttpError, HttpErrorKind}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.effect {Effect}
import silk.format {Format, Debug}
import silk.io.writer_native {StderrWriter}
import silk.io.writer {Writer, WriterError}
import silk.system.host_input {HostInput, HostInputError}
import silk.option {Option}
import silk.core.result {Result}
import silk.text.string {String, InvalidUtf8}

effect fn url(base: string, path: string) -> String ! OutOfMemoryError ? &mut Allocator {
 let mut output = run String.copy(base)
 run String.append(&mut output, path)
 return move output
}
effect fn fails(request: Request, kind: HttpErrorKind) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Http {
 return match move run Effect.result(Http.send(move request)) {
  Result<Response, HttpError | OutOfMemoryError>.Success {value} => { drop value return false }
  Result<Response, HttpError | OutOfMemoryError>.Failure {error} => match move error {
   HttpError value => value.kind == kind
   OutOfMemoryError exhausted => { fail move exhausted }
  }
 }
}
effect fn check(base: string) -> i32 ! HttpError | OutOfMemoryError ? &mut Allocator | &mut Http {
 let redirect = run url(base, "/redirect")
 let response = run Http.send(Request.get(String.view(&redirect)))
 if Response.status(&response) != 200 || Response.body(&response).length != 5 || Response.body(&response)[0] != 104 { return 1 }
 let echo = run url(base, "/echo")
 let payload = run Bytes.zeroed(200000)
 let echoed = run Http.send(Request.post(String.view(&echo)).bytes(Bytes.asSlice(&payload), "application/octet-stream"))
 if Response.body(&echoed).length != 200000 { return 2 }
 let reject = run url(base, "/reject")
 let rejected = run Http.send(Request.post(String.view(&reject)).bytes(Bytes.asSlice(&payload), "application/octet-stream"))
 if Response.status(&rejected) != 413 { return 11 }
 let rewrite = run url(base, "/rewrite")
 let rewritten = run Http.send(Request.post(String.view(&rewrite)).text("payload"))
 if Response.body(&rewritten).length != 5 { return 3 }
 let cross = run url(base, "/cross")
 let crossed = run Http.send(Request.get(String.view(&cross)).header("Authorization", "old").bearer("secret"))
 if Response.status(&crossed) != 200 { return 4 }
 let hello = run url(base, "/hello")
 if !run fails(Request.get(String.view(&hello)).maxBodyBytes(4), HttpErrorKind.TooLarge) { return 5 }
 if !run fails(Request.get(String.view(&hello)).timeoutSeconds(0), HttpErrorKind.Timeout) { return 6 }
 let loopUrl = run url(base, "/loop")
 if !run fails(Request.get(String.view(&loopUrl)).maxRedirects(2), HttpErrorKind.Redirect) { return 7 }
 // A small host resource limit makes leaked futures, streams, fields, or bodies fail this loop.
 let mut at: usize = 0
 while at < 50 {
  let repeated = run Http.send(Request.get(String.view(&hello)))
  if Response.body(&repeated).length != 5 { return 8 }
  at = at + 1
 }
 return 0
}
effect fn program() -> i32 ! HttpError | OutOfMemoryError | HostInputError ? &mut Allocator | &mut Http | &mut HostInput {
 let raw = match move run HostInput.variableNamed("SILK_TEST_HTTP_URL") {
  Option<Bytes>.Some {value} => move value
  Option<Bytes>.None => { return 9 }
 }
 let base = match move String.fromBytes(move raw) {
  Result<String, InvalidUtf8>.Success {value} => move value
  Result<String, InvalidUtf8>.Failure {error: _} => { return 10 }
 }
 return run check(String.view(&base))
}
effect fn report<T: Debug>(value: &T) -> () {
 let mut writer = StderrWriter.make()
 let printed = run Effect.result(Format.debug(value) |> Effect.provideMut<Writer>(&mut writer))
 drop printed
}
pub effect fn main() -> i32 ? &mut HostInput {
 let mut allocator = Allocator.systemAllocatorProvider()
 let mut http = WasiHttp.make()
 let outcome = run Effect.result(program() |> Effect.provideMut<Http>(&mut http) |> Effect.provideMut<Allocator>(&mut allocator))
 return match move outcome {
  Result<i32, HttpError | OutOfMemoryError | HostInputError>.Success {value} => {
   if value != 0 { run report(&value) }
   return value
  }
  Result<i32, HttpError | OutOfMemoryError | HostInputError>.Failure {error} => {
   match move error {
    HttpError value => { run report(&value) }
    OutOfMemoryError value => { run report(&value) }
    HostInputError value => { run report(&value) }
   }
   return 1
  }
 }
}
