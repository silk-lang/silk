import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.concurrency.fiber { Fiber, Cancelled }
import silk.concurrency.local_scheduler { LocalScheduler, StalledError }
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.monotonic_clock_native { OsMonotonicClock }
import silk.concurrency.scheduler { Scheduler, TaskIdExhaustedError }
import silk.concurrency.sync { Arc, Mutex }
import silk.counter { Counter }

struct Sink { state: Mutex<i32> }
impl Counter for Sink {
  effect fn add(self: &Self, value: i32) -> () {
    let mut guard = self.state.lock()
    let total = guard.getMut()
    total.* = total.* + value
  }
}
fn note(value: i32) -> () { run Counter.add(value) }

effect fn child(value: i32) -> i32 ? &mut Scheduler | &mut MonotonicClock {
  note(value)
  run Fiber.yieldNow()
  note(value)
  return value
}
effect fn siblings(a: Arc<Sink>, b: Arc<Sink>) -> i32
! OutOfMemoryError | TaskIdExhaustedError | Cancelled ? &mut Scheduler | &mut MonotonicClock {
  let one = run Effect.provideAmbient<Counter>(Fiber<i32, never>.forkChild(child(1)), &a)
  let two = run Effect.provideAmbient<Counter>(Fiber<i32, never>.forkChild(child(10)), &b)
  note(100)
  let left = run Fiber<i32, never>.join(move one)
  let right = run Fiber<i32, never>.join(move two)
  return left + right
}
effect fn test() -> i32 ! OutOfMemoryError | TaskIdExhaustedError | Cancelled | StalledError ? &mut MonotonicClock | &mut Allocator {
  let a = run Arc<Sink>.make(Sink {state: run Mutex<i32>.make(0)})
  let b = run Arc<Sink>.make(Sink {state: run Mutex<i32>.make(0)})
  let mut scheduler = LocalScheduler.make()
  let result = run LocalScheduler.execute(&mut scheduler, siblings(a.clone(), b.clone()))
  if result != 11 || a.get().state.lock().get().* != 2 || b.get().state.lock().get().* != 20 { return 1 }
  if a.count() != 1 || b.count() != 1 { return 2 }
  return 0
}
effect fn failed(error: OutOfMemoryError | TaskIdExhaustedError | Cancelled | StalledError) -> i32 { return 3 }
pub fn main() -> i32 {
  let mut clock = OsMonotonicClock.make()
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(test() |> Effect.provideMut<MonotonicClock>(&mut clock) |> Effect.provideMut<Allocator>(&mut allocator), failed)
}
