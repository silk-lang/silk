import silk.counter { hasAmbientCount, hasCounterCount }
import silk.observation { Observation }
effect fn observe<T>(static template: string<'static>, args: &T) -> () {
  return run Observation.record(false, template, args)
}
fn constantValue() -> i32 {
  let value: i32 = 17
  run Observation.record(false, "static observation", &value)
  run observe("forwarded", &.{ value: value + 1 })
  return 17
}
const VALUE: i32 = constantValue()
fn execute<'env, F: once Effect<'env; ()>>(task: F) -> () { run move task }

pub fn main() -> i32 {
  if !hasAmbientCount(0) || !hasCounterCount(0) { return 7 }
  let value: i32 = 17
  execute(Observation.record(true, "runtime observation", &value))
  return value - VALUE
}
