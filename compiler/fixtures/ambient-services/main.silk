import silk.observation { Observation }
fn constantValue() -> i32 {
  let value: i32 = 17
  run Observation.record(false, "static observation", &value)
  return 17
}
const VALUE: i32 = constantValue()
fn execute<'env, F: once Effect<'env; ()>>(task: F) -> () { run move task }

pub fn main() -> i32 {
  let value: i32 = 17
  execute(Observation.record(true, "runtime observation", &value))
  return value - VALUE
}
