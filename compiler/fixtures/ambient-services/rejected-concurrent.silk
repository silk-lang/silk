import silk.concurrency.thread { Transferable }
import silk.concurrency.sync { Arc }
import silk.core.effect { Effect }
import silk.counter { Counter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }

struct Raw { ptr: *mut i32 }
impl Transferable for Raw {}
impl Counter for Raw {
  effect fn add(self: &Self, value: i32) -> () {}
}
effect fn work() -> () { run Counter.add(1) }
effect fn exercise() -> () ! OutOfMemoryError ? &mut Allocator {
  let mut value: i32 = 0
  let provider = run Arc<Raw>.make(Raw { ptr: Pointer.fromMutRef(&mut value) })
  run work() |> Effect.provideAmbient<Counter>(&provider)
}
effect fn failed(error: OutOfMemoryError) -> () {}
pub fn main() -> () {
  let mut allocator = Allocator.systemAllocatorProvider()
  run Effect.catchAll(exercise() |> Effect.provideMut<Allocator>(&mut allocator), failed)
}
