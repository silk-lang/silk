pub ambient service Flag default SET {
  effect fn expect(expected: bool) -> () ? &Flag
}
pub struct State { pub set: bool }
const SET: State = State { set: true }
impl Flag for State {
  effect fn expect(self: &Self, expected: bool) -> () {
    if self.set != expected { Intrinsic.trap("wrong stateful ambient provider") }
  }
}
