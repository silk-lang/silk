import silk.counter { Counter }
import silk.concurrency.sync { Arc, Mutex }
import silk.concurrency.fiber { Cancelled }
import silk.concurrency.thread_native { SpawnError }
import silk.concurrency.thread_pool { Pool, ThreadPool }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }

struct Sink { state: Mutex<i32> }
impl Counter for Sink {
  effect fn add(self: &Self, value: i32) -> () {
    let mut guard = self.state.lock()
    let total = guard.getMut()
    total.* = total.* + value
  }
}
fn note(value: i32) -> () { run Counter.add(value) }

effect fn child() -> i32 {
  note(40)
  run Pool.yieldNow()
  note(2)
  return 42
}
effect fn parent(pool: Pool, sink: Arc<Sink>) -> i32 ! OutOfMemoryError | Cancelled {
  let fiber = run Effect.provideAmbient<Counter>(pool.fork(child()), &sink)
  note(100)
  return run fiber.join()
}
effect fn exercise() -> i32 ! OutOfMemoryError | SpawnError | Cancelled ? &mut Allocator {
  let sink = run Arc<Sink>.make(Sink {state: run Mutex<i32>.make(0)})
  let threads = run ThreadPool.make(2)
  let pool = threads.pool()
  let done = run pool.block(parent(pool.clone(), sink.clone()))
  drop pool
  drop threads
  if done != 42 || sink.get().state.lock().get().* != 42 || sink.count() != 1 { return 1 }
  return 0
}
effect fn failed(error: OutOfMemoryError | SpawnError | Cancelled) -> i32 { return 2 }
pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(exercise() |> Effect.provideMut<Allocator>(&mut allocator), failed)
}
