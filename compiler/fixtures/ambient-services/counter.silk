pub ambient service Counter default QuietCounter {
  effect fn add(value: i32) -> () ? &Counter
}
struct QuietCounter {}
impl Counter for QuietCounter {
  effect fn add(self: &Self, value: i32) -> () {}
}

pub fn hasAmbientCount(static expected: usize) -> bool {
  static if Intrinsic.ambientCount() == expected { return true } else { return false }
}

pub fn hasCounterCount(static expected: usize) -> bool {
  static if Intrinsic.ambientCount<Counter>() == expected { return true } else { return false }
}
