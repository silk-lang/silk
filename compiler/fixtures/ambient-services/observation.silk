pub ambient service Observation default CONFIGURED {
  effect fn record<T>(static live: bool, static template: string<'static>, value: &T) -> () ? &Observation
}

struct Configured { enabled: bool }
const CONFIGURED: Configured = Configured { enabled: true }

impl Observation for Configured {
  effect fn record<T>(self: &Self, static live: bool, static template: string<'static>, value: &T) -> () {
    static if live {
      if !self.enabled { Intrinsic.trap("wrong ambient default") }
    } else {
      Intrinsic.trap("static evaluation ran the ambient provider")
    }
  }
}
