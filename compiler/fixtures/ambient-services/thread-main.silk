import silk.counter { Counter }
import silk.concurrency.sync { Arc, Mutex }
import silk.concurrency.thread_native { NativeThread, SpawnError }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }

struct Sink { state: Mutex<i32> }
impl Counter for Sink {
  effect fn add(self: &Self, value: i32) -> () {
    let mut guard = self.state.lock()
    let total = guard.getMut()
    total.* = total.* + value
  }
}
fn note(value: i32) -> () { run Counter.add(value) }

effect fn spawnAndJoin() -> i32 ! OutOfMemoryError | SpawnError ? &mut Allocator {
  let thread = run NativeThread.spawn(|| -> i32 { note(41) return 1 })
  return thread.join()
}
effect fn exercise() -> i32 ! OutOfMemoryError | SpawnError ? &mut Allocator {
  let logs = run Arc<Sink>.make(Sink {state: run Mutex<i32>.make(0)})
  let one = run Effect.provideAmbient<Counter>(spawnAndJoin(), &logs)
  note(100)
  if logs.count() != 1 { return 1 }
  return logs.get().state.lock().get().* + one - 42
}
effect fn failed(error: OutOfMemoryError | SpawnError) -> i32 { return 11 }
pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(exercise() |> Effect.provideMut<Allocator>(&mut allocator), failed)
}
