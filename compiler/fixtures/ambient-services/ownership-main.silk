import silk.concurrency.sync { ownCaptured }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }

effect fn refused(error: OutOfMemoryError) -> i32 { return 10 }
pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(ownCaptured() |> Effect.provideMut<Allocator>(&mut allocator), refused)
}
