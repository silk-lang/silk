import silk.concurrency.sync { Arc }
import silk.core.effect { Effect }
import silk.counter { Counter }
import silk.mem.allocator { Allocator, OutOfMemoryError }

struct Parking {}
impl Counter for Parking {
  effect fn add(self: &Self, value: i32) -> () { run Intrinsic.relinquish() }
}

effect fn work() -> () { run Counter.add(1) }
effect fn exercise() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let provider = run Arc<Parking>.make(Parking {})
  run work() |> Effect.provideAmbient<Counter>(&provider)
  return 0
}
effect fn failed(error: OutOfMemoryError) -> i32 { return 1 }
pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(exercise() |> Effect.provideMut<Allocator>(&mut allocator), failed)
}
