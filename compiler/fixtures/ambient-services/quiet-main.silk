import silk.concurrency.sync { Arc }
import silk.core.effect { Effect }
import silk.counter { Counter }
import silk.mem.allocator { Allocator, OutOfMemoryError }

struct Quiet {}
impl Counter for Quiet {
  effect fn add(self: &Self, value: i32) -> () {}
}
effect fn observe() -> () { run Counter.add(1) }
effect fn exercise() -> () ! OutOfMemoryError ? &mut Allocator {
  let provider = run Arc<Quiet>.make(Quiet {})
  run observe() |> Effect.provideAmbient<Counter>(&provider)
}
effect fn failed(error: OutOfMemoryError) -> () {}
pub fn main() -> () {
  let mut allocator = Allocator.systemAllocatorProvider()
  run Effect.catchAll(exercise() |> Effect.provideMut<Allocator>(&mut allocator), failed)
}
