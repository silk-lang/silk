import silk.core.effect { Effect }
import silk.concurrency.sync { Arc, Mutex }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.observation { Observation }
effect fn noop() -> () {}
struct Collector { count: Arc<Mutex<i32>> }
impl Observation for Collector {
  effect fn record<T>(self: &Self, static live: bool, static template: string<'static>, value: &T) -> () {
    run Effect.suspend(noop())
  }
}
fn leaf() -> () { let n: i32 = 9 run Observation.record(true, "sample", &n) }
effect fn work() -> i32 { leaf() return 42 }
effect fn exercise() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let count = run Arc<Mutex<i32>>.make(run Mutex<i32>.make(0))
  let owner = run Arc<Collector>.make(Collector { count: count.clone() })
  let result = run work() |> Effect.provideAmbient<Observation>(&owner)
  leaf()
  if count.get().lock().get().* != 1 || owner.count() != 1 { return 1 }
  return result - 42
}
effect fn oom(error: OutOfMemoryError) -> i32 { return 2 }
pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(exercise() |> Effect.provideMut<Allocator>(&mut allocator), oom)
}
