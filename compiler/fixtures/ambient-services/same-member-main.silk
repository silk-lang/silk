import silk.counter { hasAmbientCount }
import silk.configured { Flag, State }
import silk.concurrency.sync { Arc }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }

effect fn probe(expected: bool) -> () { run Flag.expect(expected) }
effect fn test() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let off = run Arc<State>.make(State {set: false})
  run probe(true)
  run probe(false) |> Effect.provideAmbient<Flag>(&off)
  run probe(true)
  return 0
}
effect fn failed(error: OutOfMemoryError) -> i32 { return 1 }
pub fn main() -> i32 {
  if !hasAmbientCount(1) { return 7 }
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(test() |> Effect.provideMut<Allocator>(&mut allocator), failed)
}
