import silk.observation { Observation }

effect fn observe<T>(static template: string<'static>, value: &T) -> () {
  return run Observation.record(false, template, value)
}
fn divided(value: i32) -> i32 { return 42 / value }
fn leaf() -> i32 {
  run observe("discarded operation", &.{ value: divided(0) })
  return 42
}
const VALUE: i32 = leaf()
pub fn main() -> i32 { return VALUE }
