import silk.concurrency.ambient_table { AmbientTable, TraceContext }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }

pub ambient service Marker default Off {
  effect fn open(expected: u64, child: u64) -> () ? &Marker
}
struct Off {}
impl Marker for Off { effect fn open(self: &Self, expected: u64, child: u64) -> () {} }

pub struct TestRecorder {}
impl Marker for TestRecorder {
  effect fn open(self: &Self, expected: u64, child: u64) -> () {
    let slot = Intrinsic.ambientSlot<AmbientTable>()
    let mut token = ()
    let address = unsafe Pointer.castMut<?*const AmbientTable, ?*mut AmbientTable>(slot)
    if let Option<*mut AmbientTable>.Some {value} = Pointer.nonNullMut(unsafe Pointer.read(address)) {
      let table = unsafe Pointer.borrowMut(&mut token, value)
      if table.context.span != expected { Intrinsic.trap("wrong parent") }
      table.context = TraceContext {traceHigh: 101, traceLow: 202, span: child, flags: 3, owner: 4, record: child}
    } else { Intrinsic.trap("missing context") }
  }
}

pub fn matches(span: u64, record: u64) -> bool {
  let p = unsafe Pointer.read(Intrinsic.ambientSlot<AmbientTable>())
  if let Option<*const AmbientTable>.Some {value} = Pointer.nonNull(p) {
    let table = unsafe Pointer.borrow(&p, value)
    return table.context.traceHigh == 101 && table.context.traceLow == 202 && table.context.span == span
      && table.context.flags == 3 && table.context.owner == 4 && table.context.record == record
  }
  return false
}
