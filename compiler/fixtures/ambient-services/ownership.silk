// Appended to the test copy of silk.concurrency.sync so this exercises the private handle.
pub ambient service TestRecords default QuietRecord {
  effect fn record() -> () ? &TestRecords
}
struct QuietRecord {}
impl TestRecords for QuietRecord { effect fn record(self: &Self) -> () {} }

struct CountedRecord { drops: Arc<Mutex<i32>> }
impl TestRecords for CountedRecord { effect fn record(self: &Self) -> () {} }
impl Drop for CountedRecord {
  fn drop(self: &mut Self) -> () {
    let mut guard = self.drops.get().lock()
    let count = guard.getMut()
    count.* = count.* + 1
  }
}

pub effect fn ownCaptured() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let drops = run Arc<Mutex<i32>>.make(run Mutex<i32>.make(0))
  let handle = run Arc<CountedRecord>.make(CountedRecord {drops: drops.clone()})
  let a = AmbientHandle.capture<TestRecords, CountedRecord>(&handle)
  if handle.count() != 2 { return 1 }
  let b = a.clone()
  if handle.count() != 3 { return 2 }
  drop a
  if handle.count() != 2 { return 3 }
  drop b
  if handle.count() != 1 { return 4 }
  let last = AmbientHandle.capture<TestRecords, CountedRecord>(&handle)
  drop handle
  if drops.get().lock().get().* != 0 { return 5 }
  drop last
  if drops.get().lock().get().* != 1 { return 6 }
  return 0
}
