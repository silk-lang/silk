import silk.concurrency.sync { Arc, Mutex }
import silk.configured { Flag, State }
import silk.core.effect { Effect }
import silk.counter { Counter, hasAmbientCount }
import silk.mem.allocator { Allocator, OutOfMemoryError }

struct Counting { total: Arc<Mutex<i32>> }
impl Counter for Counting {
  effect fn add(self: &Self, value: i32) -> () {
    run Flag.expect(false)
    run Counter.add(1000)
    let mut guard = self.total.get().lock()
    let total = guard.getMut()
    total.* = total.* + value
  }
}
effect fn both() -> () {
  run Flag.expect(false)
  run Counter.add(3)
}
effect fn inner(handle: &Arc<Counting>) -> () {
  run both() |> Effect.provideAmbient<Counter>(handle)
  run Flag.expect(false)
  run Counter.add(100)
}
effect fn exercise() -> i32 ! OutOfMemoryError ? &mut Allocator {
  if !hasAmbientCount(2) { return 7 }
  let state = run Arc<State>.make(State {set: false})
  let total = run Arc<Mutex<i32>>.make(run Mutex<i32>.make(0))
  let counter = run Arc<Counting>.make(Counting {total: total.clone()})
  run inner(&counter) |> Effect.provideAmbient<Flag>(&state)
  run Flag.expect(true)
  if total.get().lock().get().* != 3 { return 1 }
  return 0
}
effect fn failed(error: OutOfMemoryError) -> i32 { return 2 }
pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(exercise() |> Effect.provideMut<Allocator>(&mut allocator), failed)
}
