import silk.mem.pointer { Pointer }

pub ambient service Samples default Quiet {
  effect fn sample() -> () ? &Samples
}

struct Quiet {}
struct Collector { enabled: bool }

impl Samples for Quiet { effect fn sample(self: &Self) -> () {} }
impl Samples for Collector { effect fn sample(self: &Self) -> () {} }

fn loadTable() -> ?*const Collector {
  return unsafe Pointer.read(Intrinsic.ambientSlot<Collector>())
}

fn swapTable(next: ?*const Collector) -> ?*const Collector {
  let slot = Intrinsic.ambientSlot<Collector>()
  let previous = unsafe Pointer.read(slot)
  unsafe Pointer.write(slot, next)
  return previous
}

pub fn checkEntries() -> i32 {
  let first = Collector { enabled: true }
  let second = Collector { enabled: false }
  let quiet = Quiet {}
  let firstTags = Intrinsic.ambientEntry<Samples>(&first)
  let quietTags = Intrinsic.ambientEntry<Samples>(&quiet)
  let secondTags = Intrinsic.ambientEntry<Samples>(&second)
  if firstTags[0] != quietTags[0] || firstTags[1] == quietTags[1] { return 1 }
  if firstTags[1] != secondTags[1] { return 2 }
  let initial = swapTable(Pointer.fromRef(&first))
  if !Pointer.isNull(initial) { return 3 }
  let outer = swapTable(Pointer.fromRef(&second))
  if Pointer.address(loadTable()) != Pointer.address(Pointer.fromRef(&second)) { return 4 }
  let inner = swapTable(outer)
  if Pointer.address(inner) != Pointer.address(Pointer.fromRef(&second)) { return 5 }
  let restored = swapTable(initial)
  if Pointer.address(restored) != Pointer.address(Pointer.fromRef(&first)) { return 6 }
  if !Pointer.isNull(loadTable()) { return 7 }
  return 0
}
