import silk.counter { Counter }
import silk.concurrency.sync {Arc, Mutex}
import silk.core.effect {Effect}
import silk.concurrency.execution {Execution, Wake}
import silk.core.ownership {Drop}
import silk.mem.allocator {Allocator, OutOfMemoryError}

struct Sink { state: Mutex<i32> }
impl Counter for Sink {
  effect fn add(self: &Self, value: i32) -> () {
    let mut guard = self.state.lock()
    let total = guard.getMut()
    total.* = total.* + value
  }
}

struct Refused {}
fn leaf(value: i32) -> () { run Counter.add(value) }
effect fn refused() -> () ! Refused { leaf(3) fail Refused {} }
effect fn recovered(error: Refused) -> () { leaf(5) }
effect fn outer(inner: &Arc<Sink>) -> () {
  leaf(1)
  run Effect.catchAll(refused() |> Effect.provideAmbient<Counter>(inner), recovered)
  leaf(7)
}
fn ready(state: &()) -> () {}
fn completed(result: &mut i32, value: i32) -> () { result.* = value leaf(100) }
fn suspended(result: &mut i32, work: Intrinsic.Execution<i32>) -> () { drop work }
effect fn child() -> i32 { leaf(17) return 42 }
effect fn createChild() -> Intrinsic.Execution<i32> ! OutOfMemoryError ? &mut Allocator {
  return run Execution.make(child(), (), ready)
}
struct Finalizer {}
impl Drop for Finalizer { fn drop(self: &mut Self) -> () { leaf(19) } }
fn register(wake: Wake) -> Finalizer { drop wake return Finalizer {} }
effect fn parkedBody() -> i32 { run Execution.park(register) return 99 }
effect fn rawPark() -> i32 { let _guard = Finalizer {} run Intrinsic.relinquish() return 99 }
effect fn createRawPark() -> Intrinsic.Execution<i32> ! OutOfMemoryError ? &mut Allocator {
  return run Execution.make(rawPark(), (), ready)
}
effect fn createParked() -> Intrinsic.Execution<i32> ! OutOfMemoryError ? &mut Allocator {
  return run Execution.make(parkedBody(), (), ready)
}
fn cancel(result: &mut i32, work: Intrinsic.Execution<i32>) -> () {
  leaf(23)
  drop work
  leaf(29)
}
effect fn driveParked(work: Intrinsic.Execution<i32>) -> () {
  let mut result: i32 = 0
  run Execution.drive(move work, &mut result, completed, cancel)
}
effect fn exercise() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let first = run Arc<Sink>.make(Sink {state: run Mutex<i32>.make(0)})
  let second = run Arc<Sink>.make(Sink {state: run Mutex<i32>.make(0)})
  leaf(100)
  run outer(&second) |> Effect.provideAmbient<Counter>(&first)
  leaf(100)
  if first.count() != 1 || second.count() != 1 { return 1 }
  if first.get().state.lock().get().* != 13 || second.get().state.lock().get().* != 3 { return 4 }
  let childWork = run Effect.provideAmbient<Counter>(createChild(), &second)
  if second.count() != 2 { return 5 }
  let mut result: i32 = 0
  run Execution.drive(move childWork, &mut result, completed, suspended)
  if result != 42 || second.get().state.lock().get().* != 20 || second.count() != 1 { return 6 }
  let unstarted = run Effect.provideAmbient<Counter>(createChild(), &second)
  drop unstarted
  if second.count() != 1 { return 7 }
  let parking = run Effect.provideAmbient<Counter>(createParked(), &second)
  run Effect.provideAmbient<Counter>(driveParked(move parking), &first)
  if first.get().state.lock().get().* != 65 { return 8 }
  if second.get().state.lock().get().* != 39 || second.count() != 1 { return 9 }
  let raw = run Effect.provideAmbient<Counter>(createRawPark(), &second)
  run Effect.provideAmbient<Counter>(driveParked(move raw), &first)
  if first.get().state.lock().get().* != 117 || second.get().state.lock().get().* != 58 { return 10 }
  return 0
}
effect fn oom(error: OutOfMemoryError) -> i32 { return 9 }
pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(exercise() |> Effect.provideMut<Allocator>(&mut allocator), oom)
}
