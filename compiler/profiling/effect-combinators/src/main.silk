import silk.core.effect { Effect }
import silk.core.result { Result }

service Counter {
  effect fn next(self: &mut Self) -> u64
}

struct Counting {
  value: u64
}

effect fn next(self: &mut Counting) -> u64 {
  self.value = self.value + 1
  return self.value
}

impl Counter for Counting {
  next: Counting.next
}

struct Payload {
  words: [u64; 32]
}

struct Problem {
  value: u64
}

// The explicit boundary makes every wrapper around this call suspendable. Preventing ordinary
// LLVM inlining alone would not exercise coroutine frames.
@inlineNever
effect fn step() -> Payload
  ! Problem
  ? &mut Counter {
  let value = run Intrinsic.suspendEffect(
    effect {
      return run Counter.next()
    },
  )
  if value % 8 == 0 {
    fail Problem { value: value }
  }
  return Payload { words: [value; 32] }
}

fn identity(value: Payload) -> Payload {
  return move value
}

pub fn main() -> i32 {
  let mut counter = Counting { value: 0 }
  let mut checksum: u64 = 0
  let mut iteration: u64 = 0
  while iteration < 1000000 {
    let outcome = run Effect.result(
      Effect.map(step(), identity) |> Effect.provideMut<Counter>(&mut counter),
    )
    match move outcome {
      Result.Success { value } => {
        let mut word: usize = 0
        while word < 32 {
          checksum = checksum + value.words[word]
          word = word + 1
        }
      }
      Result.Failure { error } => {
        checksum = checksum + error.value
      }
    }
    iteration = iteration + 1
  }

  // Sum(1..1M) * 32, replacing each eighth payload's 32 words with its failure's one word.
  if counter.value != 1000000 || checksum != 14062500500000 {
    return 1
  }
  return 0
}
