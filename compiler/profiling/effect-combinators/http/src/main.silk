import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.http.client { Http, HttpError, Request, Response }
import silk.http.client_native { NativeHttp }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8

effect fn benchmark() -> i32
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut requests = List<Request>.make()
  let mut next: usize = 0
  while next < 4096 {
    run List<Request>.append(&mut requests, Request.get("http://127.0.0.1:18080/payload"))
    next = next + 1
  }
  let mut http = NativeHttp.make().withConcurrency(16)
  let responses = run Http.sendAll(move requests) |> Effect.provideMut<Http>(&mut http)
  let values = List<Result<Response, HttpError>>.asSlice(&responses)
  if values.length != 4096 {
    return 1
  }
  let mut checksum: usize = 0
  next = 0
  while next < values.length {
    match &values[next] {
      Result.Success { value } => {
        if value.status() != 200 || value.body().length != 32 {
          return 2
        }
        let body = value.body()
        let mut byte: usize = 0
        while byte < body.length {
          checksum = checksum + u8.toUsize(body[byte])
          byte = byte + 1
        }
      }
      Result.Failure { .. } => {
        return 3
      }
    }
    next = next + 1
  }

  // The server returns thirty-two ASCII 'x' bytes per response.
  if checksum != 4096 * 32 * 120 {
    return 4
  }
  return 0
}

pub effect fn main() -> i32
  ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run benchmark() |> Effect.provideMut<Allocator>(&mut allocator)
}
