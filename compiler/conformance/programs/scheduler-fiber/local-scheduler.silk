import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.fiber { Fiber, Cancelled }
import silk.local_scheduler { LocalScheduler, StalledError }
import silk.monotonic_clock { MonotonicClock }
import silk.scheduler { Scheduler, TaskIdExhaustedError }
import silk.system_clock { SystemClock }
import silk.system_clock { Instant }

struct ParentClock { mark: Instant }

effect fn parentNow(self: &mut ParentClock) -> Instant {
  return SystemClock.make(
    SystemClock.seconds(&self.mark),
    SystemClock.nanoseconds(&self.mark),
  )
}
effect fn parentResolution(self: &mut ParentClock) -> u64 { return 1 }
effect fn parentWaitUntil(self: &mut ParentClock, deadline: Instant) -> () {
  self.mark = move deadline
  return ()
}
effect fn parentWaitFor(self: &mut ParentClock, duration: u64) -> () {
  let deadline = MonotonicClock.deadlineAfter(&self.mark, duration)
  return run parentWaitUntil(move self, move deadline)
}
impl MonotonicClock for ParentClock {
  now: ParentClock.parentNow
  getResolution: ParentClock.parentResolution
  waitUntil: ParentClock.parentWaitUntil
  waitFor: ParentClock.parentWaitFor
}

struct RootProblem { code: i32 }

fn rootStarted() -> () { return () }
fn childStarted() -> () { return () }
fn forkReturned() -> () { return () }
fn rootResumed() -> () { return () }

effect fn child() -> i32 ? &mut Scheduler | &mut MonotonicClock {
  childStarted()
  return 42
}

effect fn success() -> i32
! OutOfMemoryError | TaskIdExhaustedError | Cancelled
? &mut Scheduler | &mut MonotonicClock {
  rootStarted()
  let handle = run Fiber.forkChild(child())
  forkReturned()
  let value = run Fiber.join(move handle)
  rootResumed()
  return value
}

effect fn failure() -> bool
! RootProblem
? &mut Scheduler | &mut MonotonicClock {
  fail RootProblem { code: 7 }
}

effect fn runSuccess(scheduler: &mut LocalScheduler) -> i32
! OutOfMemoryError | TaskIdExhaustedError | Cancelled | StalledError
? &mut MonotonicClock {
  return run LocalScheduler.execute(move scheduler, success())
}

effect fn runFailure(scheduler: &mut LocalScheduler) -> bool
! RootProblem | OutOfMemoryError | StalledError
? &mut MonotonicClock {
  return run LocalScheduler.execute(move scheduler, failure())
}

effect fn recoverFailure(
  error: RootProblem | OutOfMemoryError | StalledError,
) -> bool {
  return match move error {
    RootProblem { code } => code == 7
    OutOfMemoryError {} => false
    StalledError {} => false
  }
}

effect fn scenario() -> i32
! OutOfMemoryError | TaskIdExhaustedError | Cancelled | StalledError
? &mut MonotonicClock {
  let mut scheduler = LocalScheduler.make()
  let value = run runSuccess(&mut scheduler)
  let failed = run Effect.catchAll(runFailure(&mut scheduler), recoverFailure)
  if value == 42 && failed { return 42 }
  return -1
}

effect fn recoverScenario(
  error: OutOfMemoryError | TaskIdExhaustedError | Cancelled | StalledError,
) -> i32 {
  drop error
  return -2
}

pub fn main() -> i32 {
  let mut clock = ParentClock { mark: SystemClock.make(0, 0) }
  let program = Effect.catchAll(scenario(), recoverScenario)
    |> Effect.provideMut<MonotonicClock>(&mut clock)
  return run move program
}
