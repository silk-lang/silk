import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.monotonic_clock { MonotonicClock }
import silk.scheduler { Scheduler as RuntimePolicy, PendingPublication, TaskIdExhaustedError }

struct RenamedDispatcher { calls: i32 }

fn renamedPrepareCalled() -> () { return () }

effect fn prepare<A, E>(
  self: &mut RenamedDispatcher,
  child: once Effect<
    A
    ! E
    ? &mut RuntimePolicy | &mut MonotonicClock
  >,
) -> PendingPublication<A, E>
! OutOfMemoryError | TaskIdExhaustedError {
  drop child
  self.calls = self.calls + 1
  renamedPrepareCalled()
  fail TaskIdExhaustedError {}
}

impl RuntimePolicy for RenamedDispatcher {
  prepare: RenamedDispatcher.prepare
}

effect fn child() -> i32
? &mut RuntimePolicy | &mut MonotonicClock {
  return 1
}

effect fn request() -> i32
! OutOfMemoryError | TaskIdExhaustedError
? &mut RuntimePolicy {
  let pending = run RuntimePolicy.prepare<i32, never>(child())
  drop pending
  return 0
}

effect fn refused(
  error: OutOfMemoryError | TaskIdExhaustedError,
) -> i32 {
  drop error
  return 42
}

pub fn main() -> i32 {
  let provider = RenamedDispatcher { calls: 0 }
  let bound = Effect.bindRequirementOwned<RuntimePolicy>(request(), move provider)
  return run Effect.catchAll(move bound, refused)
}
