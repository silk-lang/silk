import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.system.monotonic_clock { MonotonicClock }
import silk.concurrency.scheduler { Scheduler as RuntimePolicy, PendingCancellation, PendingPublication, TaskId, TaskIdExhaustedError }
import silk.system.system_clock { Instant }

struct RenamedDispatcher { calls: i32 }

fn renamedPrepareCalled() -> () { return () }

effect fn prepare<A, E>(
  self: &mut RenamedDispatcher,
  child: once Effect<
    A
    ! E
    ? &mut RuntimePolicy | &mut MonotonicClock
  >,
) -> PendingPublication<A, E>
! OutOfMemoryError | TaskIdExhaustedError {
  drop child
  self.calls = self.calls + 1
  renamedPrepareCalled()
  fail TaskIdExhaustedError {}
}

fn unusedCancel(target: TaskId) -> PendingCancellation {
  return Intrinsic.trap("RenamedDispatcher: requestCancel is not used")
}

effect fn requestCancel(self: &mut RenamedDispatcher, target: TaskId) -> PendingCancellation {
  return unusedCancel(target)
}

fn unusedDeadline(deadline: Instant) -> usize {
  drop deadline
  return Intrinsic.trap("RenamedDispatcher: armDeadline is not used")
}

effect fn armDeadline(self: &mut RenamedDispatcher, deadline: Instant) -> usize {
  return unusedDeadline(move deadline)
}

effect fn disarmDeadline(self: &mut RenamedDispatcher, token: usize) -> () {
  return ()
}

impl RuntimePolicy for RenamedDispatcher {
  prepare: RenamedDispatcher.prepare
  requestCancel: RenamedDispatcher.requestCancel
  armDeadline: RenamedDispatcher.armDeadline
  disarmDeadline: RenamedDispatcher.disarmDeadline
}

effect fn child() -> i32
? &mut RuntimePolicy | &mut MonotonicClock {
  return 1
}

effect fn request() -> i32
! OutOfMemoryError | TaskIdExhaustedError
? &mut RuntimePolicy {
  let pending = run RuntimePolicy.prepare<i32, never>(child())
  drop pending
  return 0
}

effect fn refused(
  error: OutOfMemoryError | TaskIdExhaustedError,
) -> i32 {
  drop error
  return 42
}

pub fn main() -> i32 {
  let provider = RenamedDispatcher { calls: 0 }
  let bound = Effect.bindRequirementOwned<RuntimePolicy>(request(), move provider)
  return run Effect.catchAll(move bound, refused)
}
