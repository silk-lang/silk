import silk.text.format {Debug, Format, Formatter}
import silk.core.ownership {Drop}
import silk.io.writer {Writer, WriterError}

unsafe extern "C" fn bootstrap_body() -> i32
unsafe extern "C" fn bootstrap_dropped() -> ()

pub struct Problem {}
impl Debug for Problem {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return run Format.debugFields(self, "Problem", &mut formatter)
  }
}

impl Drop for Problem {
  fn drop(self: &mut Problem) -> () {
    unsafe bootstrap_dropped()
  }
}

pub effect fn main() -> () ! Problem {
  if unsafe bootstrap_body() == 7 { fail Problem {} }
  return ()
}
