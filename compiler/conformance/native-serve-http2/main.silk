// Serves HTTP/1.1 and HTTP/2 (prior knowledge) on 127.0.0.1 at the port in the first argument,
// for test-native-http2.mjs. `/echo` answers with the request body, `/large` with 100 KB, and
// any other path with `hello <path> <x-test field>`.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.http.serve { Handler, Request, Response, Server, ServeError }
import silk.system.host_input { HostInput, HostInputError }
import silk.num.u8
import silk.num.u16
import silk.text.string { String }

struct Site {
  large: List<u8>,
}

impl Handler for Site {
  effect fn handle(self: &Self, request: &Request<'_>, response: &mut Response<'_>) -> () ! OutOfMemoryError ? &mut Allocator {
    let path = request.path()
    if path == "/echo" {
      run response.header("x-method", request.method())
      run response.send(request.body())
      return ()
    }
    if path == "/large" {
      run response.send(List.asSlice(&self.large))
      return ()
    }
    if path == "/missing" {
      response.status(404)
      run response.text("missing")
      return ()
    }
    let mut text = List<u8>.make()
    run List.appendBytes(&mut text, b"hello ")
    run List.appendBytes(&mut text, String.utf8Bytes(path))
    run List.appendBytes(&mut text, b" ")
    match request.header("x-test") {
      Option.Some { value } => { run List.appendBytes(&mut text, String.utf8Bytes(value)) }
      Option.None => {}
    }
    run response.header("X-Served-By", "Silk")
    run response.send(List.asSlice(&text))
    return ()
  }
}

effect fn program() -> i32 ! HostInputError | ServeError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  let portBytes = match move run HostInput.argument(1) {
    Option.Some { value } => move value
    Option.None => { return 17 }
  }
  let mut port: u16 = 0
  let data = Bytes.asSlice(&portBytes)
  let mut index: usize = 0
  while index < data.length {
    if data[index] < 48 || data[index] > 57 { return 18 }
    port = port * 10 + u8.toU16(data[index] - 48)
    index = index + 1
  }
  let mut large = List<u8>.make()
  run List.appendRepeated(&mut large, 120, 100000)
  run Server.make(port).serve(Site { large: move large })
  return 0
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  return 99
}

pub effect fn main() -> i32
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(program(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
}
