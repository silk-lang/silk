//! Real native `silk.http.client` conformance; the harness supplies two loopback HTTP servers.
//! Each failed check exits with its own code and prints what it saw to standard error.
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.effect {Effect}
import silk.text.format {Format}
import silk.system.host_input {HostInput, HostInputError}
import silk.http.client {Http, HttpError, HttpErrorKind, Request, Response}
import silk.http.client_native {NativeHttp}
import silk.json.value {Json, Value}
import silk.core.option {Option}
import silk.io.writer_native {StderrWriter}
import silk.core.result {Result}
import silk.text.string {String}
import silk.io.writer {Writer, WriterError}
import silk.collections.list {List}

struct Mismatch {
  code: i32,
  field: string<'static>,
  expected: String,
  actual: String,
}

effect fn text(value: &Value, key: string) -> String ! OutOfMemoryError ? &mut Allocator {
  return match move Json.asString(Json.field(value, key)) {
    Option<string>.Some {value: found} => run String.copy(found)
    Option<string>.None => run String.copy("<missing>")
  }
}

/// Fails with `code` unless the echoed request field has the expected text.
effect fn expect(echo: &Value, code: i32, key: string<'static>, expected: string) -> ()
! Mismatch | OutOfMemoryError ? &mut Allocator {
  let actual = run text(echo, key)
  if String.view(&actual) != expected {
    fail Mismatch {code: code, field: key, expected: run String.copy(expected), actual: move actual}
  }
}

effect fn mismatch(code: i32, field: string<'static>, expected: string, actual: string) -> Mismatch
! OutOfMemoryError ? &mut Allocator {
  return Mismatch {code: code, field: field, expected: run String.copy(expected), actual: run String.copy(actual)}
}

fn kindName(kind: HttpErrorKind) -> string<'static> {
  return match kind {
    HttpErrorKind.InvalidUrl => "InvalidUrl"
    HttpErrorKind.InvalidRequest => "InvalidRequest"
    HttpErrorKind.Encode => "Encode"
    HttpErrorKind.Connect => "Connect"
    HttpErrorKind.Tls => "Tls"
    HttpErrorKind.Timeout => "Timeout"
    HttpErrorKind.Protocol => "Protocol"
    HttpErrorKind.TooLarge => "TooLarge"
    HttpErrorKind.Redirect => "Redirect"
    HttpErrorKind.Status => "Status"
    HttpErrorKind.Decode => "Decode"
  }
}

/// Sends a request that must fail with `kind`.
effect fn expectFailure(code: i32, request: Request<'_>, kind: HttpErrorKind) -> ()
! Mismatch | OutOfMemoryError ? &mut Http | &mut Allocator {
  let sent = run Effect.result(Http.send(move request))
  match move sent {
    Result.Success {value: _response} => {
      fail run mismatch(code, "failure", kindName(kind), "a response")
    }
    Result.Failure {error} => match move error {
      HttpError failed => {
        if failed.kind != kind { fail run mismatch(code, "kind", kindName(kind), kindName(failed.kind)) }
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

fn sameText(left: &[u8], right: string) -> bool {
  let expected = String.utf8Bytes(right)
  if left.length != expected.length { return false }
  let mut index: usize = 0
  while index < left.length {
    if left[index] != expected[index] { return false }
    index = index + 1
  }
  return true
}

effect fn requests(base: string, other: string) -> ()
! Mismatch | HttpError | OutOfMemoryError ? &mut Http | &mut Allocator {
  // Query parameters are percent-encoded; provider headers apply to every request.
  let mut query = Request.get("/echo")
  run query.query("language", "Silk")
  run query.query("q", "a b")
  let got = run Http.send(move query)
  let gotEcho = run got.json()
  run expect(&gotEcho, 1, "method", "GET")
  run expect(&gotEcho, 1, "target", "/echo?language=Silk&q=a%20b")
  run expect(&gotEcho, 1, "userAgent", "silk-http/1")
  run expect(&gotEcho, 1, "xDefault", "client")
  run expect(&gotEcho, 1, "acceptEncoding", "identity")
  let marker = match move got.header("x-echo") {
    Option.Some {value: found} => sameText(found, "yes")
    Option.None => false
  }
  if !marker { fail run mismatch(1, "x-echo", "yes", "another value") }

  // A request header replaces the provider default with the same name, including User-Agent.
  let mut overriding = Request.get("/echo")
  run overriding.header("user-agent", "conformance/2")
  run overriding.header("X-Default", "request")
  let overridden = run Http.send(move overriding)
  let overriddenEcho = run overridden.json()
  run expect(&overriddenEcho, 2, "userAgent", "conformance/2")
  run expect(&overriddenEcho, 2, "xDefault", "request")

  // A request holds any number of headers; past the client's fixed field array they go in a list.
  let mut padded = Request.get("/echo")
  run padded.header("X-Default", "many")
  let mut pad: usize = 0
  while pad < 60 {
    run padded.header("X-Pad", "1")
    pad = pad + 1
  }
  let paddedEcho = run (run Http.send(move padded)).json()
  run expect(&paddedEcho, 2, "xDefault", "many")

  let posted = run Http.send(run Request.post("/echo").json(&.{language: "Silk", count: 3}))
  let postedEcho = run posted.json()
  run expect(&postedEcho, 3, "method", "POST")
  run expect(&postedEcho, 3, "contentType", "application/json")
  run expect(&postedEcho, 3, "body", "{\"language\":\"Silk\",\"count\":3}")

  let put = run Http.send(Request.put("/echo").text("plain"))
  let putEcho = run put.json()
  run expect(&putEcho, 4, "method", "PUT")
  run expect(&putEcho, 4, "contentType", "text/plain; charset=utf-8")
  run expect(&putEcho, 4, "body", "plain")

  let authorized = run Http.send(Request.get("/echo").bearer("secret"))
  let authorizedEcho = run authorized.json()
  run expect(&authorizedEcho, 5, "authorization", "Bearer secret")

  // Every status is a response until the caller opts in to failure.
  let missing = run Http.send(Request.get("/status/404"))
  if missing.status() != 404 || missing.ok() { fail run mismatch(6, "status", "404", "another status") }
  let body = run missing.text()
  if body != "status 404" { fail run mismatch(6, "body", "status 404", body) }
  let checked = run Effect.result(missing.expectOk())
  match move checked {
    Result.Success {value: _response} => { fail run mismatch(7, "expectOk", "Status", "a response") }
    Result.Failure {error: failed} => {
      let kind = failed.kind
      let reported: u16 = match move failed.status {
        Option.Some {value: code} => code
        Option.None => 0
      }
      if kind != HttpErrorKind.Status || reported != 404 {
        fail run mismatch(7, "expectOk", "Status 404", kindName(kind))
      }
    }
  }

  // Relative and absolute redirects end at the echo endpoint, and the response keeps its final URL.
  let followed = run Http.send(Request.get("/redirect/3"))
  let mut finalUrl = run String.copy(base)
  run String.append(&mut finalUrl, "/echo")
  if followed.url() != String.view(&finalUrl) { fail run mismatch(8, "url", String.view(&finalUrl), followed.url()) }
  let followedEcho = run followed.json()
  run expect(&followedEcho, 8, "server", "main")
  let absolute = run Http.send(Request.get("/absolute"))
  let absoluteEcho = run absolute.json()
  run expect(&absoluteEcho, 9, "target", "/echo")

  // 303 switches to GET without a body; 307 repeats the method and body.
  let seeOther = run Http.send(Request.post("/see-other").text("dropped"))
  let seeOtherEcho = run seeOther.json()
  run expect(&seeOtherEcho, 10, "method", "GET")
  run expect(&seeOtherEcho, 10, "body", "")
  let temporary = run Http.send(Request.post("/temporary").text("kept"))
  let temporaryEcho = run temporary.json()
  run expect(&temporaryEcho, 11, "method", "POST")
  run expect(&temporaryEcho, 11, "body", "kept")

  // Credentials stay with the origin they were written for.
  let mut crossUrl = run String.copy(base)
  run String.append(&mut crossUrl, "/cross")
  let mut crossing = Request.get(String.view(&crossUrl)).bearer("secret")
  run crossing.header("Cookie", "session=1")
  let crossed = run Http.send(move crossing)
  let crossedEcho = run crossed.json()
  run expect(&crossedEcho, 12, "server", "other")
  run expect(&crossedEcho, 12, "authorization", "")
  run expect(&crossedEcho, 12, "cookie", "")
  run expect(&crossedEcho, 12, "xDefault", "client")

  run expectFailure(13, Request.get("/redirect/5").maxRedirects(2), HttpErrorKind.Redirect)
  run expectFailure(14, Request.get("/large").maxBodyBytes(1024), HttpErrorKind.TooLarge)
  run expectFailure(15, Request.get("/slow").timeoutSeconds(1), HttpErrorKind.Timeout)
  run expectFailure(16, Request.get("not a url"), HttpErrorKind.InvalidUrl)

  let decoded = run Http.send(Request.get("/json-string"))
  let greeting = run decoded.decode<String>()
  if String.view(&greeting) != "hello" { fail run mismatch(17, "decode", "hello", String.view(&greeting)) }
  if other == base { fail run mismatch(17, "origins", "two origins", "one") }

  // Bodies larger than the default HTTP/2 window take several flow-control updates each way.
  let mut upload = run String.copy("")
  let mut filled: usize = 0
  while filled < 200000 {
    run String.append(&mut upload, "uuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuu")
    filled = filled + 100
  }
  let counted = run Http.send(Request.post("/length").text(String.view(&upload)))
  let length = run counted.text()
  if length != "200000" { fail run mismatch(26, "upload", "200000", length) }
  let big = run Http.send(Request.get("/big"))
  if big.body().length != 100000 { fail run mismatch(27, "download", "100000 bytes", "another length") }

  // `sendAll` keeps the request order, follows redirects, and gives a failure as its result.
  let mut batch = List<Request>.make()
  run List<Request>.append(&mut batch, Request.get("/redirect/3"))
  let mut second = Request.get("/echo")
  run second.query("n", "2")
  run List<Request>.append(&mut batch, move second)
  run List<Request>.append(&mut batch, Request.get("/redirect/5").maxRedirects(2))
  run List<Request>.append(&mut batch, Request.post("/temporary").text("kept"))
  let answers = run Http.sendAll(move batch)
  let results = List<Result<Response, HttpError>>.asSlice(&answers)
  if results.length != 4 { fail run mismatch(19, "sendAll", "4 results", "another count") }
  match &results[0] {
    Result.Success {value: redirected} => {
      if redirected.url() != String.view(&finalUrl) { fail run mismatch(19, "url", String.view(&finalUrl), redirected.url()) }
      let redirectedEcho = run redirected.json()
      run expect(&redirectedEcho, 19, "server", "main")
    }
    Result.Failure {..} => { fail run mismatch(19, "sendAll", "a response", "a failure") }
  }
  match &results[1] {
    Result.Success {value: echoed} => {
      let echoedEcho = run echoed.json()
      run expect(&echoedEcho, 20, "target", "/echo?n=2")
    }
    Result.Failure {..} => { fail run mismatch(20, "sendAll", "a response", "a failure") }
  }
  match &results[2] {
    Result.Success {..} => { fail run mismatch(21, "failure", "Redirect", "a response") }
    Result.Failure {error: failed} => {
      if failed.kind != HttpErrorKind.Redirect { fail run mismatch(21, "kind", "Redirect", kindName(failed.kind)) }
    }
  }
  match &results[3] {
    Result.Success {value: kept} => {
      let keptEcho = run kept.json()
      run expect(&keptEcho, 22, "method", "POST")
      run expect(&keptEcho, 22, "body", "kept")
    }
    Result.Failure {..} => { fail run mismatch(22, "sendAll", "a response", "a failure") }
  }
}

/// A batch larger than one round keeps the request order, and a redirect in a later round is
/// followed. Two tasks give rounds of 64 jobs, so 150 requests take three rounds.
effect fn rounds() -> () ! Mismatch | HttpError | OutOfMemoryError ? &mut Http | &mut Allocator {
  let targets: [string<'static>; 3] = ["a", "b", "c"]
  let mut batch = List<Request>.make()
  let mut index: usize = 0
  while index < 150 {
    if index % 50 == 49 {
      run List<Request>.append(&mut batch, Request.get("/redirect/1"))
    } else {
      let mut echo = Request.get("/echo")
      run echo.query("n", targets[index % 3])
      run List<Request>.append(&mut batch, move echo)
    }
    index = index + 1
  }
  let answers = run Http.sendAll(move batch)
  let results = List<Result<Response, HttpError>>.asSlice(&answers)
  if results.length != 150 { fail run mismatch(23, "sendAll", "150 results", "another count") }
  index = 0
  while index < 150 {
    match &results[index] {
      Result.Success {value: answered} => {
        let echoed = run answered.json()
        if index % 50 == 49 {
          run expect(&echoed, 24, "target", "/echo")
        } else {
          let mut target = run String.copy("/echo?n=")
          run String.append(&mut target, targets[index % 3])
          run expect(&echoed, 25, "target", String.view(&target))
        }
      }
      Result.Failure {..} => { fail run mismatch(23, "sendAll", "a response", "a failure") }
    }
    index = index + 1
  }
}

/// Sixteen tasks send 96 requests, a third of them with a body. Over HTTP/2 they share a few
/// connections, several streams on each, and every result still matches its request.
effect fn shared() -> () ! Mismatch | HttpError | OutOfMemoryError ? &mut Http | &mut Allocator {
  let targets: [string<'static>; 4] = ["a", "b", "c", "d"]
  let mut batch = List<Request>.make()
  let mut index: usize = 0
  while index < 96 {
    if index % 3 == 2 {
      run List<Request>.append(&mut batch, Request.post("/echo").text(targets[index % 4]))
    } else {
      let mut echo = Request.get("/echo")
      run echo.query("n", targets[index % 4])
      run List<Request>.append(&mut batch, move echo)
    }
    index = index + 1
  }
  let answers = run Http.sendAll(move batch)
  let results = List<Result<Response, HttpError>>.asSlice(&answers)
  if results.length != 96 { fail run mismatch(28, "sendAll", "96 results", "another count") }
  index = 0
  while index < 96 {
    match &results[index] {
      Result.Success {value: answered} => {
        let echoed = run answered.json()
        if index % 3 == 2 {
          run expect(&echoed, 29, "method", "POST")
          run expect(&echoed, 29, "body", targets[index % 4])
        } else {
          let mut target = run String.copy("/echo?n=")
          run String.append(&mut target, targets[index % 4])
          run expect(&echoed, 30, "target", String.view(&target))
        }
      }
      Result.Failure {..} => { fail run mismatch(28, "sendAll", "a response", "a failure") }
    }
    index = index + 1
  }
}

/// Sixteen tasks send 48 requests to a TLS port where nothing listens. Jobs wait for the
/// connection that another task opens, and when it fails each still gets a Connect failure.
effect fn unreachable() -> () ! Mismatch | HttpError | OutOfMemoryError ? &mut Http | &mut Allocator {
  let mut batch = List<Request>.make()
  let mut index: usize = 0
  while index < 48 {
    run List<Request>.append(&mut batch, Request.get("https://127.0.0.1:1/closed"))
    index = index + 1
  }
  let answers = run Http.sendAll(move batch)
  let results = List<Result<Response, HttpError>>.asSlice(&answers)
  if results.length != 48 { fail run mismatch(31, "sendAll", "48 results", "another count") }
  index = 0
  while index < 48 {
    match &results[index] {
      Result.Success {..} => { fail run mismatch(31, "sendAll", "a failure", "a response") }
      Result.Failure {error: failed} => {
        if failed.kind != HttpErrorKind.Connect { fail run mismatch(31, "kind", "Connect", kindName(failed.kind)) }
      }
    }
    index = index + 1
  }
}

/// The provider's opt-in turns 4xx and 5xx into `HttpErrorKind.Status`.
effect fn strict() -> () ! Mismatch | HttpError | OutOfMemoryError ? &mut Http | &mut Allocator {
  run expectFailure(18, Request.get("/status/500"), HttpErrorKind.Status)
  let fine = run Http.send(Request.get("/echo"))
  if fine.status() != 200 { fail run mismatch(18, "status", "200", "another status") }
}

/// `fromEnvironment` sends plain HTTP through `HTTP_PROXY` with the absolute URI as the target and
/// the credentials of the proxy URL, and reaches a `NO_PROXY` host directly. Only the proxy connects
/// to the proxied host, so its name is never resolved here.
effect fn proxied(through: string, bypass: string) -> () ! Mismatch | HttpError | OutOfMemoryError ? &mut Http | &mut Allocator {
  let mut url = run String.copy(through)
  run String.append(&mut url, "/echo?via=proxy")
  let forwarded = run Http.send(Request.get(String.view(&url)))
  let forwardedEcho = run forwarded.json()
  run expect(&forwardedEcho, 19, "server", "proxy")
  run expect(&forwardedEcho, 19, "target", String.view(&url))
  run expect(&forwardedEcho, 19, "proxyAuthorization", "Basic dXNlcjpwYTpzcw==")
  let mut direct = run String.copy(bypass)
  run String.append(&mut direct, "/echo")
  let reached = run Http.send(Request.get(String.view(&direct)))
  let reachedEcho = run reached.json()
  run expect(&reachedEcho, 20, "server", "other")
  run expect(&reachedEcho, 20, "proxyAuthorization", "")
}

effect fn report(failure: &Mismatch) -> () ! WriterError ? &mut Writer {
  run Format.format("check {code} {field}: expected {expected}, got {actual}\n", &.{
    code: failure.code,
    field: failure.field,
    expected: String.view(&failure.expected),
    actual: String.view(&failure.actual),
  })
}

effect fn argument(index: usize) -> String ! HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  return match move run HostInput.argument(index) {
    Option.Some {value} => match move run String.copyUtf8(Bytes.asSlice(&value)) {
      Result.Success {value: text} => move text
      Result.Failure {..} => run String.copy("")
    }
    Option.None => run String.copy("")
  }
}

/// The optional fourth argument names a trust bundle; the harness then serves HTTPS that only
/// speaks HTTP/2, so every check runs over h2 negotiated with ALPN.
fn client<'c>(base: string<'c>, trust: string<'c>) -> NativeHttp<'c> {
  let http = NativeHttp<'c>.make().baseUrl(base)
  if String.byteLength(trust) == 0 { return move http }
  return http.trustBundle(trust)
}

effect fn program() -> i32 ! HttpError | HostInputError | WriterError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  let base = run argument(1)
  let other = run argument(2)
  let through = run argument(3)
  let trust = run argument(4)
  let mut http = client(String.view(&base), String.view(&trust)).header("X-Default", "client")
  let mut outcome = run Effect.result(requests(String.view(&base), String.view(&other)) |> Effect.provideMut<Http>(&mut http))
  match move outcome {
    Result.Success {value: _done} => {
      let mut strictHttp = client(String.view(&base), String.view(&trust)).failOnStatus()
      outcome = run Effect.result(strict() |> Effect.provideMut<Http>(&mut strictHttp))
    }
    Result.Failure {error} => { outcome = Result.Failure {error: move error} }
  }
  match move outcome {
    Result.Success {value: _done} => {
      let mut pairedHttp = client(String.view(&base), String.view(&trust)).withConcurrency(2)
      outcome = run Effect.result(rounds() |> Effect.provideMut<Http>(&mut pairedHttp))
    }
    Result.Failure {error} => { outcome = Result.Failure {error: move error} }
  }
  match move outcome {
    Result.Success {value: _done} => {
      let mut sharedHttp = client(String.view(&base), String.view(&trust)).withConcurrency(16)
      outcome = run Effect.result(shared() |> Effect.provideMut<Http>(&mut sharedHttp))
    }
    Result.Failure {error} => { outcome = Result.Failure {error: move error} }
  }
  match move outcome {
    Result.Success {value: _done} => {
      let mut closedHttp = client(String.view(&base), String.view(&trust)).withConcurrency(16)
      outcome = run Effect.result(unreachable() |> Effect.provideMut<Http>(&mut closedHttp))
    }
    Result.Failure {error} => { outcome = Result.Failure {error: move error} }
  }
  if String.byteLength(String.view(&through)) > 0 {
    match move outcome {
      Result.Success {value: _done} => {
        let mut environmentHttp = run NativeHttp.fromEnvironment()
        outcome = run Effect.result(proxied(String.view(&through), String.view(&other)) |> Effect.provideMut<Http>(&mut environmentHttp))
      }
      Result.Failure {error} => { outcome = Result.Failure {error: move error} }
    }
  }
  return match move outcome {
    Result.Success {value: _done} => 0
    Result.Failure {error} => match move error {
      Mismatch failure => {
        let mut writer = StderrWriter.make()
        run report(&failure) |> Effect.provideMut<Writer>(&mut writer)
        return failure.code
      }
      HttpError failed => {
        let mut writer = StderrWriter.make()
        run Format.format("unexpected HttpError {kind}: {message}\n", &.{kind: kindName(failed.kind), message: failed.message})
          |> Effect.provideMut<Writer>(&mut writer)
        return 30
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

pub effect fn main() -> i32 ! HttpError | HostInputError | WriterError | OutOfMemoryError ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run program() |> Effect.provideMut<Allocator>(&mut allocator)
}
