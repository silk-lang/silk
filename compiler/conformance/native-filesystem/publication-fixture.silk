// The C receiver owns real paths and payloads; only this fixture crosses into the portable service.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.system.filesystem { AtomicWriteError, FileError, FileSystem, Path }
import silk.option { Option }
import silk.core.result { Result }
import silk.system.filesystem_native { OsFileSystem }
import silk.num.usize

unsafe extern "C" fn publication_input_length(which: i32) -> usize
unsafe extern "C" fn publication_input_byte(which: i32, index: usize) -> u8
unsafe extern "C" fn publication_error(
  published: i32, operation: i32, reason: i32, nativeCode: i32,
  cleanupOperation: i32, cleanupReason: i32, cleanupNative: i32,
  stagingLength: usize,
) -> ()
unsafe extern "C" fn publication_staging_byte(index: usize, value: u8) -> ()

// The byte getters avoid relying on an internal Silk slice layout in the independent C consumer.
effect fn input(which: i32) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let length = unsafe publication_input_length(which)
  let mut bytes = Bytes.make()
  run Bytes.reserveExact(&mut bytes, length)
  let mut index = usize.ZERO
  while index < length {
    let byte: [u8; 1] = [unsafe publication_input_byte(which, index)]
    run Bytes.append(&mut bytes, &byte)
    index = index + usize.ONE
  }
  return move bytes
}

fn nativeCode(error: &FileError) -> i32 {
  return match move FileSystem.providerCode(error) {
    Option<i32>.Some { value } => value
    Option<i32>.None => -1
  }
}

effect fn fileFailure(error: FileError) -> i32 {
  unsafe publication_error(0, error.operation.code, error.reason.code, nativeCode(&error), -1, -1, -1, usize.ZERO)
  return 1
}

effect fn atomicFailure(error: AtomicWriteError) -> i32 {
  let mut published = 0
  if error.published { published = 1 }
  let staging = Bytes.asSlice(&error.stagingName)
  let mut index = usize.ZERO
  while index < staging.length {
    unsafe publication_staging_byte(index, staging[index])
    index = index + usize.ONE
  }
  let mut cleanupOperation = -1
  let mut cleanupReason = -1
  let mut cleanupNative = -1
  match move error.cleanupError {
    Option<FileError>.Some { value } => {
      cleanupOperation = value.operation.code
      cleanupReason = value.reason.code
      cleanupNative = nativeCode(&value)
    }
    Option<FileError>.None => {}
  }
  unsafe publication_error(
    published, error.cause.operation.code, error.cause.reason.code, nativeCode(&error.cause),
    cleanupOperation, cleanupReason, cleanupNative, staging.length,
  )
  return 1
}

effect fn memoryFailure(error: OutOfMemoryError) -> i32 { return 2 }

effect fn operation(selector: i32, policy: i32, durability: i32) -> i32
! FileError | AtomicWriteError | OutOfMemoryError ? &mut Allocator {
  let root = run input(0)
  let name = run input(1)
  let bytes = run input(2)
  let path = run Path.fromBytes(Bytes.asSlice(&name))
  let mut provider = run OsFileSystem.makeBytes(Bytes.asSlice(&root))
  if selector == 0 {
    run FileSystem.createFile(&path, Bytes.asSlice(&bytes))
      |> Effect.provideMut<FileSystem>(&mut provider)
  } else if selector == 1 {
    let mut publicationPolicy = FileSystem.replaceExisting()
    if policy != 0 { publicationPolicy = FileSystem.createNew() }
    let mut synchronization = FileSystem.buffered()
    if durability != 0 { synchronization = FileSystem.synchronized() }
    run FileSystem.writeFileAtomic(&path, Bytes.asSlice(&bytes), move publicationPolicy, move synchronization)
      |> Effect.provideMut<FileSystem>(&mut provider)
  } else if selector == 2 {
    run FileSystem.syncDirectory(&path) |> Effect.provideMut<FileSystem>(&mut provider)
  } else {
    run FileSystem.writeFile(&path, Bytes.asSlice(&bytes))
      |> Effect.provideMut<FileSystem>(&mut provider)
  }
  return 0
}

export "C" fn publication_fixture(selector: i32, policy: i32, durability: i32) -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  let outcome = run Effect.result(
    operation(selector, policy, durability) |> Effect.provideMut<Allocator>(&mut allocator)
  )
  return match move outcome {
    Result<i32, FileError | AtomicWriteError | OutOfMemoryError>.Success { value } => value
    Result<i32, FileError | AtomicWriteError | OutOfMemoryError>.Failure { error } => match move error {
      FileError file => run fileFailure(move file)
      AtomicWriteError atomic => run atomicFailure(move atomic)
      OutOfMemoryError memory => run memoryFailure(move memory)
    }
  }
}
