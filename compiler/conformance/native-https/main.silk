//! Real native HTTPS conformance; the harness supplies a loopback TLS server and explicit trust.
import changeset.GitHub as GitHub
import changeset.History {Record, Entry}
import changeset.Http {Http, HttpError, Response, reportError}
import changeset.HttpNative as HttpNative {Native}
import changeset.Problem {Problem}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.effect {Effect}
import silk.format {Format}
import silk.system.host_input {HostInput, HostInputError}
import silk.option {Option}
import silk.json.value {Json}
import silk.io.writer_native {StderrWriter}
import silk.core.result {Result}
import silk.text.string {String}
import silk.tls.client {TlsError}
import silk.tls.connection {ConnectionError}
import silk.collections.list {List}
import silk.io.writer {Writer, WriterError}

// Route the existing replaceable service to a real TLS endpoint. Only the hostname/port changes;
// metadata selection, native transport, response parsing, tag pinning, and history walking run.
struct Routed {
  native: Native,
  origin: String,
}
impl Http for Routed {
  effect fn get(self: &mut Self, url: string) -> Response
  ! Problem | HttpError | OutOfMemoryError ? &mut Allocator {
    let mut path = ""
    if url == "https://api.github.com/repos/owner/repo/releases/latest" {
      path = "/repos/owner/repo/releases/latest"
    } else if url == "https://github.com/owner/repo/releases/download/v1.1.0/changes-snapshot.toml" {
      path = "/downloads/v1.1.0/changes-snapshot.toml"
    } else if url == "https://api.github.com/repos/owner/repo/releases/tags/v1.1.0-beta.2%2Babc" {
      path = "/repos/owner/repo/releases/tags/v1.1.0-beta.2%2Babc"
    } else if url == "https://github.com/owner/repo/releases/download/v1.1.0-beta.2%2Babc/changes-snapshot.toml" {
      path = "/downloads/v1.1.0-beta.2%2Babc/changes-snapshot.toml"
    } else {
      fail Problem {message: "Unexpected history URL"}
    }
    let mut endpoint = run String.copy(String.view(&self.origin))
    run String.append(&mut endpoint, path)
    return run Http.get(String.view(&endpoint)) |> Effect.provideMut<Http>(&mut self.native)
  }
}

effect fn controlled(origin: String, native: Native) -> i32
! Problem | HttpError | OutOfMemoryError ? &mut Allocator {
  let mut http = Routed {native: move native, origin: move origin}
  let publication = run GitHub.resolve("owner/repo", "", "", "1.0.0") |> Effect.provideMut<Http>(&mut http)
  if String.view(&publication.version) != "1.1.0" { return 1 }
  let records = run GitHub.query(&publication, "example", "1.1.0-beta.2+abc") |> Effect.provideMut<Http>(&mut http)
  let items = List<Record>.asSlice(&records)
  if items.length != 1 { return 2 }
  let entries = List<Entry>.asSlice(&items[0].entries)
  if entries.length != 1 || String.view(&entries[0].id) != "second" { return 3 }
  if String.view(&entries[0].migration) != "Update config → safe\nKeep this newline." { return 4 }
  return 0
}

effect fn reportLiveResponse(response: &Response) -> () ! WriterError ? &mut Writer {
  run Format.format("Live GitHub release metadata: HTTP {status}\n", &.{status: response.status})
  run Writer.writeAll(Bytes.asSlice(&response.body))
  run Writer.writeAll(b"\n")
}

effect fn live(native: Native) -> i32 ! Problem | HttpError | OutOfMemoryError ? &mut Allocator {
  let mut http = move native
  // The retained bootstrap release predates snapshot publication. Exercise its real
  // metadata and small asset without pretending it can supply new upgrade history.
  let metadata = run Http.get("https://api.github.com/repos/silk-lang/silk/releases/tags/v0.1.0-dev.1%2B5081812")
    |> Effect.provideMut<Http>(&mut http)
  if metadata.status != 200 {
    let mut writer = StderrWriter.make()
    let reported = run Effect.result(reportLiveResponse(&metadata) |> Effect.provideMut<Writer>(&mut writer))
    return match move reported {
      Result.Success {value} => 5
      Result.Failure {error} => 17
    }
  }
  let manifest = run Http.get("https://raw.githubusercontent.com/silk-lang/silk/v0.1.0-dev.1%2B5081812/compiler/silk.toml")
    |> Effect.provideMut<Http>(&mut http)
  if manifest.status != 200 || Bytes.length(&manifest.body) == 0 { return 6 }
  let missing = run Http.get("https://raw.githubusercontent.com/silk-lang/silk/v0.1.0-dev.1%2B5081812/compiler/.changes/releases/0.1.0-dev.1%2B5081812.toml")
    |> Effect.provideMut<Http>(&mut http)
  if missing.status != 404 { return 7 }
  let seed = run Http.get("https://github.com/silk-lang/silk/releases/download/v0.1.0-dev.1%2B5081812/native-seed.json")
    |> Effect.provideMut<Http>(&mut http)
  if seed.status != 200 { return 8 }
  let document = match move run Effect.result(Json.parse(Bytes.asSlice(&seed.body))) {
    Result.Success {value} => move value
    Result.Failure {error} => { return 9 }
  }
  let seeds = match move Json.field(&document, "seeds") {
    Option.Some {value} => value
    Option.None => { return 9 }
  }
  let target = match move Json.field(seeds, "x86_64-unknown-linux-gnu") {
    Option.Some {value} => value
    Option.None => { return 9 }
  }
  let tag = Option<string>.unwrapOr(Json.asString(Json.field(target, "tag")), "")
  let commit = Option<string>.unwrapOr(Json.asString(Json.field(target, "sourceCommit")), "")
  if tag != "v0.1.0-dev.1+5081812" || commit != "5081812816eb01929872170cc6cca27f92a7deb1" { return 9 }
  return 0
}

effect fn program() -> i32 ! Problem | HttpError | HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  let native = run HttpNative.make()
  let base = run HostInput.variable(b"SILK_HTTPS_TEST_BASE")
  return match move base {
    Option.None => run live(move native)
    Option.Some {value} => {
      let parsed = run String.copyUtf8(Bytes.asSlice(&value))
      return match move parsed {
        Result.Success {value: origin} => run controlled(move origin, move native)
        Result.Failure {error} => 8
      }
    }
  }
}

effect fn report(cause: Problem | HttpError | HostInputError | OutOfMemoryError) -> i32 ! WriterError ? &mut Writer {
  return match move cause {
    HttpError failure => {
      run reportError(&failure)
      return match & failure {
        HttpError.Trust {error} => 12
        HttpError.Tls {error: connection} => match & connection {
          ConnectionError.Tls {error: TlsError.CertificateIdentity {error}} => 11
          ConnectionError.Tls {error: TlsError.CertificatePath {error}} => 10
          _ => 13
        }
      }
    }
    Problem problem => { run Writer.writeString(problem.message) return 14 }
    HostInputError error => 15
    OutOfMemoryError error => 16
  }
}
pub effect fn main() -> i32 ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run Effect.result(program() |> Effect.provideMut<Allocator>(&mut allocator))
  return match move result {
    Result.Success {value} => value
    Result.Failure {error} => {
      let mut writer = StderrWriter.make()
      let reported = run Effect.result(report(move error) |> Effect.provideMut<Writer>(&mut writer))
      return match move reported { Result.Success {value} => value Result.Failure {error: ignored} => 17 }
    }
  }
}
