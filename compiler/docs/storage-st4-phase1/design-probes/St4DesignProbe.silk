import semantic.Rejection {Rejection, RejectionCode}
import silk.shared {Shared}
import silk.result {Result}
import silk.option {Option}
import semantic.Semantic {Semantic, Request, Answer}
import semantic.Types {TypeTable, Types}
import semantic.Query {Cycle}
import semantic.SourceIndex {RevisionMismatch, NoRejection}
import semantic.ModuleId {InvalidModulePath}
import semantic.TypedBody {BorrowStatus}
import semantic.SemanticCaseSupport {module, staticSemantic, succeeded, hasBorrowStatus, rejection}
import semantic.Target {Target as MachineTarget, Id as TargetId}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.effect {Effect}
import silk.os_writer {StdoutWriter}
import silk.writer {Writer, WriterError}
import silk.testing {Testing, AssertionError}

test effect fn classifyDelayedDrive() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut table = TypeTable.make()
  let id = run module("st4-delayed-drive.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
fn valid<'a,
  C: once fn<'a>(&'a i32, i32) -> () + Intrinsic.NonParking,
  S: once fn<'a>(&'a i32, Intrinsic.Execution<i32>) -> () + Intrinsic.NonParking
>(execution: Intrinsic.Execution<i32>, state: &'a i32, complete: C, suspend: S) -> once Effect<'a; ()> {
  return Intrinsic.executionDrive<i32, &'a i32, C, S>(move execution, state, move complete, move suspend)
}

fn bad<'a,
  C: once fn<'a>(&'a i32, i32) -> () + Intrinsic.NonParking,
  S: once fn<'a>(&'a i32, Intrinsic.Execution<i32>) -> () + Intrinsic.NonParking
>(execution: Intrinsic.Execution<i32>, state: &'a i32, complete: C, suspend: S) -> once Effect<'static; ()> {
  return Intrinsic.executionDrive<i32, &'a i32, C, S>(move execution, state, move complete, move suspend)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let valid = run Semantic.demandBody(&mut store, &mut request, &id, b"valid") |> Effect.provideMut<Types>(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  let bad = run Semantic.demandBody(&mut store, &mut request, &id, b"bad") |> Effect.provideMut<Types>(&mut table) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut output = StdoutWriter.make()
  if succeeded(&valid) {
    run Writer.writeAll(b"valid: accepted\n") |> Effect.provideMut<Writer>(&mut output)
  } else {
    run Writer.writeAll(b"valid: rejected\n") |> Effect.provideMut<Writer>(&mut output)
    run printRejection(&valid) |> Effect.provideMut<Writer>(&mut output)
  }
  if succeeded(&bad) {
    if hasBorrowStatus(&bad, BorrowStatus.Storage) {
      run Writer.writeAll(b"bad: accepted Storage\n") |> Effect.provideMut<Writer>(&mut output)
    } else if hasBorrowStatus(&bad, BorrowStatus.Checked) {
      run Writer.writeAll(b"bad: accepted Checked\n") |> Effect.provideMut<Writer>(&mut output)
    } else {
      run Writer.writeAll(b"bad: accepted other unchecked reason\n") |> Effect.provideMut<Writer>(&mut output)
    }
  } else {
    run Writer.writeAll(b"bad: rejected\n") |> Effect.provideMut<Writer>(&mut output)
    run printRejection(&bad) |> Effect.provideMut<Writer>(&mut output)
  }
}

effect fn printRejection(answer: &Shared<Result<Answer, NoRejection>>) -> () ! WriterError ? &mut Writer {
  let found = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Rejection>>>(answer, rejection)
  if let Option<Shared<Rejection>>.Some {value} = move found {
    let code = Shared<Rejection>.with<RejectionCode>(&value, fn(diagnostic: &Rejection) -> RejectionCode { return diagnostic.code })
    run Writer.writeAll(Rejection.name(code))
    run Writer.writeAll(b"\n")
  }
}
