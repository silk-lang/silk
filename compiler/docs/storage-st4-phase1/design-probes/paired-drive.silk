fn valid<'a,
  C: once fn<'a>(&'a i32, i32) -> () + Intrinsic.NonParking,
  S: once fn<'a>(&'a i32, Intrinsic.Execution<i32>) -> () + Intrinsic.NonParking
>(execution: Intrinsic.Execution<i32>, state: &'a i32, complete: C, suspend: S) -> once Effect<'a; ()> {
  return Intrinsic.executionDrive<i32, &'a i32, C, S>(move execution, state, move complete, move suspend)
}

fn bad<'a,
  C: once fn<'a>(&'a i32, i32) -> () + Intrinsic.NonParking,
  S: once fn<'a>(&'a i32, Intrinsic.Execution<i32>) -> () + Intrinsic.NonParking
>(execution: Intrinsic.Execution<i32>, state: &'a i32, complete: C, suspend: S) -> once Effect<'static; ()> {
  return Intrinsic.executionDrive<i32, &'a i32, C, S>(move execution, state, move complete, move suspend)
}
