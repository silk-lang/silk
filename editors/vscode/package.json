{
  "name": "silk",
  "displayName": "Silk",
  "version": "0.1.0",
  "private": true,
  "description": "Silk language support through the silk lsp language server",
  "categories": [
    "Formatters",
    "Programming Languages"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/silk-lang/silk"
  },
  "publisher": "silk-lang",
  "main": "./extension.js",
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "contributes": {
    "languages": [
      {
        "id": "silk",
        "aliases": [
          "Silk"
        ],
        "extensions": [
          ".silk"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "Silk",
      "properties": {
        "silk.path": {
          "type": "string",
          "default": "silk",
          "description": "The silk compiler to run as the language server, as a path or a command on PATH."
        }
      }
    }
  },
  "engines": {
    "vscode": "^1.90.0"
  }
}
