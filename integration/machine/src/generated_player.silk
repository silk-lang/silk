//! Generated from the definition of Player. Do not edit: change the definition and generate again.

import silk.machine.chart { Chart }
import history_tests { Player, PlayerContext, PlayerEffect, PlayerEvent, Mode, Gear }

pub static fn playerChart() -> Chart<Player, PlayerEvent, PlayerContext, PlayerEffect> {
  return Chart<Player, PlayerEvent, PlayerContext, PlayerEffect>.of()
    |> Chart.initial(Player.Stopped)
    |> Chart.region("mode")
    |> Chart.history("Playing", "lastPlaying")
    |> Chart.shallowHistory("Editing", "lastEditing")
    |> Chart.on("Stopped", "Play", Player.Playing { mode: Mode.Normal })
    |> Chart.resume("Stopped", "Resume", Player.Playing { mode: Mode.Normal })
    |> Chart.on("Stopped", "Edit", Player.Editing { mode: Mode.Normal })
    |> Chart.resume("Stopped", "ResumeEdit", Player.Editing { mode: Mode.Normal })
    |> Chart.on("Playing", "Stop", Player.Stopped)
    |> Chart.on("Editing", "Stop", Player.Stopped)
}

pub static fn modeChart() -> Chart<Mode, PlayerEvent, PlayerContext, PlayerEffect> {
  return Chart<Mode, PlayerEvent, PlayerContext, PlayerEffect>.of()
    |> Chart.initial(Mode.Normal)
    |> Chart.region("gear")
    |> Chart.on("Normal", "Faster", Mode.Fast { gear: Gear.Second })
}

pub static fn gearChart() -> Chart<Gear, PlayerEvent, PlayerContext, PlayerEffect> {
  return Chart<Gear, PlayerEvent, PlayerContext, PlayerEffect>.of()
    |> Chart.initial(Gear.Second)
    |> Chart.on("Second", "Shift", Gear.Third)
}
