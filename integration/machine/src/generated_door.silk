//! Generated from the definition of Door. Do not edit: change the definition and generate again.

import silk.machine.chart { Chart }
import generate_tests { Door, DoorContext, DoorEffect, DoorEvent, guardClosedOpen }

pub static fn doorChart() -> Chart<Door, DoorEvent, DoorContext, DoorEffect> {
  return Chart<Door, DoorEvent, DoorContext, DoorEffect>.of()
    |> Chart.initial(Door.Closed)
    |> Chart.tag("Closed", "shut")
    |> Chart.meta("Closed", "label", "The door is \"closed\"")
    |> Chart.tag("Locked", "shut")
    |> Chart.onWhen("Closed", "Open", Door.Opened, guardClosedOpen)
    |> Chart.metaOn("Closed", "Open", "label", "With the key")
    |> Chart.on("Closed", "Lock", Door.Locked)
    |> Chart.on("Opened", "Close", Door.Closed)
    |> Chart.stay("Opened", "Lock")
    |> Chart.onAny("Opened", Door.Closed)
    |> Chart.metaOnAny("Opened", "label", "Anything else")
    |> Chart.after("Opened", 5s, Door.Closed)
    |> Chart.final("Locked")
}
