//! Statechart rules that xstate checks and that regions must follow too: eventless transitions
//! and final states in regions, timers of charts that several regions share, and guards that
//! see the context as it was before the event.
import silk.machine.chart { Chart, Enqueue, Machine }
import silk.machine.simple { NoContext, NoEffect, Simple, SimpleChart, SimpleMachine }
import silk.machine.definition { Definitions }
import silk.machine.generate { Generate }
import silk.machine.xstate { Xstate, XstateError }
import silk.json.scanner { JsonError }
import silk.io.writer { Writer, WriterError }
import silk.machine.snapshot { Status, Steps, TransitionLoopError }
import silk.core.result { Result }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }

// A job whose steps run in a region. Start moves on to Middle by itself, and the job is done
// when its region reaches End.

union Job {
  Idle,
  Running { pub step: Step },
  Finished,
}

union Step {
  Start,
  Middle,
  End
}

union JobEvent {
  Go,
  Next,
  Back,
}

impl SimpleMachine<JobEvent> for Job {
  static fn chart() -> SimpleChart<Job, JobEvent> {
    return Simple.chart<Job, JobEvent>()
      |> Chart.initial(Job.Idle)
      |> Chart.region("step")
      |> Chart.on("Idle", "Go", Job.Running { step: Step.Start })
      |> Chart.onDone("Running", Job.Finished)
      |> Chart.final("Finished")
  }
}

impl SimpleMachine<JobEvent> for Step {
  static fn chart() -> SimpleChart<Step, JobEvent> {
    return Simple.chart<Step, JobEvent>()
      |> Chart.initial(Step.Start)
      |> Chart.always("Start", Step.Middle)
      |> Chart.on("Middle", "Next", Step.End)
      |> Chart.on("End", "Back", Step.Middle)
      |> Chart.final("End")
  }
}

effect fn jobScenario() -> ()
  ! OutOfMemoryError | TransitionLoopError
  ? &mut Allocator {
  let mut job = run Simple.begin<Job, JobEvent>(0)
  drop run Simple.send(&mut job, JobEvent.Go)

  // The eventless transition of the region is taken in the same step.
  match &job.value {
    Job.Running { step: Step.Middle } => {}
    _ => Intrinsic.trap("the region's eventless transition is taken")
  }
  drop run Simple.send(&mut job, JobEvent.Next)

  // The region reached its final state, so the job's done transition is taken.
  match &job.value {
    Job.Finished => {}
    _ => Intrinsic.trap("a region in a final state makes its state done")
  }
  return ()
}

test effect fn regionsTakeEventlessAndDoneTransitions()
  ! OutOfMemoryError | TransitionLoopError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run jobScenario() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A final state in a region takes no events, even one its chart names.

union Holder {
  Holding { pub step: Step },
}

impl SimpleMachine<JobEvent> for Holder {
  static fn chart() -> SimpleChart<Holder, JobEvent> {
    return Simple.chart<Holder, JobEvent>()
      |> Chart.initial(Holder.Holding { step: Step.Middle })
      |> Chart.region("step")
  }
}

effect fn holderScenario() -> ()
  ! OutOfMemoryError | TransitionLoopError
  ? &mut Allocator {
  let mut holder = run Simple.begin<Holder, JobEvent>(0)
  drop run Simple.send(&mut holder, JobEvent.Next)
  if run Simple.send(&mut holder, JobEvent.Back) {
    Intrinsic.trap("a final state takes no events")
  }
  match &holder.value {
    Holder.Holding { step: Step.End } => {}
    _ => Intrinsic.trap("the region stays in its final state")
  }
  return ()
}

test effect fn finalStatesInRegionsTakeNoEvents()
  ! OutOfMemoryError | TransitionLoopError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run holderScenario() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Two regions of one chart type keep their own timers.

union Desk {
  Open { pub left: Panel, pub right: Panel },
}

union Panel {
  Idle,
  Busy
}

union DeskEvent {
  Poke,
}

impl SimpleMachine<DeskEvent> for Desk {
  static fn chart() -> SimpleChart<Desk, DeskEvent> {
    return Simple.chart<Desk, DeskEvent>()
      |> Chart.initial(Desk.Open { left: Panel.Busy, right: Panel.Idle })
      |> Chart.region("left")
      |> Chart.region("right")
  }
}

impl SimpleMachine<DeskEvent> for Panel {
  static fn chart() -> SimpleChart<Panel, DeskEvent> {
    return Simple.chart<Panel, DeskEvent>()
      |> Chart.initial(Panel.Idle)
      |> Chart.on("Idle", "Poke", Panel.Busy)
      |> Chart.after("Busy", 1s, Panel.Idle)
  }
}

effect fn deskScenario() -> ()
  ! OutOfMemoryError | TransitionLoopError
  ? &mut Allocator {
  let mut desk = run Simple.begin<Desk, DeskEvent>(0)
  drop run Simple.advance(&mut desk, 500ms)

  // The left panel is busy and passes, the right one starts its own timer.
  drop run Simple.send(&mut desk, DeskEvent.Poke)
  match &desk.value {
    Desk.Open { left: Panel.Busy, right: Panel.Busy } => {}
    _ => Intrinsic.trap("both panels are busy")
  }
  if desk.timers.length() != 2 {
    Intrinsic.trap("each panel has a timer")
  }
  drop run Simple.advance(&mut desk, 1s)
  match &desk.value {
    Desk.Open { left: Panel.Idle, right: Panel.Busy } => {}
    _ => Intrinsic.trap("only the left panel's timer fired")
  }

  // Poking makes the left panel busy again, and leaves the right panel's timer alone.
  drop run Simple.send(&mut desk, DeskEvent.Poke)
  if desk.timers.length() != 2 {
    Intrinsic.trap("each panel still has a timer")
  }
  drop run Simple.advance(&mut desk, 1500ms)
  match &desk.value {
    Desk.Open { left: Panel.Busy, right: Panel.Idle } => {}
    _ => Intrinsic.trap("only the right panel's timer fired")
  }
  return ()
}

test effect fn regionsOfOneChartKeepTheirOwnTimers()
  ! OutOfMemoryError | TransitionLoopError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run deskScenario() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Guards see the context as it was before the event, whatever an earlier region did with it.

union Pair {
  Both { pub first: First, pub second: Second },
}

union First {
  Waiting,
  Flagged
}

union Second {
  Waiting,
  SawFlag,
  SawNoFlag
}

union PairEvent {
  Flip,
}

struct PairContext {
  pub flag: bool,
}

union PairEffect {
  Nothing,
}

fn flagSet(context: &PairContext, event: &PairEvent) -> bool {
  return context.flag
}

impl Machine<PairEvent, PairContext, PairEffect> for Pair {
  static fn chart() -> Chart<Pair, PairEvent, PairContext, PairEffect> {
    return Chart<Pair, PairEvent, PairContext, PairEffect>.of()
      |> Chart.initial(Pair.Both { first: First.Waiting, second: Second.Waiting })
      |> Chart.region("first")
      |> Chart.region("second")
  }
}

impl Machine<PairEvent, PairContext, PairEffect> for First {
  static fn chart() -> Chart<First, PairEvent, PairContext, PairEffect> {
    return Chart<First, PairEvent, PairContext, PairEffect>.of()
      |> Chart.initial(First.Waiting)
      |> Chart.on("Waiting", "Flip", First.Flagged)
  }

  effect fn enter(
    state: &First,
    context: &mut PairContext,
    enq: &mut Enqueue<PairEvent, PairEffect>,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    match &state.* {
      First.Flagged => {
        context.flag = true
      }
      _ => {}
    }
    return ()
  }
}

impl Machine<PairEvent, PairContext, PairEffect> for Second {
  static fn chart() -> Chart<Second, PairEvent, PairContext, PairEffect> {
    return Chart<Second, PairEvent, PairContext, PairEffect>.of()
      |> Chart.initial(Second.Waiting)
      |> Chart.onWhen("Waiting", "Flip", Second.SawFlag, flagSet)
      |> Chart.on("Waiting", "Flip", Second.SawNoFlag)
  }
}

effect fn pairScenario() -> ()
  ! OutOfMemoryError | TransitionLoopError
  ? &mut Allocator {
  let mut pair = run Steps.begin<Pair, PairEvent, PairContext, PairEffect>(
    PairContext { flag: false },
    0,
  )
  drop run Steps.send(&mut pair, PairEvent.Flip)
  if !pair.context.flag {
    Intrinsic.trap("entering Flagged sets the flag")
  }
  match &pair.value {
    Pair.Both { first: First.Flagged, second: Second.SawNoFlag } => {}
    _ => Intrinsic.trap("the second region's guard sees the context from before the event")
  }
  return ()
}

test effect fn guardsSeeTheContextBeforeTheEvent()
  ! OutOfMemoryError | TransitionLoopError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run pairScenario() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A done transition is part of the definition, of the xstate config, and of generated source.

struct Capture {
  bytes: [u8; 2048],
  length: usize,
}

impl Writer for Capture {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> ()
    ! WriterError
    ? &mut Writer {
    let mut index: usize = 0
    while index < value.length {
      self.bytes[self.length] = value[index]
      self.length = self.length + 1
      index = index + 1
    }
    return ()
  }

  effect fn flush(self: &mut Self) -> ()
    ! WriterError
    ? &mut Writer {
    return ()
  }
}

fn holds(capture: &Capture, expected: &[u8]) -> bool {
  if capture.length != expected.length {
    return false
  }
  let mut index: usize = 0
  while index < expected.length {
    if capture.bytes[index] != expected[index] {
      return false
    }
    index = index + 1
  }
  return true
}

const JOB_CONFIG: &[u8] = b"{\"id\":\"Job\",\"initial\":\"Idle\",\"states\":{\"Idle\":{\"on\":{\"Go\":[{\"target\":\"Running\"}]}},\"Running\":{\"initial\":\"Start\",\"states\":{\"Start\":{\"always\":[{\"target\":\"Middle\"}]},\"Middle\":{\"on\":{\"Next\":[{\"target\":\"End\"}]}},\"End\":{\"type\":\"final\",\"on\":{\"Back\":[{\"target\":\"Middle\"}]}}},\"onDone\":{\"target\":\"Finished\"}},\"Finished\":{\"type\":\"final\"}}}"

effect fn doneScenario() -> ()
  ! OutOfMemoryError | WriterError | JsonError | XstateError
  ? &mut Allocator {
  let definition = run Definitions.of<Job, JobEvent, NoContext, NoEffect>()
  let mut config = Capture { bytes: [0; 2048], length: 0 }
  run Xstate.write(&definition) |> Effect.provideMut<Writer>(&mut config)
  if !holds(&config, JOB_CONFIG) {
    Intrinsic.trap("the xstate config has onDone")
  }

  // Read back, the config gives the same definition.
  let read = run Xstate.read(JOB_CONFIG)
  let mut again = Capture { bytes: [0; 2048], length: 0 }
  run Xstate.write(&read) |> Effect.provideMut<Writer>(&mut again)
  if !holds(&again, JOB_CONFIG) {
    Intrinsic.trap("onDone is read back")
  }
  let mut source = Capture { bytes: [0; 2048], length: 0 }
  run Generate.write(&definition, "semantics_tests") |> Effect.provideMut<Writer>(&mut source)
  if !contains(&source, b"    |> Chart.onDone(\"Running\", Job.Finished)\n") {
    Intrinsic.trap("generated source has onDone")
  }
  return ()
}

fn contains(capture: &Capture, part: &[u8]) -> bool {
  let mut start: usize = 0
  while start + part.length <= capture.length {
    let mut index: usize = 0
    while index < part.length && capture.bytes[start + index] == part[index] {
      index = index + 1
    }
    if index == part.length {
      return true
    }
    start = start + 1
  }
  return false
}

test effect fn doneTransitionsAreData()
  ! OutOfMemoryError | WriterError | JsonError | XstateError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run doneScenario() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A step that never settles leaves the machine failed, and a failed machine takes no events.

union Spin {
  Still,
  Left,
  Right
}

union SpinEvent {
  Go,
}

impl SimpleMachine<SpinEvent> for Spin {
  static fn chart() -> SimpleChart<Spin, SpinEvent> {
    return Simple.chart<Spin, SpinEvent>()
      |> Chart.initial(Spin.Still)
      |> Chart.on("Still", "Go", Spin.Left)
      |> Chart.always("Left", Spin.Right)
      |> Chart.always("Right", Spin.Left)
      |> Chart.after("Still", 1s, Spin.Left)
  }
}

effect fn spinScenario() -> ()
  ! OutOfMemoryError | TransitionLoopError
  ? &mut Allocator {
  let mut spin = run Simple.begin<Spin, SpinEvent>(0)
  let sent = run Effect.result(Simple.send(&mut spin, SpinEvent.Go))
  match move sent {
    Result<bool, OutOfMemoryError | TransitionLoopError>.Failure {
      error: TransitionLoopError { .. }
    } => {}
    _ => Intrinsic.trap("the step never settles")
  }
  match &spin.status {
    Status.Failed => {}
    _ => Intrinsic.trap("the machine failed")
  }
  if spin.timers.length() != 0 {
    Intrinsic.trap("a failed machine has no timers")
  }
  if run Simple.send(&mut spin, SpinEvent.Go) {
    Intrinsic.trap("a failed machine takes no events")
  }
  return ()
}

test effect fn failedStepsStopTheMachine()
  ! OutOfMemoryError | TransitionLoopError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run spinScenario() |> Effect.provideMut<Allocator>(&mut allocator)
}
