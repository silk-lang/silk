import silk.machine.chart { Chart, Machine }
import silk.machine.definition { Definition }
import silk.machine.generate { Generate }
import generated_door { doorChart }
import silk.machine.snapshot { Steps, TransitionLoopError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.issue { SchemaError }
import silk.schema.json { SchemaJson }

// A door whose transition table is generated from a definition. `src/generated_door.silk` holds
// the text that `Generate.write` returns for the definition below, so this module proves both
// that the generator writes that text and that the text compiles against the program's types.

pub union Door {
  Closed,
  Opened,
  Locked
}

pub union DoorEvent {
  Open { pub key: u32 },
  Close,
  Lock,
}

pub struct DoorContext {
  pub key: u32,
}

pub union DoorEffect {
  Nothing,
}

pub fn guardClosedOpen(context: &DoorContext, event: &DoorEvent) -> bool {
  return match &event.* {
    DoorEvent.Open { key } => key == context.key
    _ => false
  }
}

impl Machine<DoorEvent, DoorContext, DoorEffect> for Door {
  static fn chart() -> Chart<Door, DoorEvent, DoorContext, DoorEffect> {
    return doorChart()
  }
}

struct Capture {
  bytes: [u8; 2048],
  length: usize,
}

impl Writer for Capture {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> ()
    ! WriterError
    ? &mut Writer {
    let mut index: usize = 0
    while index < value.length {
      self.bytes[self.length] = value[index]
      self.length = self.length + 1
      index = index + 1
    }
    return ()
  }

  effect fn flush(self: &mut Self) -> ()
    ! WriterError
    ? &mut Writer {
    return ()
  }
}

fn holds(capture: &Capture, expected: &[u8]) -> bool {
  if capture.length != expected.length {
    return false
  }
  let mut index: usize = 0
  while index < expected.length {
    if capture.bytes[index] != expected[index] {
      return false
    }
    index = index + 1
  }
  return true
}

effect fn generateScenario() -> ()
  ! OutOfMemoryError | SchemaError
  ? &mut Allocator {
  let definition = run SchemaJson.decode<Definition>(
    b"{\"name\":\"Door\",\"charts\":[{\"name\":\"Door\",\"initial\":\"Closed\",\"states\":[{\"name\":\"Closed\",\"final\":false,\"tags\":[\"shut\"],\"meta\":[{\"key\":\"label\",\"value\":\"The door is \\\"closed\\\"\"}],\"on\":[{\"event\":\"Open\",\"target\":\"Opened\",\"guarded\":true,\"history\":false,\"meta\":[{\"key\":\"label\",\"value\":\"With the key\"}]},{\"event\":\"Lock\",\"target\":\"Locked\",\"guarded\":false,\"history\":false,\"meta\":[]}],\"always\":[],\"after\":[],\"done\":\"\",\"regions\":[]},{\"name\":\"Opened\",\"final\":false,\"tags\":[],\"meta\":[],\"on\":[{\"event\":\"Close\",\"target\":\"Closed\",\"guarded\":false,\"history\":false,\"meta\":[]},{\"event\":\"Lock\",\"target\":\"\",\"guarded\":false,\"history\":false,\"meta\":[]},{\"event\":\"*\",\"target\":\"Closed\",\"guarded\":false,\"history\":false,\"meta\":[{\"key\":\"label\",\"value\":\"Anything else\"}]}],\"always\":[],\"after\":[{\"duration\":5000000000,\"target\":\"Closed\"}],\"done\":\"\",\"regions\":[]},{\"name\":\"Locked\",\"final\":true,\"tags\":[\"shut\"],\"meta\":[],\"on\":[],\"always\":[],\"after\":[],\"done\":\"\",\"regions\":[]}]}]}",
  )
  let mut capture = Capture { bytes: [0; 2048], length: 0 }
  let written = run Effect.result(Generate.write(&definition, "generate_tests"))
    |> Effect.provideMut<Writer>(&mut capture)
  match move written {
    Result<(), WriterError>.Success { .. } => {}
    Result<(), WriterError>.Failure { .. } => Intrinsic.trap("generated source")
  }
  if !holds(
    &capture,
    b"//! Generated from the definition of Door. Do not edit: change the definition and generate again.\n\nimport silk.machine.chart { Chart }\nimport generate_tests { Door, DoorContext, DoorEffect, DoorEvent, guardClosedOpen }\n\npub static fn doorChart() -> Chart<Door, DoorEvent, DoorContext, DoorEffect> {\n  return Chart<Door, DoorEvent, DoorContext, DoorEffect>.of()\n    |> Chart.initial(Door.Closed)\n    |> Chart.tag(\"Closed\", \"shut\")\n    |> Chart.meta(\"Closed\", \"label\", \"The door is \\\"closed\\\"\")\n    |> Chart.tag(\"Locked\", \"shut\")\n    |> Chart.onWhen(\"Closed\", \"Open\", Door.Opened, guardClosedOpen)\n    |> Chart.metaOn(\"Closed\", \"Open\", \"label\", \"With the key\")\n    |> Chart.on(\"Closed\", \"Lock\", Door.Locked)\n    |> Chart.on(\"Opened\", \"Close\", Door.Closed)\n    |> Chart.stay(\"Opened\", \"Lock\")\n    |> Chart.onAny(\"Opened\", Door.Closed)\n    |> Chart.metaOnAny(\"Opened\", \"label\", \"Anything else\")\n    |> Chart.after(\"Opened\", 5s, Door.Closed)\n    |> Chart.final(\"Locked\")\n}\n",
  ) {
    Intrinsic.trap("generated source text")
  }
  return ()
}

test effect fn generatedSourceMatchesTheFixture()
  ! OutOfMemoryError | SchemaError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run generateScenario() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn doorScenario() -> ()
  ! OutOfMemoryError | TransitionLoopError
  ? &mut Allocator {
  let mut door = run Steps.begin<Door, DoorEvent, DoorContext, DoorEffect>(
    DoorContext { key: 7 },
    0,
  )

  // The generated meta data of the state the door starts in.
  match Steps.meta(&door, "label") {
    Option.Some { value } => {
      if value != "The door is \"closed\"" {
        Intrinsic.trap("the label of a closed door")
      }
    }
    Option.None => Intrinsic.trap("a closed door has a label")
  }

  // The generated guard refuses the wrong key.
  if run Steps.send(&mut door, DoorEvent.Open { key: 1 }) {
    Intrinsic.trap("the wrong key opens nothing")
  }
  if !(run Steps.send(&mut door, DoorEvent.Open { key: 7 })) {
    Intrinsic.trap("the right key opens the door")
  }

  // The generated tags, forbidden transition and wildcard transition.
  match Steps.meta(&door, "label") {
    Option.Some { .. } => Intrinsic.trap("an open door has no label")
    Option.None => {}
  }
  if Steps.hasTag(&door, "shut") {
    Intrinsic.trap("an open door is not shut")
  }
  if !(run Steps.send(&mut door, DoorEvent.Lock)) {
    Intrinsic.trap("an open door takes Lock")
  }
  match &door.value {
    Door.Opened => {}
    _ => Intrinsic.trap("an open door cannot be locked")
  }
  drop run Steps.send(&mut door, DoorEvent.Open { key: 7 })
  match &door.value {
    Door.Closed => {}
    _ => Intrinsic.trap("any other event closes an open door")
  }
  if !Steps.hasTag(&door, "shut") {
    Intrinsic.trap("a closed door is shut")
  }
  drop run Steps.send(&mut door, DoorEvent.Open { key: 7 })

  // The generated delayed transition closes the door again.
  if !(run Steps.advance(&mut door, 5s)) {
    Intrinsic.trap("the door closes after five seconds")
  }
  match &door.value {
    Door.Closed => {}
    _ => Intrinsic.trap("expected Closed")
  }
  return ()
}

test effect fn generatedChartRuns()
  ! OutOfMemoryError | TransitionLoopError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run doorScenario() |> Effect.provideMut<Allocator>(&mut allocator)
}
