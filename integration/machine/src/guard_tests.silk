import silk.machine.chart { Chart, Enqueue, Guards, Machine, Next }
import silk.machine.snapshot { Steps, TransitionLoopError }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }

// A turnstile. A visitor enters with a ticket or a pass, unless the gate is locked. A full
// hall closes the gate by itself.

union Gate {
  Waiting,
  Open,
  Full,
}

union GateEvent {
  Visitor { pub ticket: bool, pub pass: bool },
  Passed,
  Lock,
  Unlock,
}

struct GateContext {
  pub locked: bool,
  pub inside: u32,
  pub staff: bool,
}

fn hasTicket(context: &GateContext, event: &GateEvent) -> bool {
  return match &event.* {
    GateEvent.Visitor { ticket, .. } => ticket
    _ => false
  }
}

fn hasPass(context: &GateContext, event: &GateEvent) -> bool {
  return match &event.* {
    GateEvent.Visitor { pass, .. } => pass
    _ => false
  }
}

fn isLocked(context: &GateContext, event: &GateEvent) -> bool {
  return context.locked
}

fn hallIsFull(context: &GateContext) -> bool {
  return context.inside >= 2
}

fn staffOnly(context: &GateContext) -> bool {
  return context.staff
}

impl Machine<GateEvent, GateContext, never> for Gate {
  static fn chart() -> Chart<Gate, GateEvent, GateContext, never> {
    return Chart<Gate, GateEvent, GateContext, never>.of()
      |> Chart.initial(Gate.Waiting)
      |> Chart.onWhen(
        "Waiting",
        "Visitor",
        Gate.Open,
        Guards.and(
          Guards.or(Guards.of(hasTicket), Guards.of(hasPass)),
          Guards.not(Guards.of(isLocked)),
        ),
      )
      |> Chart.on("Open", "Passed", Gate.Waiting)
      |> Chart.alwaysWhen(
        "Waiting",
        Gate.Full,
        Guards.and(Guards.of(hallIsFull), Guards.not(Guards.of(staffOnly))),
      )
  }

  effect fn handle(
    state: &Gate,
    context: &mut GateContext,
    event: &GateEvent,
    enq: &mut Enqueue<GateEvent, never>,
  ) -> Next<Gate>
    ! OutOfMemoryError
    ? &mut Allocator {
    match &event.* {
      GateEvent.Lock => {
        context.locked = true
        return Next<Gate>.Stay
      }
      GateEvent.Unlock => {
        context.locked = false
        return Next<Gate>.Stay
      }
      GateEvent.Passed => {
        context.inside = context.inside + 1
      }
      _ => {}
    }
    return Next<Gate>.Pass
  }
}

effect fn gateScenario() -> ()
  ! OutOfMemoryError | TransitionLoopError
  ? &mut Allocator {
  let mut gate = run Steps.begin<Gate, GateEvent, GateContext, never>(
    GateContext { locked: false, inside: 0, staff: false },
    0,
  )

  // Neither a ticket nor a pass: `or` fails, so the event is not taken.
  if run Steps.send(&mut gate, GateEvent.Visitor { ticket: false, pass: false }) {
    Intrinsic.trap("a visitor with nothing does not enter")
  }

  // A pass is enough for `or`, but `not` refuses while the gate is locked.
  drop run Steps.send(&mut gate, GateEvent.Lock)
  if run Steps.send(&mut gate, GateEvent.Visitor { ticket: false, pass: true }) {
    Intrinsic.trap("a locked gate lets nobody in")
  }
  drop run Steps.send(&mut gate, GateEvent.Unlock)
  if !run Steps.send(&mut gate, GateEvent.Visitor { ticket: false, pass: true }) {
    Intrinsic.trap("a pass opens an unlocked gate")
  }
  match &gate.value {
    Gate.Open => {}
    _ => Intrinsic.trap("expected Open")
  }
  drop run Steps.send(&mut gate, GateEvent.Passed)
  match &gate.value {
    Gate.Waiting => {}
    _ => Intrinsic.trap("expected Waiting with one visitor inside")
  }

  // The second visitor fills the hall: the eventless transition closes the gate.
  drop run Steps.send(&mut gate, GateEvent.Visitor { ticket: true, pass: false })
  drop run Steps.send(&mut gate, GateEvent.Passed)
  match &gate.value {
    Gate.Full => {}
    _ => Intrinsic.trap("expected Full")
  }

  // With staff inside, the same count does not close the gate.
  let mut staffed = run Steps.begin<Gate, GateEvent, GateContext, never>(
    GateContext { locked: false, inside: 5, staff: true },
    0,
  )
  match &staffed.value {
    Gate.Waiting => {}
    _ => Intrinsic.trap("expected Waiting for staff")
  }
  return ()
}

test effect fn guardsCombine()
  ! OutOfMemoryError | TransitionLoopError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run gateScenario() |> Effect.provideMut<Allocator>(&mut allocator)
}
