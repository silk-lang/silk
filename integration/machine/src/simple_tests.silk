//! The short form of a machine with states and events only.
import silk.machine.chart { Chart }
import silk.machine.simple { Simple, SimpleChart, SimpleMachine }
import silk.machine.snapshot { TransitionLoopError }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }

union Lamp {
  Off,
  On
}

union LampEvent {
  Toggle,
}

impl SimpleMachine<LampEvent> for Lamp {
  static fn chart() -> SimpleChart<Lamp, LampEvent> {
    return Simple.chart<Lamp, LampEvent>()
      |> Chart.initial(Lamp.Off)
      |> Chart.on("Off", "Toggle", Lamp.On)
      |> Chart.on("On", "Toggle", Lamp.Off)
      |> Chart.after("On", 1m, Lamp.Off)
  }
}

effect fn lampScenario() -> ()
  ! OutOfMemoryError | TransitionLoopError
  ? &mut Allocator {
  let mut lamp = run Simple.begin<Lamp, LampEvent>(0)
  if !(run Simple.send(&mut lamp, LampEvent.Toggle)) {
    Intrinsic.trap("Toggle is handled")
  }
  match &lamp.value {
    Lamp.On => {}
    _ => Intrinsic.trap("expected On")
  }
  if !(run Simple.advance(&mut lamp, 1m)) {
    Intrinsic.trap("the lamp goes off after a minute")
  }
  match &lamp.value {
    Lamp.Off => {}
    _ => Intrinsic.trap("expected Off")
  }
  return ()
}

test effect fn simpleMachineRuns()
  ! OutOfMemoryError | TransitionLoopError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run lampScenario() |> Effect.provideMut<Allocator>(&mut allocator)
}
