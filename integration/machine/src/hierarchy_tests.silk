//! Compound and parallel states.
import silk.machine.chart { Chart, Enqueue, Machine, Machines, Next }
import silk.machine.definition { Definitions }
import silk.machine.generate { Generate }
import generated_editor { boldChart, editorChart, italicChart }
import silk.machine.xstate { Xstate }
import silk.machine.snapshot { Snapshot, Steps, TransitionLoopError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.issue { SchemaError }
import silk.schema.json { SchemaJson }
import silk.schema.schema { Schema }

// A compound state with a guard, a transition function, state data and entry and exit functions.

union Light {
  Green,
  Yellow,
  Red { pub walk: Walk },
}

union Walk {
  Walking,
  Waiting,
  Stopped
}

union LightEvent {
  Timer,
  Countdown { pub seconds: u32 },
}

struct LightContext {
  pub cycles: u32,
  pub trace: u32,
}

union LightEffect {
  Beep { pub times: u32 },
}

fn enoughCycles(context: &LightContext, event: &LightEvent) -> bool {
  return context.cycles < 2
}

impl Machine<LightEvent, LightContext, LightEffect> for Light {
  static fn chart() -> Chart<Light, LightEvent, LightContext, LightEffect> {
    return Chart<Light, LightEvent, LightContext, LightEffect>.of()
      |> Chart.initial(Light.Green)
      |> Chart.region("walk")
      |> Chart.on("Green", "Timer", Light.Yellow)
      |> Chart.on("Yellow", "Timer", Light.Red { walk: Walk.Walking })
      |> Chart.onWhen("Red", "Timer", Light.Green, enoughCycles)
  }

  effect fn enter(
    state: &Light,
    context: &mut LightContext,
    enq: &mut Enqueue<LightEvent, LightEffect>,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    match &state.* {
      Light.Green => {
        context.cycles = context.cycles + 1
      }
      Light.Red { .. } => {
        context.trace = context.trace * 10 + 1
      }
      _ => {}
    }
    return ()
  }

  effect fn exit(
    state: &Light,
    context: &mut LightContext,
    enq: &mut Enqueue<LightEvent, LightEffect>,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    match &state.* {
      Light.Red { .. } => {
        context.trace = context.trace * 10 + 4
      }
      _ => {}
    }
    return ()
  }
}

impl Machine<LightEvent, LightContext, LightEffect> for Walk {
  static fn chart() -> Chart<Walk, LightEvent, LightContext, LightEffect> {
    return Chart<Walk, LightEvent, LightContext, LightEffect>.of()
      |> Chart.initial(Walk.Walking)
      |> Chart.meta("Walking", "sign", "walk")
      |> Chart.on("Waiting", "Timer", Walk.Stopped)
  }

  effect fn handle(
    state: &Walk,
    context: &mut LightContext,
    event: &LightEvent,
    enq: &mut Enqueue<LightEvent, LightEffect>,
  ) -> Next<Walk>
    ! OutOfMemoryError
    ? &mut Allocator {
    match &state.* {
      Walk.Walking => {
        match &event.* {
          LightEvent.Countdown { seconds } => {
            run enq.perform(LightEffect.Beep { times: seconds })
            return Next<Walk>.To { state: Walk.Waiting }
          }
          _ => {}
        }
      }
      _ => {}
    }
    return Next<Walk>.Pass
  }

  effect fn enter(
    state: &Walk,
    context: &mut LightContext,
    enq: &mut Enqueue<LightEvent, LightEffect>,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    context.trace = context.trace * 10 + 2
    return ()
  }

  effect fn exit(
    state: &Walk,
    context: &mut LightContext,
    enq: &mut Enqueue<LightEvent, LightEffect>,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    context.trace = context.trace * 10 + 3
    return ()
  }
}

effect fn sendLight(
  state: &mut Light,
  context: &mut LightContext,
  enq: &mut Enqueue<LightEvent, LightEffect>,
  event: LightEvent,
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  return run Machines.dispatch<Light, LightEvent, LightContext, LightEffect>(
    &mut state.*,
    &mut context.*,
    &event,
    &mut enq.*,
  )
}

effect fn lightScenario() -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut light = Machines.start<Light, LightEvent, LightContext, LightEffect>()
  let mut context = LightContext { cycles: 0, trace: 0 }
  let mut enq = Enqueue<LightEvent, LightEffect>.make()

  drop run sendLight(&mut light, &mut context, &mut enq, LightEvent.Timer)
  drop run sendLight(&mut light, &mut context, &mut enq, LightEvent.Timer)

  // Entering Red runs the parent's entry (1), then the child's (2).
  if context.trace != 12 {
    Intrinsic.trap("entry order: parent before child")
  }
  match &light {
    Light.Red { walk: Walk.Walking } => {}
    _ => Intrinsic.trap("expected Red with Walking")
  }

  // Red has no meta data of its own, so the meta data of its region answers.
  match Machines.meta<Light, LightEvent, LightContext, LightEffect>(&light, "sign") {
    Option.Some { value } => {
      if value != "walk" {
        Intrinsic.trap("the sign of Walking")
      }
    }
    Option.None => Intrinsic.trap("the region's meta data is found")
  }

  // The child handles Countdown: Walking exits (3), Waiting enters (2), Red stays.
  drop run sendLight(&mut light, &mut context, &mut enq, LightEvent.Countdown { seconds: 5 })
  if context.trace != 1232 {
    Intrinsic.trap("only the child changes")
  }
  if enq.effects.length() != 1 {
    Intrinsic.trap("one effect queued")
  }

  // The child handles Timer first: Waiting to Stopped. The parent does not see it.
  drop run sendLight(&mut light, &mut context, &mut enq, LightEvent.Timer)
  match &light {
    Light.Red { walk: Walk.Stopped } => {}
    _ => Intrinsic.trap("expected Red with Stopped")
  }

  // Now the child passes, the parent's guarded edge is taken: child exits (3) before parent (4).
  context.trace = 0
  context.cycles = 1
  drop run sendLight(&mut light, &mut context, &mut enq, LightEvent.Timer)
  if context.trace != 34 {
    Intrinsic.trap("exit order: child before parent")
  }
  match &light {
    Light.Green => {}
    _ => Intrinsic.trap("expected Green")
  }
  return ()
}

test effect fn compoundStateOrder()
  ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run lightScenario() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A parallel state: two regions that are active together, in a snapshot. The transition tables
// are generated: `src/generated_editor.silk` holds the text that `Generate.write` returns for the
// definition of `Editor`.

pub union Editor {
  Closed,
  Open { pub bold: Bold, pub italic: Italic },
}

pub union Bold {
  Off,
  On
}

pub union Italic {
  Plain,
  Slanted
}

pub union EditorEvent {
  OpenFile,
  ToggleBold,
  ToggleItalic,
  Reset,
  Close,
}

pub struct EditorContext {
  pub changes: u32,
}

pub union EditorEffect {
  Nothing,
}

impl Schema for Editor {}

impl Schema for Bold {}

impl Schema for Italic {}

impl Schema for EditorEvent {}

impl Schema for EditorContext {}

impl Schema for EditorEffect {}

impl Machine<EditorEvent, EditorContext, EditorEffect> for Editor {
  static fn chart() -> Chart<Editor, EditorEvent, EditorContext, EditorEffect> {
    return editorChart()
  }
}

impl Machine<EditorEvent, EditorContext, EditorEffect> for Bold {
  static fn chart() -> Chart<Bold, EditorEvent, EditorContext, EditorEffect> {
    return boldChart()
  }

  effect fn enter(
    state: &Bold,
    context: &mut EditorContext,
    enq: &mut Enqueue<EditorEvent, EditorEffect>,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    context.changes = context.changes + 1
    return ()
  }
}

impl Machine<EditorEvent, EditorContext, EditorEffect> for Italic {
  static fn chart() -> Chart<Italic, EditorEvent, EditorContext, EditorEffect> {
    return italicChart()
  }
}

type EditorSnapshot = Snapshot<Editor, EditorEvent, EditorContext, EditorEffect>

struct Capture {
  bytes: [u8; 4096],
  length: usize,
}

impl Writer for Capture {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> ()
    ! WriterError
    ? &mut Writer {
    let mut index: usize = 0
    while index < value.length {
      self.bytes[self.length] = value[index]
      self.length = self.length + 1
      index = index + 1
    }
    return ()
  }

  effect fn flush(self: &mut Self) -> ()
    ! WriterError
    ? &mut Writer {
    return ()
  }
}

fn holds(capture: &Capture, expected: &[u8]) -> bool {
  if capture.length != expected.length {
    return false
  }
  let mut index: usize = 0
  while index < expected.length {
    if capture.bytes[index] != expected[index] {
      return false
    }
    index = index + 1
  }
  return true
}

effect fn encodesEditor(snapshot: &EditorSnapshot, expected: &[u8]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut capture = Capture { bytes: [0; 4096], length: 0 }
  let encoded = run Effect.result(SchemaJson.encode<EditorSnapshot>(snapshot))
    |> Effect.provideMut<Writer>(&mut capture)
  return match move encoded {
    Result<(), SchemaError | WriterError | OutOfMemoryError>.Success { .. } => holds(
      &capture,
      expected,
    )
    Result<(), SchemaError | WriterError | OutOfMemoryError>.Failure { .. } => false
  }
}

effect fn editorScenario() -> ()
  ! OutOfMemoryError | TransitionLoopError | SchemaError
  ? &mut Allocator {
  let mut editor = run Steps.begin<Editor, EditorEvent, EditorContext, EditorEffect>(
    EditorContext { changes: 0 },
    1s,
  )

  // Entering Open enters both regions at their initial states.
  drop run Steps.send(&mut editor, EditorEvent.OpenFile)
  match &editor.value {
    Editor.Open { bold: Bold.Off, italic: Italic.Plain } => {}
    _ => Intrinsic.trap("expected Open with both regions at their initial states")
  }

  // Each region takes the events it knows, and the other one stays.
  drop run Steps.send(&mut editor, EditorEvent.ToggleBold)
  drop run Steps.send(&mut editor, EditorEvent.ToggleItalic)
  match &editor.value {
    Editor.Open { bold: Bold.On, italic: Italic.Slanted } => {}
    _ => Intrinsic.trap("expected bold and italic")
  }

  // The snapshot holds the regions and the timer of the region's delayed transition.
  if !(run encodesEditor(
    &editor,
    b"{\"version\":2,\"status\":\"Active\",\"value\":{\"type\":\"Open\",\"bold\":\"On\",\"italic\":\"Slanted\"},\"context\":{\"changes\":2},\"mailbox\":[],\"pending\":[],\"clock\":1000000000,\"timers\":[{\"path\":\"Editor.Open.bold\",\"index\":0,\"deadline\":1100000000}]}",
  )) {
    Intrinsic.trap("snapshot JSON of a parallel state")
  }

  // One event that both regions know moves both in one step, and cancels the region's timer.
  if !(run Steps.send(&mut editor, EditorEvent.Reset)) {
    Intrinsic.trap("Reset is handled")
  }
  match &editor.value {
    Editor.Open { bold: Bold.Off, italic: Italic.Plain } => {}
    _ => Intrinsic.trap("expected both regions reset")
  }
  if editor.timers.length() != 0 {
    Intrinsic.trap("leaving On cancels its timer")
  }

  // A restored snapshot continues inside the region: its overdue timer fires in the region.
  let mut restored = run SchemaJson.decode<EditorSnapshot>(
    b"{\"version\":2,\"status\":\"Active\",\"value\":{\"type\":\"Open\",\"bold\":\"On\",\"italic\":\"Slanted\"},\"context\":{\"changes\":2},\"mailbox\":[],\"pending\":[],\"clock\":1000000000,\"timers\":[{\"path\":\"Editor.Open.bold\",\"index\":0,\"deadline\":1100000000}]}",
  )
  if !(run Steps.advance(&mut restored, 5s)) {
    Intrinsic.trap("the region's timer fires")
  }
  match &restored.value {
    Editor.Open { bold: Bold.Off, italic: Italic.Slanted } => {}
    _ => Intrinsic.trap("expected bold off and italic kept")
  }

  // Leaving the parent leaves both regions, and cancels a region's timer.
  drop run Steps.send(&mut restored, EditorEvent.ToggleBold)
  drop run Steps.send(&mut restored, EditorEvent.Close)
  match &restored.value {
    Editor.Closed => {}
    _ => Intrinsic.trap("expected Closed")
  }
  if restored.timers.length() != 0 {
    Intrinsic.trap("leaving Open cancels the timers of its regions")
  }
  return ()
}

test effect fn parallelRegions()
  ! OutOfMemoryError | TransitionLoopError | SchemaError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run editorScenario() |> Effect.provideMut<Allocator>(&mut allocator)
}

// The machine with its regions as data: one definition with three charts, written as an xstate
// config with a parallel state and as Silk source.

effect fn editorDefinitionScenario() -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let definition = run Definitions.of<Editor, EditorEvent, EditorContext, EditorEffect>()
  if definition.charts.length() != 3 || Definitions.find(&definition, "Italic") != 2 {
    Intrinsic.trap("one chart for the machine and one per region")
  }
  let mut config = Capture { bytes: [0; 4096], length: 0 }
  let written = run Effect.result(Xstate.write(&definition))
    |> Effect.provideMut<Writer>(&mut config)
  match move written {
    Result<(), WriterError>.Success { .. } => {}
    Result<(), WriterError>.Failure { .. } => Intrinsic.trap("xstate config")
  }
  if !holds(
    &config,
    b"{\"id\":\"Editor\",\"initial\":\"Closed\",\"states\":{\"Closed\":{\"on\":{\"OpenFile\":[{\"target\":\"Open\"}]}},\"Open\":{\"type\":\"parallel\",\"states\":{\"bold\":{\"initial\":\"Off\",\"states\":{\"Off\":{\"on\":{\"ToggleBold\":[{\"target\":\"On\"}]}},\"On\":{\"on\":{\"ToggleBold\":[{\"target\":\"Off\"}],\"Reset\":[{\"target\":\"Off\"}]},\"after\":{\"100\":[{\"target\":\"Off\"}]}}}},\"italic\":{\"initial\":\"Plain\",\"states\":{\"Plain\":{\"on\":{\"ToggleItalic\":[{\"target\":\"Slanted\"}]}},\"Slanted\":{\"on\":{\"ToggleItalic\":[{\"target\":\"Plain\"}],\"Reset\":[{\"target\":\"Plain\"}]}}}}},\"on\":{\"Close\":[{\"target\":\"Closed\"}]}}}}",
  ) {
    Intrinsic.trap("xstate config of a parallel state")
  }
  let mut source = Capture { bytes: [0; 4096], length: 0 }
  let generated = run Effect.result(Generate.write(&definition, "hierarchy_tests"))
    |> Effect.provideMut<Writer>(&mut source)
  match move generated {
    Result<(), WriterError>.Success { .. } => {}
    Result<(), WriterError>.Failure { .. } => Intrinsic.trap("generated source")
  }
  if !holds(
    &source,
    b"//! Generated from the definition of Editor. Do not edit: change the definition and generate again.\n\nimport silk.machine.chart { Chart }\nimport hierarchy_tests { Editor, EditorContext, EditorEffect, EditorEvent, Bold, Italic }\n\npub static fn editorChart() -> Chart<Editor, EditorEvent, EditorContext, EditorEffect> {\n  return Chart<Editor, EditorEvent, EditorContext, EditorEffect>.of()\n    |> Chart.initial(Editor.Closed)\n    |> Chart.region(\"bold\")\n    |> Chart.region(\"italic\")\n    |> Chart.on(\"Closed\", \"OpenFile\", Editor.Open { bold: Bold.Off, italic: Italic.Plain })\n    |> Chart.on(\"Open\", \"Close\", Editor.Closed)\n}\n\npub static fn boldChart() -> Chart<Bold, EditorEvent, EditorContext, EditorEffect> {\n  return Chart<Bold, EditorEvent, EditorContext, EditorEffect>.of()\n    |> Chart.initial(Bold.Off)\n    |> Chart.on(\"Off\", \"ToggleBold\", Bold.On)\n    |> Chart.on(\"On\", \"ToggleBold\", Bold.Off)\n    |> Chart.on(\"On\", \"Reset\", Bold.Off)\n    |> Chart.after(\"On\", 100ms, Bold.Off)\n}\n\npub static fn italicChart() -> Chart<Italic, EditorEvent, EditorContext, EditorEffect> {\n  return Chart<Italic, EditorEvent, EditorContext, EditorEffect>.of()\n    |> Chart.initial(Italic.Plain)\n    |> Chart.on(\"Plain\", \"ToggleItalic\", Italic.Slanted)\n    |> Chart.on(\"Slanted\", \"ToggleItalic\", Italic.Plain)\n    |> Chart.on(\"Slanted\", \"Reset\", Italic.Plain)\n}\n",
  ) {
    Intrinsic.trap("generated source of a machine with regions")
  }
  return ()
}

test effect fn regionsAsData()
  ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run editorDefinitionScenario() |> Effect.provideMut<Allocator>(&mut allocator)
}
