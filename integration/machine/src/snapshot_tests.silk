import silk.machine.chart { Chart, Enqueue, Machine, Next }
import silk.machine.definition { Definition, Definitions }
import silk.machine.snapshot { Snapshot, Status, Steps, TransitionLoopError }
import silk.machine.xstate { Xstate, XstateError }
import silk.json.scanner { JsonError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.issue { SchemaError }
import silk.schema.json { SchemaJson }
import silk.schema.schema { Schema }

struct Capture {
  bytes: [u8; 1024],
  length: usize,
}

impl Writer for Capture {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> ()
    ! WriterError
    ? &mut Writer {
    let mut index: usize = 0
    while index < value.length {
      self.bytes[self.length] = value[index]
      self.length = self.length + 1
      index = index + 1
    }
    return ()
  }

  effect fn flush(self: &mut Self) -> ()
    ! WriterError
    ? &mut Writer {
    return ()
  }
}

fn holds(capture: &Capture, expected: &[u8]) -> bool {
  if capture.length != expected.length {
    return false
  }
  let mut index: usize = 0
  while index < expected.length {
    if capture.bytes[index] != expected[index] {
      return false
    }
    index = index + 1
  }
  return true
}

// An order: a counter in the context, a raised event, an eventless transition and a final state.

union Order {
  Open,
  Checking,
  Rejected,
  Paid
}

union OrderEvent {
  Add { pub amount: u32 },
  Checkout,
  Approved,
}

struct OrderContext {
  pub total: u32,
}

union OrderEffect {
  Charge { pub amount: u32 },
}

impl Schema for Order {}

impl Schema for OrderEvent {}

impl Schema for OrderContext {}

impl Schema for OrderEffect {}

fn tooLarge(context: &OrderContext) -> bool {
  return context.total > 100
}

impl Machine<OrderEvent, OrderContext, OrderEffect> for Order {
  static fn chart() -> Chart<Order, OrderEvent, OrderContext, OrderEffect> {
    return Chart<Order, OrderEvent, OrderContext, OrderEffect>.of()
      |> Chart.initial(Order.Open)
      |> Chart.on("Open", "Checkout", Order.Checking)
      |> Chart.alwaysWhen("Checking", Order.Rejected, tooLarge)
      |> Chart.on("Checking", "Approved", Order.Paid)
      |> Chart.on("Rejected", "Add", Order.Open)
      |> Chart.final("Paid")
  }

  effect fn handle(
    state: &Order,
    context: &mut OrderContext,
    event: &OrderEvent,
    enq: &mut Enqueue<OrderEvent, OrderEffect>,
  ) -> Next<Order>
    ! OutOfMemoryError
    ? &mut Allocator {
    match &state.* {
      Order.Open => {
        match &event.* {
          OrderEvent.Add { amount } => {
            context.total = context.total + amount
            return Next<Order>.Stay
          }
          _ => {}
        }
      }
      _ => {}
    }
    return Next<Order>.Pass
  }

  effect fn enter(
    state: &Order,
    context: &mut OrderContext,
    enq: &mut Enqueue<OrderEvent, OrderEffect>,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    match &state.* {
      // A small order approves itself: the raised event is processed in the same step.
      Order.Checking => {
        if context.total <= 50 {
          run enq.raise(OrderEvent.Approved)
        }
      }
      Order.Paid => {
        run enq.perform(OrderEffect.Charge { amount: context.total })
      }
      _ => {}
    }
    return ()
  }
}

type OrderSnapshot = Snapshot<Order, OrderEvent, OrderContext, OrderEffect>

effect fn encodes(snapshot: &OrderSnapshot, expected: &[u8]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut capture = Capture { bytes: [0; 1024], length: 0 }
  let encoded = run Effect.result(SchemaJson.encode<OrderSnapshot>(snapshot))
    |> Effect.provideMut<Writer>(&mut capture)
  return match move encoded {
    Result<(), SchemaError | WriterError | OutOfMemoryError>.Success { .. } => holds(
      &capture,
      expected,
    )
    Result<(), SchemaError | WriterError | OutOfMemoryError>.Failure { .. } => false
  }
}

effect fn orderScenario() -> ()
  ! OutOfMemoryError | TransitionLoopError | SchemaError
  ? &mut Allocator {
  let mut order = run Steps.begin<Order, OrderEvent, OrderContext, OrderEffect>(
    OrderContext { total: 0 },
    0,
  )

  // A large order is rejected by the eventless transition, in the same step as Checkout.
  drop run Steps.send(&mut order, OrderEvent.Add { amount: 120 })
  drop run Steps.send(&mut order, OrderEvent.Checkout)
  match &order.value {
    Order.Rejected => {}
    _ => Intrinsic.trap("expected Rejected")
  }
  if !run encodes(
    &order,
    b"{\"version\":2,\"status\":\"Active\",\"value\":\"Rejected\",\"context\":{\"total\":120},\"mailbox\":[],\"pending\":[],\"clock\":0,\"timers\":[]}",
  ) {
    Intrinsic.trap("snapshot JSON")
  }

  // A snapshot read back continues where the first one stopped.
  let mut restored = run SchemaJson.decode<OrderSnapshot>(
    b"{\"version\":2,\"status\":\"Active\",\"value\":\"Open\",\"context\":{\"total\":40},\"mailbox\":[],\"pending\":[],\"clock\":0,\"timers\":[]}",
  )
  drop run Steps.send(&mut restored, OrderEvent.Checkout)
  match &restored.value {
    Order.Paid => {}
    _ => Intrinsic.trap("expected Paid")
  }
  match &restored.status {
    Status.Done => {}
    _ => Intrinsic.trap("expected Done")
  }
  if !run encodes(
    &restored,
    b"{\"version\":2,\"status\":\"Done\",\"value\":\"Paid\",\"context\":{\"total\":40},\"mailbox\":[],\"pending\":[{\"type\":\"Charge\",\"amount\":40}],\"clock\":0,\"timers\":[]}",
  ) {
    Intrinsic.trap("snapshot JSON with a pending effect")
  }

  // A finished machine takes no more events.
  if run Steps.send(&mut restored, OrderEvent.Checkout) {
    Intrinsic.trap("Done takes no events")
  }
  return ()
}

test effect fn snapshotRoundTrip()
  ! OutOfMemoryError | TransitionLoopError | SchemaError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run orderScenario() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A traffic light: delayed transitions, their timers in the snapshot, and a restore.

union Light {
  Green,
  Yellow,
  Red,
  Off
}

union LightEvent {
  Reset,
  Stop,
}

struct NoContext {}

union NoEffect {
  Nothing,
}

impl Schema for Light {}

impl Schema for LightEvent {}

impl Schema for NoContext {}

impl Schema for NoEffect {}

impl Machine<LightEvent, NoContext, NoEffect> for Light {
  static fn chart() -> Chart<Light, LightEvent, NoContext, NoEffect> {
    return Chart<Light, LightEvent, NoContext, NoEffect>.of()
      |> Chart.initial(Light.Green)
      |> Chart.after("Green", 3s, Light.Yellow)
      |> Chart.after("Yellow", 500ms, Light.Red)
      |> Chart.on("Red", "Reset", Light.Green)
      |> Chart.on("Green", "Stop", Light.Off)
      |> Chart.metaOn("Green", "Stop", "label", "Emergency stop")
      |> Chart.final("Off")
  }
}

type LightSnapshot = Snapshot<Light, LightEvent, NoContext, NoEffect>

fn isGreen(light: &LightSnapshot) -> bool {
  return match &light.value {
    Light.Green => true
    _ => false
  }
}

fn isYellow(light: &LightSnapshot) -> bool {
  return match &light.value {
    Light.Yellow => true
    _ => false
  }
}

fn isRed(light: &LightSnapshot) -> bool {
  return match &light.value {
    Light.Red => true
    _ => false
  }
}

fn deadlineIs(light: &LightSnapshot, expected: u64) -> bool {
  return match Steps.nextDeadline(light) {
    Option<u64>.Some { value } => value == expected
    Option<u64>.None => false
  }
}

effect fn lightScenario() -> ()
  ! OutOfMemoryError | TransitionLoopError | SchemaError
  ? &mut Allocator {
  let mut light = run Steps.begin<Light, LightEvent, NoContext, NoEffect>(NoContext {}, 1s)
  if !deadlineIs(&light, 4s) {
    Intrinsic.trap("Green starts a timer for 4s")
  }
  if run Steps.advance(&mut light, 3s999ms) {
    Intrinsic.trap("nothing is due at 3s999ms")
  }
  if !(run Steps.advance(&mut light, 4s)) || !isYellow(&light) || !deadlineIs(&light, 4s500ms) {
    Intrinsic.trap("expected Yellow with a timer for 4s500ms")
  }
  if !run encodesLight(
    &light,
    b"{\"version\":2,\"status\":\"Active\",\"value\":\"Yellow\",\"context\":{},\"mailbox\":[],\"pending\":[],\"clock\":4000000000,\"timers\":[{\"path\":\"Light\",\"index\":1,\"deadline\":4500000000}]}",
  ) {
    Intrinsic.trap("snapshot JSON with a timer")
  }
  if !(run Steps.advance(&mut light, 10s)) || !isRed(&light) || light.timers.length() != 0 {
    Intrinsic.trap("expected Red without timers")
  }

  // A timer counts from the step that entered its state.
  drop run Steps.send(&mut light, LightEvent.Reset)
  if !isGreen(&light) || !deadlineIs(&light, 13s) {
    Intrinsic.trap("expected Green with a timer for 13s")
  }

  // A late clock fires the due timer. The timer of the state it enters starts from the new time.
  if !(run Steps.advance(&mut light, 20s)) || !isYellow(&light) || !deadlineIs(&light, 20s500ms) {
    Intrinsic.trap("expected Yellow with a timer for 20s500ms")
  }

  // A restored timer keeps its deadline, so one that passed while stopped fires at once.
  let mut restored = run SchemaJson.decode<LightSnapshot>(
    b"{\"version\":2,\"status\":\"Active\",\"value\":\"Green\",\"context\":{},\"mailbox\":[],\"pending\":[],\"clock\":1000000000,\"timers\":[{\"path\":\"Light\",\"index\":0,\"deadline\":4000000000}]}",
  )
  if !(run Steps.advance(&mut restored, 1m30s)) || !isYellow(&restored) {
    Intrinsic.trap("expected the restored timer to fire")
  }

  // Leaving a state cancels its timer, and a finished machine has none.
  let mut stopped = run Steps.begin<Light, LightEvent, NoContext, NoEffect>(NoContext {}, 0)
  drop run Steps.send(&mut stopped, LightEvent.Stop)
  if stopped.timers.length() != 0 || (run Steps.advance(&mut stopped, 5s)) {
    Intrinsic.trap("expected no timers after Stop")
  }
  return ()
}

effect fn encodesLight(snapshot: &LightSnapshot, expected: &[u8]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut capture = Capture { bytes: [0; 1024], length: 0 }
  let encoded = run Effect.result(SchemaJson.encode<LightSnapshot>(snapshot))
    |> Effect.provideMut<Writer>(&mut capture)
  return match move encoded {
    Result<(), SchemaError | WriterError | OutOfMemoryError>.Success { .. } => holds(
      &capture,
      expected,
    )
    Result<(), SchemaError | WriterError | OutOfMemoryError>.Failure { .. } => false
  }
}

test effect fn delayedTransitions()
  ! OutOfMemoryError | TransitionLoopError | SchemaError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run lightScenario() |> Effect.provideMut<Allocator>(&mut allocator)
}

// The chart of the traffic light as data, written to JSON and read back.

effect fn definitionScenario() -> ()
  ! OutOfMemoryError | SchemaError
  ? &mut Allocator {
  let definition = run Definitions.of<Light, LightEvent, NoContext, NoEffect>()
  let mut capture = Capture { bytes: [0; 1024], length: 0 }
  let encoded = run Effect.result(SchemaJson.encode<Definition>(&definition))
    |> Effect.provideMut<Writer>(&mut capture)
  match move encoded {
    Result<(), SchemaError | WriterError | OutOfMemoryError>.Success { .. } => {}
    Result<(), SchemaError | WriterError | OutOfMemoryError>.Failure { .. } => Intrinsic.trap(
      "definition JSON",
    )
  }
  if !holds(
    &capture,
    b"{\"name\":\"Light\",\"charts\":[{\"name\":\"Light\",\"initial\":\"Green\",\"states\":[{\"name\":\"Green\",\"final\":false,\"tags\":[],\"meta\":[],\"on\":[{\"event\":\"Stop\",\"target\":\"Off\",\"guarded\":false,\"history\":false,\"meta\":[{\"key\":\"label\",\"value\":\"Emergency stop\"}]}],\"always\":[],\"after\":[{\"duration\":3000000000,\"target\":\"Yellow\"}],\"done\":\"\",\"regions\":[]},{\"name\":\"Yellow\",\"final\":false,\"tags\":[],\"meta\":[],\"on\":[],\"always\":[],\"after\":[{\"duration\":500000000,\"target\":\"Red\"}],\"done\":\"\",\"regions\":[]},{\"name\":\"Red\",\"final\":false,\"tags\":[],\"meta\":[],\"on\":[{\"event\":\"Reset\",\"target\":\"Green\",\"guarded\":false,\"history\":false,\"meta\":[]}],\"always\":[],\"after\":[],\"done\":\"\",\"regions\":[]},{\"name\":\"Off\",\"final\":true,\"tags\":[],\"meta\":[],\"on\":[],\"always\":[],\"after\":[],\"done\":\"\",\"regions\":[]}]}]}",
  ) {
    Intrinsic.trap("definition JSON text")
  }
  let decoded = run SchemaJson.decode<Definition>(
    b"{\"name\":\"Door\",\"charts\":[{\"name\":\"Door\",\"initial\":\"Closed\",\"states\":[{\"name\":\"Closed\",\"final\":false,\"tags\":[],\"meta\":[],\"on\":[{\"event\":\"Open\",\"target\":\"Opened\",\"guarded\":true,\"history\":false,\"meta\":[]}],\"always\":[],\"after\":[],\"done\":\"\",\"regions\":[]},{\"name\":\"Opened\",\"final\":true,\"tags\":[],\"meta\":[],\"on\":[],\"always\":[],\"after\":[],\"done\":\"\",\"regions\":[]}]}]}",
  )
  if decoded.charts.length() != 1 || decoded.charts.asSlice()[0].initial.view() != "Closed" {
    Intrinsic.trap("decoded definition")
  }
  return ()
}

test effect fn definitionRoundTrip()
  ! OutOfMemoryError | SchemaError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run definitionScenario() |> Effect.provideMut<Allocator>(&mut allocator)
}

// The same charts in the JSON that xstate tools read.

effect fn xstateText<S: Machine<E, C, X>, E, C, X>(expected: &[u8]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let definition = run Definitions.of<S, E, C, X>()
  let mut capture = Capture { bytes: [0; 1024], length: 0 }
  let written = run Effect.result(Xstate.write(&definition))
    |> Effect.provideMut<Writer>(&mut capture)
  return match move written {
    Result<(), WriterError>.Success { .. } => holds(&capture, expected)
    Result<(), WriterError>.Failure { .. } => false
  }
}

test effect fn xstateConfig()
  ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  if !(run xstateText<Light, LightEvent, NoContext, NoEffect>(
    b"{\"id\":\"Light\",\"initial\":\"Green\",\"states\":{\"Green\":{\"on\":{\"Stop\":[{\"target\":\"Off\",\"meta\":{\"label\":\"Emergency stop\"}}]},\"after\":{\"3000\":[{\"target\":\"Yellow\"}]}},\"Yellow\":{\"after\":{\"500\":[{\"target\":\"Red\"}]}},\"Red\":{\"on\":{\"Reset\":[{\"target\":\"Green\"}]}},\"Off\":{\"type\":\"final\"}}}",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)) {
    Intrinsic.trap("xstate config of Light")
  }
  if !(run xstateText<Order, OrderEvent, OrderContext, OrderEffect>(
    b"{\"id\":\"Order\",\"initial\":\"Open\",\"states\":{\"Open\":{\"on\":{\"Checkout\":[{\"target\":\"Checking\"}]}},\"Checking\":{\"on\":{\"Approved\":[{\"target\":\"Paid\"}]},\"always\":[{\"target\":\"Rejected\",\"guard\":\"Checking.always\"}]},\"Rejected\":{\"on\":{\"Add\":[{\"target\":\"Open\"}]}},\"Paid\":{\"type\":\"final\"}}}",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)) {
    Intrinsic.trap("xstate config of Order")
  }
  return ()
}

// An xstate config in the forms that xstate tools write, read as a definition and written back
// in the one form this library writes.

effect fn readsXstate(source: &[u8], expected: &[u8]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let read = run Effect.result(Xstate.read(source))
  return match move read {
    Result<Definition, JsonError | OutOfMemoryError | XstateError>.Success { value } => {
      let mut capture = Capture { bytes: [0; 1024], length: 0 }
      let written = run Effect.result(Xstate.write(&value))
        |> Effect.provideMut<Writer>(&mut capture)
      match move written {
        Result<(), WriterError>.Success { .. } => holds(&capture, expected)
        Result<(), WriterError>.Failure { .. } => false
      }
    }
    Result<Definition, JsonError | OutOfMemoryError | XstateError>.Failure { .. } => false
  }
}

effect fn refusesXstate(source: &[u8]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let read = run Effect.result(Xstate.read(source))
  return match move read {
    Result<Definition, JsonError | OutOfMemoryError | XstateError>.Success { .. } => false
    Result<Definition, JsonError | OutOfMemoryError | XstateError>.Failure { .. } => true
  }
}

effect fn xstateReadScenario() -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if !(run readsXstate(
    b"{\"id\":\"Door\",\"context\":{\"key\":7},\"initial\":\"Closed\",\"states\":{\"Closed\":{\"on\":{\"Open\":[{\"target\":\"Opened\",\"guard\":\"hasKey\"},{\"target\":\"Closed\"}],\"Lock\":\"Locked\",\"Ring\":{\"actions\":\"ring\"}}},\"Opened\":{\"entry\":\"light\",\"on\":{\"Close\":{\"target\":\"Closed\"}},\"after\":{\"5000\":\"Closed\"},\"always\":{\"target\":\"Locked\",\"guard\":{\"type\":\"broken\"}}},\"Locked\":{\"type\":\"final\"}}}",
    b"{\"id\":\"Door\",\"initial\":\"Closed\",\"states\":{\"Closed\":{\"on\":{\"Open\":[{\"target\":\"Opened\",\"guard\":\"Closed.Open\"},{\"target\":\"Closed\"}],\"Lock\":[{\"target\":\"Locked\"}],\"Ring\":[{}]}},\"Opened\":{\"on\":{\"Close\":[{\"target\":\"Closed\"}]},\"always\":[{\"target\":\"Locked\",\"guard\":\"Opened.always\"}],\"after\":{\"5000\":[{\"target\":\"Closed\"}]}},\"Locked\":{\"type\":\"final\"}}}",
  )) {
    Intrinsic.trap("an xstate config read and written back")
  }

  // What this library writes reads back to the same text.
  let light = b"{\"id\":\"Light\",\"initial\":\"Green\",\"states\":{\"Green\":{\"on\":{\"Stop\":[{\"target\":\"Off\",\"meta\":{\"label\":\"Emergency stop\"}}]},\"after\":{\"3000\":[{\"target\":\"Yellow\"}]}},\"Yellow\":{\"after\":{\"500\":[{\"target\":\"Red\"}]}},\"Red\":{\"on\":{\"Reset\":[{\"target\":\"Green\"}]}},\"Off\":{\"type\":\"final\"}}}"
  if !(run readsXstate(light, light)) {
    Intrinsic.trap("the written config reads back")
  }
  if !(run refusesXstate(b"{\"id\":\"A\",\"states\":{}}")) {
    Intrinsic.trap("a config without an initial state is refused")
  }

  // A compound state is read as a state with one region, a parallel state as a state with one
  // region per child, and both are written back in xstate's nesting.
  let nested = b"{\"id\":\"Player\",\"initial\":\"Stopped\",\"states\":{\"Stopped\":{\"on\":{\"Play\":[{\"target\":\"Playing\"}]}},\"Playing\":{\"initial\":\"Normal\",\"states\":{\"Normal\":{\"on\":{\"Fast\":[{\"target\":\"Double\"}]}},\"Double\":{}},\"on\":{\"Stop\":[{\"target\":\"Stopped\"}],\"Edit\":[{\"target\":\"Editing\"}]}},\"Editing\":{\"type\":\"parallel\",\"states\":{\"bold\":{\"initial\":\"Off\",\"states\":{\"Off\":{\"on\":{\"Toggle\":[{\"target\":\"On\"}]}},\"On\":{}}},\"italic\":{\"initial\":\"Plain\",\"states\":{\"Plain\":{}}}}}}}"
  if !(run readsXstate(
    b"{\"id\":\"Player\",\"initial\":\"Stopped\",\"states\":{\"Stopped\":{\"on\":{\"Play\":\"Playing\"}},\"Playing\":{\"initial\":\"Normal\",\"states\":{\"Normal\":{\"on\":{\"Fast\":\"Double\"}},\"Double\":{}},\"on\":{\"Stop\":\"Stopped\",\"Edit\":\"Editing\"}},\"Editing\":{\"type\":\"parallel\",\"states\":{\"bold\":{\"initial\":\"Off\",\"states\":{\"Off\":{\"on\":{\"Toggle\":\"On\"}},\"On\":{}}},\"italic\":{\"initial\":\"Plain\",\"states\":{\"Plain\":{}}}}}}}",
    nested,
  )) {
    Intrinsic.trap("nested states read and written back")
  }
  if !(run readsXstate(nested, nested)) {
    Intrinsic.trap("the written nested config reads back")
  }

  // Tags, the transition that any event takes, and a transition without a target.
  if !(run readsXstate(
    b"{\"id\":\"T\",\"initial\":\"A\",\"states\":{\"A\":{\"tags\":\"busy\",\"on\":{\"*\":\"B\",\"Skip\":{\"guard\":\"never\"}}},\"B\":{\"tags\":[\"busy\",\"late\"],\"type\":\"final\"}}}",
    b"{\"id\":\"T\",\"initial\":\"A\",\"states\":{\"A\":{\"tags\":[\"busy\"],\"on\":{\"*\":[{\"target\":\"B\"}],\"Skip\":[{\"guard\":\"A.Skip\"}]}},\"B\":{\"type\":\"final\",\"tags\":[\"busy\",\"late\"]}}}",
  )) {
    Intrinsic.trap("tags and a wildcard transition read and written back")
  }

  // Meta data: the text members are kept.
  if !(run readsXstate(
    b"{\"id\":\"M\",\"initial\":\"A\",\"states\":{\"A\":{\"meta\":{\"view\":\"home\",\"order\":1,\"hint\":\"say \\\"hi\\\"\"}}}}",
    b"{\"id\":\"M\",\"initial\":\"A\",\"states\":{\"A\":{\"meta\":{\"view\":\"home\",\"hint\":\"say \\\"hi\\\"\"}}}}",
  )) {
    Intrinsic.trap("meta data read and written back")
  }

  // Meta data of a transition, with and without a target and a guard.
  if !(run readsXstate(
    b"{\"id\":\"N\",\"initial\":\"A\",\"states\":{\"A\":{\"on\":{\"Go\":{\"target\":\"B\",\"meta\":{\"label\":\"go\",\"weight\":2}},\"Skip\":{\"meta\":{\"label\":\"skip\"}},\"*\":{\"target\":\"B\",\"guard\":\"g\",\"meta\":{\"label\":\"rest\"}}}},\"B\":{}}}",
    b"{\"id\":\"N\",\"initial\":\"A\",\"states\":{\"A\":{\"on\":{\"Go\":[{\"target\":\"B\",\"meta\":{\"label\":\"go\"}}],\"Skip\":[{\"meta\":{\"label\":\"skip\"}}],\"*\":[{\"target\":\"B\",\"guard\":\"A.*\",\"meta\":{\"label\":\"rest\"}}]}},\"B\":{}}}",
  )) {
    Intrinsic.trap("transition meta data read and written back")
  }

  // A history child state and a transition to it are read as the history of the parent state.
  if !(run readsXstate(
    b"{\"id\":\"P\",\"initial\":\"Stopped\",\"states\":{\"Stopped\":{\"on\":{\"Resume\":\"Playing.hist\",\"Play\":\"Playing\"}},\"Playing\":{\"initial\":\"Normal\",\"states\":{\"Normal\":{},\"Fast\":{},\"hist\":{\"type\":\"history\",\"history\":\"deep\"}},\"on\":{\"Stop\":\"Stopped\"}}}}",
    b"{\"id\":\"P\",\"initial\":\"Stopped\",\"states\":{\"Stopped\":{\"on\":{\"Resume\":[{\"target\":\"Playing.hist\"}],\"Play\":[{\"target\":\"Playing\"}]}},\"Playing\":{\"initial\":\"Normal\",\"states\":{\"Normal\":{},\"Fast\":{},\"hist\":{\"type\":\"history\",\"history\":\"deep\"}},\"on\":{\"Stop\":[{\"target\":\"Stopped\"}]}}}}",
  )) {
    Intrinsic.trap("a history state read and written back")
  }
  if !(run refusesXstate(b"{\"initial\":\"A\",\"states\":{\"A\":{\"states\":{\"B\":{}}}}}")) {
    Intrinsic.trap("a compound state without an initial state is refused")
  }
  if !(run refusesXstate(b"{\"initial\":\"A\",\"states\":{\"A\":{\"after\":{\"SOON\":\"A\"}}}}")) {
    Intrinsic.trap("a named delay is refused")
  }
  return ()
}

test effect fn xstateConfigIsRead()
  ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run xstateReadScenario() |> Effect.provideMut<Allocator>(&mut allocator)
}
