//! History states: a state that is entered again as it was when its chart last left it.
import silk.machine.chart { Chart, Enqueue, History, Machine }
import silk.machine.definition { Definitions }
import silk.machine.generate { Generate }
import generated_player { gearChart, modeChart, playerChart }
import silk.machine.xstate { Xstate }
import silk.machine.snapshot { Snapshot, Steps, TransitionLoopError }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.issue { SchemaError }
import silk.schema.json { SchemaJson }
import silk.schema.schema { Schema }

// A player with two compound states over the same regions. `Playing` has deep history and
// `Editing` shallow history. The transition tables are generated: `src/generated_player.silk`
// holds the text that `Generate.write` returns for the definition of `Player`.

pub union Player {
  Stopped,
  Playing { pub mode: Mode },
  Editing { pub mode: Mode },
}

pub union Mode {
  Normal,
  Fast { pub gear: Gear },
}

pub union Gear {
  Second,
  Third
}

pub union PlayerEvent {
  Play,
  Resume,
  Edit,
  ResumeEdit,
  Stop,
  Faster,
  Shift,
}

pub struct PlayerContext {
  pub lastPlaying: History<Player>,
  pub lastEditing: History<Player>,
  /// How many times a gear was entered.
  pub gears: u32,
}

pub union PlayerEffect {
  Nothing,
}

impl Schema for Player {}

impl Schema for Mode {}

impl Schema for Gear {}

impl Schema for PlayerEvent {}

impl Schema for PlayerContext {}

impl Schema for PlayerEffect {}

impl Machine<PlayerEvent, PlayerContext, PlayerEffect> for Player {
  static fn chart() -> Chart<Player, PlayerEvent, PlayerContext, PlayerEffect> {
    return playerChart()
  }
}

impl Machine<PlayerEvent, PlayerContext, PlayerEffect> for Mode {
  static fn chart() -> Chart<Mode, PlayerEvent, PlayerContext, PlayerEffect> {
    return modeChart()
  }
}

impl Machine<PlayerEvent, PlayerContext, PlayerEffect> for Gear {
  static fn chart() -> Chart<Gear, PlayerEvent, PlayerContext, PlayerEffect> {
    return gearChart()
  }

  effect fn enter(
    state: &Gear,
    context: &mut PlayerContext,
    enq: &mut Enqueue<PlayerEvent, PlayerEffect>,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    context.gears = context.gears + 1
    return ()
  }
}

type PlayerSnapshot = Snapshot<Player, PlayerEvent, PlayerContext, PlayerEffect>

struct Capture {
  bytes: [u8; 2048],
  length: usize,
}

impl Writer for Capture {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> ()
    ! WriterError
    ? &mut Writer {
    let mut index: usize = 0
    while index < value.length {
      self.bytes[self.length] = value[index]
      self.length = self.length + 1
      index = index + 1
    }
    return ()
  }

  effect fn flush(self: &mut Self) -> ()
    ! WriterError
    ? &mut Writer {
    return ()
  }
}

// Writes the snapshot to JSON and reads it back, as a program that saves and restores does.
effect fn saved(snapshot: &PlayerSnapshot) -> PlayerSnapshot
  ! OutOfMemoryError | SchemaError
  ? &mut Allocator {
  let mut capture = Capture { bytes: [0; 2048], length: 0 }
  let encoded = run Effect.result(SchemaJson.encode<PlayerSnapshot>(snapshot))
    |> Effect.provideMut<Writer>(&mut capture)
  match move encoded {
    Result<(), SchemaError | WriterError | OutOfMemoryError>.Success { .. } => {}
    Result<(), SchemaError | WriterError | OutOfMemoryError>.Failure { .. } => Intrinsic.trap(
      "snapshot JSON",
    )
  }
  return run SchemaJson.decode<PlayerSnapshot>(Slice.view(&capture.bytes, 0, capture.length))
}

effect fn historyScenario() -> ()
  ! OutOfMemoryError | TransitionLoopError | SchemaError
  ? &mut Allocator {
  let mut player = run Steps.begin<Player, PlayerEvent, PlayerContext, PlayerEffect>(
    PlayerContext {
      lastPlaying: History<Player>.empty(),
      lastEditing: History<Player>.empty(),
      gears: 0,
    },
    0,
  )

  // With nothing remembered, a transition to the history enters the initial states.
  drop run Steps.send(&mut player, PlayerEvent.Resume)
  match &player.value {
    Player.Playing { mode: Mode.Normal } => {}
    _ => Intrinsic.trap("expected Playing at its initial state")
  }

  drop run Steps.send(&mut player, PlayerEvent.Faster)
  drop run Steps.send(&mut player, PlayerEvent.Shift)
  drop run Steps.send(&mut player, PlayerEvent.Stop)
  match &player.value {
    Player.Stopped => {}
    _ => Intrinsic.trap("expected Stopped")
  }

  // The history is part of the context, so a saved and restored machine still has it.
  let mut restored = run saved(&player)

  // Deep history: the region and the region below it come back, and their entry functions run.
  let before = restored.context.gears
  drop run Steps.send(&mut restored, PlayerEvent.Resume)
  match &restored.value {
    Player.Playing { mode: Mode.Fast { gear: Gear.Third } } => {}
    _ => Intrinsic.trap("expected Playing as it was left")
  }
  if restored.context.gears != before + 1 {
    Intrinsic.trap("entering through the history runs the entry functions")
  }

  // A plain transition to the state enters its initial states.
  drop run Steps.send(&mut restored, PlayerEvent.Stop)
  drop run Steps.send(&mut restored, PlayerEvent.Play)
  match &restored.value {
    Player.Playing { mode: Mode.Normal } => {}
    _ => Intrinsic.trap("expected Playing at its initial state after Play")
  }
  drop run Steps.send(&mut restored, PlayerEvent.Stop)

  // Shallow history: the region comes back, the region below it starts again.
  drop run Steps.send(&mut restored, PlayerEvent.Edit)
  drop run Steps.send(&mut restored, PlayerEvent.Faster)
  drop run Steps.send(&mut restored, PlayerEvent.Shift)
  drop run Steps.send(&mut restored, PlayerEvent.Stop)
  drop run Steps.send(&mut restored, PlayerEvent.ResumeEdit)
  match &restored.value {
    Player.Editing { mode: Mode.Fast { gear: Gear.Second } } => {}
    _ => Intrinsic.trap("expected Editing with its region and the gear at its start")
  }
  return ()
}

test effect fn historyComesBack()
  ! OutOfMemoryError | TransitionLoopError | SchemaError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run historyScenario() |> Effect.provideMut<Allocator>(&mut allocator)
}

fn holds(capture: &Capture, expected: &[u8]) -> bool {
  if capture.length != expected.length {
    return false
  }
  let mut index: usize = 0
  while index < expected.length {
    if capture.bytes[index] != expected[index] {
      return false
    }
    index = index + 1
  }
  return true
}

// The history as data: in the definition, as xstate history states, and in generated source.

effect fn historyDefinitionScenario() -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let definition = run Definitions.of<Player, PlayerEvent, PlayerContext, PlayerEffect>()
  if definition.charts.length() != 3 {
    Intrinsic.trap("a chart that two states hold is listed one time")
  }
  let mut config = Capture { bytes: [0; 2048], length: 0 }
  let written = run Effect.result(Xstate.write(&definition))
    |> Effect.provideMut<Writer>(&mut config)
  match move written {
    Result<(), WriterError>.Success { .. } => {}
    Result<(), WriterError>.Failure { .. } => Intrinsic.trap("xstate config")
  }
  if !holds(
    &config,
    b"{\"id\":\"Player\",\"initial\":\"Stopped\",\"states\":{\"Stopped\":{\"on\":{\"Play\":[{\"target\":\"Playing\"}],\"Resume\":[{\"target\":\"Playing.hist\"}],\"Edit\":[{\"target\":\"Editing\"}],\"ResumeEdit\":[{\"target\":\"Editing.hist\"}]}},\"Playing\":{\"initial\":\"Normal\",\"states\":{\"Normal\":{\"on\":{\"Faster\":[{\"target\":\"Fast\"}]}},\"Fast\":{\"initial\":\"Second\",\"states\":{\"Second\":{\"on\":{\"Shift\":[{\"target\":\"Third\"}]}},\"Third\":{}}},\"hist\":{\"type\":\"history\",\"history\":\"deep\"}},\"on\":{\"Stop\":[{\"target\":\"Stopped\"}]}},\"Editing\":{\"initial\":\"Normal\",\"states\":{\"Normal\":{\"on\":{\"Faster\":[{\"target\":\"Fast\"}]}},\"Fast\":{\"initial\":\"Second\",\"states\":{\"Second\":{\"on\":{\"Shift\":[{\"target\":\"Third\"}]}},\"Third\":{}}},\"hist\":{\"type\":\"history\",\"history\":\"shallow\"}},\"on\":{\"Stop\":[{\"target\":\"Stopped\"}]}}}}",
  ) {
    Intrinsic.trap("xstate config with history states")
  }
  let mut source = Capture { bytes: [0; 2048], length: 0 }
  let generated = run Effect.result(Generate.write(&definition, "history_tests"))
    |> Effect.provideMut<Writer>(&mut source)
  match move generated {
    Result<(), WriterError>.Success { .. } => {}
    Result<(), WriterError>.Failure { .. } => Intrinsic.trap("generated source")
  }
  if !holds(
    &source,
    b"//! Generated from the definition of Player. Do not edit: change the definition and generate again.\n\nimport silk.machine.chart { Chart }\nimport history_tests { Player, PlayerContext, PlayerEffect, PlayerEvent, Mode, Gear }\n\npub static fn playerChart() -> Chart<Player, PlayerEvent, PlayerContext, PlayerEffect> {\n  return Chart<Player, PlayerEvent, PlayerContext, PlayerEffect>.of()\n    |> Chart.initial(Player.Stopped)\n    |> Chart.region(\"mode\")\n    |> Chart.history(\"Playing\", \"lastPlaying\")\n    |> Chart.shallowHistory(\"Editing\", \"lastEditing\")\n    |> Chart.on(\"Stopped\", \"Play\", Player.Playing { mode: Mode.Normal })\n    |> Chart.resume(\"Stopped\", \"Resume\", Player.Playing { mode: Mode.Normal })\n    |> Chart.on(\"Stopped\", \"Edit\", Player.Editing { mode: Mode.Normal })\n    |> Chart.resume(\"Stopped\", \"ResumeEdit\", Player.Editing { mode: Mode.Normal })\n    |> Chart.on(\"Playing\", \"Stop\", Player.Stopped)\n    |> Chart.on(\"Editing\", \"Stop\", Player.Stopped)\n}\n\npub static fn modeChart() -> Chart<Mode, PlayerEvent, PlayerContext, PlayerEffect> {\n  return Chart<Mode, PlayerEvent, PlayerContext, PlayerEffect>.of()\n    |> Chart.initial(Mode.Normal)\n    |> Chart.region(\"gear\")\n    |> Chart.on(\"Normal\", \"Faster\", Mode.Fast { gear: Gear.Second })\n}\n\npub static fn gearChart() -> Chart<Gear, PlayerEvent, PlayerContext, PlayerEffect> {\n  return Chart<Gear, PlayerEvent, PlayerContext, PlayerEffect>.of()\n    |> Chart.initial(Gear.Second)\n    |> Chart.on(\"Second\", \"Shift\", Gear.Third)\n}\n",
  ) {
    Intrinsic.trap("generated source of a machine with history")
  }
  return ()
}

test effect fn historyAsData()
  ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run historyDefinitionScenario() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A desk whose task is a region. `Writing` has a history in the chart of the region, and the
// desk leaves `Busy`, the parent state, while the task is `Writing`.

pub union Desk {
  Idle,
  Busy { pub task: Task },
}

pub union Task {
  Reading,
  Writing { pub pen: Pen },
}

pub union Pen {
  Black,
  Blue
}

pub union DeskEvent {
  Start,
  Stop,
  Write,
  Rewrite,
  Swap,
  Draft,
}

pub struct DeskContext {
  pub lastWriting: History<Task>,
}

impl Schema for Desk {}

impl Schema for Task {}

impl Schema for Pen {}

impl Schema for DeskEvent {}

impl Schema for DeskContext {}

impl Machine<DeskEvent, DeskContext, PlayerEffect> for Desk {
  static fn chart() -> Chart<Desk, DeskEvent, DeskContext, PlayerEffect> {
    return Chart<Desk, DeskEvent, DeskContext, PlayerEffect>.of()
      |> Chart.initial(Desk.Idle)
      |> Chart.region("task")
      |> Chart.on("Idle", "Start", Desk.Busy { task: Task.Reading })
      |> Chart.on("Idle", "Draft", Desk.Busy { task: Task.Writing { pen: Pen.Blue } })
      |> Chart.on("Busy", "Stop", Desk.Idle)
  }
}

impl Machine<DeskEvent, DeskContext, PlayerEffect> for Task {
  static fn chart() -> Chart<Task, DeskEvent, DeskContext, PlayerEffect> {
    return Chart<Task, DeskEvent, DeskContext, PlayerEffect>.of()
      |> Chart.initial(Task.Reading)
      |> Chart.region("pen")
      |> Chart.history("Writing", "lastWriting")
      |> Chart.on("Reading", "Write", Task.Writing { pen: Pen.Black })
      |> Chart.resume("Reading", "Rewrite", Task.Writing { pen: Pen.Black })
  }
}

impl Machine<DeskEvent, DeskContext, PlayerEffect> for Pen {
  static fn chart() -> Chart<Pen, DeskEvent, DeskContext, PlayerEffect> {
    return Chart<Pen, DeskEvent, DeskContext, PlayerEffect>.of()
      |> Chart.initial(Pen.Black)
      |> Chart.on("Black", "Swap", Pen.Blue)
  }
}

effect fn deskScenario() -> ()
  ! OutOfMemoryError | TransitionLoopError
  ? &mut Allocator {
  let mut desk = run Steps.begin<Desk, DeskEvent, DeskContext, PlayerEffect>(
    DeskContext { lastWriting: History<Task>.empty() },
    0,
  )
  drop run Steps.send(&mut desk, DeskEvent.Start)
  drop run Steps.send(&mut desk, DeskEvent.Write)
  drop run Steps.send(&mut desk, DeskEvent.Swap)
  match &desk.value {
    Desk.Busy { task: Task.Writing { pen: Pen.Blue } } => {}
    _ => Intrinsic.trap("writing with the blue pen")
  }

  // Leaving Busy leaves Writing with it, so the history of Writing is kept.
  drop run Steps.send(&mut desk, DeskEvent.Stop)
  drop run Steps.send(&mut desk, DeskEvent.Start)
  match &desk.value {
    Desk.Busy { task: Task.Reading } => {}
    _ => Intrinsic.trap("a new task starts at Reading")
  }
  drop run Steps.send(&mut desk, DeskEvent.Rewrite)
  match &desk.value {
    Desk.Busy { task: Task.Writing { pen: Pen.Blue } } => {}
    _ => Intrinsic.trap("Writing comes back with the blue pen")
  }
  return ()
}

effect fn draftScenario() -> ()
  ! OutOfMemoryError | TransitionLoopError
  ? &mut Allocator {
  let mut desk = run Steps.begin<Desk, DeskEvent, DeskContext, PlayerEffect>(
    DeskContext { lastWriting: History<Task>.empty() },
    0,
  )

  // The target is a value, so a transition enters the regions at any state, not only at
  // their initial ones.
  drop run Steps.send(&mut desk, DeskEvent.Draft)
  match &desk.value {
    Desk.Busy { task: Task.Writing { pen: Pen.Blue } } => {}
    _ => Intrinsic.trap("Draft enters Writing with the blue pen")
  }
  return ()
}

test effect fn targetEntersNestedStates()
  ! OutOfMemoryError | TransitionLoopError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run draftScenario() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn historyKeptWhenTheParentIsLeft()
  ! OutOfMemoryError | TransitionLoopError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run deskScenario() |> Effect.provideMut<Allocator>(&mut allocator)
}
