//! Paths through a chart.
import silk.machine.chart { Chart, Machine }
import silk.machine.definition { Definitions }
import silk.machine.paths { Path, Paths }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }

// An order with a state that nothing leads to.

union Parcel {
  Cart,
  Paying,
  Packed,
  Shipped,
  Archived,
  Lost,
}

union ParcelEvent {
  Pay,
  Paid,
  Refused,
  Found,
}

struct ParcelContext {}

union ParcelEffect {
  Nothing,
}

impl Machine<ParcelEvent, ParcelContext, ParcelEffect> for Parcel {
  static fn chart() -> Chart<Parcel, ParcelEvent, ParcelContext, ParcelEffect> {
    return Chart<Parcel, ParcelEvent, ParcelContext, ParcelEffect>.of()
      |> Chart.initial(Parcel.Cart)
      |> Chart.on("Cart", "Pay", Parcel.Paying)
      |> Chart.on("Paying", "Refused", Parcel.Cart)
      |> Chart.on("Paying", "Paid", Parcel.Packed)
      |> Chart.after("Packed", 2s, Parcel.Shipped)
      |> Chart.always("Shipped", Parcel.Archived)
      |> Chart.on("Lost", "Found", Parcel.Cart)
      |> Chart.final("Archived")
  }
}

fn isPath(path: &Path, state: string, steps: &[string]) -> bool {
  if path.state.view() != state || path.steps.length() != steps.length {
    return false
  }
  let mut index: usize = 0
  while index < steps.length {
    if path.steps.asSlice()[index].view() != steps[index] {
      return false
    }
    index = index + 1
  }
  return true
}

effect fn pathsScenario() -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let definition = run Definitions.of<Parcel, ParcelEvent, ParcelContext, ParcelEffect>()
  let paths = run Paths.shortest(&definition, "Parcel")
  let found = paths.asSlice()
  if found.length != 5 {
    Intrinsic.trap("five states can be reached")
  }
  if !isPath(&found[0], "Cart", &[]) {
    Intrinsic.trap("the initial state needs no step")
  }
  if !isPath(&found[1], "Paying", &["Pay"]) || !isPath(&found[2], "Packed", &["Pay", "Paid"]) {
    Intrinsic.trap("events lead to Paying and Packed")
  }
  if !isPath(&found[3], "Shipped", &["Pay", "Paid", "after 2s"]) {
    Intrinsic.trap("a delayed transition is a step")
  }
  if !isPath(&found[4], "Archived", &["Pay", "Paid", "after 2s", "always"]) {
    Intrinsic.trap("an eventless transition is a step")
  }
  let unreachable = run Paths.unreachable(&definition, "Parcel")
  if unreachable.length() != 1 || unreachable.asSlice()[0].view() != "Lost" {
    Intrinsic.trap("nothing leads to Lost")
  }
  let none = run Paths.shortest(&definition, "Missing")
  if none.length() != 0 {
    Intrinsic.trap("a chart the definition does not have has no paths")
  }
  return ()
}

test effect fn shortestPathsAndUnreachableStates()
  ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run pathsScenario() |> Effect.provideMut<Allocator>(&mut allocator)
}
