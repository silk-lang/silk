//! Generated from the definition of Editor. Do not edit: change the definition and generate again.

import silk.machine.chart { Chart }
import hierarchy_tests { Editor, EditorContext, EditorEffect, EditorEvent, Bold, Italic }

pub static fn editorChart() -> Chart<Editor, EditorEvent, EditorContext, EditorEffect> {
  return Chart<Editor, EditorEvent, EditorContext, EditorEffect>.of()
    |> Chart.initial(Editor.Closed)
    |> Chart.region("bold")
    |> Chart.region("italic")
    |> Chart.on("Closed", "OpenFile", Editor.Open { bold: Bold.Off, italic: Italic.Plain })
    |> Chart.on("Open", "Close", Editor.Closed)
}

pub static fn boldChart() -> Chart<Bold, EditorEvent, EditorContext, EditorEffect> {
  return Chart<Bold, EditorEvent, EditorContext, EditorEffect>.of()
    |> Chart.initial(Bold.Off)
    |> Chart.on("Off", "ToggleBold", Bold.On)
    |> Chart.on("On", "ToggleBold", Bold.Off)
    |> Chart.on("On", "Reset", Bold.Off)
    |> Chart.after("On", 100ms, Bold.Off)
}

pub static fn italicChart() -> Chart<Italic, EditorEvent, EditorContext, EditorEffect> {
  return Chart<Italic, EditorEvent, EditorContext, EditorEffect>.of()
    |> Chart.initial(Italic.Plain)
    |> Chart.on("Plain", "ToggleItalic", Italic.Slanted)
    |> Chart.on("Slanted", "ToggleItalic", Italic.Plain)
    |> Chart.on("Slanted", "Reset", Italic.Plain)
}
