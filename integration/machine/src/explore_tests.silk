// The life of one program version on one computer: rows that say what they leave, a state that
// waits for the world, refusals, rules, and a walk over every state.

import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.machine.chart { Chart, Guards, Machine }
import silk.machine.definition { Definitions }
import silk.machine.explore { Explorer }
import silk.machine.rules { Rules }
import silk.machine.snapshot { Snapshot, Steps, TransitionLoopError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.issue { SchemaError }
import silk.schema.schema { Schema }

pub union Slot {
  Absent,
  Downloading,
  Verifying,
  Installed,
}

pub union Typed {
  Use,
  Uninstall,
  Arrived,
  Cut,
  Genuine,
  Forged,
}

pub enum Place {
  Toolchain,
  Settings,
  Project,
}

pub union Mark {
  Exits { pub status: u8 },
  Downloads,
  Creates { pub place: Place },
  Changes { pub place: Place },
  Removes { pub place: Place },
}

// The computer as the machine sees it.
pub struct Disk {
  pub online: bool,
  pub toolchain: bool,
  pub isDefault: bool,
}

impl Schema for Slot {}

impl Schema for Typed {}

impl Schema for Mark {}

impl Schema for Place {}

impl Schema for Disk {}

fn online(disk: &Disk, event: &Typed) -> bool {
  return disk.online
}

fn offline(disk: &Disk, event: &Typed) -> bool {
  return !disk.online
}

fn isDefault(disk: &Disk, event: &Typed) -> bool {
  return disk.isDefault
}

impl Machine<Typed, Disk, Mark> for Slot {
  static fn chart() -> Chart<Slot, Typed, Disk, Mark> {
    return Chart<Slot, Typed, Disk, Mark>.of()
      |> Chart.initial(Slot.Absent)
      |> Chart.onWhen("Absent", "Use", Slot.Downloading, Guards.named("the network is up", online))
      |> Chart.leaves(&[Mark.Downloads])
      |> Chart.refuseWhen("Absent", "Use", offline, "there is no network")
      |> Chart.leaves(&[Mark.Exits { status: 4 }])
      |> Chart.awaits("Downloading", "Arrived")
      |> Chart.awaits("Downloading", "Cut")
      |> Chart.on("Downloading", "Arrived", Slot.Verifying)
      |> Chart.on("Downloading", "Cut", Slot.Absent)
      |> Chart.leaves(&[Mark.Exits { status: 4 }])
      |> Chart.awaits("Verifying", "Genuine")
      |> Chart.awaits("Verifying", "Forged")
      |> Chart.on("Verifying", "Genuine", Slot.Installed)
      |> Chart.leaves(&[Mark.Creates { place: Place.Toolchain }, Mark.Changes { place: Place.Settings }])
      |> Chart.leaves(&[Mark.Exits { status: 0 }])
      |> Chart.on("Verifying", "Forged", Slot.Absent)
      |> Chart.leaves(&[Mark.Exits { status: 5 }])
      |> Chart.stayWhen("Installed", "Use", isDefault)
      |> Chart.leaves(&[Mark.Exits { status: 0 }])
      |> Chart.stay("Installed", "Use")
      |> Chart.leaves(&[Mark.Changes { place: Place.Settings }, Mark.Exits { status: 0 }])
      |> Chart.on("Installed", "Uninstall", Slot.Absent)
      |> Chart.leaves(&[Mark.Removes { place: Place.Toolchain }, Mark.Exits { status: 0 }])
      |> Chart.refuse("Absent", "Uninstall", "the version is not installed")
      |> Chart.leaves(&[Mark.Exits { status: 1 }])
  }

  // The disk takes in what a row leaves.
  fn absorb(state: &Slot, disk: &mut Disk, mark: &Mark) -> () {
    match &mark.* {
      Mark.Creates { place } => {
        if place == Place.Toolchain {
          disk.toolchain = true
        }
      }
      Mark.Changes { place } => {
        if place == Place.Settings {
          disk.isDefault = true
        }
      }
      Mark.Removes { place } => {
        if place == Place.Toolchain {
          disk.toolchain = false
          disk.isDefault = false
        }
      }
      _ => {}
    }
    return ()
  }
}

static fn rules() -> Rules<Typed, Disk, Mark> {
  return Rules<Typed, Disk, Mark>.of()
    |> Rules.never("Use", Mark.Changes { place: Place.Project }, "use never edits a project")
    |> Rules.neverWhen("Use", isDefault, Mark.Changes { place: Place.Settings }, "the default is already this version")
    |> Rules.always("Uninstall", Mark.Exits { status: 9 }, "a rule that is broken on purpose")
}

type SlotSnapshot = Snapshot<Slot, Typed, Disk, Mark>

effect fn explored() -> ()
  ! OutOfMemoryError | TransitionLoopError | SchemaError
  ? &mut Allocator {
  let events: [Typed; 6] = [Typed.Use, Typed.Uninstall, Typed.Arrived, Typed.Cut, Typed.Genuine, Typed.Forged]
  let mut starts = List<SlotSnapshot>.make()
  run List<SlotSnapshot>.append(
    &mut starts,
    run Steps.begin<Slot, Typed, Disk, Mark>(Disk { online: true, toolchain: false, isDefault: false }, 0),
  )
  run List<SlotSnapshot>.append(
    &mut starts,
    run Steps.begin<Slot, Typed, Disk, Mark>(Disk { online: false, toolchain: false, isDefault: false }, 0),
  )
  let walk = run Explorer.walk<Slot, Typed, Disk, Mark>(move starts, &events, 100)
  if !walk.complete {
    Intrinsic.trap("the walk ends")
  }

  // Online: Absent, Downloading, Verifying, Installed as the default. Offline: Absent.
  if walk.nodes.length() != 5 {
    Intrinsic.trap("five snapshots")
  }

  // Installed takes no answer and Downloading no command, so nothing is a hole. Offline, Use
  // is refused and Uninstall too, which are rows.
  let holes = run walk.holes()
  if holes.length() != 0 {
    Intrinsic.trap("no holes")
  }
  let overlaps = run walk.overlaps()

  // Installed as the default: the guarded stay and the plain stay both apply to Use.
  if overlaps.length() != 1 {
    Intrinsic.trap("one overlap")
  }
  let unreached = run walk.unreached()
  if unreached.length() != 0 {
    Intrinsic.trap("every state is reached")
  }
  let stuck = run walk.stuck()
  if stuck.length() != 0 {
    Intrinsic.trap("nothing is stuck")
  }

  // Online and absent: Use ends three ways (cut, forged, installed) and Uninstall one. Installed:
  // Use and Uninstall. Offline: Use and Uninstall.
  let runs = run walk.runs(10)
  if runs.length() != 8 {
    Intrinsic.trap("eight runs")
  }
  let mut index: usize = 0
  while index < runs.length() {
    if !runs.asSlice()[index].settled {
      Intrinsic.trap("every run settles")
    }
    index = index + 1
  }

  // The rule broken on purpose is broken by each of the three runs of Uninstall, and the two
  // real rules by none.
  let broken = run Rules<Typed, Disk, Mark>.broken<Slot>(rules(), &walk, runs.asSlice(), &events)
  if broken.length() != 3 {
    Intrinsic.trap("three broken runs")
  }
  index = 0
  while index < broken.length() {
    if broken.asSlice()[index].reason != "a rule that is broken on purpose" {
      Intrinsic.trap("only the planted rule is broken")
    }
    index = index + 1
  }

  // The definition keeps what the rows say.
  let definition = run Definitions.of<Slot, Typed, Disk, Mark>()
  let absent = &definition.charts.asSlice()[0].states.asSlice()[0]
  let use = &absent.on.asSlice()[0]
  if use.guard.view() != "the network is up" || use.leaves.length() != 1
    || use.leaves.asSlice()[0].view() != "Downloads" || use.enters.view() != "Downloading" {
    Intrinsic.trap("the first row as data")
  }
  let refused = &absent.on.asSlice()[1]
  if refused.refused.view() != "there is no network"
    || refused.leaves.asSlice()[0].view() != "Exits { status: 4 }" {
    Intrinsic.trap("the refusal as data")
  }
  let downloading = &definition.charts.asSlice()[0].states.asSlice()[1]
  if downloading.awaits.length() != 2 || downloading.awaits.asSlice()[1].view() != "Cut" {
    Intrinsic.trap("the answers as data")
  }
  let verifying = &definition.charts.asSlice()[0].states.asSlice()[2]
  let genuine = &verifying.on.asSlice()[0]
  if genuine.leaves.length() != 3
    || genuine.leaves.asSlice()[0].view() != "Creates { place: Toolchain }" {
    Intrinsic.trap("two leaves for one row add up")
  }
  return ()
}

test effect fn walkFindsHolesOverlapsAndBrokenRules()
  ! OutOfMemoryError | TransitionLoopError | SchemaError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run explored() |> Effect.provideMut<Allocator>(&mut allocator)
}
