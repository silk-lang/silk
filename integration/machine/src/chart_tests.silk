import silk.machine.chart { Chart, Enqueue, History, Machine, Machines, Next }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }

union Player {
  Stopped,
  Playing,
  Paused
}

union PlayerEvent {
  Play,
  Pause,
  Stop
}

struct Nothing {}

impl Machine<PlayerEvent, Nothing, never> for Player {
  static fn chart() -> Chart<Player, PlayerEvent, Nothing, never> {
    return Chart<Player, PlayerEvent, Nothing, never>.of()
      |> Chart.initial(Player.Stopped)
      |> Chart.on("Stopped", "Play", Player.Playing)
      |> Chart.on("Playing", "Pause", Player.Paused)
      |> Chart.on("Playing", "Stop", Player.Stopped)
      |> Chart.on("Paused", "Play", Player.Playing)
      |> Chart.on("Paused", "Stop", Player.Stopped)
  }
}

effect fn sendPlayer(state: &mut Player, event: PlayerEvent) -> bool
  ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut nothing = Nothing {}
  let mut enq = Enqueue<PlayerEvent, never>.make()
  return run Machines.dispatch<Player, PlayerEvent, Nothing, never>(
    &mut state.*,
    &mut nothing,
    &event,
    &mut enq,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn pauseWhileStoppedIsIgnored()
  ! OutOfMemoryError {
  let mut player = Machines.start<Player, PlayerEvent, Nothing, never>()
  let handled = run sendPlayer(&mut player, PlayerEvent.Pause)
  if handled {
    Intrinsic.trap("Pause is not handled while Stopped")
  }
  match &player {
    Player.Stopped => {}
    _ => Intrinsic.trap("expected Stopped")
  }
}

test effect fn playStartsPlaying()
  ! OutOfMemoryError {
  let mut player = Machines.start<Player, PlayerEvent, Nothing, never>()
  drop run sendPlayer(&mut player, PlayerEvent.Play)
  match &player {
    Player.Playing => {}
    _ => Intrinsic.trap("expected Playing")
  }
}

// A flat machine with a context, a guard, a transition function, effects and entry and exit
// functions: the release approval flow.

union Approval {
  Awaiting,
  Deploying,
  Failed,
  Deployed,
  Cancelled
}

union ApprovalEvent {
  Approve,
  Cancel,
  Retry,
  DeployDone { pub build: u32 },
  DeployFailed,
}

struct ApprovalContext {
  pub attempts: u32,
  pub build: u32,
  pub entered: u32,
  pub exited: u32,
}

union ApprovalEffect {
  Deploy { pub attempt: u32 },
  Audit { pub code: u32 },
}

fn canRetry(context: &ApprovalContext, event: &ApprovalEvent) -> bool {
  return context.attempts < 2
}

impl Machine<ApprovalEvent, ApprovalContext, ApprovalEffect> for Approval {
  static fn chart() -> Chart<Approval, ApprovalEvent, ApprovalContext, ApprovalEffect> {
    return Chart<Approval, ApprovalEvent, ApprovalContext, ApprovalEffect>.of()
      |> Chart.initial(Approval.Awaiting)
      |> Chart.on("Awaiting", "Approve", Approval.Deploying)
      |> Chart.on("Awaiting", "Cancel", Approval.Cancelled)
      |> Chart.on("Deploying", "Cancel", Approval.Cancelled)
      |> Chart.onWhen("Failed", "Retry", Approval.Deploying, canRetry)
      |> Chart.on("Failed", "Cancel", Approval.Cancelled)
  }

  effect fn handle(
    state: &Approval,
    context: &mut ApprovalContext,
    event: &ApprovalEvent,
    enq: &mut Enqueue<ApprovalEvent, ApprovalEffect>,
  ) -> Next<Approval>
    ! OutOfMemoryError
    ? &mut Allocator {
    match &state.* {
      Approval.Deploying => {
        match &event.* {
          ApprovalEvent.DeployDone { build } => {
            context.build = build
            run enq.perform(ApprovalEffect.Audit { code: 1 })
            return Next<Approval>.To { state: Approval.Deployed }
          }
          ApprovalEvent.DeployFailed => {
            context.attempts = context.attempts + 1
            return Next<Approval>.To { state: Approval.Failed }
          }
          _ => {}
        }
      }
      _ => {}
    }
    return Next<Approval>.Pass
  }

  effect fn enter(
    state: &Approval,
    context: &mut ApprovalContext,
    enq: &mut Enqueue<ApprovalEvent, ApprovalEffect>,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    context.entered = context.entered + 1
    match &state.* {
      Approval.Deploying => {
        run enq.perform(ApprovalEffect.Deploy { attempt: context.attempts })
      }
      _ => {}
    }
    return ()
  }

  effect fn exit(
    state: &Approval,
    context: &mut ApprovalContext,
    enq: &mut Enqueue<ApprovalEvent, ApprovalEffect>,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    context.exited = context.exited + 1
    return ()
  }
}

effect fn approvalScenario() -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut state = Machines.start<Approval, ApprovalEvent, ApprovalContext, ApprovalEffect>()
  let mut context = ApprovalContext { attempts: 0, build: 0, entered: 0, exited: 0 }
  let mut enq = Enqueue<ApprovalEvent, ApprovalEffect>.make()

  // Retry is not handled while Awaiting.
  if run Machines.dispatch(&mut state, &mut context, &ApprovalEvent.Retry, &mut enq) {
    Intrinsic.trap("Retry handled while Awaiting")
  }

  drop run Machines.dispatch(&mut state, &mut context, &ApprovalEvent.Approve, &mut enq)
  if enq.effects.length() != 1 {
    Intrinsic.trap("entering Deploying queues the deploy")
  }

  // Two failures: the first retry is allowed, the second is refused by the guard.
  drop run Machines.dispatch(&mut state, &mut context, &ApprovalEvent.DeployFailed, &mut enq)
  if !run Machines.dispatch(&mut state, &mut context, &ApprovalEvent.Retry, &mut enq) {
    Intrinsic.trap("first retry")
  }
  drop run Machines.dispatch(&mut state, &mut context, &ApprovalEvent.DeployFailed, &mut enq)
  if run Machines.dispatch(&mut state, &mut context, &ApprovalEvent.Retry, &mut enq) {
    Intrinsic.trap("second retry is guarded")
  }
  match &state {
    Approval.Failed => {}
    _ => Intrinsic.trap("expected Failed")
  }
  if context.attempts != 2 {
    Intrinsic.trap("two attempts")
  }

  // Awaiting, Deploying, Failed, Deploying, Failed were entered after the start: four entries.
  if context.entered != 4 || context.exited != 4 {
    Intrinsic.trap("entry and exit counts")
  }
  return ()
}

test effect fn approvalFlow()
  ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run approvalScenario() |> Effect.provideMut<Allocator>(&mut allocator)
}

// States that hold data. The initial state and the targets are values, so they carry fields.

union Countdown {
  Counting { pub left: u32 },
  Finished,
}

union CountdownEvent {
  Tick,
  Restart,
}

impl Machine<CountdownEvent, Nothing, never> for Countdown {
  static fn chart() -> Chart<Countdown, CountdownEvent, Nothing, never> {
    return Chart<Countdown, CountdownEvent, Nothing, never>.of()
      |> Chart.initial(Countdown.Counting { left: 2 })
      |> Chart.on("Finished", "Restart", Countdown.Counting { left: 5 })
  }

  effect fn handle(
    state: &Countdown,
    context: &mut Nothing,
    event: &CountdownEvent,
    enq: &mut Enqueue<CountdownEvent, never>,
  ) -> Next<Countdown>
    ! OutOfMemoryError
    ? &mut Allocator {
    match &state.* {
      Countdown.Counting { left } => {
        match &event.* {
          CountdownEvent.Tick => {
            if left == 1 {
              return Next<Countdown>.To { state: Countdown.Finished }
            }
            return Next<Countdown>.To { state: Countdown.Counting { left: left - 1 } }
          }
          _ => {}
        }
      }
      _ => {}
    }
    return Next<Countdown>.Pass
  }
}

effect fn sendCountdown(state: &mut Countdown, event: CountdownEvent) -> bool
  ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut nothing = Nothing {}
  let mut enq = Enqueue<CountdownEvent, never>.make()
  return run Machines.dispatch<Countdown, CountdownEvent, Nothing, never>(
    &mut state.*,
    &mut nothing,
    &event,
    &mut enq,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn statesHoldData()
  ! OutOfMemoryError {
  let mut countdown = Machines.start<Countdown, CountdownEvent, Nothing, never>()
  match &countdown {
    Countdown.Counting { left } => {
      if left != 2 {
        Intrinsic.trap("the initial state carries its field")
      }
    }
    _ => Intrinsic.trap("expected Counting")
  }
  drop run sendCountdown(&mut countdown, CountdownEvent.Tick)
  drop run sendCountdown(&mut countdown, CountdownEvent.Tick)
  match &countdown {
    Countdown.Finished => {}
    _ => Intrinsic.trap("expected Finished after two ticks")
  }
  drop run sendCountdown(&mut countdown, CountdownEvent.Restart)
  match &countdown {
    Countdown.Counting { left } => {
      if left != 5 {
        Intrinsic.trap("the target carries its field")
      }
    }
    _ => Intrinsic.trap("expected Counting again")
  }
}

// A state that holds data and has a history: the data comes back with the state.

union Timer {
  Idle,
  Running { pub left: u32 },
}

union TimerEvent {
  Start,
  Tick,
  Pause,
  Resume,
}

struct TimerContext {
  pub last: History<Timer>,
}

impl Machine<TimerEvent, TimerContext, never> for Timer {
  static fn chart() -> Chart<Timer, TimerEvent, TimerContext, never> {
    return Chart<Timer, TimerEvent, TimerContext, never>.of()
      |> Chart.initial(Timer.Idle)
      |> Chart.history("Running", "last")
      |> Chart.on("Idle", "Start", Timer.Running { left: 9 })
      |> Chart.resume("Idle", "Resume", Timer.Running { left: 9 })
      |> Chart.on("Running", "Pause", Timer.Idle)
  }

  effect fn handle(
    state: &Timer,
    context: &mut TimerContext,
    event: &TimerEvent,
    enq: &mut Enqueue<TimerEvent, never>,
  ) -> Next<Timer>
    ! OutOfMemoryError
    ? &mut Allocator {
    match &state.* {
      Timer.Running { left } => {
        match &event.* {
          TimerEvent.Tick => {
            return Next<Timer>.To { state: Timer.Running { left: left - 1 } }
          }
          _ => {}
        }
      }
      _ => {}
    }
    return Next<Timer>.Pass
  }
}

effect fn sendTimer(state: &mut Timer, context: &mut TimerContext, event: TimerEvent) -> bool
  ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut enq = Enqueue<TimerEvent, never>.make()
  return run Machines.dispatch<Timer, TimerEvent, TimerContext, never>(
    &mut state.*,
    &mut context.*,
    &event,
    &mut enq,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn historyKeepsTheDataOfAState()
  ! OutOfMemoryError {
  let mut timer = Machines.start<Timer, TimerEvent, TimerContext, never>()
  let mut context = TimerContext { last: History<Timer>.empty() }

  // Nothing is remembered yet, so the history transition enters the value of its row.
  drop run sendTimer(&mut timer, &mut context, TimerEvent.Resume)
  match &timer {
    Timer.Running { left } => {
      if left != 9 {
        Intrinsic.trap("the value of the row")
      }
    }
    _ => Intrinsic.trap("expected Running")
  }
  drop run sendTimer(&mut timer, &mut context, TimerEvent.Tick)
  drop run sendTimer(&mut timer, &mut context, TimerEvent.Pause)
  drop run sendTimer(&mut timer, &mut context, TimerEvent.Resume)
  match &timer {
    Timer.Running { left } => {
      if left != 8 {
        Intrinsic.trap("the remembered value has its data")
      }
    }
    _ => Intrinsic.trap("expected Running again")
  }
}
