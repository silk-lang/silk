//! An editor with nested and parallel states: closed, or open with two settings that change on
//! their own.
import silk.machine.chart { Chart }
import silk.machine.simple { Simple, SimpleChart, SimpleMachine, SimpleSnapshot }
import silk.machine.snapshot { TransitionLoopError }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.issue { SchemaError }
import silk.schema.json { SchemaJson }
import silk.schema.schema { Schema }

// An editor is closed, or open with two settings that change on their own.
union Editor {
  Closed,
  Open { pub bold: Bold, pub italic: Italic },
}

union Bold {
  Off,
  On
}

union Italic {
  Plain,
  Slanted
}

// One event type for the whole machine. Each chart names the events it takes.
union EditorEvent {
  OpenFile,
  OpenBold,
  ToggleBold,
  ToggleItalic,
  Close,
}

impl Schema for Editor {}

impl Schema for Bold {}

impl Schema for Italic {}

impl Schema for EditorEvent {}

impl SimpleMachine<EditorEvent> for Editor {
  static fn chart() -> SimpleChart<Editor, EditorEvent> {
    return Simple.chart<Editor, EditorEvent>()
      |> Chart.initial(Editor.Closed)
      // The fields `bold` and `italic` are regions: machines that run while Open is active.
      |> Chart.region("bold")
      |> Chart.region("italic")
      // A target is a whole value, so it says which state each region starts in.
      |> Chart.on("Closed", "OpenFile", Editor.Open { bold: Bold.Off, italic: Italic.Plain })
      |> Chart.on("Closed", "OpenBold", Editor.Open { bold: Bold.On, italic: Italic.Plain })
      |> Chart.on("Open", "Close", Editor.Closed)
  }
}

impl SimpleMachine<EditorEvent> for Bold {
  static fn chart() -> SimpleChart<Bold, EditorEvent> {
    return Simple.chart<Bold, EditorEvent>()
      |> Chart.initial(Bold.Off)
      |> Chart.on("Off", "ToggleBold", Bold.On)
      |> Chart.on("On", "ToggleBold", Bold.Off)
  }
}

impl SimpleMachine<EditorEvent> for Italic {
  static fn chart() -> SimpleChart<Italic, EditorEvent> {
    return Simple.chart<Italic, EditorEvent>()
      |> Chart.initial(Italic.Plain)
      |> Chart.on("Plain", "ToggleItalic", Italic.Slanted)
      |> Chart.on("Slanted", "ToggleItalic", Italic.Plain)
  }
}

type EditorSnapshot = SimpleSnapshot<Editor, EditorEvent>

struct Capture {
  bytes: [u8; 1024],
  length: usize,
}

impl Writer for Capture {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> ()
    ! WriterError
    ? &mut Writer {
    let mut index: usize = 0
    while index < value.length {
      self.bytes[self.length] = value[index]
      self.length = self.length + 1
      index = index + 1
    }
    return ()
  }

  effect fn flush(self: &mut Self) -> ()
    ! WriterError
    ? &mut Writer {
    return ()
  }
}

effect fn encodes(snapshot: &EditorSnapshot, expected: &[u8]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut capture = Capture { bytes: [0; 1024], length: 0 }
  let encoded = run Effect.result(SchemaJson.encode<EditorSnapshot>(snapshot))
    |> Effect.provideMut<Writer>(&mut capture)
  match move encoded {
    Result<(), SchemaError | WriterError | OutOfMemoryError>.Success { .. } => {}
    Result<(), SchemaError | WriterError | OutOfMemoryError>.Failure { .. } => {
      return false
    }
  }
  let written = Slice.view(&capture.bytes, 0, capture.length)
  if written.length != expected.length {
    return false
  }
  let mut index: usize = 0
  while index < expected.length {
    if written[index] != expected[index] {
      return false
    }
    index = index + 1
  }
  return true
}

effect fn editorScenario() -> ()
  ! OutOfMemoryError | TransitionLoopError
  ? &mut Allocator {
  let mut editor = run Simple.begin<Editor, EditorEvent>(0)

  // Closed has no regions, so nothing takes ToggleBold yet.
  if run Simple.send(&mut editor, EditorEvent.ToggleBold) {
    Intrinsic.trap("a closed editor takes no toggle")
  }

  drop run Simple.send(&mut editor, EditorEvent.OpenBold)
  match &editor.value {
    Editor.Open { bold: Bold.On, italic: Italic.Plain } => {}
    _ => Intrinsic.trap("OpenBold opens with bold on")
  }

  // Each region takes its own events and leaves the other alone.
  drop run Simple.send(&mut editor, EditorEvent.ToggleItalic)
  drop run Simple.send(&mut editor, EditorEvent.ToggleBold)
  match &editor.value {
    Editor.Open { bold: Bold.Off, italic: Italic.Slanted } => {}
    _ => Intrinsic.trap("the regions change on their own")
  }
  if !run encodes(
    &editor,
    b"{\"version\":2,\"status\":\"Active\",\"value\":{\"type\":\"Open\",\"bold\":\"Off\",\"italic\":\"Slanted\"},\"context\":{},\"mailbox\":[],\"pending\":[],\"clock\":0,\"timers\":[]}",
  ) {
    Intrinsic.trap("the snapshot holds the nested value")
  }

  // No region takes Close, so it goes up to Editor, which leaves Open and both regions.
  drop run Simple.send(&mut editor, EditorEvent.Close)
  match &editor.value {
    Editor.Closed => {}
    _ => Intrinsic.trap("Close closes the editor")
  }
  return ()
}

test effect fn readmeEditorExample()
  ! OutOfMemoryError | TransitionLoopError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run editorScenario() |> Effect.provideMut<Allocator>(&mut allocator)
}
