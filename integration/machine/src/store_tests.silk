//! Stores: a context and one reducer.
import silk.machine.actor { Actors, Reply }
import silk.machine.chart { Enqueue }
import silk.machine.store { Reducer, Store, Stores }
import silk.machine.snapshot { TransitionLoopError }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.issue { SchemaError }
import silk.schema.json { SchemaJson }
import silk.schema.schema { Schema }

// A cart: items are added and removed, and an empty cart after a removal is reported.

union CartEvent {
  Add { pub count: u32 },
  Remove { pub count: u32 },
  Clear,
}

struct Cart {
  pub items: u32,
  pub changes: u32,
}

union CartEffect {
  ReportEmpty,
}

impl Schema for CartEvent {}

impl Schema for Cart {}

impl Schema for CartEffect {}

impl Reducer<CartEvent, CartEffect> for Cart {
  effect fn reduce(
    self: &mut Self,
    event: &CartEvent,
    enq: &mut Enqueue<CartEvent, CartEffect>,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.changes = self.changes + 1
    match &event.* {
      CartEvent.Add { count } => {
        self.items = self.items + count
      }
      CartEvent.Remove { count } => {
        if count >= self.items {
          // Removing the last items is the same as clearing: raise it as the next event.
          run enq.raise(CartEvent.Clear)
        } else {
          self.items = self.items - count
        }
      }
      CartEvent.Clear => {
        self.items = 0
        run enq.perform(CartEffect.ReportEmpty)
      }
    }
    return ()
  }
}

type CartStore = Store<CartEvent, Cart, CartEffect>

struct Capture {
  bytes: [u8; 1024],
  length: usize,
}

impl Writer for Capture {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> ()
    ! WriterError
    ? &mut Writer {
    let mut index: usize = 0
    while index < value.length {
      self.bytes[self.length] = value[index]
      self.length = self.length + 1
      index = index + 1
    }
    return ()
  }

  effect fn flush(self: &mut Self) -> ()
    ! WriterError
    ? &mut Writer {
    return ()
  }
}

service Reports {
  effect fn empty() -> () ? &mut Reports
}

struct TestReports {
  pub empties: u32,
}

impl Reports for TestReports {
  effect fn empty(self: &mut Self) -> () {
    self.empties = self.empties + 1
    return ()
  }
}

effect fn perform(queued: CartEffect, reply: &mut Reply<CartEvent>) -> ()
  ? &mut Reports {
  match move queued {
    CartEffect.ReportEmpty => {
      run Reports.empty()
    }
  }
  return ()
}

effect fn storeScenario() -> ()
  ! OutOfMemoryError | TransitionLoopError | SchemaError
  ? &mut Reports | &mut Allocator {
  let mut cart = run Stores.begin<CartEvent, Cart, CartEffect>(Cart { items: 0, changes: 0 })
  run Stores.send(&mut cart, CartEvent.Add { count: 3 })
  run Stores.send(&mut cart, CartEvent.Remove { count: 1 })
  if cart.context.items != 2 || cart.context.changes != 2 {
    Intrinsic.trap("expected two items after two changes")
  }

  // A store is a snapshot: it goes to JSON and back.
  let mut capture = Capture { bytes: [0; 1024], length: 0 }
  let encoded = run Effect.result(SchemaJson.encode<CartStore>(&cart))
    |> Effect.provideMut<Writer>(&mut capture)
  match move encoded {
    Result<(), SchemaError | WriterError | OutOfMemoryError>.Success { .. } => {}
    Result<(), SchemaError | WriterError | OutOfMemoryError>.Failure { .. } => Intrinsic.trap(
      "store JSON",
    )
  }
  let mut restored = run SchemaJson.decode<CartStore>(Slice.view(&capture.bytes, 0, capture.length))
  if restored.context.items != 2 {
    Intrinsic.trap("the restored store has its items")
  }

  // An actor performs the effects the reducer queues, and raised events are applied in the
  // same send.
  run Actors.send(&mut restored, CartEvent.Remove { count: 5 }, perform)
  if restored.context.items != 0 || restored.context.changes != 4 {
    Intrinsic.trap("removing the last items raises Clear, which empties the cart")
  }
  if restored.pending.length() != 0 {
    Intrinsic.trap("the report was performed")
  }
  return ()
}

test effect fn storeReducesAndPerforms()
  ! OutOfMemoryError | TransitionLoopError | SchemaError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut reports = TestReports { empties: 0 }
  run storeScenario()
    |> Effect.provideMut<Reports>(&mut reports)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if reports.empties != 1 {
    Intrinsic.trap("expected one report of an empty cart")
  }
  return ()
}
