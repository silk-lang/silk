// Hand-run CommonMark and performance driver. Argument one is the input path;
// argument two is optionally "parse" or "safe". The default enables reference HTML policy.
import silk.markdown.document { MarkdownDocument }
import silk.markdown.html { MarkdownHtml, HtmlOptions }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.host_input { HostInput, HostInputError }
import silk.system.filesystem { Path, FileSystem, FileError }
import silk.system.filesystem_machine { MachineFileSystem }
import silk.text.string { String, InvalidUtf8 }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter }
import silk.io.buffered_output { BufferedWriter }
import silk.io.buffered_input { BufferError }

static if Intrinsic.targetOperatingSystem() == "windows" {
  import silk.platform.windows.path { WindowsPath }
}

effect fn hostPath(raw: &[u8]) -> Path
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    return run WindowsPath.fromNativeBytes(raw)
  } else {
    return run Path.fromBytes(raw)
  }
}

effect fn execute() -> i32
  ! HostInputError | FileError | OutOfMemoryError | WriterError | BufferError
  ? &mut HostInput | &mut Allocator {
  let argument = match move run HostInput.argument(1) {
    Option<Bytes>.Some { value } => move value
    _ => {
      return 2
    }
  }
  let mode = run HostInput.argument(2)
  let mut parseOnly = false
  let mut options = HtmlOptions { rawHtml: true, unsafeLinks: true }
  if let Option<Bytes>.Some { value } = &mode {
    let modeText = String.fromUtf8(Bytes.asSlice(&value))
      |> Result<string, InvalidUtf8>.unwrapOr("")
    if modeText == "parse" {
      parseOnly = true
    }
    if modeText == "safe" {
      options = HtmlOptions.make()
    }
  }
  let path = run hostPath(Bytes.asSlice(&argument))
  let mut files = run MachineFileSystem.make()
  let data = run FileSystem.readFile(&path) |> Effect.provideMut<FileSystem>(&mut files)
  let text = match move String.fromUtf8(Bytes.asSlice(&data)) {
    Result<string, InvalidUtf8>.Success { value } => value
    _ => {
      return 4
    }
  }
  let document = run MarkdownDocument.parse(text)
  if MarkdownDocument.nodes(&document).length == 0 {
    return 3
  }
  let mut writer = run BufferedWriter<StdoutWriter>.make(StdoutWriter.make(), 65536)
  if !parseOnly {
    run MarkdownHtml.renderToWriterWithOptions(&document, &options)
      |> Effect.provideMut<Writer>(&mut writer)
  }
  run Writer.flush() |> Effect.provideMut<Writer>(&mut writer)
  return 0
}

pub effect fn main() -> i32
  ! HostInputError | FileError | OutOfMemoryError | WriterError | BufferError
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run execute() |> Effect.provideMut<Allocator>(&mut allocator)
}
