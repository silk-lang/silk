#!/usr/bin/env python3
"""Baseline-only executed Silk/ICU script-run comparison (not a PR-CI gate).

Requires silk, a C++17 compiler, pkg-config and installed ICU development files.
Usage: integration/unicode-conformance/check-unicode-itemization [--silk-executable PATH]
Set SILK to the silk command and SILK_STDLIB to a stdlib root to test a checkout.
The optional executable must implement itemization_reference.silk's output.

The reference algorithm is the unmodified ICU release-78.1 ScriptRun sample.
Its two source files are SHA256-pinned; the actual linked ICU/UCD versions are
printed because installed property data need not be Unicode 18. Shared cases
use long-established characters, not new Unicode 18 assignments. The sample
uses primary Script rather than Script_Extensions and lacks UAX24's combining
sequence recommendation. Those differences have explicit two-sided expectations,
not ignored mismatches. No native reference is linked into the stdlib.
"""
import argparse
import hashlib
import os
from pathlib import Path
import shlex
import subprocess
import urllib.request

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[1]
CACHE = ROOT / "build/unicode/reference/icu-78.1-script-run"
SOURCE = "https://raw.githubusercontent.com/unicode-org/icu/release-78.1/icu4c/source/extra/scrptrun/"
PINS = {
    "scrptrun.cpp": "e1f186ae89616030cb899d17e8bda194ae0ba063121e78853f28727ccb91fab1",
    "scrptrun.h": "75bcc2d48ac59de98be71e59905bc54c13d7d7043981d96acba09d4e7d9b037b",
}


def pinned_source(name, digest):
    path = CACHE / name
    data = path.read_bytes() if path.exists() else urllib.request.urlopen(SOURCE + name, timeout=60).read()
    actual = hashlib.sha256(data).hexdigest()
    if actual != digest:
        raise SystemExit(f"SHA256 mismatch for {path}: expected {digest}, got {actual}")
    if not path.exists():
        path.write_bytes(data)
    return path


def run(command):
    return subprocess.run(command, cwd=ROOT, check=True, text=True, capture_output=True).stdout.strip()


def build_probe():
    executable = CACHE / "itemization_reference"
    command = shlex.split(os.environ.get("SILK", "silk")) + [
        "build", str(HERE / "src/itemization_reference.silk"), "-o", str(executable),
        "--optimization", "speed", "--debug", "false"]
    if os.environ.get("SILK_STDLIB"):
        command += ["--stdlib", os.environ["SILK_STDLIB"]]
    subprocess.run(command, cwd=ROOT, check=True)
    return executable


def iso(tag):
    return int.from_bytes(tag.encode("ascii"), "big")


def runs(executable, text):
    output = run([str(executable), text])
    values = [tuple(map(int, row.split())) for row in output.splitlines()]
    end = 0
    boundaries = {0}
    for character in text:
        end += len(character.encode("utf-8"))
        boundaries.add(end)
    previous = 0
    for value in values:
        if len(value) != 3:
            raise AssertionError(f"invalid reference row {value!r}")
        start, stop, tag = value
        if start != previous or stop <= start or stop not in boundaries or tag <= 0:
            raise AssertionError(f"invalid UTF-8 run {value!r} for {text!r}")
        previous = stop
    if previous != end:
        raise AssertionError(f"incomplete byte coverage for {text!r}: {values!r}")
    return values


def expected(*entries):
    return [(start, end, iso(tag)) for start, end, tag in entries]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--silk-executable", type=Path, help="use an already-built diagnostic instead of building it")
    args = parser.parse_args()
    CACHE.mkdir(parents=True, exist_ok=True)
    for name, digest in PINS.items():
        pinned_source(name, digest)
    # The sample includes ICU's internal cmemory.h only for UPRV_LENGTHOF.
    # Supply that compile-time array-length macro, not a modified sample algorithm
    # or a dependency on private installed ICU headers.
    (CACHE / "cmemory.h").write_text("#pragma once\n#define UPRV_LENGTHOF(a) (sizeof(a) / sizeof((a)[0]))\n")
    reference = CACHE / "icu-script-run"
    compiler = shlex.split(os.environ.get("CXX", "c++"))
    flags = shlex.split(run(["pkg-config", "--cflags", "--libs", "icu-uc"]))
    subprocess.run(compiler + ["-std=c++17", "-O2", "-I", str(CACHE),
                   str(HERE / "unicode-itemization-reference.cpp"),
                   str(CACHE / "scrptrun.cpp"), "-o", str(reference)] + flags,
                   cwd=ROOT, check=True)
    print("Reference sample: ICU release-78.1 (SHA256 verified)", flush=True)
    print("Linked reference: " + run([str(reference), "--version"]), flush=True)
    print("Silk property data: Unicode 18.0.0", flush=True)
    if args.silk_executable is None:
        actual = build_probe()
    else:
        actual = args.silk_executable.resolve()

    shared = ["", " ... ", "  α!", "a, Б!", "é世界!", "😀a😀", "áБ",
              "a(γ)b", "a(α[Б]β)c", "a([Б)γ]", "a(Б]γ)", "a{}b",
              "a(😀γ)b", "a(α)[Б]{א}b", "א(abc)ב"]
    # Systematically cover script changes, common punctuation, nested brackets
    # and supplementary-plane neutral characters without the sample's fixed
    # 128-entry bracket-stack limit or language-dependent quote heuristics.
    for left in ("a", "α", "Б", "א", "ب", "漢"):
        for right in ("a", "α", "Б", "א", "ب", "漢"):
            shared.extend((left + ", " + right + "!",
                           left + "([" + right + "])" + left,
                           left + "(😀" + right + ")"))
    for text in shared:
        silk = runs(actual, text)
        icu = runs(reference, text)
        if silk != icu:
            raise AssertionError(f"shared case {text!r}: Silk={silk!r}, ICU={icu!r}")
    print(f"Matched {len(shared)} primary-Script/context/bracket cases", flush=True)

    differences = [
        ("Aーア", "Script_Extensions prevents U+30FC continuing Latin",
         expected((0, 1, "Latn"), (1, 7, "Kana")),
         expected((0, 4, "Latn"), (4, 7, "Kana"))),
        ("Aー", "isolated U+30FC resolves the Hira/Kana set deterministically",
         expected((0, 1, "Latn"), (1, 4, "Hira")),
         expected((0, 4, "Latn"))),
        ("Aـܐ", "U+0640 extension intersection selects following Syriac",
         expected((0, 1, "Latn"), (1, 5, "Syrc")),
         expected((0, 3, "Latn"), (3, 5, "Syrc"))),
        ("aְב", "UAX24 section 5.2 keeps a cross-script combining mark with its base",
         expected((0, 3, "Latn"), (3, 5, "Hebr")),
         expected((0, 1, "Latn"), (1, 5, "Hebr"))),
    ]
    for text, reason, silk_expected, icu_expected in differences:
        silk = runs(actual, text)
        icu = runs(reference, text)
        if silk != silk_expected or icu != icu_expected or silk == icu:
            raise AssertionError(f"documented difference {text!r}: Silk={silk!r}, ICU={icu!r}; "
                                 f"expected Silk={silk_expected!r}, ICU={icu_expected!r}")
        print(f"Confirmed intentional difference {text!r}: {reason}", flush=True)
    print(f"PASS: {len(shared)} matching cases; {len(differences)} explained differences", flush=True)


if __name__ == "__main__":
    main()
