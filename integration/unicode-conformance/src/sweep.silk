//! Runs every property lookup over the whole code point range and checks that none traps.
import silk.text.unicode { Unicode, Decomposed }
import silk.text.unicode_script { Script }
import silk.text.unicode_properties {
  GeneralCategory,
  CanonicalCombiningClass,
  BidiPairedBracketType,
  BidiClass,
  JoiningType,
  JoiningGroup,
  LineBreak,
  EastAsianWidth,
  GraphemeBreak,
  WordBreak,
  SentenceBreak,
  IndicConjunctBreak,
  VerticalOrientation,
}
import silk.core.option { Option }
import silk.testing.testing { Testing, AssertionError }
import silk.num.u8

test effect fn fullUnicodeRangeNoTrap() -> ()
  ! AssertionError<'static> {
  let mut cp: u32 = 0
  let mut classes: u32 = 0
  let mut scripts: u32 = 0
  let mut selectors: u32 = 0
  let mut ignorables: u32 = 0
  let mut pictographs: u32 = 0
  let mut seconds: u32 = 0
  let mut properties: [u32; 10] = [0; 10]
  while cp <= 0x10ffff {
    let category = GeneralCategory.of(cp)
    run Testing.expect(
      Unicode.isMark(cp)
        == (category == GeneralCategory.Mc || category == GeneralCategory.Me
          || category == GeneralCategory.Mn),
      "mark classification",
    )
    classes = classes + u8.toU32(CanonicalCombiningClass.of(cp).number())
    scripts = scripts | Script.of(cp).value
    run Testing.expect(Unicode.mirror(cp) <= 0x10ffff, "mirror result range")
    run Testing.expect(Unicode.verticalForm(cp) <= 0x10ffff, "vertical result range")
    let extensions = Script.extensions(cp)
    run Testing.expect(extensions.length() > 0, "script extensions are nonempty")
    run Testing.expect(Unicode.bidiPairedBracket(cp) <= 0x10ffff, "bracket result range")
    if BidiPairedBracketType.of(cp) != BidiPairedBracketType.None {
      run Testing.expect(
        Unicode.bidiPairedBracket(Unicode.bidiPairedBracket(cp)) == cp,
        "paired brackets are symmetric",
      )
    }
    if BidiClass.of(cp) == BidiClass.AL {
      properties[0] = properties[0] + 1
    }
    if JoiningType.of(cp) == JoiningType.D {
      properties[1] = properties[1] + 1
    }
    if JoiningGroup.of(cp) == JoiningGroup.Alaph {
      properties[2] = properties[2] + 1
    }
    if LineBreak.of(cp) == LineBreak.BK {
      properties[3] = properties[3] + 1
    }
    if EastAsianWidth.of(cp) == EastAsianWidth.W {
      properties[4] = properties[4] + 1
    }
    if GraphemeBreak.of(cp) == GraphemeBreak.Extend {
      properties[5] = properties[5] + 1
    }
    if WordBreak.of(cp) == WordBreak.Hebrew_Letter {
      properties[6] = properties[6] + 1
    }
    if SentenceBreak.of(cp) == SentenceBreak.ATerm {
      properties[7] = properties[7] + 1
    }
    if IndicConjunctBreak.of(cp) == IndicConjunctBreak.Linker {
      properties[8] = properties[8] + 1
    }
    if VerticalOrientation.of(cp) == VerticalOrientation.Tu {
      properties[9] = properties[9] + 1
    }
    run Testing.expect(
      !Unicode.isEmojiPresentation(cp) || Unicode.isEmoji(cp),
      "emoji presentation is emoji",
    )
    run Testing.expect(
      !Unicode.isEmojiModifier(cp) || Unicode.isEmojiComponent(cp),
      "emoji modifier is component",
    )
    run Testing.expect(
      !Unicode.isEmojiModifierBase(cp) || Unicode.isEmoji(cp),
      "emoji base is emoji",
    )
    run Testing.expect(
      !Unicode.isRegionalIndicator(cp) || Unicode.isEmojiComponent(cp),
      "regional indicator is emoji component",
    )
    if Unicode.isVariationSelector(cp) {
      selectors = selectors + 1
    }
    if Unicode.isDefaultIgnorable(cp) {
      ignorables = ignorables + 1
    }
    if Unicode.isExtendedPictographic(cp) {
      pictographs = pictographs + 1
    }
    if Unicode.composesAsSecond(cp) {
      seconds = seconds + 1
    }
    let decompositionInRange = match move Unicode.decompose(cp) {
      Option<Decomposed>.None => true
      Option<Decomposed>.Some { value: Decomposed.Singleton { scalar } } => scalar <= 0x10ffff
      Option<Decomposed>.Some { value: Decomposed.Pair { first, second } } => first <= 0x10ffff
        && second <= 0x10ffff
    }
    run Testing.expect(decompositionInRange, "decomposition range")
    let asFirst = Unicode.compose(cp, 0x301) |> Option<u32>.unwrapOr(0)
    let asSecond = Unicode.compose(0x41, cp) |> Option<u32>.unwrapOr(0)
    run Testing.expect(asFirst <= 0x10ffff && asSecond <= 0x10ffff, "composition input domains")
    cp = cp + 1
  }
  let mut property: usize = 0
  while property < properties.length {
    run Testing.expect(properties[property] > 0, "typed property table was traversed")
    property = property + 1
  }
  run Testing.expect(classes > 0 && scripts != 0, "class and script tables were traversed")
  run Testing.expect(selectors == 260, "standard and Mongolian selector ranges were traversed")
  run Testing.expect(
    ignorables > 0 && pictographs > 0 && seconds > 0,
    "boolean tables were traversed",
  )
}
