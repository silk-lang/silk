//! Full Unicode 18 segmentation conformance; inputs are fetched and hash-checked
//! by scripts/unicode/fetch-unicode. No rows or code points are filtered or tailored.
import silk.text.segmentation
import test_support as Scan
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.system.filesystem { Path, FileSystem, FileError }
import silk.system.host_input { HostInputError }

static if Intrinsic.targetOperatingSystem() == "windows" {
  import silk.platform.windows.host_input { WindowsHostInput }
  import silk.system.host_input { HostInput }
} else {
  import silk.platform.native.host_input { NativeHostInput }
}

import silk.system.filesystem_native { OsFileSystem }
import silk.io.writer_native { StderrWriter }
import silk.io.writer { Writer, WriterError }
import silk.text.format { Format }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.testing.testing { Testing, AssertionError }

fn same(left: &[usize], right: &[usize]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut i: usize = 0
  while i < left.length {
    if left[i] != right[i] {
      return false
    }
    i = i + 1
  }
  return true
}

effect fn conformance(name: string, kind: u8) -> ()
  ! FileError | HostInputError | OutOfMemoryError | AssertionError<'static> | WriterError
  ? &mut Allocator {
  let cwd = run workingDirectory()
  let root = run Path.root()
  let path = run Path.resolve(&root, name)
  let mut files = run OsFileSystem.makeBytes(Bytes.asSlice(&cwd))
  let contents = run FileSystem.readFile(&path) |> Effect.provideMut<FileSystem>(&mut files)
  let data = Bytes.asSlice(&contents)
  let mut text = List<u8>.make()
  let mut expected = List<usize>.make()
  let mut actual = List<usize>.make()
  let mut at: usize = 0
  let mut lineNumber: usize = 0
  let mut cases: usize = 0
  let mut failures: usize = 0
  while at < data.length {
    let row = Scan.view(data, Scan.line(data, &mut at))
    lineNumber = lineNumber + 1
    let mut comment: usize = 0
    let body = Scan.trim(Scan.view(row, Scan.field(row, &mut comment, 35)))
    if body.length == 0 {
      continue
    }
    List<u8>.clear(&mut text)
    List<usize>.clear(&mut expected)
    List<usize>.clear(&mut actual)
    let mut position: usize = 0
    let mut marker = true
    let mut finalBreak = false
    while position < body.length {
      let token = Scan.view(body, Scan.word(body, &mut position))
      if marker {
        let boundary = Scan.equal(token, b"\xc3\xb7")
        run Testing.expect(boundary || Scan.equal(token, b"\xc3\x97"), "invalid break-test marker")
        finalBreak = boundary
        if boundary {
          run List<usize>.append(&mut expected, List<u8>.length(&text))
        }
      } else {
        let value = Scan.number(token, 16)
        run Testing.expect(value.isSome(), "invalid break-test code point")
        run Scan.appendScalar(move value |> Option<u32>.unwrapOr(0), &mut text)
      }
      marker = !marker
    }
    run Testing.expect(!marker && finalBreak, "missing terminal break-test marker")
    run Testing.expect(
      List<usize>.length(&expected) != 0 && List<usize>.get(&expected, 0) == 0,
      "missing initial break-test marker",
    )
    if kind == 0 {
      run segmentation.graphemes(Scan.text(List<u8>.asSlice(&text)), &mut actual)
    } else if kind == 1 {
      run segmentation.words(Scan.text(List<u8>.asSlice(&text)), &mut actual)
    } else {
      run segmentation.sentences(Scan.text(List<u8>.asSlice(&text)), &mut actual)
    }
    cases = cases + 1
    if !same(List<usize>.asSlice(&actual), List<usize>.asSlice(&expected)) {
      failures = failures + 1

      // Formatting is failure-only, never part of the per-item algorithm path.
      let mut writer = StderrWriter.make()
      run Format.format(
        "{file}:{line}: segmentation mismatch\n",
        &.{ file: name, line: lineNumber },
      )
        |> Effect.provideMut<Writer>(&mut writer)
    }
  }
  run Testing.expect(cases != 0, "empty segmentation conformance file")
  run Testing.expect(failures == 0, "Unicode segmentation conformance failures (see stderr lines)")
}

test effect fn fullGraphemeBreakTest() -> ()
  ! FileError | HostInputError | OutOfMemoryError | AssertionError<'static> | WriterError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run conformance("build/unicode/18.0.0/auxiliary/GraphemeBreakTest.txt", 0)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn fullWordBreakTest() -> ()
  ! FileError | HostInputError | OutOfMemoryError | AssertionError<'static> | WriterError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run conformance("build/unicode/18.0.0/auxiliary/WordBreakTest.txt", 1)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn fullSentenceBreakTest() -> ()
  ! FileError | HostInputError | OutOfMemoryError | AssertionError<'static> | WriterError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run conformance("build/unicode/18.0.0/auxiliary/SentenceBreakTest.txt", 2)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn workingDirectory() -> Bytes
  ! HostInputError | OutOfMemoryError
  ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    let mut inputs = run WindowsHostInput.capture()
    return run HostInput.workingDirectory() |> Effect.provideMut<HostInput>(&mut inputs)
  } else {
    return run NativeHostInput.workingDirectory()
  }
}
