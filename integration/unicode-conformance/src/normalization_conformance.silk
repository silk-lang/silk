//! Checks Unicode.normalizeNfc and Unicode.normalizeNfd against every column of the
//! pinned Unicode 18 NormalizationTest.txt.
import silk.text.unicode { Unicode }
import silk.text.string { String }
import test_support as Scan
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.system.filesystem { Path, FileSystem, FileError }
import silk.text.format { Format }
import silk.system.host_input { HostInputError }
import silk.collections.list { List }

static if Intrinsic.targetOperatingSystem() == "windows" {
  import silk.platform.windows.host_input { WindowsHostInput }
  import silk.system.host_input { HostInput }
} else {
  import silk.platform.native.host_input { NativeHostInput }
}

import silk.core.option { Option }
import silk.system.filesystem_native { OsFileSystem }
import silk.io.writer_native { StderrWriter }
import silk.testing.testing { Testing, AssertionError }
import silk.io.writer { Writer, WriterError }

effect fn column(body: &[u8], position: &mut usize, output: &mut List<u8>) -> ()
  ! OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  List<u8>.clear(&mut output)
  let text = Scan.trim(Scan.view(body, Scan.field(body, &mut position, 59)))
  run Testing.expect(text.length != 0, "empty normalization column")
  run Testing.expect(
    position.* > 0 && body[position.* - 1] == 59,
    "missing normalization column delimiter",
  )
  let mut at: usize = 0
  while at < text.length {
    let token = Scan.view(text, Scan.word(text, &mut at))
    let number = Scan.number(token, 16)
    run Testing.expect(number.isSome(), "invalid normalization scalar")
    run Scan.appendScalar(move number |> Option<u32>.unwrapOr(0), &mut output)
  }
}

effect fn mismatch(line: usize, column: usize, form: string) -> ()
  ! OutOfMemoryError | WriterError
  ? &mut Allocator {
  let mut writer = StderrWriter.make()
  run Format.format(
    "NormalizationTest.txt:{line}: {form}(c{column}) mismatch\n",
    &.{ line: line, form: form, column: column },
  )
    |> Effect.provideMut<Writer>(&mut writer)
}

// The expected bytes come only from the fixture's columns, never from another
// normalizer or generated property data. Both forms run even after a failure.
effect fn relationships(
  input: &[u8],
  expectedNfc: &[u8],
  expectedNfd: &[u8],
  line: usize,
  column: usize,
) -> usize
  ! OutOfMemoryError | WriterError
  ? &mut Allocator {
  let text = Scan.text(input)
  let mut failures: usize = 0
  let nfd = run Unicode.normalizeNfd(text)
  if !Scan.equal(String.utf8Bytes(nfd.view()), expectedNfd) {
    failures = failures + 1
    run mismatch(line, column, "NFD")
  }
  let nfc = run Unicode.normalizeNfc(text)
  if !Scan.equal(String.utf8Bytes(nfc.view()), expectedNfc) {
    failures = failures + 1
    run mismatch(line, column, "NFC")
  }
  return failures
}

effect fn conformance() -> ()
  ! FileError | HostInputError | OutOfMemoryError | AssertionError<'static> | WriterError
  ? &mut Allocator {
  let cwd = run workingDirectory()
  let root = run Path.root()
  let path = run Path.resolve(&root, "build/unicode/18.0.0/NormalizationTest.txt")
  let mut files = run OsFileSystem.makeBytes(Bytes.asSlice(&cwd))
  let contents = run FileSystem.readFile(&path) |> Effect.provideMut<FileSystem>(&mut files)
  let data = Bytes.asSlice(&contents)
  let mut c1 = List<u8>.make()
  let mut c2 = List<u8>.make()
  let mut c3 = List<u8>.make()
  let mut c4 = List<u8>.make()
  let mut c5 = List<u8>.make()
  let mut at: usize = 0
  let mut line: usize = 0
  let mut cases: usize = 0
  let mut failures: usize = 0
  while at < data.length {
    let row = Scan.view(data, Scan.line(data, &mut at))
    line = line + 1
    let mut comment: usize = 0
    let body = Scan.trim(Scan.view(row, Scan.field(row, &mut comment, 35)))
    if body.length == 0 {
      continue
    }

    // @Part directives divide the file into sections; they are not test rows.
    if body[0] == 64 {
      continue
    }
    let mut position: usize = 0
    run column(body, &mut position, &mut c1)
    run column(body, &mut position, &mut c2)
    run column(body, &mut position, &mut c3)
    run column(body, &mut position, &mut c4)
    run column(body, &mut position, &mut c5)
    run Testing.expect(position == body.length, "unexpected normalization columns")
    failures = failures
      + run relationships(
        List<u8>.asSlice(&c1),
        List<u8>.asSlice(&c2),
        List<u8>.asSlice(&c3),
        line,
        1,
      )
    failures = failures
      + run relationships(
        List<u8>.asSlice(&c2),
        List<u8>.asSlice(&c2),
        List<u8>.asSlice(&c3),
        line,
        2,
      )
    failures = failures
      + run relationships(
        List<u8>.asSlice(&c3),
        List<u8>.asSlice(&c2),
        List<u8>.asSlice(&c3),
        line,
        3,
      )
    failures = failures
      + run relationships(
        List<u8>.asSlice(&c4),
        List<u8>.asSlice(&c4),
        List<u8>.asSlice(&c5),
        line,
        4,
      )
    failures = failures
      + run relationships(
        List<u8>.asSlice(&c5),
        List<u8>.asSlice(&c4),
        List<u8>.asSlice(&c5),
        line,
        5,
      )
    cases = cases + 1
  }
  run Testing.expect(cases == 20171, "complete pinned Unicode 18 normalization row count")
  run Testing.expect(failures == 0, "Unicode normalization conformance failures (see stderr)")
}

test effect fn fullNormalizationTest() -> ()
  ! FileError | HostInputError | OutOfMemoryError | AssertionError<'static> | WriterError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run conformance() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn workingDirectory() -> Bytes
  ! HostInputError | OutOfMemoryError
  ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    let mut inputs = run WindowsHostInput.capture()
    return run HostInput.workingDirectory() |> Effect.provideMut<HostInput>(&mut inputs)
  } else {
    return run NativeHostInput.workingDirectory()
  }
}
