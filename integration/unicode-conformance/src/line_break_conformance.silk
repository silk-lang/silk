//! Every row of the SHA256-pinned Unicode 18 LineBreakTest.txt, with no exclusions.
//! Run from the repository root after scripts/unicode/fetch-unicode:
//! silk test --release --manifest-path integration/unicode-conformance/silk.toml --root src/line_break_conformance.silk
import silk.text.line_break
import silk.text.line_break { LineOptions, BreakOpportunity }
import test_support as Scan
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.system.filesystem { Path, FileSystem, FileError }
import silk.text.format { Format }
import silk.system.host_input { HostInputError }
import silk.collections.list { List }

static if Intrinsic.targetOperatingSystem() == "windows" {
  import silk.platform.windows.host_input { WindowsHostInput }
  import silk.system.host_input { HostInput }
} else {
  import silk.platform.native.host_input { NativeHostInput }
}

import silk.core.option { Option }
import silk.system.filesystem_native { OsFileSystem }
import silk.io.writer_native { StderrWriter }
import silk.testing.testing { Testing, AssertionError }
import silk.io.writer { Writer, WriterError }

effect fn conformance() -> ()
  ! AssertionError<'static> | OutOfMemoryError | FileError | HostInputError | WriterError
  ? &mut Allocator {
  let cwd = run workingDirectory()
  let root = run Path.root()
  let path = run Path.resolve(&root, "build/unicode/18.0.0/auxiliary/LineBreakTest.txt")
  let mut files = run OsFileSystem.makeBytes(Bytes.asSlice(&cwd))
  let content = run FileSystem.readFile(&path) |> Effect.provideMut<FileSystem>(&mut files)
  let data = Bytes.asSlice(&content)
  let mut input = List<u8>.make()
  let mut expected = List<usize>.make()
  let mut actual = List<BreakOpportunity>.make()
  let mut at: usize = 0
  let mut lineNumber: usize = 0
  let mut cases: usize = 0
  let mut failures: usize = 0
  while at < data.length {
    let span = Scan.line(data, &mut at)
    lineNumber = lineNumber + 1
    let line = Scan.view(data, span)
    let mut commentAt: usize = 0
    let bodySpan = Scan.field(line, &mut commentAt, 35)
    let body = Scan.trim(Scan.view(line, bodySpan))
    if body.length == 0 {
      continue
    }
    input.clear()
    expected.clear()
    actual.clear()
    let mut tokenAt: usize = 0
    let mut needMarker = true
    while tokenAt < body.length {
      let tokenSpan = Scan.word(body, &mut tokenAt)
      let token = Scan.view(body, tokenSpan)
      if token.length == 0 {
        break
      }
      if needMarker {
        let yes = Scan.equal(token, b"\xc3\xb7")
        run Testing.expect(yes || Scan.equal(token, b"\xc3\x97"), "LineBreakTest boundary marker")
        if yes {
          run expected.append(input.length())
        }
      } else {
        let parsed = Scan.number(token, 16)
        run Testing.expect(parsed.isSome(), "LineBreakTest hexadecimal scalar")
        let cp = move parsed |> Option<u32>.unwrapOr(0)
        run Testing.expect(
          cp <= 0x10ffff && !(cp >= 0xd800 && cp <= 0xdfff),
          "LineBreakTest scalar domain",
        )
        run Scan.appendScalar(cp, &mut input)
      }
      needMarker = !needMarker
    }
    run Testing.expect(!needMarker && input.length() > 0, "complete LineBreakTest row")
    run line_break.breaks(Scan.text(List<u8>.asSlice(&input)), LineOptions.make(), &mut actual)
    let mut same = actual.length() == expected.length()
    let mut i: usize = 0
    while same && i < expected.length() {
      same = actual.get(i).offset == expected.get(i)
      i = i + 1
    }
    if !same {
      failures = failures + 1
      if failures <= 10 {
        let mut writer = StderrWriter.make()
        run Format.format(
          "LineBreakTest line {line}: expected {expected} opportunities, got {actual}; first differing index {index}\n",
          &.{ line: lineNumber, expected: expected.length(), actual: actual.length(), index: i },
        )
          |> Effect.provideMut<Writer>(&mut writer)
      }
    }
    cases = cases + 1
  }

  // Pinned file's '# Lines: 19346' trailer. This also detects truncated caches.
  run Testing.expect(cases == 19346, "all Unicode 18 LineBreakTest rows executed")
  run Testing.expect(failures == 0, "Unicode 18 line breaking conformance")
}

test effect fn allUnicode18LineBreakRows() -> ()
  ! AssertionError<'static> | OutOfMemoryError | FileError | HostInputError | WriterError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run conformance() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn workingDirectory() -> Bytes
  ! HostInputError | OutOfMemoryError
  ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    let mut inputs = run WindowsHostInput.capture()
    return run HostInput.workingDirectory() |> Effect.provideMut<HostInput>(&mut inputs)
  } else {
    return run NativeHostInput.workingDirectory()
  }
}
