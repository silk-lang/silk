//! Baseline-only diagnostic for integration/unicode-conformance/check-unicode-itemization.
//! Prints actual ScriptRun byte ranges and numeric ISO tags for one UTF-8 argument.
import silk.text.script_itemization { ScriptRun }
import silk.text.script_itemization as itemization
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.text.string { String, InvalidUtf8 }
import silk.core.result { Result }
import silk.core.effect { Effect }
import silk.text.format { Format }
import silk.system.host_input { HostInput, HostInputError }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.io.writer_native { StdoutWriter, StderrWriter }
import silk.io.writer { Writer, WriterError }

effect fn report() -> i32
  ! HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator {
  if (run HostInput.argumentCount()) != 2 {
    let mut error = StderrWriter.make()
    run Writer.writeString("usage: itemization_reference TEXT\n")
      |> Effect.provideMut<Writer>(&mut error)
    return 2
  }
  let argument = run HostInput.argument(1)
  if let Option<Bytes>.Some { value: bytes } = move argument {
    let text = match String.fromUtf8(Bytes.asSlice(&bytes)) {
      Result<string, InvalidUtf8>.Success { value } => value
      Result<string, InvalidUtf8>.Failure { error } => {
        drop error
        return 2
      }
    }
    let mut runs = List<ScriptRun>.make()
    run itemization.scripts(text, &mut runs)
    let values = List<ScriptRun>.asSlice(&runs)
    let mut writer = StdoutWriter.make()
    let mut i: usize = 0
    while i < values.length {
      let value = values[i]
      run Format.format(
        "{start} {end} {script}\n",
        &.{ start: value.start, end: value.end, script: value.script.value },
      )
        |> Effect.provideMut<Writer>(&mut writer)
      i = i + 1
    }
    return 0
  }
  return 2
}

effect fn failed<E>(error: E) -> i32
  ! WriterError {
  drop error
  let mut writer = StderrWriter.make()
  run Writer.writeString("itemization_reference: unable to process input\n")
    |> Effect.provideMut<Writer>(&mut writer)
  return 2
}

pub effect fn main() -> i32
  ! WriterError
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(report(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
}
