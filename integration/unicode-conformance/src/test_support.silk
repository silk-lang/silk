//! Nonallocating scanners for the pinned Unicode conformance files.
import silk.core.ownership { Copy }
import silk.core.option { Option }
import silk.collections.slice { Slice }
import silk.num.u8
import silk.text.string { String }
import silk.num.u32
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }

pub struct Span {
  pub start: usize,
  pub end: usize
}

impl Copy for Span {}

pub fn line(data: &[u8], at: &mut usize) -> Span {
  let start = at.*
  while at.* < data.length && data[at.*] != 10 {
    at.* = at.* + 1
  }
  let end = at.*
  if at.* < data.length {
    at.* = at.* + 1
  }
  return Span { start: start, end: end }
}

pub fn field(data: &[u8], at: &mut usize, delimiter: u8) -> Span {
  let start = at.*
  while at.* < data.length && data[at.*] != delimiter {
    at.* = at.* + 1
  }
  let end = at.*
  if at.* < data.length {
    at.* = at.* + 1
  }
  return Span { start: start, end: end }
}

pub fn whitespace(value: u8) -> bool {
  return value == 32 || value == 9 || value == 10 || value == 13
}

pub fn word(data: &[u8], at: &mut usize) -> Span {
  while at.* < data.length && whitespace(data[at.*]) {
    at.* = at.* + 1
  }
  let start = at.*
  while at.* < data.length && !whitespace(data[at.*]) {
    at.* = at.* + 1
  }
  return Span { start: start, end: at.* }
}

pub fn view<'a>(data: &'a [u8], span: Span) -> &'a [u8] {
  return Slice.view<u8>(data, span.start, span.end - span.start)
}

pub fn trim<'a>(data: &'a [u8]) -> &'a [u8] {
  let mut start: usize = 0
  let mut end = data.length
  while start < end && whitespace(data[start]) {
    start = start + 1
  }
  while end > start && whitespace(data[end - 1]) {
    end = end - 1
  }
  return Slice.view<u8>(data, start, end - start)
}

pub fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut i: usize = 0
  while i < left.length {
    if left[i] != right[i] {
      return false
    }
    i = i + 1
  }
  return true
}

pub fn number(data: &[u8], radix: u32) -> Option<u32> {
  if data.length == 0 || radix < 2 || radix > 16 {
    return Option<u32>.None
  }
  let mut value: u32 = 0
  let mut i: usize = 0
  while i < data.length {
    let byte = data[i]
    let mut digit: u32 = 16
    if byte >= 48 && byte <= 57 {
      digit = u8.toU32(byte - 48)
    } else if byte >= 65 && byte <= 70 {
      digit = u8.toU32(byte - 65) + 10
    } else if byte >= 97 && byte <= 102 {
      digit = u8.toU32(byte - 97) + 10
    }
    if digit >= radix || value > (u32.MAX - digit) / radix {
      return Option<u32>.None
    }
    value = value * radix + digit
    i = i + 1
  }
  return Option<u32>.some(value)
}

/// Append one Unicode scalar; reject invalid conformance input rather than replacing it.
pub effect fn appendScalar(cp: u32, output: &mut List<u8>) -> ()
  ! OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  run Testing.expect(cp <= 0x10ffff && !(cp >= 0xd800 && cp <= 0xdfff), "conformance scalar range")
  if cp < 0x80 {
    run output.append(u32.toU8(cp))
  } else if cp < 0x800 {
    run output.append(u32.toU8(0xc0 | u32.shiftRight(cp, 6)))
    run output.append(u32.toU8(0x80 | (cp & 63)))
  } else if cp < 0x10000 {
    run output.append(u32.toU8(0xe0 | u32.shiftRight(cp, 12)))
    run output.append(u32.toU8(0x80 | (u32.shiftRight(cp, 6) & 63)))
    run output.append(u32.toU8(0x80 | (cp & 63)))
  } else {
    run output.append(u32.toU8(0xf0 | u32.shiftRight(cp, 18)))
    run output.append(u32.toU8(0x80 | (u32.shiftRight(cp, 12) & 63)))
    run output.append(u32.toU8(0x80 | (u32.shiftRight(cp, 6) & 63)))
    run output.append(u32.toU8(0x80 | (cp & 63)))
  }
}

/// View bytes built by `appendScalar` as text. The scanners only append valid scalars.
pub fn text(bytes: &[u8]) -> string {
  return unsafe String.fromUtf8Unchecked(bytes)
}
