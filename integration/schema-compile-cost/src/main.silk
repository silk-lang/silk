import silk.build.request { Request }
import silk.core.effect { Effect }
import silk.io.writer { Writer, WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.issue { SchemaError }
import silk.schema.json { SchemaJson }
import silk.schema.toml { SchemaToml }
import silk.text.string { String }

const tomlRequest: string = """
version = 1
name = "silk-compiler"
artifact = "executable"
root = "/project/compiler/src/main.silk"
root-module = "main.silk"
output = "/project/build/compiler"
stdlib = "/project/stdlib"
profile = {target = "x86_64-unknown-linux-gnu", cpu = "x86-64", cpu-features = ["sse2"], libc = "gnu", entry = "default", runtime = "default", link = "dynamic", code-model = "small", relocation = "static", optimization = "speed", debug = false, safety = "checked", threading = "single", sanitizers = [], unwind = "none", backend = "llvm", codegen-units = 1}
packages = [{name = "silk-compiler", version = "0.0.0", directory = "/project/compiler", source = "/project/compiler/src", dependencies = [{name = "tomledit", package = "tomledit@0.0.0"}], exports = [], parameters = [], modules = []}, {name = "tomledit", version = "0.0.0", directory = "/project/tomledit", source = "/project/tomledit/src", dependencies = [], exports = ["ManifestEdit.silk"], parameters = [], modules = []}]
composition = {runtime = {package = "silk", module = "silk/platform/native/start_sync.silk"}, support = [], retention = [], storage = {create = {package = "silk", module = "silk/concurrency/execution_storage.silk", declaration = "silk_execution_storage_create"}, acquire = {package = "silk", module = "silk/concurrency/execution_storage.silk", declaration = "silk_execution_storage_acquire"}, release = {package = "silk", module = "silk/concurrency/execution_storage.silk", declaration = "silk_execution_storage_release"}, destroy = {package = "silk", module = "silk/concurrency/execution_storage.silk", declaration = "silk_execution_storage_destroy"}}}
native = {sources = [], link = []}
emit = "final"
"""

const jsonRequest: string = """
{
  "version": 1,
  "name": "silk-compiler",
  "artifact": "executable",
  "root": "/project/compiler/src/main.silk",
  "root-module": "main.silk",
  "output": "/project/build/compiler",
  "stdlib": "/project/stdlib",
  "profile": {
    "target": "x86_64-unknown-linux-gnu",
    "cpu": "x86-64",
    "cpu-features": [
      "sse2"
    ],
    "libc": "gnu",
    "entry": "default",
    "runtime": "default",
    "link": "dynamic",
    "code-model": "small",
    "relocation": "static",
    "optimization": "speed",
    "debug": false,
    "safety": "checked",
    "threading": "single",
    "sanitizers": [],
    "unwind": "none",
    "backend": "llvm",
    "codegen-units": 1
  },
  "packages": [
    {
      "name": "silk-compiler",
      "version": "0.0.0",
      "directory": "/project/compiler",
      "source": "/project/compiler/src",
      "dependencies": [
        {
          "name": "tomledit",
          "package": "tomledit@0.0.0"
        }
      ],
      "exports": [],
      "parameters": [],
      "modules": []
    },
    {
      "name": "tomledit",
      "version": "0.0.0",
      "directory": "/project/tomledit",
      "source": "/project/tomledit/src",
      "dependencies": [],
      "exports": [
        "ManifestEdit.silk"
      ],
      "parameters": [],
      "modules": []
    }
  ],
  "composition": {
    "runtime": {
      "package": "silk",
      "module": "silk/platform/native/start_sync.silk"
    },
    "support": [],
    "retention": [],
    "storage": {
      "create": {
        "package": "silk",
        "module": "silk/concurrency/execution_storage.silk",
        "declaration": "silk_execution_storage_create"
      },
      "acquire": {
        "package": "silk",
        "module": "silk/concurrency/execution_storage.silk",
        "declaration": "silk_execution_storage_acquire"
      },
      "release": {
        "package": "silk",
        "module": "silk/concurrency/execution_storage.silk",
        "declaration": "silk_execution_storage_release"
      },
      "destroy": {
        "package": "silk",
        "module": "silk/concurrency/execution_storage.silk",
        "declaration": "silk_execution_storage_destroy"
      }
    }
  },
  "native": {
    "sources": [],
    "link": []
  },
  "emit": "final"
}
"""

struct Counter { bytes: usize }
impl Writer for Counter {
  effect fn writeAll(self: &mut Self, bytes: &[u8]) -> () ! WriterError { self.bytes = self.bytes + bytes.length }
  effect fn flush(self: &mut Self) -> () ! WriterError {}
}
effect fn codecs() -> i32 ! SchemaError | WriterError | OutOfMemoryError ? &mut Allocator {
  let toml = run SchemaToml.decode<Request>(String.utf8Bytes(tomlRequest))
  let json = run SchemaJson.decode<Request>(String.utf8Bytes(jsonRequest))
  let mut sink = Counter {bytes: 0}
  run SchemaToml.encode<Request>(&json) |> Effect.provideMut<Writer>(&mut sink)
  let tomlBytes = sink.bytes
  run SchemaJson.encode<Request>(&toml) |> Effect.provideMut<Writer>(&mut sink)
  if tomlBytes > 0 && sink.bytes > tomlBytes { return 0 }
  return 1
}
pub effect fn main() -> i32 ! SchemaError | WriterError | OutOfMemoryError {
  let mut system = Allocator.systemAllocatorProvider()
  return run codecs() |> Effect.provideMut<Allocator>(&mut system)
}
