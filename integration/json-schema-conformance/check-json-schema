#!/usr/bin/env python3
"""Run the native Silk validator against a pinned official JSON Schema Test Suite.

All required and optional cases for the five supported drafts run by default, including
format assertion cases. Proposals for unpublished specifications are not selected.
The native runner receives original JSON text, without converting numbers through Python.

--manifest-schema [PATH] instead validates the TOML-authored manifest schema against the
official Draft 2020-12 metaschema, every git-tracked silk.toml, and manifest-cases.json.
Both schema and document TOML are parsed by the native runner, not Python. Manifest
instances omit tool-owned data before JSON conversion, as the compiler does. This mode
uses the runner's bundled official metaschema registry and needs no suite download.
"""
import argparse
import collections
import hashlib
import io
import json
import os
from pathlib import Path
import subprocess
import sys
import tarfile
import urllib.request

ROOT = Path(__file__).resolve().parents[2]
REVISION = "245a45abc90190c0bff04d97e6d2b541b4bb9f12"
ARCHIVE_SHA256 = "b60bdf58fd414e9b86c8be70b03e3b2d596b8bc3bc822a2083d86041cea4b20e"
URL = f"https://codeload.github.com/json-schema-org/JSON-Schema-Test-Suite/tar.gz/{REVISION}"
CACHE = ROOT / "build/json-schema-conformance"
DRAFTS = ("draft4", "draft6", "draft7", "draft2019-09", "draft2020-12")


def fetch():
    suite = CACHE / f"JSON-Schema-Test-Suite-{REVISION}"
    archive = CACHE / f"{REVISION}.tar.gz"
    if archive.is_file():
        data = archive.read_bytes()
    else:
        with urllib.request.urlopen(URL, timeout=60) as response:
            data = response.read()
    if hashlib.sha256(data).hexdigest() != ARCHIVE_SHA256:
        raise SystemExit("JSON Schema suite archive does not match its pinned SHA-256")
    CACHE.mkdir(parents=True, exist_ok=True)
    if not archive.is_file():
        archive.write_bytes(data)
    if not suite.is_dir():
        with tarfile.open(fileobj=io.BytesIO(data), mode="r:gz") as source:
            source.extractall(CACHE, filter="data")
    return suite


def resources(suite):
    parts = []
    for path in sorted((suite / "remotes").rglob("*.json")):
        uri = "http://localhost:1234/" + path.relative_to(suite / "remotes").as_posix()
        parts.append('{"uri":' + json.dumps(uri) + ',"schema":' + path.read_text() + '}')
    return '[' + ','.join(parts) + ']'


def fixtures(suite, drafts, matching):
    for draft in drafts:
        directory = suite / "tests" / draft
        paths = sorted(directory.glob("*.json")) + sorted((directory / "optional").rglob("*.json"))
        for path in paths:
            relative = path.relative_to(directory).as_posix()
            if matching and matching not in relative:
                continue
            original = path.read_text(encoding="utf-8")
            # Only descriptions and expected booleans are consumed from this parsed form.
            # Schema and instance numbers go to the native parser in `original` unchanged.
            groups = json.loads(original)
            expected = [
                {"draft": draft, "file": relative, "group": group["description"],
                 "test": test["description"], "expected": "VALID" if test["valid"] else "INVALID"}
                for group in groups for test in group["tests"]
            ]
            yield draft, relative, original, expected


def build():
    manifest = ROOT / "integration/json-schema-conformance/silk.toml"
    command = [os.environ.get("SILK", "silk"), "build", "--release", "--manifest-path", str(manifest),
               "--stdlib", os.environ.get("SILK_STDLIB", str(ROOT / "stdlib"))]
    subprocess.run(command, cwd=ROOT, check=True)
    name = "json-schema-conformance.exe" if os.name == "nt" else "json-schema-conformance"
    binaries = list((manifest.parent / "build/llvm").glob(f"*/release/{name}"))
    if len(binaries) != 1:
        raise SystemExit(f"expected one native runner, found {len(binaries)}; use --runner")
    return binaries[0]


def execute(runner, path, count):
    try:
        process = subprocess.run([str(runner), str(path)], capture_output=True, text=True, timeout=120)
        lines = process.stdout.splitlines()
        if process.returncode != 0 or len(lines) != count:
            outcome = f"RUNNER_ERROR(exit={process.returncode},rows={len(lines)}/{count})"
            lines = [outcome] * count
            if process.stderr:
                print(process.stderr, file=sys.stderr, end="")
        return lines
    except subprocess.TimeoutExpired:
        return ["TIMEOUT"] * count


def record(results, expected, lines):
    for case, actual in zip(expected, lines):
        case["actual"] = actual
        case["passed"] = actual == case["expected"]
        results.append(case)
        if not case["passed"]:
            print(f"FAIL {case['draft']}/{case['file']}: {case['group']} / {case['test']}: "
                  f"expected {case['expected']}, got {actual}", flush=True)


def manifest_schema(runner, schema_path, report):
    schema = schema_path.read_text(encoding="utf-8")
    workspace = CACHE / "inputs/manifest-schema"
    workspace.mkdir(parents=True, exist_ok=True)
    results = []

    def run_group(name, group, expected):
        path = workspace / f"{name}.json"
        path.write_text(json.dumps({
            "draft": "draft2020-12", "assertFormats": False, "assertContent": False,
            "resources": [], "cases": [group],
        }), encoding="utf-8")
        record(results, expected, execute(runner, path, len(expected)))

    def expectation(category, name, valid):
        return {"draft": "draft2020-12", "file": name, "group": category, "test": name,
                "expected": "VALID" if valid else "INVALID"}

    run_group("metaschema", {
        "schema": {"$ref": "https://json-schema.org/draft/2020-12/schema"},
        "tests": [{"dataToml": schema}],
    }, [expectation("metaschema", str(schema_path), True)])
    print(f"manifest schema metaschema: {'PASS' if results[0]['passed'] else 'FAIL'}")

    tracked = subprocess.run(
        ["git", "ls-files", "-z", "--", "silk.toml", "**/silk.toml"],
        cwd=ROOT, capture_output=True, check=True,
    )
    manifests = sorted({os.fsdecode(path) for path in tracked.stdout.split(b"\0") if path})
    if not manifests:
        raise SystemExit("no tracked silk.toml manifests found")
    cases_path = Path(__file__).with_name("manifest-cases.json")
    cases = json.loads(cases_path.read_text(encoding="utf-8"))
    if not cases:
        raise SystemExit("no manifest fixtures found")
    tests = [{"manifestToml": (ROOT / path).read_text(encoding="utf-8")} for path in manifests]
    expected = [expectation("repository", path, True) for path in manifests]
    tests.extend({"manifestToml": case["toml"]} for case in cases)
    expected.extend(expectation("fixture", case["name"], case["valid"]) for case in cases)
    run_group("manifests", {"schemaToml": schema, "tests": tests}, expected)
    repo_results = results[1:1 + len(manifests)]
    fixture_results = results[1 + len(manifests):]
    print(f"repository manifests: {sum(case['passed'] for case in repo_results)}/{len(manifests)} pass")
    for case in fixture_results:
        print(f"{'PASS' if case['passed'] else 'FAIL'} fixture/{case['test']}: {case['actual']}")
    print(f"manifest fixtures: {sum(case['passed'] for case in fixture_results)}/{len(cases)} pass")
    if report:
        report.write_text(json.dumps({
            "mode": "manifest-schema", "schema": str(schema_path), "cases": results,
        }, indent=2) + "\n", encoding="utf-8")
    return 0 if all(case["passed"] for case in results) else 1


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--runner", type=Path, help="use an already built native runner")
    parser.add_argument("--suite", type=Path, help="use an existing official suite checkout")
    parser.add_argument("--draft", choices=DRAFTS, action="append", help="select drafts; default all five")
    parser.add_argument("--match", help="select fixture paths containing this substring")
    parser.add_argument("--report", type=Path, help="write individual results as JSON")
    parser.add_argument("--manifest-schema", nargs="?", type=Path,
                        const=ROOT / "compiler/manifest.schema.toml", metavar="PATH",
                        help="validate the TOML schema, tracked manifests and TOML fixtures; "
                             "default PATH: compiler/manifest.schema.toml (no suite download)")
    args = parser.parse_args()
    if args.manifest_schema and (args.suite or args.draft or args.match):
        parser.error("--manifest-schema cannot be combined with --suite, --draft or --match")
    runner = (args.runner or build()).resolve()
    if args.manifest_schema:
        return manifest_schema(runner, args.manifest_schema.resolve(), args.report)
    suite = args.suite or fetch()
    remote = resources(suite)
    workspace = CACHE / "inputs"
    workspace.mkdir(parents=True, exist_ok=True)
    results = []
    for draft, relative, original, expected in fixtures(suite, args.draft or DRAFTS, args.match):
        path = workspace / draft / relative
        path.parent.mkdir(parents=True, exist_ok=True)
        assert_formats = relative.startswith("optional/format/")
        assert_content = draft == "draft7" and relative == "optional/content.json"
        path.write_text('{"draft":' + json.dumps(draft) + ',"assertFormats":' + json.dumps(assert_formats)
                        + ',"assertContent":' + json.dumps(assert_content)
                        + ',"resources":' + remote + ',"cases":' + original + '}', encoding="utf-8")
        record(results, expected, execute(runner, path, len(expected)))
    if not results:
        raise SystemExit("no conformance cases selected")
    totals = collections.defaultdict(lambda: [0, 0])
    for case in results:
        totals[case["draft"]][0] += case["passed"]
        totals[case["draft"]][1] += 1
    for draft, (passed, total) in totals.items():
        print(f"{draft}: {passed}/{total} pass")
    if args.report:
        args.report.write_text(json.dumps({"revision": REVISION, "cases": results}, indent=2) + "\n")
    return 0 if all(case["passed"] for case in results) else 1


if __name__ == "__main__":
    sys.exit(main())
