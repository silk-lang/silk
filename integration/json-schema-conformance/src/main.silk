// Runs the official JSON Schema cases supplied by check-json-schema. Expected validity is
// compared by the external driver, not by the validator. JSON number spellings stay exact.
import silk.json.schema { Schema, Draft, Options, Resource, SchemaError, Output }
import silk.json.value { Json, Value }
import silk.json.schema_metas { SchemaMetas, MetaDocument }
import silk.json.scanner { JsonError }
import silk.json.output { JsonOutput }
import silk.text.regex { RegexError }
import silk.text.string { String }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.host_input { HostInput, HostInputError }
import silk.system.filesystem { Path, FileSystem, FileError }
import silk.system.filesystem_machine { MachineFileSystem }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter }

static if Intrinsic.targetOperatingSystem() == "windows" {
  import silk.platform.windows.path { WindowsPath }
}

struct HarnessError {}

effect fn field<'a>(value: &'a Value, name: string) -> &'a Value ! HarnessError {
  return match move Json.field(value, name) {
    Option<&Value>.Some { value: found } => found
    _ => { fail HarnessError {} }
  }
}

effect fn text(value: &Value) -> string ! HarnessError {
  return match move Json.asString(Option<&Value>.some(value)) {
    Option<string>.Some { value: found } => found
    _ => { fail HarnessError {} }
  }
}

effect fn array(value: &Value) -> &[Value] ! HarnessError {
  return match &value.* {
    Value.Array { values } => List<Value>.asSlice(&values)
    _ => { fail HarnessError {} }
  }
}

effect fn draft(name: string) -> Draft ! HarnessError {
  if name == "draft4" { return Draft.Draft4 }
  if name == "draft6" { return Draft.Draft6 }
  if name == "draft7" { return Draft.Draft7 }
  if name == "draft2019-09" { return Draft.Draft201909 }
  if name == "draft2020-12" { return Draft.Draft202012 }
  fail HarnessError {}
}

effect fn report(result: Output) -> () ! WriterError ? &mut Writer {
  if result.valid { run Writer.writeString("VALID\n") }
  else { run Writer.writeString("INVALID\n") }
}

effect fn errorLine(error: &(SchemaError | RegexError | OutOfMemoryError)) -> ()
  ! WriterError ? &mut Writer {
  match &error.* {
    SchemaError problem => {
      run Writer.writeString("SCHEMA_ERROR ")
      run JsonOutput.writeString(String.view(&problem.keywordLocation))
      run Writer.writeString(" ")
      run JsonOutput.writeString(String.view(&problem.detail))
    }
    RegexError _ => { run Writer.writeString("REGEX_ERROR") }
    _ => { run Writer.writeString("OUT_OF_MEMORY") }
  }
  run Writer.writeString("\n")
}

effect fn group(value: &Value, resources: &[Resource], options: Options) -> ()
  ! HarnessError | OutOfMemoryError | WriterError ? &mut Allocator | &mut Writer {
  let schema = run field(value, "schema")
  let tests = run array(run field(value, "tests"))
  let compiled = run Effect.result(Schema.compile(schema, "https://silk.invalid/suite/schema", resources, options))
  match move compiled {
    Result.Success { value: validator } => {
      let mut index: usize = 0
      while index < tests.length {
        let instance = run field(&tests[index], "data")
        let checked = run Effect.result(Schema.validate(&validator, instance))
        match move checked {
          Result<Output, SchemaError | RegexError | OutOfMemoryError>.Success { value: output } => {
            run report(move output)
          }
          Result<Output, SchemaError | RegexError | OutOfMemoryError>.Failure { error } => {
            run errorLine(&error)
          }
        }
        index = index + 1
      }
    }
    Result.Failure { error } => {
      let mut index: usize = 0
      while index < tests.length {
        run errorLine(&error)
        index = index + 1
      }
    }
  }
}

effect fn envelope(bytes: &[u8]) -> ()
  ! JsonError | HarnessError | OutOfMemoryError | WriterError ? &mut Allocator | &mut Writer {
  let input = run Json.parseExact(bytes)
  let version = run draft(run text(run field(&input, "draft")))
  let assertionValue = run field(&input, "assertFormats")
  let assertions = match &assertionValue.* {
    Value.Bool { value } => value
    _ => { fail HarnessError {} }
  }
  let contentValue = run field(&input, "assertContent")
  let content = match &contentValue.* {
    Value.Bool { value } => value
    _ => { fail HarnessError {} }
  }
  let options = Options { draft: version, assertFormats: assertions, assertContent: content }
  let metas = run SchemaMetas.documents()
  let documents = List<MetaDocument>.asSlice(&metas)
  let remote = run array(run field(&input, "resources"))
  let mut resources = run List<Resource>.makeWithCapacity(documents.length + remote.length)
  let mut index: usize = 0
  while index < documents.length {
    run List<Resource>.append(&mut resources, Resource {
      uri: String.view(&documents[index].uri), schema: &documents[index].schema,
    })
    index = index + 1
  }
  index = 0
  while index < remote.length {
    let uri = run text(run field(&remote[index], "uri"))
    let schema = run field(&remote[index], "schema")
    run List<Resource>.append(&mut resources, Resource { uri: uri, schema: schema })
    index = index + 1
  }
  let groups = run array(run field(&input, "cases"))
  index = 0
  while index < groups.length {
    run group(&groups[index], List<Resource>.asSlice(&resources), options)
    index = index + 1
  }
}

effect fn hostPath(raw: &[u8]) -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    return run WindowsPath.fromNativeBytes(raw)
  } else {
    return run Path.fromBytes(raw)
  }
}

effect fn all() -> ()
  ! HostInputError | FileError | JsonError | HarnessError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator {
  let mut writer = StdoutWriter.make()
  let mut files = run MachineFileSystem.make()
  let count = run HostInput.argumentCount()
  let mut index: usize = 1
  while index < count {
    let raw = run HostInput.argument(index)
    let argument = match move raw {
      Option<Bytes>.Some { value } => move value
      _ => { fail HarnessError {} }
    }
    let path = run hostPath(Bytes.asSlice(&argument))
    let data = run FileSystem.readFile(&path) |> Effect.provideMut<FileSystem>(&mut files)
    run envelope(Bytes.asSlice(&data)) |> Effect.provideMut<Writer>(&mut writer)
    index = index + 1
  }
  run Writer.flush() |> Effect.provideMut<Writer>(&mut writer)
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  return 1
}
effect fn successful() -> i32
  ! HostInputError | FileError | JsonError | HarnessError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator {
  run all()
  return 0
}

pub effect fn main() -> i32 ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(successful(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
}
