// Runs JSON Schema cases and TOML manifest checks supplied by check-json-schema. Expected
// validity is compared by the external driver; parsing and evaluation failures are never INVALID.
import silk.json.schema { Schema, Draft, Options, SchemaError, Output, CompiledSchema }
import silk.json.schema_resolver { SchemaResolver, SchemaRegistry, SchemaResolutionError }
import silk.json.value { Json, Value, JsonEntry }
import silk.json.schema_metas { SchemaMetas, MetaDocument }
import silk.json.schema_value { SchemaValue, ValueError }
import silk.toml.scanner { TomlError }
import silk.toml.value { Toml, Value as TomlValue, TomlChild }
import silk.mem.box { Box }
import silk.json.scanner { JsonError }
import silk.json.output { JsonOutput }
import silk.text.regex { RegexError }
import silk.text.string { String }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.host_input { HostInput, HostInputError }
import silk.system.filesystem { Path, FileSystem, FileError }
import silk.system.filesystem_machine { MachineFileSystem }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter }

static if Intrinsic.targetOperatingSystem() == "windows" {
  import silk.platform.windows.path { WindowsPath }
}

struct HarnessError {}

effect fn field<'a>(value: &'a Value, name: string) -> &'a Value ! HarnessError {
  return match move Json.field(value, name) {
    Option<&Value>.Some { value: found } => found
    _ => { fail HarnessError {} }
  }
}

effect fn takeField(value: &mut Value, name: string) -> Value ! HarnessError {
  match &mut value.* {
    Value.Object { entries } => {
      let mut index: usize = 0
      while index < List<JsonEntry>.length(&entries) {
        if String.view(&List<JsonEntry>.asSlice(&entries)[index].key) == name {
          let entry = List<JsonEntry>.remove(&mut entries, index)
          return move entry.value
        }
        index = index + 1
      }
    }
    _ => {}
  }
  fail HarnessError {}
}

effect fn text(value: &Value) -> string ! HarnessError {
  return match move Json.asString(Option<&Value>.some(value)) {
    Option<string>.Some { value: found } => found
    _ => { fail HarnessError {} }
  }
}

effect fn array(value: &Value) -> &[Value] ! HarnessError {
  return match &value.* {
    Value.Array { values } => List<Value>.asSlice(&values)
    _ => { fail HarnessError {} }
  }
}

effect fn draft(name: string) -> Draft ! HarnessError {
  if name == "draft4" { return Draft.Draft4 }
  if name == "draft6" { return Draft.Draft6 }
  if name == "draft7" { return Draft.Draft7 }
  if name == "draft2019-09" { return Draft.Draft201909 }
  if name == "draft2020-12" { return Draft.Draft202012 }
  fail HarnessError {}
}

effect fn report(result: Output) -> () ! WriterError ? &mut Writer {
  if result.valid { run Writer.writeString("VALID\n") }
  else { run Writer.writeString("INVALID\n") }
}

effect fn errorLine(error: &(SchemaError | SchemaResolutionError | RegexError | OutOfMemoryError)) -> ()
  ! WriterError ? &mut Writer {
  match &error.* {
    SchemaError problem => {
      run Writer.writeString("SCHEMA_ERROR ")
      run JsonOutput.writeString(String.view(&problem.keywordLocation))
      run Writer.writeString(" ")
      run JsonOutput.writeString(String.view(&problem.detail))
    }
    SchemaResolutionError problem => {
      run Writer.writeString("RESOLUTION_ERROR ")
      run JsonOutput.writeString(String.view(&problem.uri))
      run Writer.writeString(" ")
      run JsonOutput.writeString(String.view(&problem.detail))
    }
    RegexError _ => { run Writer.writeString("REGEX_ERROR") }
    _ => { run Writer.writeString("OUT_OF_MEMORY") }
  }
  run Writer.writeString("\n")
}

effect fn tomlErrorLine(error: &(TomlError | ValueError | OutOfMemoryError)) -> ()
  ! WriterError ? &mut Writer {
  match &error.* {
    TomlError _ => { run Writer.writeString("TOML_ERROR\n") }
    ValueError _ => { run Writer.writeString("VALUE_ERROR\n") }
    _ => { run Writer.writeString("OUT_OF_MEMORY\n") }
  }
}

effect fn check(validator: &CompiledSchema, instance: &Value) -> ()
  ! WriterError ? &mut Allocator | &mut Writer {
  let checked = run Effect.result(Schema.validate(validator, instance))
  match move checked {
    Result<Output, SchemaError | RegexError | OutOfMemoryError>.Success { value: output } => {
      run report(move output)
    }
    Result<Output, SchemaError | RegexError | OutOfMemoryError>.Failure { error } => {
      let reported: SchemaError | SchemaResolutionError | RegexError | OutOfMemoryError = move error
      run errorLine(&reported)
    }
  }
}

// Tool-owned data is outside the manifest contract, even when it holds TOML-only values.
// Keep this projection local to manifest instances; generic TOML schemas/documents stay exact.
effect fn manifestValue(bytes: &[u8]) -> Value
  ! TomlError | ValueError | OutOfMemoryError ? &mut Allocator {
  let source = run Toml.parse(bytes)
  let table = match &source {
    TomlValue.Table { entries, kind: _ } => Box<List<TomlChild>>.get(&entries)
    _ => { fail ValueError.InvalidTomlValue }
  }
  let fields = List<TomlChild>.asSlice(&table[0])
  let mut entries = run List<JsonEntry>.makeWithCapacity(fields.length)
  let mut index: usize = 0
  while index < fields.length {
    match &fields[index] {
      TomlChild.Member { entry } => {
        if String.view(&entry.key) != "tool" {
          run List<JsonEntry>.append(&mut entries, JsonEntry {
            key: run String.copy(String.view(&entry.key)),
            value: run SchemaValue.fromToml(&entry.value),
          })
        }
      }
      _ => { fail ValueError.InvalidTomlValue }
    }
    index = index + 1
  }
  return Value.Object { entries: move entries }
}

effect fn test(validator: &CompiledSchema, value: &Value) -> ()
  ! HarnessError | WriterError ? &mut Allocator | &mut Writer {
  if let Option<&Value>.Some { value: source } = move Json.field(value, "manifestToml") {
    let sourceText = run text(source)
    let parsed = run Effect.result(manifestValue(String.utf8Bytes(sourceText)))
    match move parsed {
      Result.Success { value: instance } => { run check(validator, &instance) }
      Result.Failure { error } => { run tomlErrorLine(&error) }
    }
  } else if let Option<&Value>.Some { value: source } = move Json.field(value, "dataToml") {
    let sourceText = run text(source)
    let parsed = run Effect.result(SchemaValue.parseToml(String.utf8Bytes(sourceText)))
    match move parsed {
      Result.Success { value: instance } => { run check(validator, &instance) }
      Result.Failure { error } => { run tomlErrorLine(&error) }
    }
  } else {
    run check(validator, run field(value, "data"))
  }
}

effect fn compiledGroup(schema: &Value, tests: &[Value], registry: &mut SchemaRegistry, options: Options) -> ()
  ! HarnessError | WriterError ? &mut Allocator | &mut Writer {
  let compiled = run Effect.result(Schema.compile(schema, "https://silk.invalid/suite/schema", options)
    |> Effect.provideMut<SchemaResolver>(&mut registry.*))
  match move compiled {
    Result.Success { value: validator } => {
      let mut index: usize = 0
      while index < tests.length {
        run test(&validator, &tests[index])
        index = index + 1
      }
    }
    Result.Failure { error } => {
      let mut index: usize = 0
      while index < tests.length {
        run errorLine(&error)
        index = index + 1
      }
    }
  }
}

effect fn group(value: &Value, registry: &mut SchemaRegistry, options: Options) -> ()
  ! HarnessError | WriterError ? &mut Allocator | &mut Writer {
  let tests = run array(run field(value, "tests"))
  if let Option<&Value>.Some { value: source } = move Json.field(value, "schemaToml") {
    let sourceText = run text(source)
    let parsed = run Effect.result(SchemaValue.parseToml(String.utf8Bytes(sourceText)))
    match move parsed {
      Result.Success { value: schema } => { run compiledGroup(&schema, tests, &mut registry.*, options) }
      Result.Failure { error } => {
        let mut index: usize = 0
        while index < tests.length {
          run tomlErrorLine(&error)
          index = index + 1
        }
      }
    }
  } else {
    run compiledGroup(run field(value, "schema"), tests, &mut registry.*, options)
  }
}

effect fn envelope(bytes: &[u8]) -> ()
  ! JsonError | HarnessError | OutOfMemoryError | WriterError ? &mut Allocator | &mut Writer {
  let mut input = run Json.parseExact(bytes)
  let version = run draft(run text(run field(&input, "draft")))
  let assertionValue = run field(&input, "assertFormats")
  let assertions = match &assertionValue.* {
    Value.Bool { value } => value
    _ => { fail HarnessError {} }
  }
  let contentValue = run field(&input, "assertContent")
  let content = match &contentValue.* {
    Value.Bool { value } => value
    _ => { fail HarnessError {} }
  }
  let options = Options { draft: version, assertFormats: assertions, assertContent: content }
  let mut registry = SchemaRegistry.make()
  let mut metas = run SchemaMetas.documents()
  while true {
    match move List<MetaDocument>.pop(&mut metas) {
      Option<MetaDocument>.Some { value: document } => {
        run SchemaRegistry.add(&mut registry, String.view(&document.uri), move document.schema)
      }
      _ => { break }
    }
  }
  let remote = run takeField(&mut input, "resources")
  let mut documents = match move remote {
    Value.Array { values } => move values
    _ => { fail HarnessError {} }
  }
  while true {
    match move List<Value>.pop(&mut documents) {
      Option<Value>.Some { value: document } => {
        let mut resource = move document
        let schema = run takeField(&mut resource, "schema")
        let uri = run text(run field(&resource, "uri"))
        run SchemaRegistry.add(&mut registry, uri, move schema)
      }
      _ => { break }
    }
  }
  let groups = run array(run field(&input, "cases"))
  let mut index: usize = 0
  while index < groups.length {
    run group(&groups[index], &mut registry, options)
    index = index + 1
  }
}

effect fn hostPath(raw: &[u8]) -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    return run WindowsPath.fromNativeBytes(raw)
  } else {
    return run Path.fromBytes(raw)
  }
}

effect fn all() -> ()
  ! HostInputError | FileError | JsonError | HarnessError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator {
  let mut writer = StdoutWriter.make()
  let mut files = run MachineFileSystem.make()
  let count = run HostInput.argumentCount()
  let mut index: usize = 1
  while index < count {
    let raw = run HostInput.argument(index)
    let argument = match move raw {
      Option<Bytes>.Some { value } => move value
      _ => { fail HarnessError {} }
    }
    let path = run hostPath(Bytes.asSlice(&argument))
    let data = run FileSystem.readFile(&path) |> Effect.provideMut<FileSystem>(&mut files)
    run envelope(Bytes.asSlice(&data)) |> Effect.provideMut<Writer>(&mut writer)
    index = index + 1
  }
  run Writer.flush() |> Effect.provideMut<Writer>(&mut writer)
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  return 1
}
effect fn successful() -> i32
  ! HostInputError | FileError | JsonError | HarnessError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator {
  run all()
  return 0
}

pub effect fn main() -> i32 ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(successful(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
}
