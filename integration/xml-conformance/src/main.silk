// Parses each argument path and prints OK or ERR for each file, in order. Driven by
// integration/xml-conformance/check-xmlconf against the W3C XML Conformance Test Suite.
import silk.xml.document { XmlDocument, XmlError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.host_input { HostInput, HostInputError }
import silk.system.filesystem { Path, FileSystem, FileError }
import silk.system.filesystem_machine { MachineFileSystem }

static if Intrinsic.targetOperatingSystem() == "windows" {
  import silk.platform.windows.path { WindowsPath }
}

import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter }

effect fn one(index: usize) -> ()
  ! HostInputError | FileError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut Writer {
  let raw = run HostInput.argument(index)
  let argument = match move raw {
    Option<Bytes>.Some { value } => move value
    _ => {
      run Writer.writeString("ARG\n")
      return
    }
  }
  let path = run hostPath(Bytes.asSlice(&argument))
  let mut files = run MachineFileSystem.make()
  let data = run FileSystem.readFile(&path) |> Effect.provideMut<FileSystem>(&mut files)
  let result = run Effect.result(XmlDocument.parse(Bytes.asSlice(&data)))
  match &result {
    Result<XmlDocument, XmlError | OutOfMemoryError>.Success { value: _ } => {
      run Writer.writeString("\tOK\n")
    }
    _ => {
      run Writer.writeString("\tERR\n")
    }
  }
}

effect fn hostPath(raw: &[u8]) -> Path
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    return run WindowsPath.fromNativeBytes(raw)
  } else {
    return run Path.fromBytes(raw)
  }
}

effect fn all() -> ()
  ! HostInputError | FileError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator {
  let mut writer = StdoutWriter.make()
  let count = run HostInput.argumentCount()
  let mut index: usize = 1
  while index < count {
    run one(index) |> Effect.provideMut<Writer>(&mut writer)
    index = index + 1
  }
  run Writer.flush() |> Effect.provideMut<Writer>(&mut writer)
}

effect fn failedUnit<E>(error: E) -> () {
  drop error
}

pub effect fn main() -> i32
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  run Effect.catchAll(all(), failedUnit) |> Effect.provideMut<Allocator>(&mut allocator)
  return 0
}
