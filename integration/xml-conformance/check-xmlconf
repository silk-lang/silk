#!/usr/bin/env python3
"""Run silk.xml.document against the W3C XML Conformance Test Suite (XML 1.0 Fifth Edition, Namespaces 1.0).

Selection for a namespace-aware, non-validating processor that never reads external entities:
XML 1.1 and NS 1.1 cases, cases for earlier editions only, NAMESPACE="no" cases and optional
"error" cases are skipped; not-wf cases that need an external entity are skipped because the
error lives in content this processor never reads. valid and invalid cases must parse.
"""
import argparse
import collections
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tarfile
import urllib.request
import xml.etree.ElementTree as ElementTree

ROOT = Path(__file__).resolve().parents[2]
SUITE = "https://www.w3.org/XML/Test/xmlts20130923.tar.gz"
SUITE_SHA256 = "9b61db9f5dbffa545f4b8d78422167083a8568c59bd1129f94138f936cf6fc1f"
CACHE = ROOT / "build" / "xmlconf"
XML_BASE = "{http://www.w3.org/XML/1998/namespace}base"


def fetch():
    archive = CACHE / "xmlts20130923.tar.gz"
    if not archive.is_file() or hashlib.sha256(archive.read_bytes()).hexdigest() != SUITE_SHA256:
        CACHE.mkdir(parents=True, exist_ok=True)
        with urllib.request.urlopen(SUITE) as response:
            data = response.read()
        if hashlib.sha256(data).hexdigest() != SUITE_SHA256:
            raise SystemExit("xmlts20130923.tar.gz does not match its pinned SHA-256")
        archive.write_bytes(data)
    suite = CACHE / "xmlconf"
    if not (suite / "xmlconf.xml").is_file():
        with tarfile.open(archive) as source:
            source.extractall(CACHE, filter="data")
    return suite


def catalog(path):
    # Catalogs are external-entity fragments of xmlconf.xml, often with several TEST roots.
    text = path.read_text(encoding="utf-8", errors="replace")
    text = re.sub(r"<\?xml[^>]*\?>", "", text, count=1)
    text = re.sub(r"<!DOCTYPE[^\[>]*(\[.*?\])?\s*>", "", text, count=1, flags=re.S)
    return ElementTree.fromstring("<CATALOG>" + text + "</CATALOG>")


def cases(suite):
    top = (suite / "xmlconf.xml").read_text(encoding="utf-8")
    for name, relative in re.findall(r'<!ENTITY\s+(\S+)\s+SYSTEM\s+"([^"]+)"', top):
        path = suite / relative
        pending = [(catalog(path), path.parent)]
        while pending:
            element, base = pending.pop()
            if element.get(XML_BASE):
                base = base / element.get(XML_BASE)
            if element.tag == "TEST":
                yield dict(element.attrib, catalog=name, file=os.path.normpath(base / element.get("URI")))
            pending.extend((child, base) for child in reversed(element))


def skip_reason(case):
    if case.get("RECOMMENDATION") in ("XML1.1", "NS1.1") or case.get("VERSION") == "1.1":
        return "xml-1.1"
    edition = case.get("EDITION")
    if edition and "5" not in edition.split():
        return "earlier-edition"
    if case.get("NAMESPACE") == "no":
        return "namespace-unaware"
    if case["TYPE"] == "error":
        return "optional-error"
    if case["TYPE"] == "not-wf" and case.get("ENTITIES", "none") != "none":
        return "not-wf-in-external-entity"
    return None


def run(runner, selected):
    results = []
    # Leave room for quoting and deep checkout paths under Windows' 32767-unit limit.
    batch = 50 if os.name == "nt" else 200
    for start in range(0, len(selected), batch):
        chunk = selected[start:start + batch]
        lines = subprocess.run([runner, *(case["file"] for case in chunk)], capture_output=True,
                               text=True, timeout=600).stdout.split()
        if len(lines) != len(chunk):
            # One case crashed the batch: rerun this batch one file at a time to name it.
            lines = []
            for case in chunk:
                single = subprocess.run([runner, case["file"]], capture_output=True, text=True, timeout=60)
                output = single.stdout.split()
                lines.append(output[0] if single.returncode == 0 and output else f"crash({single.returncode})")
        results.extend(lines)
    return results


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--report", type=Path, help="write every selected case and its outcome as JSON")
    args = parser.parse_args()
    silk = os.environ.get("SILK", "silk")
    manifest = ROOT / "integration/xml-conformance/silk.toml"
    command = [silk, "build", "--release", "--manifest-path", manifest]
    if os.environ.get("SILK_STDLIB"):
        command += ["--stdlib", os.environ["SILK_STDLIB"]]
    subprocess.run(command, cwd=ROOT, check=True)
    name = "xml-conformance.exe" if os.name == "nt" else "xml-conformance"
    runner = next((manifest.parent / "build/llvm").glob(f"*/release/{name}"))
    suite = fetch()
    selected, skipped = [], collections.Counter()
    for case in cases(suite):
        reason = skip_reason(case)
        if reason:
            skipped[reason] += 1
        else:
            case["expected"] = "ERR" if case["TYPE"] == "not-wf" else "OK"
            selected.append(case)
    for case, outcome in zip(selected, run(str(runner), selected)):
        case["outcome"] = outcome
    failures = [case for case in selected if case["outcome"] != case["expected"]]
    for case in failures:
        print(f"FAIL {case['ID']} ({case['TYPE']}): expected {case['expected']}, got {case['outcome']}: "
              f"{os.path.relpath(case['file'], suite)}")
    print(f"{len(selected) - len(failures)}/{len(selected)} selected cases pass; skipped "
          + ", ".join(f"{count} {reason}" for reason, count in sorted(skipped.items())))
    if args.report:
        args.report.write_text(json.dumps({"skipped": skipped, "cases": selected}, indent=1) + "\n")
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
