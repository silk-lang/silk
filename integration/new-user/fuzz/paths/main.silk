import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.filesystem { FileError, Path }
import silk.list { List }
import silk.option { Option }
import silk.os_standard_input { OsStandardInput }
import silk.os_writer { StdoutWriter }
import silk.result { Result }
import silk.slice { Slice }
import silk.standard_input { StandardInput, StreamReadError }
import silk.string { InvalidUtf8, String }
import silk.writer { Writer, WriterError }

// Each input line is an operation letter and tab-separated arguments:
//   M <path>            Path.fromBytes
//   J <base> <frag>     Path.joinBytes
//   R <base> <text>     Path.resolve (text must be UTF-8)
//   P <path>            parent of Path.fromBytes
// Each output line is `ok <path>`, `none`, or `err`.
effect fn report(result: Result<Path, FileError | OutOfMemoryError>) -> () ! WriterError ? &mut Writer {
  match move result {
    Result<Path, FileError | OutOfMemoryError>.Success { value } => {
      run Writer.writeAll(b"ok ")
      run Writer.writeAll(value.rawBytes())
      run Writer.writeAll(b"\n")
    }
    Result<Path, FileError | OutOfMemoryError>.Failure { error } => {
      drop error
      run Writer.writeAll(b"err\n")
    }
  }
  return ()
}

effect fn answer(line: &[u8]) -> ()
  ! OutOfMemoryError | WriterError
  ? &mut Allocator | &mut Writer {
  let mut second: usize = line.length
  let mut i: usize = 2
  while i < line.length {
    if line[i] == 9 {
      second = i
      break
    }
    i = i + 1
  }
  let first = Slice.view(line, 2, second - 2)
  let mut rest: &[u8] = Slice.view(line, 0, 0)
  if second < line.length {
    rest = Slice.view(line, second + 1, line.length - second - 1)
  }
  let op = line[0]
  if op == 77 {
    run report(run Effect.result(Path.fromBytes(first)))
    return ()
  }
  if op == 80 {
    let made = run Effect.result(Path.fromBytes(first))
    match move made {
      Result<Path, FileError | OutOfMemoryError>.Success { value } => {
        match move run value.parent() {
          Option<Path>.Some { value: up } => {
            run Writer.writeAll(b"ok ")
            run Writer.writeAll(up.rawBytes())
            run Writer.writeAll(b"\n")
          }
          Option<Path>.None => {
            run Writer.writeAll(b"none\n")
          }
        }
      }
      Result<Path, FileError | OutOfMemoryError>.Failure { error } => {
        drop error
        run Writer.writeAll(b"err\n")
      }
    }
    return ()
  }
  let base = run Effect.result(Path.fromBytes(first))
  match move base {
    Result<Path, FileError | OutOfMemoryError>.Success { value } => {
      if op == 74 {
        run report(run Effect.result(Path.joinBytes(&value, rest)))
      } else {
        match String.fromUtf8(rest) {
          Result<string, InvalidUtf8>.Success { value: text } => {
            run report(run Effect.result(Path.resolve(&value, text)))
          }
          Result<string, InvalidUtf8>.Failure { error } => {
            run Writer.writeAll(b"utf8\n")
          }
        }
      }
    }
    Result<Path, FileError | OutOfMemoryError>.Failure { error } => {
      drop error
      run Writer.writeAll(b"base\n")
    }
  }
  return ()
}

pub effect fn main() -> i32
  ! OutOfMemoryError | StreamReadError | WriterError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut input = OsStandardInput.make()
  let mut out = StdoutWriter.make()
  let mut data = List<u8>.make()
  let mut chunk: [u8; 65536] = [0; 65536]
  while true {
    let outcome = run StandardInput.receive(&mut chunk)
      |> Effect.provideMut<StandardInput>(&mut input)
    if StandardInput.isEndOfInput(&outcome) {
      break
    }
    run data.appendBytes(Slice.view(&chunk, 0, StandardInput.count(&outcome)))
      |> Effect.provideMut<Allocator>(&mut allocator)
  }
  let bytes = data.asSlice()
  let mut start: usize = 0
  let mut i: usize = 0
  while i < bytes.length {
    if bytes[i] == 10 {
      run answer(Slice.view(bytes, start, i - start))
        |> Effect.provideMut<Allocator>(&mut allocator)
        |> Effect.provideMut<Writer>(&mut out)
      start = i + 1
    }
    i = i + 1
  }
  run Writer.flush() |> Effect.provideMut<Writer>(&mut out)
  return 0
}
