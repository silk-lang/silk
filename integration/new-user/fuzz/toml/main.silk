import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.toml_output { TomlOutput }
import silk.toml_scanner { TomlError }
import silk.toml_value { Toml }
import silk.os_standard_input { OsStandardInput }
import silk.os_writer { StdoutWriter }
import silk.slice { Slice }
import silk.standard_input { StandardInput, StreamReadError }
import silk.writer { Writer, WriterError }

pub effect fn main() -> i32
  ! TomlError | OutOfMemoryError | StreamReadError | WriterError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut input = OsStandardInput.make()
  let mut out = StdoutWriter.make()
  let mut buffer: [u8; 262144] = [0; 262144]
  let mut total: usize = 0
  let mut chunk: [u8; 4096] = [0; 4096]
  while true {
    let outcome = run StandardInput.receive(&mut chunk)
      |> Effect.provideMut<StandardInput>(&mut input)
    if StandardInput.isEndOfInput(&outcome) {
      break
    }
    let count = StandardInput.count(&outcome)
    let mut i: usize = 0
    while i < count {
      buffer[total] = chunk[i]
      total = total + 1
      i = i + 1
    }
  }
  let document = run Toml.parse(Slice.view(&buffer, 0, total))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run TomlOutput.write(&document)
    |> Effect.provideMut<Allocator>(&mut allocator)
    |> Effect.provideMut<Writer>(&mut out)
  run Writer.flush() |> Effect.provideMut<Writer>(&mut out)
  return 0
}
