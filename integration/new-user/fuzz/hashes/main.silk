import silk.blake2b { Blake2b512 }
import silk.effect { Effect }
import silk.hmac { HmacSha256, HmacSha384 }
import silk.logger { LogError, Logger }
import silk.os_logger { StdoutLogger }
import silk.os_standard_input { OsStandardInput }
import silk.sha1 { Sha1 }
import silk.sha2 { Sha224, Sha256, Sha384, Sha512, Sha512_224, Sha512_256 }
import silk.sha3 { Sha3_224, Sha3_256, Sha3_384, Sha3_512 }
import silk.slice { Slice }
import silk.standard_input { StandardInput, StreamReadError }

effect fn hex(name: string, digest: &[u8]) -> () ! LogError ? &mut Logger {
  run Effect.log("{name} ", &.{ name: name })
  let mut i: usize = 0
  while i < digest.length {
    let b = digest[i]
    run Effect.log("{b:02x}", &.{ b: b })
    i = i + 1
  }
  run Effect.log("\n", &.{})
  return ()
}

pub effect fn main() -> () ! LogError | StreamReadError {
  let mut logger = StdoutLogger.make()
  let mut input = OsStandardInput.make()
  let longKey: [u8; 200] = [107; 200]
  let mut s1 = Sha1.make()
  let mut s224 = Sha224.make()
  let mut s256 = Sha256.make()
  let mut s384 = Sha384.make()
  let mut s512 = Sha512.make()
  let mut s512t224 = Sha512_224.make()
  let mut s512t256 = Sha512_256.make()
  let mut k224 = Sha3_224.make()
  let mut k256 = Sha3_256.make()
  let mut k384 = Sha3_384.make()
  let mut k512 = Sha3_512.make()
  let mut b512 = Blake2b512.make()
  let mut h256 = HmacSha256.make(b"key")
  let mut h384 = HmacSha384.make(&longKey)
  let steps: [usize; 8] = [1, 3, 64, 127, 128, 200, 55, 4096]
  let mut turn: usize = 0
  let mut buffer: [u8; 4096] = [0; 4096]
  while true {
    let outcome = run StandardInput.receive(&mut buffer)
      |> Effect.provideMut<StandardInput>(&mut input)
    if StandardInput.isEndOfInput(&outcome) {
      break
    }
    let count = StandardInput.count(&outcome)
    let mut offset: usize = 0
    while offset < count {
      let mut size = steps[turn % 8]
      turn = turn + 1
      if size > count - offset {
        size = count - offset
      }
      let piece = Slice.view(&buffer, offset, size)
      s1.update(piece)
      s224.update(piece)
      s256.update(piece)
      s384.update(piece)
      s512.update(piece)
      s512t224.update(piece)
      s512t256.update(piece)
      k224.update(piece)
      k256.update(piece)
      k384.update(piece)
      k512.update(piece)
      b512.update(piece)
      h256.update(piece)
      h384.update(piece)
      offset = offset + size
    }
  }
  let d1 = s1.finish()
  let d224 = s224.finish()
  let d256 = s256.finish()
  let d384 = s384.finish()
  let d512 = s512.finish()
  let d512t224 = s512t224.finish()
  let d512t256 = s512t256.finish()
  let e224 = k224.finish()
  let e256 = k256.finish()
  let e384 = k384.finish()
  let e512 = k512.finish()
  let f512 = b512.finish()
  let g256 = h256.finish()
  let g384 = h384.finish()
  run hex("sha1", &d1) |> Effect.provideMut(&mut logger)
  run hex("sha224", &d224) |> Effect.provideMut(&mut logger)
  run hex("sha256", &d256) |> Effect.provideMut(&mut logger)
  run hex("sha384", &d384) |> Effect.provideMut(&mut logger)
  run hex("sha512", &d512) |> Effect.provideMut(&mut logger)
  run hex("sha512_224", &d512t224) |> Effect.provideMut(&mut logger)
  run hex("sha512_256", &d512t256) |> Effect.provideMut(&mut logger)
  run hex("sha3_224", &e224) |> Effect.provideMut(&mut logger)
  run hex("sha3_256", &e256) |> Effect.provideMut(&mut logger)
  run hex("sha3_384", &e384) |> Effect.provideMut(&mut logger)
  run hex("sha3_512", &e512) |> Effect.provideMut(&mut logger)
  run hex("blake2b512", &f512) |> Effect.provideMut(&mut logger)
  run hex("hmac_sha256", &g256) |> Effect.provideMut(&mut logger)
  run hex("hmac_sha384", &g384) |> Effect.provideMut(&mut logger)
  return ()
}
