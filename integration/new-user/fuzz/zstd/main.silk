import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.zstd { Zstd, ZstdError, ZstdLimits, ZstdProgress, ZstdStatus }
import silk.list { List }
import silk.os_standard_input { OsStandardInput }
import silk.os_writer { StdoutWriter }
import silk.result { Result }
import silk.slice { Slice }
import silk.standard_input { StandardInput, StreamReadError }
import silk.writer { Writer, WriterError }

// Standard input is one ignored byte and then the zstd stream.
// The stream is fed in uneven pieces into uneven output buffers, and the output goes to stdout.
pub effect fn main() -> i32
  ! ZstdError | OutOfMemoryError | StreamReadError | WriterError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut input = OsStandardInput.make()
  let mut out = StdoutWriter.make()
  let mut data = List<u8>.make()
  let mut chunk: [u8; 65536] = [0; 65536]
  while true {
    let outcome = run StandardInput.receive(&mut chunk)
      |> Effect.provideMut<StandardInput>(&mut input)
    if StandardInput.isEndOfInput(&outcome) {
      break
    }
    run data.appendBytes(Slice.view(&chunk, 0, StandardInput.count(&outcome)))
      |> Effect.provideMut<Allocator>(&mut allocator)
  }
  let bytes = data.asSlice()
  if bytes.length == 0 {
    return 2
  }
  let mut limits = ZstdLimits.make()
  limits.windowBytes = 134217728
  let mut decoder = run Zstd.make(move limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let inSizes: [usize; 7] = [1, 2, 7, 100, 4096, 3, 65536]
  let outSizes: [usize; 6] = [1, 13, 4096, 2, 300, 8192]
  let mut position: usize = 1
  let mut turn: usize = 0
  let mut final = false
  while true {
    let remaining = bytes.length - position
    let mut size = inSizes[turn % 7]
    if final || size >= remaining {
      size = remaining
      final = true
    }
    let outSize = outSizes[turn % 6]
    turn = turn + 1
    let mut window = List<u8>.make()
    run window.appendRepeated(0, outSize) |> Effect.provideMut<Allocator>(&mut allocator)
    let progress = match Zstd.step(&mut decoder, Slice.view(bytes, position, size), window.asMutSlice(), final) {
      Result<ZstdProgress, ZstdError>.Success { value } => move value
      Result<ZstdProgress, ZstdError>.Failure { error } => {
        fail move error
      }
    }
    run Writer.writeAll(Slice.view(window.asSlice(), 0, progress.written)) |> Effect.provideMut<Writer>(&mut out)
    position = position + progress.consumed
    if progress.status == ZstdStatus.Finished {
      break
    }
  }
  run Writer.flush() |> Effect.provideMut<Writer>(&mut out)
  if position != bytes.length {
    return 3
  }
  return 0
}
