import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.http_client { Http, HttpError, HttpErrorKind, Request, Response }
import silk.http_client_native { NativeHttp }
import silk.list { List }
import silk.os_standard_input { OsStandardInput }
import silk.os_writer { StderrWriter }
import silk.result { Result }
import silk.slice { Slice }
import silk.standard_input { StandardInput, StreamReadError }
import silk.string { InvalidUtf8, String }
import silk.u64
import silk.u8

// Reads one path per line from standard input, GETs each from 127.0.0.1:18081 with a 3 s
// deadline, and prints `<path> status=<code> length=<n> sum=<checksum>` or `<path> error=<kind>`.
fn sum(bytes: &[u8]) -> u64 {
  let mut total: u64 = 0
  let mut i: usize = 0
  while i < bytes.length {
    total = u64.wrappingAdd(u64.wrappingMultiply(total, 31), u8.toU64(bytes[i]))
    i = i + 1
  }
  return total
}

fn kindName(kind: HttpErrorKind) -> string<'static> {
  return match kind {
    HttpErrorKind.InvalidUrl => "InvalidUrl"
    HttpErrorKind.InvalidRequest => "InvalidRequest"
    HttpErrorKind.Encode => "Encode"
    HttpErrorKind.Connect => "Connect"
    HttpErrorKind.Tls => "Tls"
    HttpErrorKind.Timeout => "Timeout"
    HttpErrorKind.Protocol => "Protocol"
    HttpErrorKind.TooLarge => "TooLarge"
    HttpErrorKind.Redirect => "Redirect"
    HttpErrorKind.Status => "Status"
    HttpErrorKind.Decode => "Decode"
  }
}

effect fn fetch(path: string) -> () ! OutOfMemoryError ? &mut Http | &mut Allocator {
  match move run Effect.result(Http.send(Request.get(path).timeoutSeconds(3))) {
    Result.Success { value } => {
      let body = value.body()
      StderrWriter.print("{path} status={status} length={length} sum={sum}\n",
        &.{ path: path, status: value.status(), length: body.length, sum: sum(body) })
    }
    Result.Failure { error } => match move error {
      HttpError failure => StderrWriter.print("{path} error={kind}\n", &.{ path: path, kind: kindName(failure.kind) })
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

pub effect fn main() -> () ! OutOfMemoryError | StreamReadError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut input = OsStandardInput.make()
  let mut data = List<u8>.make()
  let mut chunk: [u8; 4096] = [0; 4096]
  while true {
    let outcome = run StandardInput.receive(&mut chunk)
      |> Effect.provideMut<StandardInput>(&mut input)
    if StandardInput.isEndOfInput(&outcome) {
      break
    }
    run data.appendBytes(Slice.view(&chunk, 0, StandardInput.count(&outcome)))
      |> Effect.provideMut<Allocator>(&mut allocator)
  }
  // The first line is the base URL and the second the trust bundle path; the rest are paths.
  let bytes = data.asSlice()
  let mut lines: [usize; 2] = [0; 2]
  let mut found: usize = 0
  let mut j: usize = 0
  while j < bytes.length && found < 2 {
    if bytes[j] == 10 {
      lines[found] = j
      found = found + 1
    }
    j = j + 1
  }
  let mut http = NativeHttp.make().maxBodyBytes(20000000).trustBundle("/tmp/claude-0/-home-user-silk/e30f93f5-40d9-560e-b320-3195613e8344/scratchpad/tls/ca.pem")
  let mut start: usize = lines[1] + 1
  let mut i: usize = start
  while i < bytes.length {
    if bytes[i] == 10 {
      match String.fromUtf8(Slice.view(bytes, start, i - start)) {
        Result<string, InvalidUtf8>.Success { value } => {
          run fetch(value) |> Effect.provideMut<Http>(&mut http) |> Effect.provideMut<Allocator>(&mut allocator)
        }
        Result<string, InvalidUtf8>.Failure { error } => {}
      }
      start = i + 1
    }
    i = i + 1
  }
}
