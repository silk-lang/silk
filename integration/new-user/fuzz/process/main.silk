import silk.allocator { Allocator, OutOfMemoryError }
import silk.child_process { ChildProcess, ProcessError, ProcessOutcome, ProcessRequest }
import silk.effect { Effect }
import silk.filesystem { FileError, Path }
import silk.option { Option }
import silk.os_child_process { OsChildProcess }
import silk.os_writer { StderrWriter }
import silk.u64
import silk.u8

// Runs `/bin/sh -c <script> sh <args...>` with only `NAME=value` set in the environment, then
// prints `<label> exit=<code> signal=<signal> out=<bytes> err=<bytes> outsum=<sum> errsum=<sum>`.
fn sum(bytes: &[u8]) -> u64 {
  let mut total: u64 = 0
  let mut i: usize = 0
  while i < bytes.length {
    total = u64.wrappingAdd(u64.wrappingMultiply(total, 31), u8.toU64(bytes[i]))
    i = i + 1
  }
  return total
}

effect fn shell(label: string, script: string, args: &[string]) -> ()
  ! FileError | OutOfMemoryError | ProcessError
  ? &mut Allocator | &mut ChildProcess {
  let sh = run Path.make("/bin/sh")
  let mut request = run ChildProcess.request(&sh)
  run ChildProcess.addArgument(&mut request, "-c")
  run ChildProcess.addArgument(&mut request, script)
  run ChildProcess.addArgument(&mut request, "sh")
  let mut i: usize = 0
  while i < args.length {
    run ChildProcess.addArgument(&mut request, args[i])
    i = i + 1
  }
  run ChildProcess.setVariable(&mut request, "NAME", "value")
  let outcome = run ChildProcess.submit(&request)
  let code = Option<i32>.unwrapOr(ChildProcess.exitCode(&outcome), -1)
  let signal = Option<i32>.unwrapOr(ChildProcess.terminatingSignal(&outcome), 0)
  let out = ChildProcess.outputBytes(&outcome)
  let err = ChildProcess.errorBytes(&outcome)
  StderrWriter.print("{label} exit={code} signal={signal} out={o} err={e} outsum={os} errsum={es}\n",
    &.{ label: label, code: code, signal: signal, o: out.length, e: err.length, os: sum(out), es: sum(err) })
  return ()
}

effect fn missing() -> ()
  ! FileError | OutOfMemoryError | ProcessError
  ? &mut Allocator | &mut ChildProcess {
  let nope = run Path.make("/nonexistent/program")
  let request = run ChildProcess.request(&nope)
  let outcome = run ChildProcess.submit(&request)
  StderrWriter.print("missing ran\n", &.{})
  return ()
}

effect fn reason(error: FileError | OutOfMemoryError | ProcessError) -> () {
  match move error {
    ProcessError held => {
      let code = ChildProcess.reasonCode(move held.reason)
      StderrWriter.print("process error reason={code}\n", &.{ code: code })
    }
    FileError held => {
      StderrWriter.print("file error\n", &.{})
    }
    OutOfMemoryError held => {
      StderrWriter.print("out of memory\n", &.{})
    }
  }
  return ()
}

effect fn program() -> ()
  ! FileError | OutOfMemoryError | ProcessError
  ? &mut Allocator | &mut ChildProcess {
  let none: [string; 0] = []
  run shell("bothbig", "head -c 20000000 /dev/zero; head -c 20000000 /dev/zero >&2", &none)
  run shell("interleaved", "i=0; while [ $i -lt 2000 ]; do echo out$i; echo err$i >&2; i=$((i+1)); done", &none)
  let odd: [string; 9] = ["", " ", "two words", "quote\"s", "single'", "$HOME", "*", "\u{e9}\u{1F600}", "back\\slash"]
  run shell("args", "printf '[%s]\\n' \"$@\"", &odd)
  run shell("env", "env | sort", &none)
  run shell("exit300", "exit 300", &none)
  run shell("kill9", "kill -9 $$", &none)
  run shell("term", "kill -TERM $$", &none)
  run shell("closedout", "exec >&-; echo gone >&2; exit 3", &none)
  run shell("stdin", "cat; echo after", &none)
  run shell("grandchild", "(sleep 3 &); echo hi", &none)
  run Effect.catchAll(missing(), reason)
  let mut n: i32 = 0
  while n < 500 {
    run shell("many", "exit 0", &none)
    n = n + 1
  }
  return ()
}

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut processes = OsChildProcess.make()
  run Effect.catchAll(program(), reason)
    |> Effect.provideMut<ChildProcess>(&mut processes)
    |> Effect.provideMut<Allocator>(&mut allocator)
  return 0
}
