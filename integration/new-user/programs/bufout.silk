// Round 62: buffered output (std/buffered_output BufferedWriter, #2429) and bulk byte building
// (List.appendSlice/appendBytes/appendRepeated and Slice.copyInto, #2406): a padded table built
// in a List<u8>, rows assembled in a fixed array, written through a BufferedWriter both to a
// counting Writer (to see how many destination writes happen) and to standard output.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.buffered_input { BufferError }
import silk.buffered_output { BufferedWriter }
import silk.effect { Effect }
import silk.list { List }
import silk.os_writer { StdoutWriter }
import silk.slice { Slice }
import silk.usize
import silk.writer { Writer, WriterError }

struct CountingWriter {
  calls: usize,
  bytes: usize,
  flushes: usize,
}

impl Writer for CountingWriter {
  effect fn writeAll(self: &mut Self, val: &[u8]) -> ()
    ! WriterError
    ? &mut Writer {
    self.calls = self.calls + 1
    self.bytes = self.bytes + val.length
    return ()
  }

  // One destination write for the pending bytes and the input together, as a writev would be.
  effect fn writeVectored(self: &mut Self, vals: &[&[u8]]) -> ()
    ! WriterError
    ? &mut Writer {
    self.calls = self.calls + 1
    let mut i: usize = 0
    while i < vals.length {
      self.bytes = self.bytes + vals[i].length
      i = i + 1
    }
    return ()
  }

  effect fn flush(self: &mut Self) -> ()
    ! WriterError
    ? &mut Writer {
    self.flushes = self.flushes + 1
    return ()
  }
}

// One table row: a right-aligned number in 5 columns, a bar of `#`, then a newline.
effect fn row(line: &mut List<u8>, n: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut digits: [u8; 5] = [0x20, 0x20, 0x20, 0x20, 0x20]
  let mut rest = n
  let mut at: usize = 5
  while at > 0 {
    at = at - 1
    digits[at] = 0x30 + usize.toU8(rest % 10)
    rest = rest / 10
    if rest == 0 {
      break
    }
  }
  run List<u8>.appendSlice(&mut line.*, &digits)
  run List<u8>.appendBytes(&mut line.*, b" |")
  run List<u8>.appendRepeated(&mut line.*, 0x23, n % 7)
  run List<u8>.appendBytes(&mut line.*, b"\n")
  return ()
}

effect fn emit(count: usize) -> usize
  ! OutOfMemoryError | WriterError
  ? &mut Allocator | &mut Writer {
  let mut total: usize = 0
  let mut n: usize = 0
  while n < count {
    let mut line = List<u8>.make()
    run row(&mut line, n * 37)
    let bytes = List<u8>.asSlice(&line)
    run Writer.writeAll(bytes)
    total = total + bytes.length
    n = n + 1
  }
  return total
}

effect fn body() -> i32
  ! BufferError | OutOfMemoryError | WriterError
  ? &mut Allocator {
  // Slice.copyInto places a source at an offset of a larger slice.
  let mut frame: [u8; 8] = [0x2E, 0x2E, 0x2E, 0x2E, 0x2E, 0x2E, 0x2E, 0x2E]
  Slice.copyInto<u8>(&mut frame, 3, b"abc")
  if frame[2] != 0x2E || frame[3] != 0x61 || frame[5] != 0x63 || frame[6] != 0x2E { return 1 }
  Slice.copyInto<u8>(&mut frame, 8, b"")

  // 200 small writes through a 256-byte buffer reach the destination in far fewer writes.
  let mut counted = run BufferedWriter<CountingWriter>.make(CountingWriter { calls: 0, bytes: 0, flushes: 0 }, 256)
  let total = run emit(200) |> Effect.provideMut<Writer>(&mut counted)
  if BufferedWriter<CountingWriter>.pending(&counted) == 0 { return 2 }
  let counter = run BufferedWriter<CountingWriter>.finish(move counted)
  if counter.bytes != total || counter.flushes != 1 { return 3 }
  if counter.calls > total / 256 + 1 || counter.calls < total / 256 { return 4 }

  // The same rows to standard output.
  let mut out = run BufferedWriter<StdoutWriter>.make(StdoutWriter.make(), 4096)
  let printed = run emit(12) |> Effect.provideMut<Writer>(&mut out)
  let stdout = run BufferedWriter<StdoutWriter>.finish(move out)
  drop stdout
  if printed == 0 { return 5 }
  return 0
}

effect fn recover(error: BufferError | OutOfMemoryError | WriterError) -> i32 {
  return 10
}

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run body()
    |> Effect.provideMut<Allocator>(&mut allocator)
    |> Effect.catchAll(recover)
}
