import silk.effect { Effect }
import silk.logger { Logger, LogError }
import silk.os_logger { StdoutLogger }
import silk.os_system_clock { OsSystemClock }
import silk.result { Result }
import silk.system_clock { Instant, SystemClock }
import silk.testing { AssertionError, Testing }

struct NightTime { hour: i64 }

// The greeting for the current hour, in UTC.
effect fn greeting() -> string<'static> ! NightTime ? &mut SystemClock {
  let now = run SystemClock.now()
  let hour = SystemClock.seconds(&now) % 86400 / 3600
  if hour < 5 {
    fail NightTime { hour: hour }
  }
  if hour < 12 {
    return "good morning"
  }
  if hour < 18 {
    return "good afternoon"
  }
  return "good evening"
}

service Doorbell {
  effect fn ring(who: string) -> () ? &mut Doorbell
}

struct Counting {
  rings: i32,
}

impl Doorbell for Counting {
  effect fn ring(self: &mut Self, who: string) -> () {
    self.rings = self.rings + 1
  }
}

effect fn visit(names: &[string]) -> () ? &mut Doorbell {
  let mut index: usize = 0
  while index < names.length {
    run Doorbell.ring(names[index])
    index = index + 1
  }
}

// A clock that always says the same thing.
struct FixedClock { seconds: i64 }

impl SystemClock for FixedClock {
  effect fn now(self: &mut Self) -> Instant {
    return SystemClock.make(self.seconds, 0)
  }
  effect fn getResolution(self: &mut Self) -> u64 {
    return 1
  }
}

pub effect fn main() -> i32 ! LogError {
  let mut logger = StdoutLogger.make()
  let mut clock = OsSystemClock.make()
  let outcome = run Effect.result(greeting()) |> Effect.provideMut<SystemClock>(&mut clock)
  return match move outcome {
    Result.Success { value } => {
      run Effect.log("{g}\n", &.{ g: value }) |> Effect.provideMut<Logger>(&mut logger)
      return 0
    }
    Result.Failure { error } => {
      run Effect.log("go to sleep ({h} h)\n", &.{ h: error.hour }) |> Effect.provideMut<Logger>(&mut logger)
      return 1
    }
  }
}

test effect fn morningAtNine() ! AssertionError<'static> | NightTime {
  let mut clock = FixedClock { seconds: 9 * 3600 }
  let g = run greeting() |> Effect.provideMut<SystemClock>(&mut clock)
  run Testing.expect(g == "good morning", "9:00 is morning")
}

test effect fn eveningAtTwenty() ! AssertionError<'static> | NightTime {
  let mut clock = FixedClock { seconds: 86400 * 3 + 20 * 3600 }
  let g = run greeting() |> Effect.provideMut<SystemClock>(&mut clock)
  run Testing.expect(g == "good evening", "20:00 is evening")
}

test effect fn nightFails() ! AssertionError<'static> {
  let mut clock = FixedClock { seconds: 3 * 3600 }
  let outcome = run Effect.result(greeting()) |> Effect.provideMut<SystemClock>(&mut clock)
  let right = match move outcome {
    Result.Success { .. } => false
    Result.Failure { error } => error.hour == 3
  }
  run Testing.expect(right, "3:00 fails with NightTime")
}

test effect fn threeRings() ! AssertionError<'static> {
  let mut bell = Counting { rings: 0 }
  let names = ["ana", "bo", "cy"]
  run visit(&names) |> Effect.provideMut<Doorbell>(&mut bell)
  run Testing.expect(bell.rings == 3, "three visitors ring three times")
}

