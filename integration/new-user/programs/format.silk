// Round 52: the format templates of std/format (Format.format, Display, Debug) written to
// standard output with StdoutWriter. The test compares the exact output.
import silk.effect { Effect }
import silk.format { Debug, Display, Format, Formatter }
import silk.os_writer { StdoutWriter }
import silk.writer { Writer, WriterError }

struct Point {
  x: i32,
  y: i32,
}

effect fn showPoint(self: &Point, formatter: &mut Formatter) -> ()
  ! WriterError
  ? &mut Writer {
  run Format.writeText(&mut formatter, "(")
  run Format.display(&self.x)
  run Format.writeText(&mut formatter, ", ")
  run Format.display(&self.y)
  return run Format.writeText(&mut formatter, ")")
}

impl Display for Point {
  display: Point.showPoint
}

pub struct Missing {
  pub id: u32,
  pub name: string,
}

impl Debug for Missing {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return run Format.debugFields(self, "Missing", &mut formatter)
  }
}

effect fn report() -> () ! WriterError ? &mut Writer {
  run Format.format("1 [{:>5}] [{:<5}] [{:^5}]\n", &(42, 42, 42))
  run Format.format("2 {:+} {:+} {:05} {:+05}\n", &(7, -7, -7, 7))
  let byte: u8 = 255
  let minus: i32 = -1
  run Format.format("3 {:#x} {:#X} {:#o} {:#b} {:x}\n", &(byte, byte, 8, 5, minus))
  run Format.format("4 {} {} {} {:.3} {:.0} {:.0}\n", &(0.1 + 0.2, 1.0, -0.0, 3.14159, 2.5, 3.5))
  run Format.format("5 {:e} {:E}\n", &(1234.5, 0.00012))
  run Format.format("6 [{:>6}] [{:-^7}]\n", &("héé", "ab"))
  run Format.format("7 {{}} {{{n}}}\n", &.{ n: 1 })
  let width: usize = 8
  let places: usize = 2
  run Format.format("8 [{v:>w$.p$}]\n", &.{ v: 3.14159, w: width, p: places })
  run Format.format("9 [{:>6}] [{:<3}]\n", &(true, 'x'))
  run Format.format("10 {}\n", &(Point { x: 3, y: -4 },))
  run Format.format("11 {:?}\n", &(Missing { id: 9, name: "a\"b\n" },))
  run Format.format("12 {1} {0} {1}\n", &("a", "b"))
  let low: i64 = -9223372036854775807 - 1
  let high: u64 = 18446744073709551615
  run Format.format("13 {} {}\n", &(low, high))
  run Format.format("14 {:#?}\n", &(Missing { id: 1, name: "x" },))
  run Format.format("15 {:.2}|{:>6.3}|{:.3}\n", &("hello", "héllo", 7))
  run Format.format("16 {:?} {:?} {:?}\n", &((1, 2), [1, 2], .{ x: 1 }))
}

pub effect fn main() -> i32
  ! WriterError {
  let mut out = StdoutWriter.make()
  run report() |> Effect.provideMut<Writer>(&mut out)
  return 0
}
