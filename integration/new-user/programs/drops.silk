// Round 60: when destructors run (reference Ownership and moves): reverse declaration order,
// drop, assignment, temporaries, maybe-moved bindings, partial moves, arrays, break and early
// return, mut parameters, Intrinsic.replace, and a typed failure leaving a function.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.ownership { Drop }
import silk.shared { Shared }

struct Log {
  order: i64,
}

struct Tracer {
  id: i64,
  log: Shared<Log>,
}

struct Pair {
  first: Tracer,
  second: Tracer,
}

struct Oops {
  code: i32,
}

fn record(log: &mut Log, id: i64) -> i64 {
  log.order = log.order * 10 + id
  return log.order
}

impl Drop for Tracer {
  fn drop(self: &mut Tracer) -> () {
    let id = self.id
    let seen = Shared<Log>.withMut<i64>(&self.log, record(id))
    return ()
  }
}

fn tracer(id: i64, log: &Shared<Log>) -> Tracer {
  return Tracer { id: id, log: Shared<Log>.clone(log) }
}

fn order(log: &Log) -> i64 {
  return log.order
}

fn reset(log: &mut Log, unused: i64) -> i64 {
  let old = log.order
  log.order = 0
  return old
}

fn take(log: &Shared<Log>) -> i64 {
  return Shared<Log>.withMut<i64>(log, reset(0))
}

fn idOf(t: &Tracer) -> i64 {
  return t.id
}

// Locals drop in reverse declaration order.
fn reverse(log: &Shared<Log>) -> () {
  let a = tracer(1, log)
  let b = tracer(2, log)
  let c = tracer(3, log)
  return ()
}

// A temporary drops at the end of its statement, before later locals.
fn temporary(log: &Shared<Log>) -> () {
  let a = tracer(1, log)
  let seen = idOf(&tracer(2, log))
  let b = tracer(3, log)
  return ()
}

// A move in one branch: dropped at scope end only when that branch did not run.
fn consume(t: Tracer) -> () {
  return ()
}

fn maybe(log: &Shared<Log>, give: bool) -> () {
  let a = tracer(1, log)
  if give {
    consume(move a)
  }
  let b = tracer(2, log)
  return ()
}

// A partial move: the remaining field drops at scope end, the moved one where it went.
fn partial(log: &Shared<Log>) -> () {
  let pair = Pair { first: tracer(1, log), second: tracer(2, log) }
  let first = move pair.first
  drop first
  let c = tracer(3, log)
  return ()
}

// Array elements drop in index order; struct fields in declaration order.
fn ordered(log: &Shared<Log>) -> () {
  let row: [Tracer; 3] = [tracer(1, log), tracer(2, log), tracer(3, log)]
  let pair = Pair { first: tracer(4, log), second: tracer(5, log) }
  return ()
}

// break drops the loop body's locals; the loop's owner drops at the end.
fn breaking(log: &Shared<Log>) -> () {
  let outer = tracer(1, log)
  let mut i: i64 = 2
  while i < 9 {
    let inner = tracer(i, log)
    if i == 3 {
      break
    }
    i = i + 1
  }
  return ()
}

// An early return drops every scope it leaves, inner first.
fn early(log: &Shared<Log>, leave: bool) -> i32 {
  let a = tracer(1, log)
  if leave || !leave {
    let b = tracer(2, log)
    if leave {
      return 1
    }
  }
  let c = tracer(3, log)
  return 0
}

// Assigning a mut parameter drops the old value at the assignment.
fn replaceParam(mut t: Tracer, log: &Shared<Log>) -> () {
  t = tracer(2, log)
  let c = tracer(3, log)
  return ()
}

// Intrinsic.replace hands back the old value without dropping it.
fn swapped(log: &Shared<Log>) -> () {
  let mut slot = tracer(1, log)
  let old = Intrinsic.replace(slot, tracer(2, log))
  let c = tracer(3, log)
  return ()
}

// A failing effect fn drops its locals on the way out.
effect fn failing(log: &Shared<Log>) -> i32
  ! Oops {
  let a = tracer(1, log)
  let b = tracer(2, log)
  fail Oops { code: 7 }
}

effect fn recoverOops(error: Oops) -> i32 {
  return error.code
}

effect fn body() -> i32
  ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let log = run Shared<Log>.make(Log { order: 0 }) |> Effect.provideMut<Allocator>(&mut allocator)
  reverse(&log)
  if take(&log) != 321 { return 1 }
  temporary(&log)
  if take(&log) != 231 { return 2 }
  maybe(&log, true)
  if take(&log) != 12 { return 3 }
  maybe(&log, false)
  if take(&log) != 21 { return 4 }
  partial(&log)
  if take(&log) != 132 { return 5 }
  ordered(&log)
  if take(&log) != 45123 { return 6 }
  breaking(&log)
  if take(&log) != 231 { return 7 }
  if early(&log, true) != 1 || take(&log) != 21 { return 8 }
  if early(&log, false) != 0 || take(&log) != 231 { return 9 }
  replaceParam(tracer(1, &log), &log)
  if take(&log) != 132 { return 10 }
  swapped(&log)
  if take(&log) != 312 { return 11 }
  let code = run Effect.catchAll(failing(&log), recoverOops)
  if code != 7 || take(&log) != 21 { return 12 }
  return 0
}

effect fn recover(error: OutOfMemoryError) -> i32 {
  return 99
}

pub fn main() -> i32 {
  return run Effect.catchAll(body(), recover)
}
