import silk.option { Option }

struct Box {
  value: i32,
}

union Shape {
  Dot,
  Square { side: i32 },
}

fn size(large: bool) -> i32 {
  return if large { 10 } else { 1 }
}

fn grade(score: i32) -> i32 {
  let letter = if score >= 90 {
    4
  } else if score >= 80 {
    3
  } else if score >= 70 {
    2
  } else {
    0
  }
  return letter
}

fn area(shape: Shape) -> i32 {
  return match move shape {
    Shape.Dot => {
      let one = 1
      one
    }
    Shape.Square { side } => {
      let squared = side * side
      squared
    }
  }
}

fn pick(flag: bool, a: Box, b: Box) -> Box {
  return if flag { move a } else { move b }
}

fn early(n: i32) -> i32 {
  let half = if n < 0 {
    return -1
  } else {
    n / 2
  }
  return half
}

fn unwrap(found: Option<i32>) -> i32 {
  return if let Option<i32>.Some { value } = move found { value } else { 0 }
}

fn twice(v: i32) -> i32 {
  return v * 2
}

pub fn main() -> i32 {
  if size(true) != 10 || size(false) != 1 {
    return 1
  }
  if grade(95) != 4 || grade(85) != 3 || grade(75) != 2 || grade(10) != 0 {
    return 2
  }
  if area(Shape.Dot) != 1 || area(Shape.Square { side: 3 }) != 9 {
    return 3
  }
  if pick(false, Box { value: 1 }, Box { value: 2 }).value != 2 {
    return 4
  }
  if early(-5) != -1 || early(8) != 4 {
    return 5
  }
  if unwrap(Option<i32>.Some { value: 7 }) != 7 || unwrap(Option<i32>.None) != 0 {
    return 6
  }
  let nested = if true { if false { 1 } else { 2 } } else { 3 }
  if nested != 2 {
    return 8
  }
  return 0
}
