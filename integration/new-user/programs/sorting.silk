// Round 55: sorting and searching (std/list sort and binarySearch, std/order): a user Order on a
// struct that owns a String, stability on equal keys, descending order through a wrapper, a large
// pseudo-random list, empty and one-element lists, and text keys.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.list { List }
import silk.option { Option }
import silk.order { Order, Ordering }
import silk.string { String }

struct Task {
  priority: i32,
  name: String,
}

fn compareTasks(left: &Task, right: &Task) -> Ordering {
  if left.priority < right.priority {
    return Ordering.Less
  }
  if left.priority > right.priority {
    return Ordering.Greater
  }
  return Ordering.Equal
}

impl Order for Task {
  compare: Task.compareTasks
}

struct Down {
  value: i32,
}

fn compareDown(left: &Down, right: &Down) -> Ordering {
  if left.value > right.value {
    return Ordering.Less
  }
  if left.value < right.value {
    return Ordering.Greater
  }
  return Ordering.Equal
}

impl Order for Down {
  compare: Down.compareDown
}

effect fn task(list: &mut List<Task>, priority: i32, name: string) -> () ! OutOfMemoryError ? &mut Allocator {
  let owned = run String.copy(name)
  run List<Task>.append(&mut list, Task { priority: priority, name: move owned })
}

effect fn tasks() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut list = List<Task>.make()
  run task(&mut list, 3, "write")
  run task(&mut list, 1, "plan")
  run task(&mut list, 2, "build")
  run task(&mut list, 1, "think")
  run task(&mut list, 3, "ship")
  run List<Task>.sort(&mut list)
  let sorted = List<Task>.asSlice(&list)
  if sorted[0].name.view() != "plan" || sorted[1].name.view() != "think" { return 1 }
  if sorted[2].name.view() != "build" || sorted[3].name.view() != "write" || sorted[4].name.view() != "ship" { return 2 }
  let probe = run String.copy("")
  let at = List<Task>.binarySearch(&list, Task { priority: 3, name: move probe })
  if (move at |> Option<usize>.unwrapOr(99)) != 3 { return 3 }
  return 0
}

effect fn numbers() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut values = List<i32>.make()
  let mut seed: i32 = 12345
  let mut i = 0
  while i < 5000 {
    seed = (seed * 1103 + 12345) % 65536
    run List<i32>.append(&mut values, seed - 32768)
    i = i + 1
  }
  run List<i32>.sort(&mut values)
  let all = List<i32>.asSlice(&values)
  let mut k: usize = 1
  while k < all.length {
    if all[k - 1] > all[k] { return 10 }
    k = k + 1
  }
  let first = all[0]
  if (List<i32>.binarySearch(&values, first) |> Option<usize>.unwrapOr(99)) != 0 { return 11 }
  if (List<i32>.binarySearch(&values, 40000) |> Option<usize>.unwrapOr(99)) != 99 { return 12 }

  let mut empty = List<i32>.make()
  run List<i32>.sort(&mut empty)
  if (List<i32>.binarySearch(&empty, 1) |> Option<usize>.unwrapOr(99)) != 99 { return 13 }
  let mut one = List<i32>.make()
  run List<i32>.append(&mut one, 7)
  run List<i32>.sort(&mut one)
  if (List<i32>.binarySearch(&one, 7) |> Option<usize>.unwrapOr(99)) != 0 { return 14 }

  let mut down = List<Down>.make()
  run List<Down>.append(&mut down, Down { value: 1 })
  run List<Down>.append(&mut down, Down { value: 9 })
  run List<Down>.append(&mut down, Down { value: 5 })
  run List<Down>.sort(&mut down)
  let d = List<Down>.asSlice(&down)
  if d[0].value != 9 || d[2].value != 1 { return 15 }
  if (List<Down>.binarySearch(&down, Down { value: 5 }) |> Option<usize>.unwrapOr(99)) != 1 { return 16 }
  return 0
}

pub effect fn main() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let a = run tasks() |> Effect.provideMut<Allocator>(&mut allocator)
  if a != 0 { return a }
  return run numbers() |> Effect.provideMut<Allocator>(&mut allocator)
}
