// Round 58: JSON documents through std/json_value (parse, write) and std/json_codec
// (deserialize): escapes, surrogate pairs, number spellings, nesting depth, and the error reason
// and offset for each kind of bad input. The test compares standard output.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.format { Format }
import silk.json_scanner { JsonError }
import silk.json_value { Json }
import silk.list { List }
import silk.os_writer { StdoutWriter }
import silk.result { Result }
import silk.writer { Writer, WriterError }

effect fn show(name: string, input: &[u8]) -> () ! WriterError | OutOfMemoryError ? &mut Allocator | &mut Writer {
  run Format.format("{name}: ", &.{ name: name })
  let parsed = run Effect.result(Json.parse(input))
  match move parsed {
    Result.Success { value } => {
      let written = run Effect.result(Json.write(&value))
      match move written {
        Result.Success { value: done } => { drop done }
        Result.Failure { error } => run report(move error)
      }
    }
    Result.Failure { error } => run report(move error)
  }
  run Writer.writeAll(b"\n")
}

effect fn report(failure: JsonError | WriterError | OutOfMemoryError) -> () ! WriterError ? &mut Writer {
  match move failure {
    JsonError { reason, offset, required, available } => {
      drop required
      drop available
      run Format.format("error {:?} at {:?}", &(reason, move offset))
    }
    WriterError { .. } => { run Writer.writeAll(b"writer error") }
    OutOfMemoryError { .. } => { run Writer.writeAll(b"out of memory") }
  }
}

effect fn nested(depth: usize) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut bytes = List<u8>.make()
  let mut i: usize = 0
  while i < depth {
    run bytes.append(91)
    i = i + 1
  }
  i = 0
  while i < depth {
    run bytes.append(93)
    i = i + 1
  }
  return move bytes
}

effect fn all() -> () ! WriterError | OutOfMemoryError ? &mut Allocator | &mut Writer {
  run show("mixed", b"{\"a\": [1, 2.50, -0, 1e3, 12345678901234567890], \"b\": \"x\\u00e9\\n\\\"\", \"c\": {\"d\": null, \"e\": true}}")
  run show("pair", b"\"\\ud83c\\udf89\"")
  run show("lone", b"\"\\ud83c\"")
  run show("trailing comma", b"[1,]")
  run show("duplicate", b"{\"a\":1,\"a\":2}")
  run show("open", b"[")
  run show("two values", b"1 2")
  run show("leading zero", b"01")
  run show("control", b"\"a\x01\"")
  run show("word", b"nul")
  run show("colon", b"{\"a\" 1}")
  run show("utf8", b"\"\xff\"")
  run show("empty", b"")
  let deep = run nested(64)
  run show("depth 64", List<u8>.asSlice(&deep))
  let deeper = run nested(65)
  run show("depth 65", List<u8>.asSlice(&deeper))
  let big = run Effect.result(Json.deserialize<List<i32>>(b"[1, 3000000000]"))
  match move big {
    Result.Success { value } => { drop value }
    Result.Failure { error } => {
      run Writer.writeAll(b"range: ")
      run report(move error)
      run Writer.writeAll(b"\n")
    }
  }
}

pub effect fn main() -> i32 ! WriterError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut out = StdoutWriter.make()
  run all() |> Effect.provideMut<Allocator>(&mut allocator) |> Effect.provideMut<Writer>(&mut out)
  return 0
}
