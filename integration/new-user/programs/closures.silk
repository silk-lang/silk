struct Counter {
  count: i32,
}

impl Counter {
  fn bump(self: &mut Self, by: i32) -> i32 {
    self.count = self.count + by
    return self.count
  }

  fn peek(self: &Self) -> i32 {
    return self.count
  }

  fn finish(self: Self) -> i32 {
    return self.count * 10
  }
}

struct Holder<F: fn<'static>(i32) -> i32> {
  step: F,
}

fn combine(a: i32, b: i32, c: i32) -> i32 {
  return a * 100 + b * 10 + c
}

fn twice<F: fn(i32) -> i32>(f: F, x: i32) -> i32 {
  return f(f(x))
}

fn callMut(mut f: mut fn(i32) -> i32) -> i32 {
  let first = f(1)
  return f(first)
}

fn callOnce(f: once fn() -> i32) -> i32 {
  return f()
}

fn adder(n: i32) -> fn<'static>(i32) -> i32 {
  return fn(x: i32) -> i32 {
    return x + n
  }
}

pub fn main() -> i32 {
  let add3 = adder(3)
  if twice(add3, 1) != 7 {
    return 1
  }
  let staged = combine(3)
  if staged(1, 2) != 123 || combine(2, 3)(1) != 123 || combine(3)(2)(1) != 123 {
    return 2
  }
  let holder = Holder { step: adder(10) }
  if (holder.step)(5) != 15 {
    return 3
  }
  let mut counter = Counter { count: 0 }
  let mut bump = counter.bump
  drop bump(2)
  drop bump(3)
  drop bump
  if counter.peek() != 5 {
    return 4
  }
  let peek = counter.peek
  if peek() != 5 {
    return 5
  }
  drop peek
  let mut total = 0
  let result = callMut(move fn(x: i32) -> i32 {
    total = total + x
    return total
  })
  if result != 2 || total != 2 {
    return 6
  }
  let finish = counter.finish
  if callOnce(move finish) != 50 {
    return 7
  }
  return 0
}
