// Round 61: integer arithmetic policies (reference Values and primitive types) and nominal
// tuples (reference Structs, tuples and arrays): FNV-1a with wrapping u32/u64 math, saturating
// and checked operations, shifts and rotates, signed division and remainder, conversions, and
// tuples built by call, by literal against a type, and read and written by ordinal.
import silk.i8
import silk.i32
import silk.i64
import silk.u8
import silk.u32
import silk.u64
import silk.option { Option }
import silk.ownership { Copy }

tuple Range(i32, i32)

impl Copy for Range {}

pub tuple Pair(u32, bool)

fn width(r: Range) -> i32 {
  return r.1 - r.0
}

fn fnv32(bytes: &[u8]) -> u32 {
  let mut hash: u32 = 2166136261
  let mut i: usize = 0
  while i < bytes.length {
    hash = hash ^ u8.toU32(bytes[i])
    hash = u32.wrappingMultiply(hash, 16777619)
    i = i + 1
  }
  return hash
}

fn fnv64(bytes: &[u8]) -> u64 {
  let mut hash: u64 = 14695981039346656037
  let mut i: usize = 0
  while i < bytes.length {
    hash = hash ^ u8.toU64(bytes[i])
    hash = u64.wrappingMultiply(hash, 1099511628211)
    i = i + 1
  }
  return hash
}

fn split(r: Range, at: i32) -> Pair {
  return Pair(i32.toU32(at - r.0), at < r.1)
}

pub fn main() -> i32 {
  // FNV-1a test vectors.
  if fnv32(b"") != 2166136261 || fnv32(b"a") != 0xE40C292C || fnv32(b"foobar") != 0xBF9CF968 { return 1 }
  if fnv64(b"a") != 0xAF63DC4C8601EC8C || fnv64(b"foobar") != 0x85944171F73967E8 { return 2 }

  // Wrapping, saturating, checked.
  if u8.wrappingAdd(250, 10) != 4 || i8.wrappingNegate(i8.MIN) != i8.MIN || u32.wrappingSubtract(0, 1) != u32.MAX { return 3 }
  if u8.saturatingAdd(250, 10) != 255 || i8.saturatingSubtract(-100, 100) != -128 || i32.saturatingMultiply(i32.MAX, 2) != i32.MAX { return 4 }
  if (i32.checkedAdd(i32.MAX, 1) |> Option<i32>.unwrapOr(-1)) != -1 { return 5 }
  if (i32.checkedDivide(i32.MIN, -1) |> Option<i32>.unwrapOr(-2)) != -2 { return 6 }
  if (i32.checkedRemainder(7, 0) |> Option<i32>.unwrapOr(-3)) != -3 { return 7 }
  if (i64.checkedMultiply(3037000499, 3037000499) |> Option<i64>.unwrapOr(0)) != 9223372030926249001 { return 8 }

  // Shifts and rotates.
  if u32.shiftLeft(1, 31) != 0x80000000 || u32.shiftRight(0x80000000, 31) != 1 { return 9 }
  if u8.rotateLeft(0x81, 1) != 0x03 || u32.rotateRight(1, 1) != 0x80000000 { return 10 }
  if i32.shiftRight(-8, 1) != -4 { return 11 }

  // Division truncates toward zero; the remainder takes the left sign.
  if -7 / 2 != -3 || -7 % 2 != -1 || 7 % -2 != 1 { return 12 }

  // Conversions.
  if i32.toI64(i32.MIN) != -2147483648 || (i64.checkedToI32(i64.MAX) |> Option<i32>.unwrapOr(-1)) != -1 { return 13 }
  if u8.toI32(u8.MAX) != 255 || (i32.checkedToU8(256) |> Option<u8>.unwrapOr(7)) != 7 { return 14 }

  // Tuples.
  let r = Range(3, 10)
  let lit: Range = (2, 5)
  if width(r) != 7 || width(lit) != 3 { return 15 }
  let mut p = split(r, 12)
  if p.0 != 9 || p.1 { return 16 }
  p.0 = p.0 + 1
  p.1 = true
  if p.0 != 10 || !p.1 { return 17 }
  let anon = (1, true, 'x')
  if anon.0 != 1 || !anon.1 || anon.2 != 'x' { return 18 }
  let single = (5,)
  if single.0 != 5 { return 19 }
  return 0
}
