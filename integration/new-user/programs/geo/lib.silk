//! Shapes with an area, and helpers that work on any shape.

import silk.ownership { Copy }
import silk.testing { AssertionError, Testing }

/// Anything with a whole-number area.
pub interface Shape {
  fn area(shape: &Self) -> i64

  /// The number of corners. Shapes without corners keep the default.
  fn corners(shape: &Self) -> i64 {
    return 0
  }
}

/// A square with a side length.
pub struct Square {
  side: i64,
}

impl Square {
  /// Returns a square with the given side.
  pub fn make(side: i64) -> Square {
    return Square { side: side }
  }
}

impl Shape for Square {
  fn area(shape: &Self) -> i64 {
    return shape.side * shape.side
  }

  fn corners(shape: &Self) -> i64 {
    return 4
  }
}

/// The best value seen so far and its score.
pub struct Best<T> {
  pub value: T,
  pub score: i64,
}

/// A shape side that is not positive.
pub struct BadSide {
  pub side: i64,
}

/// Returns a square, or fails with BadSide when the side is not positive.
pub effect fn checkedSquare(side: i64) -> Square
  ! BadSide {
  if side <= 0 {
    fail BadSide { side: side }
  }
  return Square.make(side)
}

/// Adds up the areas of all shapes.
pub fn totalArea<T: Shape>(shapes: &[T]) -> i64 {
  let mut total: i64 = 0
  let mut index: usize = 0
  while index < shapes.length {
    total = total + shapes[index].area()
    index = index + 1
  }
  return total
}

/// Returns the shape with the largest area, with that area. Needs at least one shape.
pub fn largest<T: Shape + Copy>(shapes: &[T]) -> Best<T> {
  let mut best = Best<T> { value: shapes[0], score: Shape.area(&shapes[0]) }
  let mut index: usize = 1
  while index < shapes.length {
    let score = shapes[index].area()
    if score > best.score {
      best = Best<T> { value: shapes[index], score: score }
    }
    index = index + 1
  }
  return move best
}

/// Counts the corners of all shapes.
pub fn totalCorners<T: Shape>(shapes: &[T]) -> i64 {
  let mut total: i64 = 0
  let mut index: usize = 0
  while index < shapes.length {
    total = total + Shape.corners(&shapes[index])
    index = index + 1
  }
  return total
}

test effect fn squaresAddUp() -> ()
  ! AssertionError<'static> {
  let shapes = [Square.make(2), Square.make(3)]
  run Testing.expect(totalArea(&shapes) == 13, "4 + 9")
}

impl<T> Best<T> {
  /// Returns the score.
  pub fn scoreOf(self: &Self) -> i64 {
    return self.score
  }
}

impl<T: Shape> Shape for Best<T> {
  fn area(shape: &Self) -> i64 {
    return shape.value.area()
  }

  fn corners(shape: &Self) -> i64 {
    return Shape.corners(&shape.value)
  }
}
