import silk.effect { Effect }
import silk.ownership { Copy }
import geo.lib { BadSide, Best, Shape, checkedSquare, largest, totalArea, totalCorners }

struct Circle {
  radius: i64,
}

impl Shape for Circle {
  fn area(shape: &Self) -> i64 {
    return 3 * shape.radius * shape.radius
  }
}

impl Copy for Circle {}

effect fn sumSquares(sides: &[i64]) -> i64
  ! BadSide {
  let mut total: i64 = 0
  let mut index: usize = 0
  while index < sides.length {
    let square = run checkedSquare(sides[index])
    total = total + square.area()
    index = index + 1
  }
  return total
}

effect fn badTotal(error: BadSide) -> i64 {
  return 0 - error.side
}

pub fn main() -> i32 {
  let circles = [Circle { radius: 1 }, Circle { radius: 3 }, Circle { radius: 2 }]
  let best = largest(&circles)
  if best.score != 27 || best.value.radius != 3 {
    return 1
  }
  if totalArea(&circles) != 42 || totalCorners(&circles) != 0 {
    return 2
  }
  let good = run sumSquares(&[1, 2]) |> Effect.catchAll(badTotal)
  let bad = run sumSquares(&[1, -5, 2]) |> Effect.catchAll(badTotal)
  if good != 5 || bad != 5 {
    return 3
  }
  let winners = [largest(&circles), largest(&circles)]
  if totalArea(&winners) != 54 || winners[0].scoreOf() != 27 {
    return 4
  }
  return 0
}
