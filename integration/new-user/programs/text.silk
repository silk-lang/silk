// Round 53: text that is not ASCII, through silk.string: scalar traversal, byte offsets, search,
// slicing, splitting on a multi-byte separator, Unicode whitespace, and building an owned String.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.option { Option }
import silk.string { Split, String }

fn scalars(value: string) -> usize {
  let mut count: usize = 0
  let mut cursor = String.scalarCursor()
  while true {
    let step = match String.nextScalar(value, move cursor) {
      Option.Some { value: step } => move step
      Option.None => { break }
    }
    count = count + 1
    cursor = String.nextCursor(move step)
  }
  return count
}

// The byte offset of the scalar number `index`, or the byte length past the end.
fn offsetOf(value: string, index: usize) -> usize {
  let mut seen: usize = 0
  let mut cursor = String.scalarCursor()
  while true {
    let step = match String.nextScalar(value, move cursor) {
      Option.Some { value: step } => move step
      Option.None => { break }
    }
    if seen == index {
      return String.scalarByteOffset(&step)
    }
    seen = seen + 1
    cursor = String.nextCursor(move step)
  }
  return String.byteLength(value)
}

fn lastScalar(value: string) -> char {
  let mut last = ' '
  let mut cursor = String.scalarCursor()
  while true {
    let step = match String.nextScalar(value, move cursor) {
      Option.Some { value: step } => move step
      Option.None => { break }
    }
    last = String.scalarValue(&step)
    cursor = String.nextCursor(move step)
  }
  return last
}

fn pieces(value: string, separator: string) -> usize {
  let mut parts = String.split(value, separator)
  let mut count: usize = 0
  while true {
    match Split.next(&mut parts) {
      Option.Some { value: piece } => {
        drop piece
        count = count + 1
      }
      Option.None => { break }
    }
  }
  return count
}

fn found(hit: Option<usize>) -> usize {
  return match move hit {
    Option.Some { value } => value
    Option.None => 999
  }
}

effect fn joined() -> usize ! OutOfMemoryError ? &mut Allocator {
  let mut text = String.make()
  run text.append("日本")
  run text.append("語 ")
  run text.append("\u{1F389}")
  if text.view() != "日本語 🎉" {
    return 0
  }
  return text.ownedByteLength()
}

pub effect fn main() -> i32 ! OutOfMemoryError {
  let text = "naïve café 日本語 🎉"
  if String.byteLength(text) != 27 { return 1 }
  if scalars(text) != 16 { return 2 }
  if offsetOf(text, 11) != 13 { return 3 }
  if lastScalar(text) != '🎉' { return 4 }
  if found(String.find(text, "本")) != 16 { return 5 }
  if found(String.findLast("aaaa", "aa")) != 2 { return 6 }
  if String.slice(text, 13, 9) != "日本語" { return 7 }
  if String.isCharBoundary(text, 3) { return 8 }
  if !String.isCharBoundary(text, 4) || !String.isCharBoundary(text, 27) || String.isCharBoundary(text, 28) { return 9 }
  if pieces("a→b→→c", "→") != 4 { return 10 }
  if pieces("", ",") != 1 || pieces("abc", "") != 1 { return 11 }
  if String.trim("\u{3000}\u{A0} Grüße\u{2029}\t") != "Grüße" { return 12 }
  if String.startsWith("e\u{301}", "e") != true || String.startsWith("é", "e") { return 13 }
  if !String.contains(text, "café 日") || String.contains(text, "CAFÉ") { return 14 }
  if !String.endsWith(text, "🎉") { return 15 }
  let mut allocator = Allocator.systemAllocatorProvider()
  let built = run joined() |> Effect.provideMut<Allocator>(&mut allocator)
  if built != 14 { return 16 }
  return 0
}
