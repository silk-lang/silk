import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.fiber { Cancelled, Fiber }
import silk.local_scheduler { LocalScheduler, StalledError }
import silk.monotonic_clock { MonotonicClock }
import silk.os_monotonic_clock { OsMonotonicClock }
import silk.ownership { Drop }
import silk.scheduler { Scheduler, TaskIdExhaustedError }
import silk.shared { Shared }

const MILLISECOND: u64 = 1000000

// What the workers report back.
struct Log {
  order: [u32; 8],
  count: usize,
  drops: i32,
  finals: i32,
}

fn record(log: &mut Log, id: u32) -> () {
  log.order[log.count] = id
  log.count = log.count + 1
}

fn countDrop(log: &mut Log) -> () {
  log.drops = log.drops + 1
}

fn countFinal(log: &mut Log) -> () {
  log.finals = log.finals + 1
}

// Held by every worker; its Drop hook runs on success and on cancellation.
struct Guard {
  log: Shared<Log>,
}

impl Drop for Guard {
  fn drop(self: &mut Self) -> () {
    Shared.withMut(&self.log, countDrop)
  }
}

effect fn finish(log: Shared<Log>) -> () {
  Shared.withMut(&log, countFinal)
}

effect fn work(id: u32, delay: u64, log: Shared<Log>) -> ()
  ? &mut Scheduler | &mut MonotonicClock {
  let guard = Guard { log: Shared.clone(&log) }
  run Effect.sleep(delay * MILLISECOND)
  Shared.withMut(&log, fn(state: &mut Log) -> () {
    record(move state, id)
  })
  drop guard
}

effect fn worker(id: u32, delay: u64, log: Shared<Log>) -> ()
  ? &mut Scheduler | &mut MonotonicClock {
  let finalLog = Shared.clone(&log)
  run work(id, delay, move log) |> Effect.ensuringNonParking(finish(move finalLog))
}

effect fn slowest(log: Shared<Log>) -> i32
  ! OutOfMemoryError | TaskIdExhaustedError | Cancelled
  ? &mut Scheduler | &mut MonotonicClock {
  let fast = run Fiber<(), never>.forkChild(worker(1, 10, Shared.clone(&log)))
  let middle = run Fiber<(), never>.forkChild(worker(2, 30, Shared.clone(&log)))
  let late = run Fiber<(), never>.forkChild(worker(3, 2000, Shared.clone(&log)))
  drop late
  run Fiber<(), never>.join(move middle)
  run Fiber<(), never>.join(move fast)
  return 2
}

fn snapshot(log: &Log) -> Log {
  return Log { order: log.order, count: log.count, drops: log.drops, finals: log.finals }
}

pub effect fn main() -> i32
  ! OutOfMemoryError | TaskIdExhaustedError | Cancelled | StalledError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let log = run Shared<Log>.make(Log { order: [0, 0, 0, 0, 0, 0, 0, 0], count: 0, drops: 0, finals: 0 })
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut scheduler = LocalScheduler.make()
  let mut clock = OsMonotonicClock.make()
  let joined = run LocalScheduler.execute(&mut scheduler, slowest(Shared.clone(&log)))
    |> Effect.provideMut<MonotonicClock>(&mut clock)
  let seen = Shared.with(&log, snapshot)
  if joined != 2 || seen.count != 2 || seen.order[0] != 1 || seen.order[1] != 2 {
    return 1
  }
  if seen.drops != 3 {
    return 10 + seen.drops
  }
  if seen.finals != 3 {
    return 20 + seen.finals
  }
  return 0
}
