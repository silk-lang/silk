// Round 59: scalar enums (reference Enums and unions): representations, explicit and implicit
// values in every literal form, value(), equality, methods in an impl, exhaustive match, if let,
// enums as struct fields and array elements, and a lookup back from an integer.
import silk.option { Option }

enum(u16) Status {
  Ok = 200,
  Created,
  Moved = 0x12D,
  NotFound = 0o624,
  Teapot = 0b110100010,
}

enum(i8) Level {
  Low = -2,
  Mid,
  High,
}

enum Light {
  Red,
  Yellow,
  Green,
}

impl Light {
  fn next(self: Light) -> Light {
    return match self {
      Light.Red => Light.Green
      Light.Green => Light.Yellow
      Light.Yellow => Light.Red
    }
  }
}

struct Reply {
  status: Status,
  retries: u8,
}

fn statusOf(code: u16) -> Option<Status> {
  let all: [Status; 5] = [Status.Ok, Status.Created, Status.Moved, Status.NotFound, Status.Teapot]
  let mut i: usize = 0
  while i < 5 {
    if Status.value(all[i]) == code {
      return Option<Status>.some(all[i])
    }
    i = i + 1
  }
  return Option<Status>.none()
}

fn isError(status: Status) -> bool {
  return match status {
    Status.NotFound => true
    Status.Teapot => true
    _ => false
  }
}

pub fn main() -> i32 {
  if Status.value(Status.Created) != 201 || Status.value(Status.Moved) != 301 { return 1 }
  if Status.value(Status.NotFound) != 404 || Status.value(Status.Teapot) != 418 { return 2 }
  if Level.value(Level.Mid) != -1 || Level.value(Level.High) != 0 { return 3 }
  if Light.value(Light.Green) != 2 { return 4 }
  if Light.Red.next() != Light.Green || Light.Red.next().next() != Light.Yellow { return 5 }
  let reply = Reply { status: Status.Teapot, retries: 1 }
  let copy = reply.status
  if copy != Status.Teapot || !isError(reply.status) || isError(Status.Ok) { return 6 }
  if let Status.Moved = Status.Moved {
  } else {
    return 7
  }
  let found = statusOf(404) |> Option<Status>.unwrapOr(Status.Ok)
  if found != Status.NotFound { return 8 }
  let missing = statusOf(500) |> Option<Status>.unwrapOr(Status.Ok)
  if missing != Status.Ok { return 9 }
  return 0
}
