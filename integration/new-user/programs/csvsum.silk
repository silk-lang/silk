import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.effect { Effect }
import silk.format { ParseError }
import silk.filesystem { FileError, FileSystem, Path }
import silk.host_input { HostInput, HostInputError }
import silk.i64
import silk.logger { Logger, LogError }
import silk.option { Option }
import silk.os_filesystem { OsFileSystem }
import silk.os_logger { StdoutLogger }
import silk.result { Result }
import silk.string { String, Split, InvalidUtf8 }

struct CorruptFile {}

struct BadRow {
  line: i64,
}

struct Summary {
  rows: i64,
  units: i64,
  total: i64,
}

effect fn number(text: string, line: i64) -> i64 ! BadRow {
  return match i64.parse(String.trim(text)) {
    Result<i64, ParseError>.Success { value } => value
    Result<i64, ParseError>.Failure { .. } => {
      fail BadRow { line: line }
    }
  }
}

effect fn summarize(text: string) -> Summary ! BadRow {
  let mut lines = String.split(text, "\n")
  let mut summary = Summary { rows: 0, units: 0, total: 0 }
  let mut line: i64 = 0
  while true {
    let row = match Split.next(&mut lines) {
      Option<string>.Some { value } => value
      Option<string>.None => { break }
    }
    line = line + 1
    if line == 1 || String.trim(row) == "" {
      continue
    }
    let mut fields = String.split(row, ",")
    let name = match Split.next(&mut fields) {
      Option<string>.Some { value } => value
      Option<string>.None => { fail BadRow { line: line } }
    }
    let qty = match Split.next(&mut fields) {
      Option<string>.Some { value } => run number(value, line)
      Option<string>.None => { fail BadRow { line: line } }
    }
    let price = match Split.next(&mut fields) {
      Option<string>.Some { value } => run number(value, line)
      Option<string>.None => { fail BadRow { line: line } }
    }
    summary.rows = summary.rows + 1
    summary.units = summary.units + qty
    summary.total = summary.total + qty * price
  }
  return move summary
}

effect fn report(file: string) -> i32
! LogError | BadRow | CorruptFile | FileError | OutOfMemoryError
? &mut Logger | &mut FileSystem | &mut Allocator {
  let path = run Path.make(file)
  let bytes = run FileSystem.readFile(&path)
  let text = match String.fromUtf8(Bytes.asSlice(&bytes)) {
    Result<string, InvalidUtf8>.Success { value } => value
    Result<string, InvalidUtf8>.Failure { .. } => { fail CorruptFile {} }
  }
  let s = run summarize(text)
  run Effect.log("{rows} rows, {units} units, total {total}\n", &.{ rows: s.rows, units: s.units, total: s.total })
  return 0
}

pub effect fn main() -> i32 ! LogError | OutOfMemoryError | HostInputError
? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut logger = StdoutLogger.make()
  let here = run HostInput.workingDirectory() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut files = run OsFileSystem.makeBytes(Bytes.asSlice(&here)) |> Effect.provideMut<Allocator>(&mut allocator)
  let handled = Effect.catchAll(report("/data.csv"), explain)
  return run move handled
    |> Effect.provideMut<Logger>(&mut logger)
    |> Effect.provideMut<FileSystem>(&mut files)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn explain(problem: BadRow | CorruptFile | FileError | LogError | OutOfMemoryError) -> i32
! LogError | OutOfMemoryError
? &mut Logger {
  return match move problem {
    BadRow bad => {
      run Effect.log("line {n} is not name,qty,price\n", &.{ n: bad.line })
      return 2
    }
    CorruptFile {} => {
      run Effect.log("data.csv is not UTF-8\n", &())
      return 3
    }
    FileError failed => {
      run Effect.log("could not read data.csv ({why:?})\n", &.{ why: move failed.reason })
      return 4
    }
    LogError held => { fail move held }
    OutOfMemoryError held => { fail move held }
  }
}
