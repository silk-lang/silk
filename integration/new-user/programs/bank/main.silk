// Round 56: typed failures across modules (reference Typed failures, book chapter 7): fail with
// structs and a union from another module, run propagation, catch of one member, catchAll with a
// match, mapError, Effect.result, ensuring order, and drops of live locals on failure.
import bank { Frozen, Overdrawn, Problem, find, withdraw }
import silk.effect { Effect }
import silk.os_writer { StderrWriter }
import silk.result { Result }

effect fn onShort(error: Overdrawn) -> i32 {
  return -error.short
}

effect fn onAny(error: Overdrawn | Frozen) -> i32 {
  return match move error {
    Overdrawn { short } => -short
    Frozen {} => -1000
  }
}

// Finding 170: catchAll(onAny), whose parameter also accepts the already handled Overdrawn,
// is SEM0052 here, so this handler takes exactly what is left.
effect fn onFrozen(error: Frozen) -> i32 {
  drop error
  return -1000
}

effect fn twice(balance: i32) -> i32 ! Overdrawn | Frozen {
  let first = run withdraw(balance, 30)
  return run withdraw(first, 30)
}

effect fn code(problem: Problem) -> i32 {
  return match move problem {
    Problem.Missing { id } => id
    Problem.Closed => -1
  }
}

fn toCode(problem: Problem) -> i32 {
  return match move problem {
    Problem.Missing { id } => id
    Problem.Closed => -1
  }
}

effect fn passthrough(n: i32) -> i32 {
  return n
}

effect fn note() -> () {
  StderrWriter.print("finalizer\n", &())
}

pub fn main() -> i32 {
  let a = run withdraw(100, 30) |> Effect.catchAll(onAny)
  if a != 70 { return 1 }
  let b = run withdraw(10, 30) |> Effect.catchAll(onAny)
  if b != -20 { return 2 }
  let c = run withdraw(-5, 1) |> Effect.catchAll(onAny)
  if c != -1000 { return 3 }
  let d = run Effect.catch(twice(50), onShort) |> Effect.catchAll(onFrozen)
  if d != -10 { return 4 }
  let e = run Effect.mapError(find(42), toCode) |> Effect.catchAll(passthrough)
  if e != 42 { return 5 }
  let outcome = run Effect.result(find(0))
  let f = match move outcome {
    Result.Success { value } => value
    Result.Failure { error } => run code(move error)
  }
  if f != -1 { return 6 }
  let g = run Effect.ensuring(find(3), note()) |> Effect.catchAll(code)
  if g != 300 { return 7 }
  StderrWriter.print("done\n", &())
  return 0
}
