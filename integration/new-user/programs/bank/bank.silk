// Failure types and effects of a small bank, used from main.silk.
import silk.os_writer { StderrWriter }
import silk.ownership { Drop }

pub struct Overdrawn {
  pub short: i32,
}

pub struct Frozen {}

pub union Problem {
  Missing { pub id: i32 },
  Closed,
}

pub struct Receipt {
  pub label: string<'static>,
}

impl Drop for Receipt {
  fn drop(self: &mut Self) -> () {
    StderrWriter.print("drop {label}\n", &.{ label: self.label })
  }
}

pub effect fn withdraw(balance: i32, amount: i32) -> i32 ! Overdrawn | Frozen {
  let receipt = Receipt { label: "withdraw" }
  if balance < 0 {
    fail Frozen {}
  }
  if amount > balance {
    fail Overdrawn { short: amount - balance }
  }
  drop receipt
  return balance - amount
}

pub effect fn find(id: i32) -> i32 ! Problem {
  if id == 0 {
    fail Problem.Closed
  }
  if id > 10 {
    fail Problem.Missing { id: id }
  }
  return id * 100
}
