// Round 57: generic structs with interface bounds (reference Generics, Interfaces and impls):
// conditional conformance through Pair<T> and Boxed<T>, a default operation, generic interface
// operations (#2407) with written and inferred type arguments, and bounded generic helpers.
import silk.ownership { Copy }

interface Weight {
  fn weight(self: &Self) -> i32

  fn heavy(self: &Self) -> bool {
    return Weight.weight(self) > 10
  }
}

interface Pick {
  fn pick<T>(self: &Self, first: T, second: T) -> T
}

struct Stone {
  grams: i32,
}

impl Copy for Stone {}

impl Weight for Stone {
  fn weight(self: &Self) -> i32 {
    return self.grams
  }
}

struct Pair<T> {
  left: T,
  right: T,
}

impl<T: Weight> Weight for Pair<T> {
  fn weight(self: &Self) -> i32 {
    return Weight.weight(&self.left) + Weight.weight(&self.right)
  }
}

struct Boxed<T> {
  inner: T,
}

impl<T: Weight> Weight for Boxed<T> {
  fn weight(self: &Self) -> i32 {
    return Weight.weight(&self.inner) + 1
  }

  fn heavy(self: &Self) -> bool {
    return false
  }
}

struct Coin {
  heads: bool,
}

impl Pick for Coin {
  fn pick<T>(self: &Self, first: T, second: T) -> T {
    if self.heads {
      drop second
      return move first
    }
    drop first
    return move second
  }
}

fn total<T: Weight>(items: &[T]) -> i32 {
  let mut sum = 0
  let mut i: usize = 0
  while i < items.length {
    sum = sum + items[i].weight()
    i = i + 1
  }
  return sum
}

fn heaviest<T: Weight + Copy>(a: T, b: T) -> T {
  if Weight.weight(&a) >= Weight.weight(&b) {
    return a
  }
  return b
}

pub fn main() -> i32 {
  let small = Stone { grams: 4 }
  let big = Stone { grams: 12 }
  if small.heavy() || !big.heavy() { return 1 }
  let pair = Pair<Stone> { left: small, right: big }
  if Weight.weight(&pair) != 16 || !pair.heavy() { return 2 }
  let nested = Pair<Pair<Stone>> { left: Pair<Stone> { left: small, right: small }, right: Pair<Stone> { left: big, right: big } }
  if nested.weight() != 32 { return 3 }
  let boxed = Boxed<Pair<Stone>> { inner: Pair<Stone> { left: big, right: big } }
  if boxed.weight() != 25 || boxed.heavy() { return 4 }
  let stones: [Stone; 3] = [small, big, small]
  if total(&stones) != 20 { return 5 }
  if heaviest(small, big).grams != 12 { return 6 }
  let heads = Coin { heads: true }
  let tails = Coin { heads: false }
  if Pick.pick<i32>(&heads, 1, 2) != 1 || tails.pick(1, 2) != 2 { return 7 }
  // Finding 171: writing `pick<string>` is an uncoded unsupported construct; inferred works.
  if heads.pick("a", "b") != "a" { return 8 }
  if tails.pick(small, big).grams != 12 { return 9 }
  return 0
}
