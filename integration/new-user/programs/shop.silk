enum(u8) Kind {
  Fruit = 1,
  Tool,
  Book = 10,
}

struct Item {
  code: i32,
  kind: Kind,
  stock: i32,
}

union Maybe<T> {
  None,
  Some { value: T },
}

union Event {
  Restock { index: usize, amount: i32 },
  Sell { index: usize, amount: i32 },
  Retag { index: usize, kind: Kind },
  Close,
}

struct Refused {
  reason: i32,
}

fn find(items: &[Item; 3], code: i32) -> Maybe<usize> {
  let mut index: usize = 0
  while index < 3 {
    if items[index].code == code {
      return Maybe<usize>.Some { value: index }
    }
    index = index + 1
  }
  return Maybe<usize>.None
}

fn restock(items: &mut [Item; 3], index: usize, amount: i32) -> i32 {
  match &mut items[index] {
    Item { stock, .. } => {
      stock = stock + amount
    }
  }
  return items[index].stock
}

fn apply(items: &mut [Item; 3], event: Event) -> i32 | Refused | bool {
  return match move event {
    Event.Restock { amount, .. } if amount <= 0 => Refused { reason: 1 }
    Event.Restock { index, amount } => restock(&mut items, index, amount)
    Event.Sell { index, amount } if items[index].stock < amount => Refused { reason: 2 }
    Event.Sell { index, amount } => restock(&mut items, index, 0 - amount)
    Event.Retag { index, kind: Kind.Book } => false
    Event.Retag { index, kind } => retag(&mut items, index, kind)
    Event.Close => true
  }
}

fn retag(items: &mut [Item; 3], index: usize, kind: Kind) -> bool {
  items[index].kind = kind
  return true
}

fn score(outcome: i32 | Refused | bool) -> i32 {
  return match move outcome {
    i32 stock => stock
    Refused { reason } => 100 * reason
    bool closed if closed => 1000
    bool _ => 2000
  }
}

fn kindWeight(kind: Kind) -> i32 {
  return match kind {
    Kind.Fruit => 1
    Kind.Tool => 2
    Kind.Book => 3
  }
}

struct Shelf {
  held: Maybe<Item>,
}

fn swapHeld(shelf: Shelf, replacement: Item) -> Shelf {
  let mut local = move shelf
  match place local.held {
    Maybe<Item>.Some { value } => {
      value = move replacement
    }
    Maybe<Item>.None => {
      local.held = Maybe<Item>.Some { value: move replacement }
    }
  }
  return move local
}

fn heldCode(shelf: &Shelf) -> i32 {
  return match &shelf.held {
    Maybe<Item>.Some { value } => value.code
    Maybe<Item>.None => 0
  }
}

pub fn main() -> i32 {
  let mut items = [
    Item { code: 7, kind: Kind.Fruit, stock: 5 },
    Item { code: 8, kind: Kind.Tool, stock: 1 },
    Item { code: 9, kind: Kind.Book, stock: 0 },
  ]
  let found = find(&items, 8)
  let index = match move found {
    Maybe<usize>.Some { value } => value
    Maybe<usize>.None => {
      return 1
    }
  }
  if score(apply(&mut items, Event.Restock { index: index, amount: 4 })) != 5 {
    return 2
  }
  if score(apply(&mut items, Event.Restock { index: index, amount: 0 })) != 100 {
    return 3
  }
  if score(apply(&mut items, Event.Sell { index: 0, amount: 9 })) != 200 {
    return 4
  }
  if score(apply(&mut items, Event.Sell { index: 0, amount: 2 })) != 3 {
    return 5
  }
  if score(apply(&mut items, Event.Retag { index: 1, kind: Kind.Book })) != 2000 {
    return 6
  }
  if score(apply(&mut items, Event.Retag { index: 1, kind: Kind.Fruit })) != 1000 || kindWeight(items[1].kind) != 1 {
    return 7
  }
  if score(apply(&mut items, Event.Close)) != 1000 {
    return 8
  }
  if Kind.value(Kind.Book) != 10 || Kind.value(Kind.Tool) != 2 {
    return 9
  }
  let Item { code, stock, .. } = &items[0]
  if code != 7 || stock != 3 {
    return 10
  }
  if let Maybe<usize>.None = find(&items, 42) {
  } else {
    return 11
  }
  let empty = Shelf { held: Maybe<Item>.None }
  let shelf = swapHeld(move empty, Item { code: 1, kind: Kind.Tool, stock: 0 })
  if heldCode(&shelf) != 1 {
    return 12
  }
  let swapped = swapHeld(move shelf, Item { code: 2, kind: Kind.Tool, stock: 0 })
  if heldCode(&swapped) != 2 {
    return 13
  }
  let hex = match code {
    -1 => 2
    0x07 => 1
    i32 other => other
  }
  if hex != 1 {
    return 14
  }
  return 0
}
