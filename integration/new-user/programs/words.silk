import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.hash { Hash, HashKey, HashSeed }
import silk.hash_map { HashMap }
import silk.list { List }
import silk.logger { Logger, LogError }
import silk.option { Option }
import silk.ownership { Copy }
import silk.order { Order, Ordering }
import silk.os_logger { StdoutLogger }
import silk.string { String, Split }
import silk.u8
import silk.u64
import silk.usize

const TEXT: string<'static> = "the cat and the dog and the bird saw a cat"

// A word used as a hash-map key.
struct Word<'text> { text: string<'text> }

impl<'text> Copy for Word<'text> {}

fn sameWord(left: &Word, right: &Word) -> bool {
  return left.text == right.text
}

fn hashWord(value: &Word, seed: &HashSeed) -> u64 {
  let bytes = String.utf8Bytes(value.text)
  let mut hashed = Hash.mix(seed, usize.toU64(bytes.length))
  let mut index: usize = 0
  while index < bytes.length {
    hashed = Hash.combine(hashed, u8.toU64(bytes[index]))
    index = index + 1
  }
  return hashed
}

impl<'text> HashKey for Word<'text> { equals: sameWord hash: hashWord }

struct Count<'text> { word: Word<'text>, n: u32 }

impl<'text> Copy for Count<'text> {}

// More frequent first, then alphabetical.
fn compareCounts(left: &Count, right: &Count) -> Ordering {
  if left.n > right.n {
    return Ordering.Less
  }
  if left.n < right.n {
    return Ordering.Greater
  }
  return compareText(left.word.text, right.word.text)
}

fn compareText(left: string, right: string) -> Ordering {
  let a = String.utf8Bytes(left)
  let b = String.utf8Bytes(right)
  let mut index: usize = 0
  while index < a.length && index < b.length {
    if a[index] < b[index] {
      return Ordering.Less
    }
    if a[index] > b[index] {
      return Ordering.Greater
    }
    index = index + 1
  }
  if a.length < b.length {
    return Ordering.Less
  }
  if a.length > b.length {
    return Ordering.Greater
  }
  return Ordering.Equal
}

impl<'text> Order for Count<'text> { compare: compareCounts }

effect fn count(text: string<'static>) -> () ! LogError | OutOfMemoryError ? &mut Logger | &mut Allocator {
  let mut seen = HashMap<Word, u32>.make(Hash.seed(2026))
  let mut order = List<Word>.make()
  let mut words = String.split(text, " ")
  while true {
    let w = match Split.next(&mut words) {
      Option<string>.Some { value } => Word { text: value }
      Option<string>.None => { break }
    }
    let mut n: u32 = 0
    if let Option<u32>.Some { value } = seen.get(w) {
      n = value
    } else {
      run order.append(w)
    }
    drop run seen.insert(w, n + 1)
  }
  let mut counts = List<Count>.make()
  let mut index: usize = 0
  while index < order.length() {
    let w = order.get(index)
    let n = match seen.get(w) {
      Option<u32>.Some { value } => value
      Option<u32>.None => 0
    }
    run counts.append(Count { word: w, n: n })
    index = index + 1
  }
  run counts.sort()
  index = 0
  while index < counts.length() && index < 3 {
    let c = counts.get(index)
    run Effect.log("{w} {n}\n", &.{ w: c.word.text, n: c.n })
    index = index + 1
  }
}

pub effect fn main() -> () ! LogError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut logger = StdoutLogger.make()
  run count(TEXT)
    |> Effect.provideMut<Logger>(&mut logger)
    |> Effect.provideMut<Allocator>(&mut allocator)
}
