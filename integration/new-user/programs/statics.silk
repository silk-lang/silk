import silk.reflect { Reflect }
import silk.static_text { StaticText }
import silk.target { Arch, Target }

static fn fib(n: u32) -> u64 {
  let mut a: u64 = 0
  let mut b: u64 = 1
  let mut i: u32 = 0
  while i < n {
    let next = a + b
    a = b
    b = next
    i = i + 1
  }
  return a
}

const FIB_20: u64 = fib(20)
const SIZE: usize = 4
const GREETING: string = "hello"

static fn shout(text: string<'static>) -> string<'static> {
  return StaticText.concat(text, "!")
}

static fn checkedSize(n: usize) -> usize {
  if n == 0 {
    compileError("size must be positive")
  }
  return n
}

struct Units {
  scale: i64,
}

impl Units {
  static fn kilo() -> Units {
    return Units { scale: 1000 }
  }
}

fn power(static exp: u32, x: i64) -> i64 {
  static if exp == 0 {
    return 1
  } else {
    return x * power(exp - 1, x)
  }
}

pub struct Stats {
  pub hits: i32,
  pub misses: i32,
  pub bonus: i32,
}

fn sumFields(stats: &Stats) -> i32 {
  let mut total = 0
  static for field in Reflect.fields<Stats>() {
    total = total + Reflect.borrowField(stats, field).*
  }
  return total
}

fn onlyHits(stats: &Stats) -> i32 {
  static for field in Reflect.fields<Stats>() {
    static if Reflect.fieldLabel(field) == "hits" {
      return Reflect.borrowField(stats, field).*
    }
  }
  return -1
}

fn archCode() -> i32 {
  static if Target.arch() == Arch.X86_64 {
    return 64
  }
  return 0
}

pub fn main() -> i32 {
  if FIB_20 != 6765 {
    return 1
  }
  let static loud = shout(GREETING)
  let static loudLength = StaticText.byteLength(loud)
  if loudLength != 6 {
    return 2
  }
  let table: [i32; SIZE] = [1, 2, 3, 4]
  let static size = checkedSize(SIZE)
  if table.length != size {
    return 3
  }
  if power(10, 2) != 1024 || power(0, 9) != 1 {
    return 4
  }
  let stats = Stats { hits: 3, misses: 4, bonus: 5 }
  if sumFields(&stats) != 12 || onlyHits(&stats) != 3 {
    return 5
  }
  let static kilo = Units.kilo()
  if kilo.scale != 1000 {
    return 6
  }
  if archCode() != 64 {
    return 7
  }
  return 0
}
