// Round 54: collections that own their values (std/hash_map, std/hash, std/list, std/string): a
// string key type, word counts updated in place with withMut, a map whose values are lists of
// owned Strings, moving a list out with remove, and visiting entries in bucket order.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.hash { Hash, HashKey, HashSeed, Word }
import silk.hash_map { HashMap }
import silk.list { List }
import silk.option { Option }
import silk.ownership { Copy }
import silk.string { Split, String }
import silk.u8
import silk.usize

struct Name {
  text: string,
}

impl Copy for Name {}

fn nameEquals(left: &Name, right: &Name) -> bool {
  return left.text == right.text
}

fn nameHash(value: &Name, seed: &HashSeed) -> u64 {
  let bytes = String.utf8Bytes(value.text)
  let mut hashed = Hash.mix(seed, usize.toU64(bytes.length))
  let mut i: usize = 0
  while i < bytes.length {
    hashed = Hash.combine(hashed, u8.toU64(bytes[i]))
    i = i + 1
  }
  return hashed
}

impl HashKey for Name {
  equals: Name.nameEquals

  hash: Name.nameHash
}

// Finding 167: with `text: string` and `HashMap<Name, i32>` the return is SEM0129, so the
// lifetime is written out.
effect fn count<'t>(text: string<'t>) -> HashMap<Name<'t>, i32> ! OutOfMemoryError ? &mut Allocator {
  let mut counts = HashMap<Name<'t>, i32>.make(Hash.seed(7))
  let mut words = String.split(text, " ")
  while true {
    let word = match Split.next(&mut words) {
      Option.Some { value: piece } => piece
      Option.None => { break }
    }
    if word == "" {
      continue
    }
    let key = Name { text: word }
    let found = HashMap<Name, i32>.withMut(&mut counts, key, fn(n: &mut i32) -> () {
      n.* = n.* + 1
    })
    if !found {
      drop run HashMap<Name, i32>.insert(&mut counts, key, 1)
    }
  }
  return move counts
}

// Groups words by their byte length; each group owns copies of its words.
effect fn group(text: string) -> HashMap<Word, List<String>> ! OutOfMemoryError ? &mut Allocator {
  let mut groups = HashMap<Word, List<String>>.make(Hash.seed(9))
  let mut words = String.split(text, " ")
  while true {
    let word = match Split.next(&mut words) {
      Option.Some { value: piece } => piece
      Option.None => { break }
    }
    let size = Hash.word(usize.toU64(String.byteLength(word)))
    let mut list = match HashMap<Word, List<String>>.remove(&mut groups, size) {
      Option.Some { value: existing } => move existing
      Option.None => List<String>.make()
    }
    let copy = run String.copy(word)
    run List<String>.append(&mut list, move copy)
    drop run HashMap<Word, List<String>>.insert(&mut groups, size, move list)
  }
  return move groups
}

effect fn check() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let text = "the cat and the dog and the bird  ünï"
  let counts = run count(text)
  if HashMap<Name, i32>.length(&counts) != 6 { return 1 }
  if (HashMap<Name, i32>.get(&counts, Name { text: "the" }) |> Option<i32>.unwrapOr(0)) != 3 { return 2 }
  if (HashMap<Name, i32>.get(&counts, Name { text: "ünï" }) |> Option<i32>.unwrapOr(0)) != 1 { return 3 }
  if HashMap<Name, i32>.contains(&counts, Name { text: "fish" }) { return 4 }
  let mut total = 0
  let mut index: usize = 0
  while index < HashMap<Name, i32>.bucketCount(&counts) {
    if HashMap<Name, i32>.occupiedAt(&counts, index) {
      total = total + HashMap<Name, i32>.valueAt(&counts, index)
    }
    index = index + 1
  }
  if total != 9 { return 5 }

  let mut groups = run group("the cat and a bird ünï")
  if HashMap<Word, List<String>>.length(&groups) != 4 { return 6 }
  let threes = match HashMap<Word, List<String>>.remove(&mut groups, Hash.word(3)) {
    Option.Some { value: list } => move list
    Option.None => { return 7 }
  }
  if List<String>.length(&threes) != 3 { return 8 }
  let first = List<String>.asSlice(&threes)
  if first[0].view() != "the" || first[2].view() != "and" { return 9 }
  if HashMap<Word, List<String>>.length(&groups) != 3 { return 10 }
  let fives = match HashMap<Word, List<String>>.remove(&mut groups, Hash.word(5)) {
    Option.Some { value: list } => move list
    Option.None => { return 11 }
  }
  if List<String>.asSlice(&fives)[0].view() != "ünï" { return 12 }
  return 0
}

pub effect fn main() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run check() |> Effect.provideMut<Allocator>(&mut allocator)
}
