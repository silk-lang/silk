#!/usr/bin/env python3
"""Run silk.url against the pinned web-platform-tests URL data.

The driver downloads the checksum-pinned WPT files, writes one native Silk program with every
case, builds it with $SILK against the repository's stdlib, and runs it. The program prints one
line per failed expectation and exits 1 when any case fails:

- url/resources/urltestdata.json: parsing with and without a base, every component getter.
- url/resources/setters_tests.json: every API setter.
- url/resources/toascii.json and IdnaTestV2.json: domain to ASCII through `https://<input>/x`.

--cache DIR reuses or stores the downloads elsewhere; --keep leaves the generated program.
"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
import urllib.request

ROOT = Path(__file__).resolve().parents[2]
REVISION = "b27f84327a95ab25aed6ebacccc9ceabcafe47aa"
BASE = f"https://raw.githubusercontent.com/web-platform-tests/wpt/{REVISION}/url/resources/"
FILES = {
    "urltestdata.json": "e9f53c341d498e64f8c4df212439ba9cffe55ac1c4fb566d27691ef71199d143",
    "setters_tests.json": "62e4b14bdaddd66b0f7d99bf066aed1c4a588667f4aa97bf26da212134fc24bf",
    "toascii.json": "644eba9d5b593df8095cfa307222f3014542ff9cc02d555f8e5660059d80470f",
    "IdnaTestV2.json": "84de621e5239676e59e5a3e68ef3e2b1acde9da5480a633d2ef446ef03238b76",
}
COMPONENTS = ("href", "protocol", "username", "password", "host", "hostname", "port", "pathname", "search", "hash")

HEAD = r'''// Generated by integration/url-conformance/check-url from web-platform-tests REVISION.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.text.string { String }
import silk.url.url { Url }
import silk.io.writer_native { StderrWriter }

struct Failures { count: usize }

fn component<'a>(url: &'a Url, key: string) -> string<'a> {
  if key == "href" { return Url.href(url) }
  if key == "protocol" { return Url.protocol(url) }
  if key == "username" { return Url.username(url) }
  if key == "password" { return Url.password(url) }
  if key == "host" { return Url.host(url) }
  if key == "hostname" { return Url.hostname(url) }
  if key == "port" { return Url.port(url) }
  if key == "pathname" { return Url.pathname(url) }
  if key == "search" { return Url.search(url) }
  return Url.hash(url)
}

// `expected` holds key, 0x01, value, 0x02 for each component to compare.
fn compare(url: &Url, label: string, expected: string, failures: &mut Failures) -> () {
  let bytes = String.utf8Bytes(expected)
  let mut i: usize = 0
  while i < bytes.length {
    let keyStart = i
    while bytes[i] != 1 { i = i + 1 }
    let key = String.slice(expected, keyStart, i - keyStart)
    i = i + 1
    let valueStart = i
    while bytes[i] != 2 { i = i + 1 }
    let want = String.slice(expected, valueStart, i - valueStart)
    i = i + 1
    let got = component(url, key)
    if got != want {
      StderrWriter.print("FAIL {} {}: got {} want {}\n", &(label, key, got, want))
      failures.count = failures.count + 1
    }
  }
}

effect fn parseWith(input: string, base: string, hasBase: bool) -> Option<Url> ! OutOfMemoryError ? &mut Allocator {
  if !hasBase { return run Url.parse(input, Option<&Url>.none()) }
  let parsedBase = run Url.parse(base, Option<&Url>.none())
  return match move parsedBase {
    Option<Url>.Some { value } => run Url.parse(input, Option<&Url>.some(&value))
    Option<Url>.None => Option<Url>.none()
  }
}

// An empty `expected` means the input must not parse.
effect fn parses(input: string, base: string, hasBase: bool, expected: string, failures: &mut Failures) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  match run parseWith(input, base, hasBase) {
    Option<Url>.Some { value } => {
      if String.byteLength(expected) == 0 {
        StderrWriter.print("FAIL {} (base {}): parsed as {}, want failure\n", &(input, base, Url.href(&value)))
        failures.count = failures.count + 1
      } else {
        compare(&value, input, expected, &mut failures.*)
      }
    }
    Option<Url>.None => {
      if String.byteLength(expected) != 0 {
        StderrWriter.print("FAIL {} (base {}): failed to parse\n", &(input, base))
        failures.count = failures.count + 1
      }
    }
  }
}

effect fn apply(url: &mut Url, setter: string, value: string) -> () ! OutOfMemoryError ? &mut Allocator {
  if setter == "protocol" { return run Url.setProtocol(&mut url.*, value) }
  if setter == "username" { return run Url.setUsername(&mut url.*, value) }
  if setter == "password" { return run Url.setPassword(&mut url.*, value) }
  if setter == "host" { return run Url.setHost(&mut url.*, value) }
  if setter == "hostname" { return run Url.setHostname(&mut url.*, value) }
  if setter == "port" { return run Url.setPort(&mut url.*, value) }
  if setter == "pathname" { return run Url.setPathname(&mut url.*, value) }
  if setter == "search" { return run Url.setSearch(&mut url.*, value) }
  if setter == "hash" { return run Url.setHash(&mut url.*, value) }
  let _ok = run Url.setHref(&mut url.*, value)
  return ()
}

effect fn sets(setter: string, href: string, value: string, expected: string, failures: &mut Failures) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let parsed = run Url.parse(href, Option<&Url>.none())
  let mut url = match move parsed {
    Option<Url>.Some { value: found } => move found
    Option<Url>.None => {
      StderrWriter.print("FAIL setter base does not parse: {}\n", &.(href))
      failures.count = failures.count + 1
      return ()
    }
  }
  run apply(&mut url, setter, value)
  compare(&url, href, expected, &mut failures.*)
}

'''


def literal(text):
    out = []
    for ch in text:
        code = ord(ch)
        # JavaScript strings convert lone surrogates to U+FFFD before URL parsing.
        if 0xD800 <= code <= 0xDFFF:
            code = 0xFFFD
            ch = chr(code)
        if ch == '"':
            out.append('\\"')
        elif ch == "\\":
            out.append("\\\\")
        elif code < 0x20 or code >= 0x7F:
            out.append("\\u{%x}" % code)
        else:
            out.append(ch)
    return '"' + "".join(out) + '"'


def expectation(values):
    return literal("".join(f"{key}\x01{value}\x02" for key, value in values))


def fetch(cache, name):
    path = cache / name
    if path.is_file():
        data = path.read_bytes()
    else:
        with urllib.request.urlopen(BASE + name, timeout=60) as response:
            data = response.read()
    if hashlib.sha256(data).hexdigest() != FILES[name]:
        raise SystemExit(f"{name} does not match its pinned SHA-256")
    if not path.is_file():
        cache.mkdir(parents=True, exist_ok=True)
        path.write_bytes(data)
    return json.loads(data)


def cases(cache):
    calls = []
    for case in fetch(cache, "urltestdata.json"):
        if not isinstance(case, dict):
            continue
        base = case.get("base")
        has_base = "true" if base is not None else "false"
        wanted = "" if case.get("failure") else "".join(f"{key}\x01{case[key]}\x02" for key in COMPONENTS)
        calls.append(f"run parses({literal(case['input'])}, {literal(base or '')}, {has_base}, {literal(wanted)}, &mut failures)")
    for setter, group in fetch(cache, "setters_tests.json").items():
        if setter == "comment":
            continue
        for case in group:
            wanted = expectation(case["expected"].items())
            calls.append(f"run sets({literal(setter)}, {literal(case['href'])}, {literal(case['new_value'])}, {wanted}, &mut failures)")
    for name in ("toascii.json", "IdnaTestV2.json"):
        for case in fetch(cache, name):
            # An empty input cannot be a host of a URL.
            if not isinstance(case, dict) or case["input"] == "":
                continue
            output = case["output"]
            wanted = "\"\"" if output is None else expectation((("host", output), ("pathname", "/x")))
            calls.append(f"run parses({literal('https://' + case['input'] + '/x')}, \"\", false, {wanted}, &mut failures)")
    return calls


def program(calls):
    parts = [HEAD.replace("REVISION", REVISION)]
    groups = [calls[i:i + 200] for i in range(0, len(calls), 200)]
    for index, group in enumerate(groups):
        body = "\n".join("  " + call for call in group)
        parts.append(f"effect fn group{index}(failures: &mut Failures) -> () ! OutOfMemoryError ? &mut Allocator {{\n{body}\n}}\n\n")
    parts.append("pub effect fn main() -> i32\n  ! OutOfMemoryError {\n")
    parts.append("  let mut allocator = Allocator.systemAllocatorProvider()\n  let mut failures = Failures { count: 0 }\n")
    for index in range(len(groups)):
        parts.append(f"  run group{index}(&mut failures) |> Effect.provideMut<Allocator>(&mut allocator)\n")
    parts.append(f'  StderrWriter.print("{{}} of {len(calls)} cases have failures\\n", &.(failures.count))\n')
    parts.append("  if failures.count != 0 { return 1 }\n  return 0\n}\n")
    return "".join(parts)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--cache", type=Path, default=ROOT / "build/url-conformance", help="download cache")
    args = parser.parse_args()
    work = args.cache / "runner"
    (work / "src").mkdir(parents=True, exist_ok=True)
    (work / "silk.toml").write_text('[package]\nname = "url-conformance"\nversion = "0.0.0"\nsource = "src"\n')
    (work / "src/main.silk").write_text(program(cases(args.cache)))
    binary = work / ("url-conformance.exe" if os.name == "nt" else "url-conformance")
    command = [os.environ.get("SILK", "silk"), "build", str(work / "src/main.silk"), "-o", str(binary),
               "--stdlib", os.environ.get("SILK_STDLIB", str(ROOT / "stdlib")), "--optimization", "none"]
    subprocess.run(command, cwd=work, check=True)
    sys.exit(subprocess.run([str(binary)]).returncode)


if __name__ == "__main__":
    main()
