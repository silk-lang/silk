import silk.cli.command { Command, CommandLine, Opt }
import silk.cli.parse { Cli, Parsed, Variable }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.text.string { String }
import silk.testing.testing { AssertionError, Testing }
import silk.io.writer { Writer, WriterError }

// The options every build command shares, described once.
struct Shared {
  pub manifestPath: Option<Bytes>,
  pub release: bool,
  pub target: List<String>,
  pub output: Output,
}

impl CommandLine for Shared {
  static fn command() -> Command<Shared> {
    return Command<Shared>.make("", "")
      |> Command.option("manifestPath", Opt.about("The manifest"))
      |> Command.option("release", Opt.about("Optimize") |> Opt.short("r"))
      |> Command.option("target", Opt.about("A target"))
      |> Command.flatten("output")
  }
}

// A group inside a group.
struct Output {
  pub quiet: bool,
  pub progress: String,
}

impl CommandLine for Output {
  static fn command() -> Command<Output> {
    return Command<Output>.make("", "")
      |> Command.option("quiet", Opt.about("Less output") |> Opt.short("q"))
      |> Command.option(
        "progress",
        Opt.about("Progress display")
          |> Opt.default("auto")
          |> Opt.env("TOOL_PROGRESS"),
      )
  }
}

union Action {
  Build { pub shared: Shared },
  Check { pub shared: Shared, pub json: bool },
}

impl CommandLine for Action {
  static fn command() -> Command<Action> {
    return Command<Action>.make("tool", "A build tool")
      |> Command.flatten("shared")
      |> Command.variant("Build", "Build the package")
      |> Command.variant("Check", "Check the package")
  }
}

effect fn parseAction(arguments: &[string], environment: &[Variable<'_>]) -> Parsed<Action>
  ! OutOfMemoryError
  ? &mut Allocator {
  return run Cli.parseWith<Action>(arguments, environment)
}

fn sameBytes(left: &Option<Bytes>, right: &[u8]) -> bool {
  return match &left.* {
    Option<Bytes>.Some { value } => Bytes.asSlice(&value) == right
    Option<Bytes>.None => false
  }
}

test effect fn readsAGroupInEverySubcommand() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let none: [Variable<'static>; 0] = []
  let build = [
    "tool",
    "build",
    "-rq",
    "--manifest-path",
    "a/silk.toml",
    "--target",
    "x",
    "--target=y",
  ]
  match run parseAction(&build, &none) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Run { value: Action.Build { shared } } => {
      run Testing.expect(shared.release && shared.output.quiet, "grouped flags of two groups")
      run Testing.expect(sameBytes(&shared.manifestPath, b"a/silk.toml"), "a group option")
      run Testing.expect(List<String>.length(&shared.target) == 2, "a repeated group option")
      run Testing.expect(String.view(&shared.output.progress) == "auto", "a nested group default")
    }
    _ => run Testing.expect(false, "parses build")
  }
  let check = ["tool", "check", "--json", "--progress", "plain"]
  match run parseAction(&check, &none) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Run { value: Action.Check { shared, json } } => {
      run Testing.expect(json && !shared.release, "own and group options")
      run Testing.expect(String.view(&shared.output.progress) == "plain", "a nested group option")
    }
    _ => run Testing.expect(false, "parses check")
  }
  let progress = [Variable { name: "TOOL_PROGRESS", value: "never" }]
  let bare = ["tool", "build"]
  match run parseAction(&bare, &progress) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Run { value: Action.Build { shared } } => {
      run Testing.expect(
        String.view(&shared.output.progress) == "never",
        "a group option's variable",
      )
    }
    _ => run Testing.expect(false, "parses build from the environment")
  }
}

test effect fn readsExactBytes() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let none: [Variable<'static>; 0] = []
  let mut arguments = List<Bytes>.make()
  let words: [&[u8]; 3] = [b"tool", b"build", b"--manifest-path=dir\xff/silk.toml"]
  let mut at: usize = 0
  while at < 3 {
    let word = run Bytes.copy(words[at]) |> Effect.provideMut<Allocator>(&mut allocator)
    run List<Bytes>.append(&mut arguments, move word)
      |> Effect.provideMut<Allocator>(&mut allocator)
    at = at + 1
  }
  match run Cli.parseBytes<Action>(List<Bytes>.asSlice(&arguments), &none)
    |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Run { value: Action.Build { shared } } => {
      run Testing.expect(sameBytes(&shared.manifestPath, b"dir\xff/silk.toml"), "the exact bytes")
    }
    _ => run Testing.expect(false, "parses an argument that is not UTF-8")
  }
}

struct Captured {
  bytes: [u8; 2048],
  length: usize,
}

impl Writer for Captured {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> ()
    ! WriterError
    ? &mut Writer {
    let mut index: usize = 0
    while index < value.length && self.length < 2048 {
      self.bytes[self.length] = value[index]
      self.length = self.length + 1
      index = index + 1
    }
    return ()
  }

  effect fn flush(self: &mut Self) -> ()
    ! WriterError
    ? &mut Writer {
    return ()
  }
}

test effect fn listsGroupOptionsInHelp() -> ()
  ! AssertionError<'static> | WriterError {
  let mut out = Captured { bytes: [0; 2048], length: 0 }
  run Cli.writeHelp<Action>("check") |> Effect.provideMut<Writer>(&mut out)
  let expected = b"Usage: tool check [options]\n\nCheck the package\n\nOptions:\n      --manifest-path <value>  The manifest\n  -r, --release                Optimize\n      --target <value>         A target\n  -q, --quiet                  Less output\n      --progress <value>       Progress display [env: TOOL_PROGRESS] [default: auto]\n      --json\n  -h, --help                   Print this help\n"
  let mut same = out.length == expected.length
  let mut index: usize = 0
  while same && index < out.length {
    same = out.bytes[index] == expected[index]
    index = index + 1
  }
  run Testing.expect(same, "help text")
}
