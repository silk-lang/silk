import silk.cli.command { Command, CommandLine, Opt }
import silk.cli.completion { Completion }
import silk.cli.parse { Cli, CliError, Parsed }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.text.string { String }
import silk.testing.testing { AssertionError, Testing }
import silk.io.writer { Writer, WriterError }

struct Git {
  pub quiet: bool,
  pub command: GitCommand,
}

union GitCommand {
  Clone { pub url: String, pub depth: Option<u32> },
  Remote { pub verbose: bool, pub action: RemoteAction },
}

union RemoteAction {
  List,
  Add { pub name: String, pub url: String },
}

impl CommandLine for Git {
  static fn command() -> Command<Git> {
    return Command<Git>.make("git", "A tiny git")
      |> Command.option("quiet", Opt.about("Say less") |> Opt.short("q"))
      |> Command.subcommand("command")
  }
}

impl CommandLine for GitCommand {
  static fn command() -> Command<GitCommand> {
    return Command<GitCommand>.make("", "")
      |> Command.variant("Clone", "Copy a repository")
      |> Command.variant("Remote", "Manage remotes")
      |> Command.arg("url", Opt.about("Where to copy from") |> Opt.required)
      |> Command.option("depth", Opt.about("How many commits"))
      |> Command.option("verbose", Opt.plain() |> Opt.short("v"))
      |> Command.subcommand("action")
  }
}

impl CommandLine for RemoteAction {
  static fn command() -> Command<RemoteAction> {
    return Command<RemoteAction>.make("", "")
      |> Command.variant("Add", "Add a remote")
      |> Command.arg("name", Opt.plain() |> Opt.required)
      |> Command.arg("url", Opt.plain() |> Opt.required)
  }
}

effect fn parseGit(arguments: &[string]) -> Parsed<Git>
  ! OutOfMemoryError
  ? &mut Allocator {
  return run Cli.parse<Git>(arguments)
}

fn same(left: &String, right: string) -> bool {
  return String.view(left) == right
}

test effect fn choosesOneSubcommand() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let arguments = ["git", "-q", "clone", "https://example.com/r", "--depth", "1"]
  match run parseGit(&arguments) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Run { value } => {
      run Testing.expect(value.quiet, "root flag before the subcommand")
      match move value.command {
        GitCommand.Clone { url, depth } => {
          run Testing.expect(same(&url, "https://example.com/r"), "clone url")
          match move depth {
            Option.Some { value: count } => run Testing.expect(count == 1, "depth")
            Option.None => run Testing.expect(false, "depth is present")
          }
        }
        _ => run Testing.expect(false, "clone is chosen")
      }
    }
    _ => run Testing.expect(false, "parses")
  }
}

test effect fn nestsSubcommands() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let arguments = ["git", "remote", "-v", "add", "origin", "https://example.com/r"]
  match run parseGit(&arguments) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Run { value } => {
      match move value.command {
        GitCommand.Remote { verbose, action: RemoteAction.Add { name, url } } => {
          run Testing.expect(verbose, "remote flag")
          run Testing.expect(
            same(&name, "origin") && same(&url, "https://example.com/r"),
            "add arguments",
          )
        }
        _ => run Testing.expect(false, "remote add is chosen")
      }
    }
    _ => run Testing.expect(false, "parses")
  }
  let listing = ["git", "remote", "list"]
  match run parseGit(&listing) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Run { value } => {
      match move value.command {
        GitCommand.Remote { verbose, action: RemoteAction.List } => run Testing.expect(
          !verbose,
          "a variant without fields",
        )
        _ => run Testing.expect(false, "remote list is chosen")
      }
    }
    _ => run Testing.expect(false, "parses list")
  }
}

test effect fn needsASubcommand() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let none = ["git"]
  match run parseGit(&none) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Failed { error: CliError.MissingCommand { command } } => run Testing.expect(
      command == "git",
      "the root needs a command",
    )
    _ => run Testing.expect(false, "missing command")
  }
  let nested = ["git", "remote"]
  match run parseGit(&nested) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Failed { error: CliError.MissingCommand { command } } => run Testing.expect(
      command == "git remote",
      "remote needs a command",
    )
    _ => run Testing.expect(false, "missing nested command")
  }
  let unknown = ["git", "push"]
  match run parseGit(&unknown) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Failed { error: CliError.UnknownCommand { command, token } } => run Testing.expect(
      command == "git" && same(&token, "push"),
      "push is no command",
    )
    _ => run Testing.expect(false, "unknown command")
  }
}

test effect fn reportsSubcommandHelpAndErrors() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let help = ["git", "remote", "add", "--help"]
  match run parseGit(&help) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Help { command } => run Testing.expect(command == "remote.add", "help path")
    _ => run Testing.expect(false, "help")
  }
  let missing = ["git", "clone"]
  match run parseGit(&missing) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Failed { error: CliError.MissingRequired { option } } => run Testing.expect(
      option == "<url>",
      "url is required",
    )
    _ => run Testing.expect(false, "missing url")
  }
}

struct Captured {
  bytes: [u8; 2048],
  length: usize,
}

impl Writer for Captured {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> ()
    ! WriterError
    ? &mut Writer {
    let mut index: usize = 0
    while index < value.length && self.length < 2048 {
      self.bytes[self.length] = value[index]
      self.length = self.length + 1
      index = index + 1
    }
    return ()
  }

  effect fn flush(self: &mut Self) -> ()
    ! WriterError
    ? &mut Writer {
    return ()
  }
}

fn captured(out: &Captured, expected: &[u8]) -> bool {
  if out.length != expected.length {
    return false
  }
  let mut index: usize = 0
  while index < out.length {
    if out.bytes[index] != expected[index] {
      return false
    }
    index = index + 1
  }
  return true
}

test effect fn writesSubcommandHelp() -> ()
  ! AssertionError<'static> | WriterError {
  let mut root = Captured { bytes: [0; 2048], length: 0 }
  run Cli.writeHelp<Git>("") |> Effect.provideMut<Writer>(&mut root)
  run Testing.expect(
    captured(
      &root,
      b"Usage: git [options] <command>\n\nA tiny git\n\nOptions:\n  -q, --quiet          Say less\n  -h, --help           Print this help\n\nCommands:\n  clone                Copy a repository\n  remote               Manage remotes\n",
    ),
    "root help",
  )
  let mut nested = Captured { bytes: [0; 2048], length: 0 }
  run Cli.writeHelp<Git>("remote.add") |> Effect.provideMut<Writer>(&mut nested)
  run Testing.expect(
    captured(
      &nested,
      b"Usage: git remote add [options] <name> <url>\n\nAdd a remote\n\nOptions:\n  -h, --help     Print this help\n\nArguments:\n  <name>         (required)\n  <url>          (required)\n",
    ),
    "nested help",
  )
  let mut middle = Captured { bytes: [0; 2048], length: 0 }
  run Cli.writeHelp<Git>("remote") |> Effect.provideMut<Writer>(&mut middle)
  run Testing.expect(
    captured(
      &middle,
      b"Usage: git remote [options] <command>\n\nManage remotes\n\nOptions:\n  -v, --verbose\n  -h, --help             Print this help\n\nCommands:\n  list\n  add                    Add a remote\n",
    ),
    "middle help",
  )
}

/// A tool whose root is a union of subcommands, each holding the next.
union Tool {
  Config { pub area: Area },
}

union Area {
  User { pub action: UserAction },
}

union UserAction {
  Set { pub name: String },
}

impl CommandLine for Tool {
  static fn command() -> Command<Tool> {
    return Command<Tool>.make("tool", "")
      |> Command.variant("Config", "Settings")
      |> Command.subcommand("area")
  }
}

impl CommandLine for Area {
  static fn command() -> Command<Area> {
    return Command<Area>.make("", "")
      |> Command.variant("User", "User settings")
      |> Command.subcommand("action")
  }
}

impl CommandLine for UserAction {
  static fn command() -> Command<UserAction> {
    return Command<UserAction>.make("", "")
      |> Command.variant("Set", "Set the name")
      |> Command.arg("name", Opt.plain() |> Opt.required)
  }
}

test effect fn nestsThreeLevels() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let arguments = ["tool", "config", "user", "set", "ana"]
  match run Cli.parse<Tool>(&arguments) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Run { value } => {
      match move value {
        Tool.Config { area: Area.User { action: UserAction.Set { name } } } => run Testing.expect(
          same(&name, "ana"),
          "name",
        )
      }
    }
    _ => run Testing.expect(false, "parses")
  }
  let help = ["tool", "config", "user", "set", "-h"]
  match run Cli.parse<Tool>(&help) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Help { command } => run Testing.expect(command == "config.user.set", "help path")
    _ => run Testing.expect(false, "help")
  }
}

test effect fn writesDeepSubcommandHelp() -> ()
  ! AssertionError<'static> | WriterError {
  let mut out = Captured { bytes: [0; 2048], length: 0 }
  run Cli.writeHelp<Tool>("config.user.set") |> Effect.provideMut<Writer>(&mut out)
  run Testing.expect(
    captured(
      &out,
      b"Usage: tool config user set [options] <name>\n\nSet the name\n\nOptions:\n  -h, --help     Print this help\n\nArguments:\n  <name>         (required)\n",
    ),
    "deep help",
  )
}

test effect fn writesCompletions() -> ()
  ! AssertionError<'static> | WriterError {
  let mut bash = Captured { bytes: [0; 2048], length: 0 }
  run Completion.writeBash<Git>() |> Effect.provideMut<Writer>(&mut bash)
  run Testing.expect(
    captured(
      &bash,
      b"_git() {\n  local cur prev path words files i\n  cur=\"${COMP_WORDS[COMP_CWORD]}\"\n  prev=\"${COMP_WORDS[COMP_CWORD-1]}\"\n  path=\"\"\n  files=\"\"\n  for ((i = 1; i < COMP_CWORD; i++)); do\n    case \"$path:${COMP_WORDS[i]}\" in\n      \":clone\") path=\"clone\" ;;\n      \":remote\") path=\"remote\" ;;\n      \"remote:list\") path=\"remote.list\" ;;\n      \"remote:add\") path=\"remote.add\" ;;\n    esac\n  done\n  case \"$path\" in\n    \"\") words=\"clone remote --quiet -q --help -h\" ;;\n    \"clone\") files=1; words=\"--depth --help -h\" ;;\n    \"remote\") words=\"list add --verbose -v --help -h\" ;;\n    \"remote.list\") words=\"--help -h\" ;;\n    \"remote.add\") files=1; words=\"--help -h\" ;;\n  esac\n  case \"$path:$prev\" in\n  esac\n  COMPREPLY=($(compgen -W \"$words\" -- \"$cur\"))\n  if [ -n \"$files\" ]; then\n    COMPREPLY+=($(compgen -f -- \"$cur\"))\n  fi\n}\ncomplete -F _git git\n",
    ),
    "bash script",
  )
  let mut fish = Captured { bytes: [0; 2048], length: 0 }
  run Completion.writeFish<Git>() |> Effect.provideMut<Writer>(&mut fish)
  run Testing.expect(
    captured(
      &fish,
      b"function __git\n  set -l words (commandline -opc)\n  set -l path ''\n  set -l files ''\n  for word in $words[2..-1]\n    switch \"$path:$word\"\n      case ':clone'\n        set path clone\n      case ':remote'\n        set path remote\n      case 'remote:list'\n        set path remote.list\n      case 'remote:add'\n        set path remote.add\n    end\n  end\n  switch \"$path:$words[-1]\"\n  end\n  switch \"$path\"\n    case ''\n      printf '%s\\n' clone remote --quiet -q --help -h\n    case 'clone'\n      set files 1\n      printf '%s\\n' --depth --help -h\n    case 'remote'\n      printf '%s\\n' list add --verbose -v --help -h\n    case 'remote.list'\n      printf '%s\\n' --help -h\n    case 'remote.add'\n      set files 1\n      printf '%s\\n' --help -h\n  end\n  if test -n \"$files\"\n    __fish_complete_path (commandline -ct)\n  end\nend\ncomplete -c git -f -a '(__git)'\n",
    ),
    "fish script",
  )
}

struct Plain {
  pub count: u32,
  pub loud: bool,
}

impl CommandLine for Plain {}

union Verb {
  Start { pub fast: bool },
  Stop,
}

impl CommandLine for Verb {}

test effect fn derivesTheDefaultDescription() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let arguments = ["plain", "--count", "3", "--loud"]
  match run Cli.parse<Plain>(&arguments) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Run { value } => run Testing.expect(
      value.count == 3 && value.loud,
      "options named after fields",
    )
    _ => run Testing.expect(false, "parses a struct without a description")
  }
  let start = ["verb", "start", "--fast"]
  match run Cli.parse<Verb>(&start) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Run { value: Verb.Start { fast } } => run Testing.expect(
      fast,
      "a variant named after its label",
    )
    _ => run Testing.expect(false, "parses a union without a description")
  }
  let stop = ["verb", "stop"]
  match run Cli.parse<Verb>(&stop) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Run { value: Verb.Stop } => {}
    _ => run Testing.expect(false, "parses a variant without fields")
  }
}
