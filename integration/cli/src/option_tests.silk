import silk.cli.command { Command, CommandLine, Opt }
import silk.cli.parse { Cli, CliError, Parsed, Variable }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.text.string { String }
import silk.testing.testing { AssertionError, Testing }
import silk.io.writer { Writer, WriterError }

struct Serve {
  pub verbose: bool,
  pub quiet: bool,
  pub port: u16,
  pub format: String,
  pub mode: String,
}

impl CommandLine for Serve {
  static fn command() -> Command<Serve> {
    return Command<Serve>.make("serve", "Serve files")
      |> Command.option(
        "verbose",
        Opt.plain()
          |> Opt.short("v")
          |> Opt.env("SERVE_VERBOSE"),
      )
      |> Command.option("quiet", Opt.plain() |> Opt.short("q"))
      |> Command.option(
        "port",
        Opt.plain()
          |> Opt.short("p")
          |> Opt.describe("Port")
          |> Opt.env("PORT")
          |> Opt.default("80")
          |> Opt.check<u16>(unprivileged),
      )
      |> Command.option(
        "format",
        Opt.plain()
          |> Opt.short("f")
          |> Opt.choice("json")
          |> Opt.choice("text")
          |> Opt.default("text"),
      )
      |> Command.arg(
        "mode",
        Opt.about("How")
          |> Opt.choice("dev")
          |> Opt.choice("prod")
          |> Opt.default("dev"),
      )
  }
}

fn unprivileged(port: &u16) -> bool {
  return port.* >= 80
}

effect fn parseServe(arguments: &[string], environment: &[Variable<'_>]) -> Parsed<Serve>
  ! OutOfMemoryError
  ? &mut Allocator {
  return run Cli.parseWith<Serve>(arguments, environment)
}

fn same(left: &String, right: string) -> bool {
  return String.view(left) == right
}

test effect fn groupsShortFlags() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let none: [Variable<'static>; 0] = []
  let grouped = ["serve", "-vqp8080", "-fjson"]
  match run parseServe(&grouped, &none) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Run { value } => {
      run Testing.expect(value.verbose && value.quiet, "both flags")
      run Testing.expect(value.port == 8080, "attached value")
      run Testing.expect(same(&value.format, "json"), "attached choice")
    }
    _ => run Testing.expect(false, "parses a group")
  }
  let separate = ["serve", "-qp", "9000", "-f=text"]
  match run parseServe(&separate, &none) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Run { value } => {
      run Testing.expect(value.quiet && !value.verbose, "one flag")
      run Testing.expect(value.port == 9000, "value from the next argument")
      run Testing.expect(same(&value.format, "text"), "value after =")
    }
    _ => run Testing.expect(false, "parses a group with a separate value")
  }
  let unknown = ["serve", "-vx"]
  match run parseServe(&unknown, &none) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Failed { error: CliError.UnknownOption { token, suggestion: _ } } => run Testing.expect(
      same(&token, "-vx"),
      "unknown letter",
    )
    _ => run Testing.expect(false, "rejects an unknown letter")
  }
}

test effect fn checksChoices() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let none: [Variable<'static>; 0] = []
  let named = ["serve", "--format", "yaml"]
  match run parseServe(&named, &none) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Failed { error: CliError.NotAChoice { option, token, choices } } => {
      run Testing.expect(option == "--format" && same(&token, "yaml"), "option and token")
      run Testing.expect(choices == "json, text", "choices")
    }
    _ => run Testing.expect(false, "rejects an option value")
  }
  let positional = ["serve", "staging"]
  match run parseServe(&positional, &none) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Failed {
      error: CliError.NotAChoice { option, token: _, choices }
    } => run Testing.expect(option == "<mode>" && choices == "dev, prod", "positional choices")
    _ => run Testing.expect(false, "rejects a positional value")
  }
  let good = ["serve", "prod"]
  match run parseServe(&good, &none) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Run { value } => run Testing.expect(same(&value.mode, "prod"), "accepts a choice")
    _ => run Testing.expect(false, "parses a choice")
  }
}

test effect fn runsChecks() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let none: [Variable<'static>; 0] = []
  let low = ["serve", "--port", "22"]
  match run parseServe(&low, &none) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Failed { error: CliError.InvalidValue { option, token } } => {
      run Testing.expect(option == "--port" && same(&token, "22"), "option and token")
    }
    _ => run Testing.expect(false, "rejects a value its check refuses")
  }
  let high = ["serve", "-p", "8080"]
  match run parseServe(&high, &none) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Run { value } => run Testing.expect(
      value.port == 8080,
      "accepts a value its check passes",
    )
    _ => run Testing.expect(false, "parses a checked value")
  }
  let port = [Variable { name: "PORT", value: "21" }]
  let bare = ["serve"]
  match run parseServe(&bare, &port) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Failed { error: CliError.InvalidValue { option, .. } } => run Testing.expect(
      option == "PORT",
      "checks the environment",
    )
    _ => run Testing.expect(false, "rejects an environment value its check refuses")
  }
}

test effect fn readsEnvironment() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let environment = [
    Variable { name: "PORT", value: "3000" },
    Variable { name: "SERVE_VERBOSE", value: "1" },
  ]
  let empty = ["serve"]
  match run parseServe(&empty, &environment) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Run { value } => {
      run Testing.expect(value.port == 3000, "port from the environment")
      run Testing.expect(value.verbose, "flag from the environment")
    }
    _ => run Testing.expect(false, "parses with the environment")
  }
  let given = ["serve", "--port", "4000"]
  match run parseServe(&given, &environment) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Run { value } => run Testing.expect(value.port == 4000, "the command line wins")
    _ => run Testing.expect(false, "parses over the environment")
  }
  let off = [Variable { name: "SERVE_VERBOSE", value: "false" }]
  match run parseServe(&empty, &off) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Run { value } => run Testing.expect(!value.verbose, "false leaves a flag off")
    _ => run Testing.expect(false, "parses with a false flag")
  }
  let bad = [Variable { name: "PORT", value: "x" }]
  match run parseServe(&empty, &bad) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Failed { error: CliError.InvalidValue { option, token: _ } } => run Testing.expect(
      option == "PORT",
      "names the variable",
    )
    _ => run Testing.expect(false, "rejects a bad variable")
  }
}

struct Captured {
  bytes: [u8; 2048],
  length: usize,
}

impl Writer for Captured {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> ()
    ! WriterError
    ? &mut Writer {
    let mut index: usize = 0
    while index < value.length && self.length < 2048 {
      self.bytes[self.length] = value[index]
      self.length = self.length + 1
      index = index + 1
    }
    return ()
  }

  effect fn flush(self: &mut Self) -> ()
    ! WriterError
    ? &mut Writer {
    return ()
  }
}

fn captured(out: &Captured, expected: &[u8]) -> bool {
  if out.length != expected.length {
    return false
  }
  let mut index: usize = 0
  while index < out.length {
    if out.bytes[index] != expected[index] {
      return false
    }
    index = index + 1
  }
  return true
}

test effect fn writesChoicesAndEnvironment() -> ()
  ! AssertionError<'static> | WriterError {
  let mut out = Captured { bytes: [0; 2048], length: 0 }
  run Cli.writeHelp<Serve>("") |> Effect.provideMut<Writer>(&mut out)
  run Testing.expect(
    captured(
      &out,
      b"Usage: serve [options] <mode>\n\nServe files\n\nOptions:\n  -v, --verbose          [env: SERVE_VERBOSE]\n  -q, --quiet\n  -p, --port <value>     Port [env: PORT] [default: 80]\n  -f, --format <value>   [choices: json, text] [default: text]\n  -h, --help             Print this help\n\nArguments:\n  <mode>                 How [choices: dev, prod] [default: dev]\n",
    ),
    "help lists choices and variables",
  )
}
