import silk.cli.command { Command, CommandLine, Opt }
import silk.cli.parse { Cli, CliError, Parsed }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.text.string { String }
import silk.testing.testing { AssertionError, Testing }
import silk.io.writer { Writer, WriterError }

struct Greet {
  pub name: String,
  pub times: u32,
  pub loud: bool,
  /// What friends call them.
  /// Only the first line is help text.
  pub nickName: Option<String>,
  pub files: List<String>,
}

impl CommandLine for Greet {
  static fn command() -> Command<Greet> {
    return Command<Greet>.make("greet", "Say hello to someone")
      |> Command.withVersion("1.2.3")
      |> Command.option(
        "name",
        Opt.about("Who to greet")
          |> Opt.short("n")
          |> Opt.default("world"),
      )
      |> Command.option("times", Opt.about("How many times") |> Opt.default("1"))
      |> Command.option("loud", Opt.about("Shout it") |> Opt.short("l"))
      |> Command.arg("files", Opt.about("Files to greet"))
  }
}

struct Required {
  pub target: String,
  pub port: u16,
}

impl CommandLine for Required {
  static fn command() -> Command<Required> {
    return Command<Required>.make("connect", "")
      |> Command.arg("target", Opt.plain() |> Opt.required)
      |> Command.option("port", Opt.plain() |> Opt.required)
  }
}

effect fn parseGreet(arguments: &[string]) -> Parsed<Greet>
  ! OutOfMemoryError
  ? &mut Allocator {
  return run Cli.parse<Greet>(arguments)
}

fn same(left: &String, right: string) -> bool {
  return String.view(left) == right
}

test effect fn readsDefaults() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let arguments = ["greet"]
  let parsed = run parseGreet(&arguments) |> Effect.provideMut<Allocator>(&mut allocator)
  match move parsed {
    Parsed.Run { value } => {
      run Testing.expect(same(&value.name, "world"), "name reads its default")
      run Testing.expect(value.times == 1, "times reads its default")
      run Testing.expect(!value.loud, "loud is off")
      run Testing.expect(List<String>.length(&value.files) == 0, "no files")
    }
    _ => run Testing.expect(false, "parses")
  }
}

test effect fn readsEveryForm() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let arguments = [
    "greet",
    "-n",
    "Julia",
    "--times=3",
    "--loud",
    "a.txt",
    "--nick-name",
    "jo",
    "--",
    "--b.txt",
  ]
  let parsed = run parseGreet(&arguments) |> Effect.provideMut<Allocator>(&mut allocator)
  match move parsed {
    Parsed.Run { value } => {
      run Testing.expect(same(&value.name, "Julia"), "name from the alias")
      run Testing.expect(value.times == 3, "times from --times=3")
      run Testing.expect(value.loud, "loud flag")
      run Testing.expect(List<String>.length(&value.files) == 2, "two files")
      run Testing.expect(same(&List<String>.asSlice(&value.files)[1], "--b.txt"), "after --")
      match move value.nickName {
        Option.Some { value: nick } => run Testing.expect(same(&nick, "jo"), "kebab-case name")
        Option.None => run Testing.expect(false, "nick name is present")
      }
    }
    _ => run Testing.expect(false, "parses")
  }
}

test effect fn reportsErrors() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let unknown = ["greet", "--nmae", "x"]
  match run parseGreet(&unknown) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Failed { error: CliError.UnknownOption { token, suggestion } } => run Testing.expect(
      same(&token, "--nmae") && suggestion == "--name",
      "unknown token and the closest name",
    )
    _ => run Testing.expect(false, "unknown option")
  }
  let far = ["greet", "--frobnicate"]
  match run parseGreet(&far) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Failed { error: CliError.UnknownOption { token: _, suggestion } } => run Testing.expect(
      suggestion == "",
      "no name is close",
    )
    _ => run Testing.expect(false, "unknown option far from every name")
  }
  let twice = ["greet", "-n", "a", "--name", "b"]
  match run parseGreet(&twice) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Failed { error: CliError.Repeated { option } } => run Testing.expect(
      option == "--name",
      "repeated option",
    )
    _ => run Testing.expect(false, "repeated option")
  }
  let flags = ["greet", "-ll"]
  match run parseGreet(&flags) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Failed { error: CliError.Repeated { option } } => run Testing.expect(
      option == "--loud",
      "repeated flag",
    )
    _ => run Testing.expect(false, "repeated flag")
  }
  let emptyValue = ["greet", "-n="]
  match run parseGreet(&emptyValue) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Run { value } => run Testing.expect(
      same(&value.name, ""),
      "an empty value after a letter",
    )
    _ => run Testing.expect(false, "parses -n=")
  }
  let flagValue = ["greet", "-l=yes"]
  match run parseGreet(&flagValue) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Failed { error: CliError.UnexpectedValue { option } } => run Testing.expect(
      option == "--loud",
      "a flag letter with a value",
    )
    _ => run Testing.expect(false, "refuses -l=yes")
  }
  let missing = ["greet", "--name"]
  match run parseGreet(&missing) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Failed { error: CliError.MissingValue { option } } => run Testing.expect(
      option == "--name",
      "missing value",
    )
    _ => run Testing.expect(false, "missing value")
  }
  let invalid = ["greet", "--times", "lots"]
  match run parseGreet(&invalid) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Failed { error: CliError.InvalidValue { option, token } } => run Testing.expect(
      option == "--times" && same(&token, "lots"),
      "invalid value",
    )
    _ => run Testing.expect(false, "invalid value")
  }
  let flagged = ["greet", "--loud=yes"]
  match run parseGreet(&flagged) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Failed { error: CliError.UnexpectedValue { option } } => run Testing.expect(
      option == "--loud",
      "flag value",
    )
    _ => run Testing.expect(false, "flag value")
  }
}

test effect fn answersHelpAndVersion() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let help = ["greet", "--times", "2", "-h"]
  match run parseGreet(&help) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Help { command: _ } => {}
    _ => run Testing.expect(false, "help")
  }
  let version = ["greet", "--version"]
  match run parseGreet(&version) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Version => {}
    _ => run Testing.expect(false, "version")
  }
}

test effect fn checksRequired() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let noPort = ["connect", "example.com"]
  match run Cli.parse<Required>(&noPort) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Failed { error: CliError.MissingRequired { option } } => run Testing.expect(
      option == "--port",
      "port is required",
    )
    _ => run Testing.expect(false, "missing port")
  }
  let extra = ["connect", "a", "b", "--port", "80"]
  match run Cli.parse<Required>(&extra) |> Effect.provideMut<Allocator>(&mut allocator) {
    Parsed.Failed { error: CliError.UnexpectedArgument { token } } => run Testing.expect(
      same(&token, "b"),
      "one target only",
    )
    _ => run Testing.expect(false, "extra argument")
  }
}

struct Captured {
  bytes: [u8; 2048],
  length: usize,
}

impl Writer for Captured {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> ()
    ! WriterError
    ? &mut Writer {
    let mut index: usize = 0
    while index < value.length && self.length < 2048 {
      self.bytes[self.length] = value[index]
      self.length = self.length + 1
      index = index + 1
    }
    return ()
  }

  effect fn flush(self: &mut Self) -> ()
    ! WriterError
    ? &mut Writer {
    return ()
  }
}

test effect fn writesHelp() -> ()
  ! AssertionError<'static> | WriterError {
  let mut out = Captured { bytes: [0; 2048], length: 0 }
  run Cli.writeHelp<Greet>("") |> Effect.provideMut<Writer>(&mut out)
  let expected = b"Usage: greet [options] <files>\n\nSay hello to someone\n\nOptions:\n  -n, --name <value>       Who to greet [default: world]\n      --times <value>      How many times [default: 1]\n  -l, --loud               Shout it\n      --nick-name <value>  What friends call them.\n  -h, --help               Print this help\n      --version            Print the version\n\nArguments:\n  <files>                  Files to greet\n"
  let mut same = out.length == expected.length
  let mut index: usize = 0
  while same && index < out.length {
    same = out.bytes[index] == expected[index]
    index = index + 1
  }
  run Testing.expect(same, "help text")
}
